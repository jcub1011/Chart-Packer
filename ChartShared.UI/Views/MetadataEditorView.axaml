<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ChartShared.UI.ViewModels"
             xmlns:res="using:ChartShared.UI.Resources"
             xmlns:ui="using:ChartShared.UI.Controls"
             xmlns:conv="using:ChartShared.UI.Converters"
             xmlns:meta="using:ChartShared.Core.Metadata"
             xmlns:views="using:ChartShared.UI.Views"
             mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="400"
             x:Class="ChartShared.UI.Views.MetadataEditorView"
             x:DataType="vm:MetadataEditorViewModel">
    <!-- A song inspector's metadata, Chart Packer's and Chart Builder's: the difficulties as icons, then a row per other
         key, edited in place, and a row to add a key. The inspector around it shows the section's heading.
         Too narrow for a key and value side by side (the compact class, set as the control is
         sized), each row's value goes on a second line under its key. -->

    <UserControl.Resources>
        <conv:DifficultyGlyphConverter x:Key="DifficultyGlyph"
                                       Guitar="{StaticResource InstrumentGuitarGeometry}"
                                       Bass="{StaticResource InstrumentBassGeometry}"
                                       Rhythm="{StaticResource InstrumentRhythmGeometry}"
                                       Drums="{StaticResource InstrumentDrumsGeometry}"
                                       ProDrums="{StaticResource InstrumentProDrumsGeometry}"
                                       Keys="{StaticResource InstrumentKeysGeometry}"
                                       ProKeys="{StaticResource InstrumentProKeysGeometry}"
                                       Vocals="{StaticResource InstrumentVocalsGeometry}"
                                       Harmonies="{StaticResource InstrumentHarmoniesGeometry}"
                                       Dance="{StaticResource InstrumentDanceGeometry}"
                                       Band="{StaticResource InstrumentBandGeometry}" />
        <!-- A chart difficulty's letter: E, M, H, X. -->
        <conv:DifficultyBrushConverter x:Key="DifficultyLetterBrush"
                                       Level0="{StaticResource DifficultyEasyBrush}"
                                       Level1="{StaticResource DifficultyMediumBrush}"
                                       Level2="{StaticResource DifficultyHardBrush}"
                                       Level3="{StaticResource DifficultyExpertBrush}" />
        <!-- A song.ini tier, 0 to 6 and up; unset is grey. -->
        <conv:DifficultyBrushConverter x:Key="DifficultyTierBrush"
                                       Level0="{StaticResource DifficultyTier0Brush}"
                                       Level1="{StaticResource DifficultyTier1Brush}"
                                       Level2="{StaticResource DifficultyTier2Brush}"
                                       Level3="{StaticResource DifficultyTier3Brush}"
                                       Level4="{StaticResource DifficultyTier4Brush}"
                                       Level5="{StaticResource DifficultyTier5Brush}"
                                       Level6="{StaticResource DifficultyTier6Brush}"
                                       Fallback="{StaticResource DifficultyUnsetBrush}" />
        <!-- "Expert   1,234 notes": a list's labels line up in a column, for an ItemsControl that's a shared size scope. -->
        <DataTemplate x:Key="NoteCountRowTemplate" x:DataType="vm:NoteCountRow">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="NoteCountLabel" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Classes="muted" Text="{Binding Label}" />
                <TextBlock Grid.Column="1" Text="{Binding Count}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://ChartShared.UI/Styles/Inspector.axaml" />
        <!-- Where a row's key and value go: side by side, or, compact, the value under the key,
             which takes the row's room. Set here rather than on the elements, as the compact styles move them. -->
        <Style Selector="TextBlock.metadataKey">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="1" />
        </Style>
        <Style Selector="Button.metadataValue">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="2" />
        </Style>
        <Style Selector="StackPanel.metadataEdit">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="2" />
        </Style>
        <Style Selector="Grid.metadataActions">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="3" />
        </Style>
        <Style Selector="StackPanel.metadataMessage">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
        </Style>
        <Style Selector="views|MetadataEditorView.compact TextBlock.metadataKey">
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="MaxWidth" Value="Infinity" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="views|MetadataEditorView.compact Button.metadataValue">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
        </Style>
        <Style Selector="views|MetadataEditorView.compact StackPanel.metadataEdit">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
        </Style>
        <Style Selector="views|MetadataEditorView.compact StackPanel.metadataMessage">
            <Setter Property="Grid.Row" Value="2" />
        </Style>
        <!-- The new row goes in the rows' columns, its key box in the key's and its value box in the value's, and moves
             as they do when compact. The key box is fixed at no wider than the key column's floor, so typing in it
             never widens the column and moves every row's value. -->
        <Style Selector="AutoCompleteBox.draftKey">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Width" Value="124" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="StackPanel.draftValue">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="2" />
        </Style>
        <Style Selector="views|MetadataEditorView.compact AutoCompleteBox.draftKey">
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="Width" Value="NaN" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="views|MetadataEditorView.compact StackPanel.draftValue">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
        </Style>
        <!-- The key box reads like a value's edit box (TextBox.inline), so its text lands where a key's does. -->
        <Style Selector="AutoCompleteBox.draftKey /template/ TextBox#PART_TextBox">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="3,1" />
        </Style>

        <!-- A row's Undo and Remove, in fixed slots at its right, so neither moves as the other comes and goes. Remove
             shows while the row is hovered or has the focus, and can't be clicked or tapped while it's hidden; Undo stays
             while there's a change to undo. Later rules win, so hovering the button itself, and a disabled one, come last. -->
        <Style Selector="Button.captionAction.rowAction">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Button.captionAction.reveal">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.metadataRow:pointerover Button.captionAction.reveal, Border.metadataRow:focus-within Button.captionAction.reveal">
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Button.captionAction.reveal:pointerover, Button.captionAction.reveal:focus-visible">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.metadataRow:pointerover Button.captionAction.reveal:disabled, Border.metadataRow:focus-within Button.captionAction.reveal:disabled">
            <Setter Property="Opacity" Value="0.3" />
        </Style>
    </UserControl.Styles>

    <StackPanel>
        <!-- An icon per song.ini difficulty, which the rows below leave out. Clicking one sets it. -->
        <StackPanel Spacing="2" Margin="0,0,0,10" IsVisible="{Binding ShowInstruments}">
            <ItemsControl ItemsSource="{Binding Instruments}"
                          AutomationProperties.Name="{x:Static res:SharedStrings.InstrumentsListName}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InstrumentDifficultyViewModel">
                        <Button Classes="instrument"
                                Classes.absent="{Binding !IsCharted}"
                                IsVisible="{Binding IsShown}"
                                IsEnabled="{Binding CanEdit}"
                                ToolTip.ShowOnDisabled="True"
                                AutomationProperties.Name="{Binding AccessibleName}">
                            <ToolTip.Tip>
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Name}" />
                                    <TextBlock Classes="muted" Text="{Binding Key}" />
                                    <TextBlock TextWrapping="Wrap"
                                               Text="{Binding KeyDescription}"
                                               IsVisible="{Binding KeyDescription, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <TextBlock TextWrapping="Wrap" Text="{Binding ValueNote}" IsVisible="{Binding HasValueNote}" />
                                    <ItemsControl Margin="0,4,0,0"
                                                  Grid.IsSharedSizeScope="True"
                                                  ItemsSource="{Binding NoteCounts}"
                                                  ItemTemplate="{StaticResource NoteCountRowTemplate}"
                                                  IsVisible="{Binding HasNoteCounts}" />
                                    <TextBlock TextWrapping="Wrap" Classes="muted" Text="{x:Static res:SharedStrings.InstrumentNotCharted}" IsVisible="{Binding !IsCharted}" />
                                </StackPanel>
                            </ToolTip.Tip>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <views:DifficultyPicker />
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Classes="instrumentFace" Spacing="4">
                                <Panel Width="50" Height="44" HorizontalAlignment="Center">
                                    <Border Classes="instrumentCircle" Classes.edited="{Binding IsEdited}">
                                        <PathIcon Data="{Binding Glyph, Converter={StaticResource DifficultyGlyph}}" />
                                    </Border>
                                    <Border Classes="instrumentTag" IsVisible="{Binding HasTag}">
                                        <TextBlock Text="{Binding Tag}" />
                                    </Border>
                                    <Border Classes="instrumentBadge"
                                            Classes.unset="{Binding Tier, Converter={x:Static ObjectConverters.IsNull}}"
                                            Background="{Binding Tier, Converter={StaticResource DifficultyTierBrush}}">
                                        <TextBlock Text="{Binding BadgeText}" />
                                    </Border>
                                </Panel>
                                <!-- "Guitar - EMHX": the letters are always shown whole; a long name gives way to them. -->
                                <DockPanel HorizontalAlignment="Center">
                                    <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Letters}" IsVisible="{Binding HasLetters}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ChartedDifficultyLetter">
                                                <TextBlock Classes="difficultyLetter"
                                                           Text="{Binding Text}"
                                                           Foreground="{Binding Difficulty, Converter={StaticResource DifficultyLetterBrush}}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock DockPanel.Dock="Right"
                                               Classes="instrumentName"
                                               Text="{x:Static res:SharedStrings.InstrumentCaptionSeparator}"
                                               IsVisible="{Binding HasLetters}" />
                                    <TextBlock Classes="instrumentName" Text="{Binding Name}" />
                                </DockPanel>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="nudge"
                    HorizontalAlignment="Left"
                    Content="{Binding InstrumentsToggleText}"
                    Command="{Binding ToggleShowAllInstrumentsCommand}"
                    IsVisible="{Binding HasHiddenInstruments}" />
            <!-- The difficulties have icons rather than rows, so their validation failures are listed here. -->
            <ItemsControl ItemsSource="{Binding HiddenIssues}"
                          IsVisible="{Binding HasHiddenIssues}"
                          Margin="0,4,0,0"
                          AutomationProperties.Name="{x:Static res:SharedStrings.HiddenIssuesListName}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MetadataIssueRow">
                        <Border Classes="metadataRow invalid" Margin="0,1">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{Binding QuickFixHeader}" Command="{Binding QuickFixCommand}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Classes="issue" FontWeight="SemiBold" Text="{Binding Key}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Classes="issue" Text="{Binding Message}" />
                                    <Button Classes="inlineAction"
                                            Command="{Binding QuickFixCommand}"
                                            AutomationProperties.Name="{Binding QuickFixHeader}">
                                        <TextBlock Text="{Binding QuickFixHeader}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <TextBlock Classes="muted" Text="{Binding MetadataNote}" IsVisible="{Binding HasMetadataNote}" />
        <!-- The rows and the new row share their columns, so a key being added sits where the keys do. -->
        <StackPanel Grid.IsSharedSizeScope="True">
            <ItemsControl ItemsSource="{Binding Metadata}"
                          AutomationProperties.Name="{x:Static res:SharedStrings.MetadataListName}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MetadataRowViewModel">
                        <!-- A value that fails validation is marked orange, with why under it. -->
                        <Border Classes="metadataRow" Classes.invalid="{Binding HasIssue}" Margin="0,1">
                            <!-- The row's actions, as its buttons and links offer them. Quick Fix puts the key's fix in the
                                 drafts; it's there on every row, disabled where there's none. -->
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{Binding UndoToolTip}"
                                              Command="{Binding RevertCommand}"
                                              IsVisible="{Binding ShowUndo}" />
                                    <MenuItem Header="{x:Static res:SharedStrings.RemoveRowToolTip}"
                                              Command="{Binding RemoveCommand}"
                                              IsVisible="{Binding ShowRemove}" />
                                    <Separator IsVisible="{Binding HasUndoOrRemove}" />
                                    <MenuItem Header="{Binding QuickFixHeader}" Command="{Binding QuickFixCommand}" />
                                    <MenuItem Header="{x:Static res:SharedStrings.AutoSetLengthButton}"
                                              Command="{Binding AutoSetSongLengthCommand}"
                                              IsVisible="{Binding ShowAutoSetLength}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid RowDefinitions="Auto,Auto,Auto">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MetadataKey" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MetadataActions" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Classes="marker"
                                           Margin="0,2,0,0"
                                           Text="{Binding Marker}" />
                                <!-- At least as wide as the new row's key box, so that box never widens the column. -->
                                <TextBlock Classes="muted metadataKey"
                                           Classes.removed="{Binding IsRemoved}"
                                           MinWidth="120"
                                           MaxWidth="220"
                                           Margin="0,2,16,0"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding Key}">
                                    <!-- The key in full (it may be trimmed), and what it does when it's a known key. -->
                                    <ToolTip.Tip>
                                        <StackPanel Spacing="2">
                                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Key}" />
                                            <TextBlock TextWrapping="Wrap" Text="{Binding KeyDescription}" IsVisible="{Binding HasKeyDescription}" />
                                        </StackPanel>
                                    </ToolTip.Tip>
                                </TextBlock>

                                <!-- Tags like <color=#FDFD96FF> are rendered and times are formatted; the tooltip shows the value as stored. -->
                                <Button Classes="value metadataValue"
                                        Command="{Binding BeginEditCommand}"
                                        IsVisible="{Binding !IsEditing}"
                                        ToolTip.Tip="{Binding ToolTip}"
                                        AutomationProperties.Name="{Binding Key}">
                                    <Panel>
                                        <TextBlock TextWrapping="Wrap"
                                                   Classes.removed="{Binding IsRemoved}"
                                                   ui:RichTextMarkup.Text="{Binding DisplayValue}"
                                                   IsVisible="{Binding ShowRichValue}" />
                                        <TextBlock TextWrapping="Wrap"
                                                   Classes="distinct"
                                                   Classes.removed="{Binding IsRemoved}"
                                                   Text="{Binding DisplayValue}"
                                                   IsVisible="{Binding ShowDistinct}" />
                                    </Panel>
                                </Button>
                                <StackPanel Classes="metadataEdit" IsVisible="{Binding IsEditing}">
                                    <!-- Enter or leaving the box keeps the text; Escape drops it. -->
                                    <TextBox Classes="inline"
                                             Text="{Binding EditText}"
                                             PlaceholderText="{Binding EditPlaceholder}"
                                             IsVisible="{Binding IsEditing}"
                                             ui:FocusWhenShown.IsEnabled="True"
                                             LostFocus="OnEditLostFocus"
                                             AutomationProperties.Name="{Binding Key}">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding CommitCommand}" />
                                            <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                    <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
                                </StackPanel>

                                <!-- Undo, then Remove, each in a slot of its own (styles above). -->
                                <Grid Classes="metadataActions"
                                      ColumnDefinitions="22,22"
                                      Margin="4,0,0,0"
                                      IsVisible="{Binding ShowActions}">
                                    <Button Grid.Column="0"
                                            Classes="captionAction rowAction"
                                            Command="{Binding RevertCommand}"
                                            IsVisible="{Binding ShowUndo}"
                                            ToolTip.Tip="{Binding UndoToolTip}"
                                            AutomationProperties.Name="{Binding UndoToolTip}">
                                        <PathIcon Data="{StaticResource RevertIconGeometry}" />
                                    </Button>
                                    <Button Grid.Column="1"
                                            Classes="captionAction rowAction reveal"
                                            Command="{Binding RemoveCommand}"
                                            IsVisible="{Binding ShowRemove}"
                                            ToolTip.Tip="{x:Static res:SharedStrings.RemoveRowToolTip}"
                                            AutomationProperties.Name="{x:Static res:SharedStrings.RemoveRowToolTip}">
                                        <PathIcon Data="{StaticResource TrashIconGeometry}" />
                                    </Button>
                                </Grid>

                                <!-- Why the value fails, or a hint, then what can be done about it, said in words: the key's
                                     Quick Fix (hidden by Button.inlineAction:disabled where there's none), and for song_length,
                                     Auto Set. -->
                                <StackPanel Classes="metadataMessage" IsVisible="{Binding !IsEditing}">
                                    <TextBlock Classes="issue" Text="{Binding Issue}" IsVisible="{Binding HasIssue}" />
                                    <TextBlock Classes="hint" Text="{Binding Hint}" IsVisible="{Binding HasHint}" />
                                    <WrapPanel ItemSpacing="12">
                                        <Button Classes="inlineAction"
                                                Command="{Binding QuickFixCommand}"
                                                AutomationProperties.Name="{Binding QuickFixHeader}">
                                            <TextBlock Text="{Binding QuickFixHeader}" />
                                        </Button>
                                        <!-- Shown by the panel, so the button's own visibility is left to the
                                             style, which hides it while Auto Set can't run. -->
                                        <Panel IsVisible="{Binding ShowAutoSetLength}">
                                            <Button Classes="inlineAction"
                                                    Command="{Binding AutoSetSongLengthCommand}"
                                                    ToolTip.Tip="{x:Static res:SharedStrings.AutoSetLengthToolTip}"
                                                    AutomationProperties.Name="{x:Static res:SharedStrings.AutoSetLengthButton}">
                                                <TextBlock Text="{x:Static res:SharedStrings.AutoSetLengthButton}" />
                                            </Button>
                                        </Panel>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The new row, at the end of the rows and in their columns: key and value, both checked before anything goes
                 into the drafts. The key box suggests the known keys not already in use, and takes any other key typed. Enter
                 adds the row and empties this one for the next key; Escape or the close button ends it, as does leaving it
                 with nothing typed. -->
            <Border x:Name="DraftRow"
                    Classes="metadataRow"
                    Margin="0,1"
                    IsVisible="{Binding IsAdding}"
                    LostFocus="OnDraftRowLostFocus">
                <Grid RowDefinitions="Auto,Auto">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="MetadataKey" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="MetadataActions" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Classes="marker" Margin="0,2,0,0" Text="+" />
                    <AutoCompleteBox x:Name="NewKeyBox"
                                     Classes="draftKey"
                                     Margin="-4,0,12,0"
                                     Text="{Binding NewKey}"
                                     ItemsSource="{Binding AvailableKeys}"
                                     ValueMemberBinding="{Binding Key, DataType=meta:KnownKey}"
                                     FilterMode="Contains"
                                     MinimumPrefixLength="0"
                                     MaxDropDownHeight="320"
                                     PlaceholderText="{x:Static res:SharedStrings.NewKeyWatermark}"
                                     IsVisible="{Binding IsAdding}"
                                     ui:FocusWhenShown.IsEnabled="True"
                                     ToolTip.Tip="{x:Static res:SharedStrings.NewKeyToolTip}"
                                     AutomationProperties.Name="{x:Static res:SharedStrings.NewKeyWatermark}">
                        <AutoCompleteBox.ItemTemplate>
                            <!-- A fixed width: the list is virtualised, so sizing to content would
                                 resize the dropdown to the widest visible item as it scrolls. -->
                            <DataTemplate x:DataType="meta:KnownKey">
                                <StackPanel Width="300" Margin="0,2" Spacing="1">
                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Key}" />
                                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding Description}" />
                                </StackPanel>
                            </DataTemplate>
                        </AutoCompleteBox.ItemTemplate>
                    </AutoCompleteBox>
                    <!-- What's wrong with the row takes the place of the hint, so the row keeps its height. -->
                    <StackPanel Classes="draftValue">
                        <TextBox x:Name="NewValueBox"
                                 Classes="inline"
                                 Text="{Binding NewValue}"
                                 PlaceholderText="{x:Static res:SharedStrings.NewValueWatermark}"
                                 AutomationProperties.Name="{x:Static res:SharedStrings.NewValueWatermark}">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding CommitAddCommand}" />
                                <KeyBinding Gesture="Escape" Command="{Binding CancelAddCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <TextBlock Classes="error" Text="{Binding NewRowError}" IsVisible="{Binding HasNewRowError}" />
                        <TextBlock Classes="hint"
                                   Margin="0,2,0,2"
                                   Text="{x:Static res:SharedStrings.AddRowHint}"
                                   IsVisible="{Binding !HasNewRowError}" />
                    </StackPanel>
                    <!-- In Remove's slot, as it drops the row. -->
                    <Grid Classes="metadataActions" ColumnDefinitions="22,22" Margin="4,0,0,0">
                        <Button Grid.Column="1"
                                Classes="captionAction rowAction"
                                Command="{Binding CancelAddCommand}"
                                ToolTip.Tip="{x:Static res:SharedStrings.StopAddingToolTip}"
                                AutomationProperties.Name="{x:Static res:SharedStrings.StopAddingToolTip}">
                            <PathIcon Data="{StaticResource RemoveIconGeometry}" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>

        <!-- The Add row icon sits in the rows' marker column, its label in line with their keys. -->
        <StackPanel Orientation="Horizontal" Margin="-5,4,0,0" Spacing="12">
            <Button Classes="icon"
                    Command="{Binding BeginAddCommand}"
                    IsVisible="{Binding ShowAddRow}"
                    AutomationProperties.Name="{x:Static res:SharedStrings.AddRowButton}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Width="12" Height="12" Data="{StaticResource AddIconGeometry}" />
                    <TextBlock Text="{x:Static res:SharedStrings.AddRowButton}" />
                </StackPanel>
            </Button>
            <!-- With no song_length row there's no row to offer Auto Set under, so it's offered here; it adds the row. Shown
                 by the panel, as the row's link is, so the style can hide it while Auto Set can't run. -->
            <Panel VerticalAlignment="Center" IsVisible="{Binding ShowAutoSetLengthFallback}">
                <Button Classes="inlineAction"
                        Margin="0"
                        VerticalAlignment="Center"
                        Command="{Binding AutoSetSongLengthCommand}"
                        ToolTip.Tip="{x:Static res:SharedStrings.AutoSetLengthToolTip}"
                        AutomationProperties.Name="{x:Static res:SharedStrings.AutoSetLengthButton}">
                    <TextBlock Text="{x:Static res:SharedStrings.AutoSetLengthButton}" />
                </Button>
            </Panel>
        </StackPanel>
    </StackPanel>
</UserControl>
