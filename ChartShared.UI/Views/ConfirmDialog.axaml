<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="using:ChartShared.Core.Help"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="using:ChartShared.UI.Resources"
        xmlns:ui="using:ChartShared.UI.Controls"
        mc:Ignorable="d"
        x:Class="ChartShared.UI.Views.ConfirmDialog"
        Background="{DynamicResource AppBackgroundBrush}"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        CanMinimize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        MinWidth="380"
        MaxWidth="520"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        WindowDecorationsTheme="{StaticResource TitleBarDecorations}">

    <!-- A prompt: the title bar, as the main windows' is, the message, and the actions in a footer, each with its icon. -->
    <DockPanel>
        <ui:TitleBar x:Name="WindowTitleBar"
                     HelpPage="{x:Static help:HelpPages.ConfirmDialog}"
                     DockPanel.Dock="Top"
                     Height="31"
                     BorderThickness="0,0,0,1"
                     BorderBrush="{DynamicResource SubtleBorderBrush}">
            <TextBlock x:Name="TitleText"
                       Margin="8,0,12,0"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </ui:TitleBar>

        <Border DockPanel.Dock="Bottom" Classes="toolbar" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="ConfirmButton" Classes="labelled" Click="OnConfirm" />
                <!-- A second action, such as Discard beside Save; shown only when it's given. -->
                <Button x:Name="SecondButton" Classes="labelled" Click="OnSecond" IsVisible="False" />
                <!-- Cancel is the default, so Enter and Escape both keep the changes. -->
                <Button x:Name="CancelButton"
                        Classes="labelled accent"
                        IsDefault="True"
                        IsCancel="True"
                        Click="OnCancel"
                        AutomationProperties.Name="{x:Static res:SharedStrings.CancelButton}" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="MessageText" Margin="20,18,20,20" TextWrapping="Wrap" />
    </DockPanel>
</Window>
