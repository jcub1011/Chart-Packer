<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="using:ChartShared.Core.Help"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:svm="using:ChartShared.UI.ViewModels.Settings"
        xmlns:res="using:ChartShared.UI.Resources"
        xmlns:ctl="using:ChartShared.UI.Controls"
        xmlns:conv="using:ChartShared.UI.Converters"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="560"
        x:Class="ChartShared.UI.Views.SettingsWindow"
        x:DataType="svm:SettingsWindowViewModel"
        Title="{x:Static res:SharedStrings.SettingsWindowTitle}"
        Background="{DynamicResource AppBackgroundBrush}"
        Width="820" Height="560"
        MinWidth="560" MinHeight="360"
        ShowInTaskbar="False"
        CanMinimize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        WindowDecorationsTheme="{StaticResource TitleBarDecorations}"
        WindowStartupLocation="CenterOwner">

    <!-- Opened by AvaloniaSettingsWindowService, which centers it over its owner at the size it last closed at;
         CenterOwner is for when that can't be worked out. It can't be minimized: a modal window with no taskbar entry
         would have nothing to restore it from, leaving its owner disabled. -->

    <Window.Styles>
        <!-- The rail, page header, flat rows and footer, shared with the Shortcuts window. -->
        <StyleInclude Source="avares://ChartShared.UI/Styles/Dialogs.axaml" />
    </Window.Styles>

    <!-- Editors, one per kind of setting; SettingEditorFactory picks the view model. Each is shown inside a
         settings row (the row template below), which adds the label, description and reset button. -->
    <Window.DataTemplates>
        <DataTemplate DataType="svm:ToggleSettingViewModel">
            <ToggleSwitch IsChecked="{Binding Value}"
                          OnContent=""
                          OffContent=""
                          AutomationProperties.Name="{Binding Label}" />
        </DataTemplate>
        <DataTemplate DataType="svm:IntegerSettingViewModel">
            <NumericUpDown Value="{Binding Value}"
                           Minimum="{Binding Minimum}"
                           Maximum="{Binding Maximum}"
                           Increment="1"
                           FormatString="0"
                           ParsingNumberStyle="Integer"
                           ClipValueToMinMax="True"
                           Width="110"
                           AutomationProperties.Name="{Binding Label}" />
        </DataTemplate>
        <DataTemplate DataType="svm:RangeSettingViewModel">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Slider Value="{Binding Value}"
                        Minimum="{Binding Minimum}"
                        Maximum="{Binding Maximum}"
                        SmallChange="{Binding SmallChange}"
                        LargeChange="{Binding SmallChange}"
                        Width="180"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding Label}" />
                <TextBlock Text="{Binding ValueText}" MinWidth="40" TextAlignment="Right" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="svm:LookAheadSettingViewModel">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ctl:LookAheadSlider LookAhead="{Binding Value}"
                        Width="180"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding Label}" />
                <TextBlock Text="{Binding ValueText}" MinWidth="40" TextAlignment="Right" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="svm:ChoiceSettingViewModel">
            <ComboBox ItemsSource="{Binding Choices}"
                      SelectedIndex="{Binding SelectedIndex}"
                      MinWidth="160"
                      AutomationProperties.Name="{Binding Label}" />
        </DataTemplate>
        <DataTemplate DataType="svm:TextSettingViewModel">
            <TextBox Text="{Binding Value}"
                     PlaceholderText="{Binding Placeholder}"
                     Width="220"
                     AutomationProperties.Name="{Binding Label}" />
        </DataTemplate>
        <DataTemplate DataType="svm:FolderSettingViewModel">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding DisplayText}"
                           Classes.muted="{Binding IsEmpty}"
                           MaxWidth="280"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           ToolTip.Tip="{Binding DisplayText}" />
                <Button Command="{Binding BrowseCommand}"
                        Content="{x:Static res:SharedStrings.SettingsBrowseButton}"
                        AutomationProperties.Name="{Binding Label}" />
            </StackPanel>
        </DataTemplate>
        <!-- No editor: the row is its label and its buttons. -->
        <DataTemplate DataType="svm:ActionSettingViewModel">
            <Panel />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- The title bar, as the main windows' are: the icon (the owner's, set in code), the title and the search box.
             Dragging anywhere but the search box moves the window. -->
        <ctl:TitleBar x:Name="WindowTitleBar"
                      HelpPage="{x:Static help:HelpPages.Settings}"
                      Grid.Row="0"
                      Height="31"
                      BorderThickness="0,0,0,1"
                      BorderBrush="{DynamicResource SubtleBorderBrush}">
            <StackPanel Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center">
                <TextBlock FontSize="12"
                           VerticalAlignment="Center"
                           Text="{x:Static res:SharedStrings.SettingsWindowTitle}" />
                <TextBox x:Name="SearchBox"
                         Classes="clearButton title-search"
                         chrome:WindowDecorationProperties.ElementRole="User"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchText}"
                         PlaceholderText="{x:Static res:SharedStrings.SettingsSearchWatermark}"
                         AutomationProperties.Name="{x:Static res:SharedStrings.SettingsSearchWatermark}">
                    <TextBox.InnerLeftContent>
                        <ctl:LineIcon Data="{StaticResource SearchStroke}" Margin="8,0,0,0" Opacity="0.6" />
                    </TextBox.InnerLeftContent>
                </TextBox>
            </StackPanel>
        </ctl:TitleBar>

        <Grid Grid.Row="1" ColumnDefinitions="200,*">
            <!-- The categories: an icon, a name, and how many of its settings have a change not yet written (or, while
                 searching, how many match). "All Settings" at the top shows every category. -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="0,0,1,0">
                <ListBox Classes="rail"
                         ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory}"
                         AutomationProperties.Name="{x:Static res:SharedStrings.SettingsCategoriesName}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="svm:SettingsCategoryViewModel">
                            <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="10">
                                <ctl:LineIcon Grid.Column="0"
                                              Data="{Binding IconKey, Converter={x:Static conv:LineIconConverter.Instance}}"
                                              IsVisible="{Binding HasIcon}"
                                              VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Label}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Classes="rail-matches"
                                               Text="{Binding MatchCount}"
                                               IsVisible="{Binding HasMatchCount}" />
                                    <Border Classes="rail-count" IsVisible="{Binding HasModified}">
                                        <TextBlock Text="{Binding ModifiedCount}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <!-- The page header: the selected category's name, and the sections it holds. -->
                <StackPanel Grid.Row="0" Spacing="2" Margin="24,18,24,8">
                    <TextBlock Classes="page-title" Text="{Binding PageTitle}" />
                    <TextBlock Classes="page-subtitle"
                               Text="{Binding PageSubtitle}"
                               IsVisible="{Binding HasPageSubtitle}" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Groups}" Margin="24,6,24,20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="22" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="svm:SettingsGroupViewModel">
                                <StackPanel>
                                    <Border Classes="section" IsVisible="{Binding HasTitle}">
                                        <TextBlock Text="{Binding Title}" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <!-- The row. Its editor comes from Window.DataTemplates, by the setting's kind. -->
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="svm:SettingViewModel">
                                                <Border Classes="row" Classes.locked="{Binding !IsEnabled}">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,32" ColumnSpacing="12">
                                                        <Border Grid.Column="0" Classes="row-bar" Classes.modified="{Binding IsModified}" />
                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                            <StackPanel Classes="row-dim" Spacing="2">
                                                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                                                <TextBlock Classes="row-description"
                                                                           Text="{Binding Description}"
                                                                           IsVisible="{Binding HasDescription}" />
                                                            </StackPanel>
                                                            <TextBlock Classes="row-note"
                                                                       Text="{Binding LockedNote}"
                                                                       IsVisible="{Binding !IsEnabled}" />
                                                        </StackPanel>
                                                        <!-- The setting's own buttons. They act at once, so they stay enabled while the setting is locked. -->
                                                        <ItemsControl Grid.Column="2"
                                                                      Classes="row-actions"
                                                                      Classes.alone="{Binding !HasEditor}"
                                                                      ItemsSource="{Binding Actions}"
                                                                      IsVisible="{Binding HasActions}"
                                                                      VerticalAlignment="Center">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="svm:SettingActionViewModel">
                                                                    <Panel>
                                                                        <!-- An icon button, as the reset button is, with the label as its tooltip. -->
                                                                        <Button Classes="tool"
                                                                                Command="{Binding RunCommand}"
                                                                                IsVisible="{Binding HasIcon}"
                                                                                ToolTip.Tip="{Binding Label}"
                                                                                AutomationProperties.Name="{Binding Label}">
                                                                            <ctl:LineIcon Data="{Binding IconKey, Converter={x:Static conv:LineIconConverter.Instance}}" />
                                                                        </Button>
                                                                        <Button Content="{Binding Label}"
                                                                                Command="{Binding RunCommand}"
                                                                                IsVisible="{Binding !HasIcon}"
                                                                                AutomationProperties.Name="{Binding Label}" />
                                                                    </Panel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <!-- The editors share a track at the row's right, so their right edges line up down the page. -->
                                                        <ContentControl Grid.Column="3"
                                                                        Content="{Binding}"
                                                                        MinWidth="180"
                                                                        HorizontalAlignment="Right"
                                                                        HorizontalContentAlignment="Right"
                                                                        VerticalAlignment="Center"
                                                                        IsVisible="{Binding HasEditor}"
                                                                        IsEnabled="{Binding IsEnabled}" />
                                                        <!-- Fixed width, so the editor doesn't shift when the button appears. -->
                                                        <Panel Grid.Column="4" VerticalAlignment="Center">
                                                            <Button Classes="tool"
                                                                    Command="{Binding ResetCommand}"
                                                                    IsVisible="{Binding !IsDefault}"
                                                                    ToolTip.Tip="{x:Static res:SharedStrings.SettingsResetToolTip}"
                                                                    AutomationProperties.Name="{x:Static res:SharedStrings.SettingsResetToolTip}">
                                                                <ctl:LineIcon Data="{StaticResource UndoStroke}" />
                                                            </Button>
                                                        </Panel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="1"
                           Classes="muted centered"
                           Margin="20"
                           VerticalAlignment="Center"
                           IsVisible="{Binding HasNoMatches}"
                           Text="{Binding NoMatchesText}" />
            </Grid>
        </Grid>

        <!-- No default button: Enter in the search or number boxes shouldn't close the window. -->
        <Border Grid.Row="2" Classes="toolbar" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Grid.Column="0"
                           Classes="footer-status"
                           Margin="4,0,0,0"
                           Text="{Binding UnsavedText}"
                           IsVisible="{Binding HasUnsaved}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button MinWidth="80"
                            HorizontalContentAlignment="Center"
                            Content="{x:Static res:SharedStrings.ApplyButton}"
                            Command="{Binding ApplyCommand}"
                            AutomationProperties.Name="{x:Static res:SharedStrings.ApplyButton}" />
                    <Button MinWidth="80"
                            HorizontalContentAlignment="Center"
                            Content="{x:Static res:SharedStrings.CancelButton}"
                            IsCancel="True"
                            Click="OnCancel"
                            AutomationProperties.Name="{x:Static res:SharedStrings.CancelButton}" />
                    <Button Classes="accent"
                            MinWidth="80"
                            HorizontalContentAlignment="Center"
                            Content="{x:Static res:SharedStrings.OkButton}"
                            Click="OnOk"
                            AutomationProperties.Name="{x:Static res:SharedStrings.OkButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
