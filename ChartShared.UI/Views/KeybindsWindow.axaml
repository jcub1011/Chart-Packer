<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="using:ChartShared.Core.Help"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:kvm="using:ChartShared.UI.ViewModels.Keybinds"
        xmlns:res="using:ChartShared.UI.Resources"
        xmlns:ctl="using:ChartShared.UI.Controls"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="560"
        x:Class="ChartShared.UI.Views.KeybindsWindow"
        x:DataType="kvm:KeybindsWindowViewModel"
        Title="{x:Static res:SharedStrings.KeybindsWindowTitle}"
        Background="{DynamicResource AppBackgroundBrush}"
        Width="760" Height="560"
        MinWidth="520" MinHeight="360"
        ShowInTaskbar="False"
        CanMinimize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        WindowDecorationsTheme="{StaticResource TitleBarDecorations}"
        WindowStartupLocation="CenterOwner">

    <!-- Opened by AvaloniaKeybindsWindowService, as the Settings window is: centered over its owner at the size it last
         closed at, and unable to be minimized, as a modal window with no taskbar entry would have nothing to restore it from.
         Edits are to a copy of the app's keys and only reach them on OK. Escape is handled in code (KeybindsWindow.axaml.cs)
         rather than by a Cancel button's IsCancel, as Escape also ends the wait for a new key. -->

    <Window.Styles>
        <Style Selector="TextBlock.keys-heading">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <!-- One shortcut. Outlined in the accent while its keys differ from the defaults. -->
        <Style Selector="Border.key-row">
            <Setter Property="Background" Value="{DynamicResource ToolbarGroupBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6,6,6" />
        </Style>
        <Style Selector="Border.key-row.modified">
            <Setter Property="BorderBrush" Value="#998B5CF6" />
        </Style>
        <!-- The shortcut just jumped to from the tree, outlined in the accent until something else is chosen. -->
        <Style Selector="Border.key-row.revealed">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentTintFaintBrush}" />
        </Style>
        <!-- A shortcut in the tree is quieter than the categories it's under. -->
        <Style Selector="TextBlock.tree-shortcut">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <!-- A fixed shortcut: listed, but dimmed as a setting that's locked is. -->
        <Style Selector="Border.key-row.locked StackPanel.key-text">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Border.key-row.locked ItemsControl.key-chips">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="TextBlock.key-note">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <!-- A key: a button that opens a menu to change or delete it, labelled as the key is on a keyboard. -->
        <Style Selector="Button.keycap">
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource ToolHoverBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.keycap:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolPressedBrush}" />
        </Style>
        <Style Selector="Button.keycap.capturing">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style Selector="Button.keycap.capturing /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
        </Style>
        <Style Selector="TreeViewItem" x:DataType="kvm:KeybindNodeViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <!-- The title bar, as the Settings window's: the icon (the owner's, set in code), the title and the search box. -->
        <ctl:TitleBar x:Name="WindowTitleBar"
                      HelpPage="{x:Static help:HelpPages.KeyboardShortcuts}"
                      Grid.Row="0"
                      Height="31"
                      BorderThickness="0,0,0,1"
                      BorderBrush="{DynamicResource SubtleBorderBrush}">
            <StackPanel Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center">
                <TextBlock FontSize="12"
                           VerticalAlignment="Center"
                           Text="{x:Static res:SharedStrings.KeybindsWindowTitle}" />
                <TextBox x:Name="SearchBox"
                         Classes="clearButton title-search"
                         chrome:WindowDecorationProperties.ElementRole="User"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchText}"
                         PlaceholderText="{x:Static res:SharedStrings.KeybindsSearchWatermark}"
                         AutomationProperties.Name="{x:Static res:SharedStrings.KeybindsSearchWatermark}">
                    <TextBox.InnerLeftContent>
                        <ctl:LineIcon Data="{StaticResource SearchStroke}" Margin="8,0,0,0" Opacity="0.6" />
                    </TextBox.InnerLeftContent>
                </TextBox>
            </StackPanel>
        </ctl:TitleBar>

        <Grid Grid.Row="1" ColumnDefinitions="220,*">
            <!-- The category tree, as the Settings window's is: a category shows its own shortcuts and those of the ones nested
                 in it, and "All shortcuts" at the top shows every one. -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="0,0,1,0">
                <TreeView ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          Margin="4,8"
                          Tapped="OnTreeTapped"
                          AutomationProperties.Name="{x:Static res:SharedStrings.KeybindsCategoriesName}">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate DataType="kvm:KeybindNodeViewModel" ItemsSource="{Binding Children}">
                            <TextBlock Classes.tree-shortcut="{Binding IsShortcut}"
                                       Text="{Binding Label}"
                                       TextTrimming="CharacterEllipsis" />
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <Panel Grid.Column="1">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Groups}" Margin="20,14,20,20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="20" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="kvm:KeybindGroupViewModel">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="keys-heading" Text="{Binding Title}" />
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="kvm:KeybindRowViewModel">
                                                <Border Classes="key-row"
                                                        Classes.modified="{Binding IsModified}"
                                                        Classes.locked="{Binding IsLocked}"
                                                        Classes.revealed="{Binding IsRevealed}">
                                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                                                        <StackPanel Grid.Column="0" Classes="key-text" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                                            <TextBlock Classes="key-note"
                                                                       Text="{Binding ConflictNote}"
                                                                       IsVisible="{Binding HasConflict}" />
                                                        </StackPanel>

                                                        <ItemsControl Grid.Column="1"
                                                                      Classes="key-chips"
                                                                      ItemsSource="{Binding Chips}"
                                                                      VerticalAlignment="Center">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="kvm:KeyChipViewModel">
                                                                    <Button Classes="keycap"
                                                                            Classes.capturing="{Binding IsCapturing}"
                                                                            Content="{Binding Label}"
                                                                            IsEnabled="{Binding Row.IsEditable}"
                                                                            ToolTip.Tip="{x:Static res:SharedStrings.KeybindsChangeToolTip}"
                                                                            AutomationProperties.Name="{Binding Label}">
                                                                        <Button.Flyout>
                                                                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                                                                <MenuItem Header="{x:Static res:SharedStrings.KeybindsChangeBinding}" Command="{Binding ChangeCommand}">
                                                                                    <MenuItem.Icon><ctl:LineIcon Data="{StaticResource PencilStroke}" /></MenuItem.Icon>
                                                                                </MenuItem>
                                                                                <MenuItem Header="{x:Static res:SharedStrings.KeybindsDeleteBinding}" Command="{Binding RemoveCommand}">
                                                                                    <MenuItem.Icon><ctl:LineIcon Data="{StaticResource TrashStroke}" /></MenuItem.Icon>
                                                                                </MenuItem>
                                                                            </MenuFlyout>
                                                                        </Button.Flyout>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- What stands in for a key when there are none: the gesture a fixed row names, a prompt while a
                                                             key to add is awaited, or that there's nothing set. -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <Border Classes="chip large" IsVisible="{Binding HasOverrideText}">
                                                                <TextBlock Text="{Binding OverrideText}" />
                                                            </Border>
                                                            <Button Classes="keycap capturing"
                                                                    IsVisible="{Binding IsCapturingNew}"
                                                                    Content="{x:Static res:SharedStrings.KeybindsPressKey}" />
                                                            <TextBlock Classes="muted"
                                                                       FontStyle="Italic"
                                                                       IsVisible="{Binding IsUnbound}"
                                                                       Text="{x:Static res:SharedStrings.KeybindsUnbound}" />
                                                            <TextBlock Classes="muted"
                                                                       IsVisible="{Binding IsLocked}"
                                                                       Text="{x:Static res:SharedStrings.KeybindsFixed}"
                                                                       ToolTip.Tip="{x:Static res:SharedStrings.KeybindsFixedToolTip}" />
                                                            <!-- Fixed width, so the keys don't shift when the button appears. -->
                                                            <Panel Width="32">
                                                                <Button Classes="tool"
                                                                        Command="{Binding ResetCommand}"
                                                                        IsVisible="{Binding IsModified}"
                                                                        ToolTip.Tip="{x:Static res:SharedStrings.KeybindsResetToolTip}"
                                                                        AutomationProperties.Name="{x:Static res:SharedStrings.KeybindsResetToolTip}">
                                                                    <ctl:LineIcon Data="{StaticResource UndoStroke}" />
                                                                </Button>
                                                            </Panel>
                                                        </StackPanel>

                                                        <!-- Fixed width too, so the buttons line up down the list when a shortcut can't take another key. -->
                                                        <Panel Grid.Column="3" Width="32" VerticalAlignment="Center">
                                                            <Button Classes="tool"
                                                                    Command="{Binding AddCommand}"
                                                                    IsVisible="{Binding CanAdd}"
                                                                    ToolTip.Tip="{x:Static res:SharedStrings.KeybindsAddToolTip}"
                                                                    AutomationProperties.Name="{x:Static res:SharedStrings.KeybindsAddToolTip}">
                                                                <ctl:LineIcon Data="{StaticResource AddStroke}" />
                                                            </Button>
                                                        </Panel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Classes="muted centered"
                           Margin="20"
                           VerticalAlignment="Center"
                           IsVisible="{Binding HasNoMatches}"
                           Text="{Binding NoMatchesText}" />
            </Panel>
        </Grid>

        <!-- Why a key was refused, what an import did, or a note on the key just set. -->
        <Border Grid.Row="2"
                Classes="banner"
                Margin="20,0,20,10"
                IsVisible="{Binding HasStatus}">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </Border>

        <!-- No default button: Enter must reach a key being set rather than close the window. -->
        <Border Grid.Row="3" Classes="toolbar" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <!-- Icon buttons, as the rows' are, each named by its tooltip. A folder to read from and one to write to
                         are the icons the apps use for input and output elsewhere. -->
                    <Button Classes="tool"
                            Command="{Binding ImportCommand}"
                            ToolTip.Tip="{x:Static res:SharedStrings.KeybindsImportToolTip}"
                            AutomationProperties.Name="{x:Static res:SharedStrings.KeybindsImportToolTip}">
                        <ctl:LineIcon Data="{StaticResource InputFolderStroke}" />
                    </Button>
                    <Button Classes="tool"
                            Command="{Binding ExportCommand}"
                            ToolTip.Tip="{x:Static res:SharedStrings.KeybindsExportToolTip}"
                            AutomationProperties.Name="{x:Static res:SharedStrings.KeybindsExportToolTip}">
                        <ctl:LineIcon Data="{StaticResource OutputFolderStroke}" />
                    </Button>
                    <Button Classes="tool"
                            Command="{Binding ResetAllCommand}"
                            ToolTip.Tip="{x:Static res:SharedStrings.KeybindsResetAllButton}"
                            AutomationProperties.Name="{x:Static res:SharedStrings.KeybindsResetAllButton}">
                        <ctl:LineIcon Data="{StaticResource TrashStroke}" />
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Classes="accent"
                            MinWidth="80"
                            HorizontalContentAlignment="Center"
                            Content="{x:Static res:SharedStrings.OkButton}"
                            Click="OnOk"
                            AutomationProperties.Name="{x:Static res:SharedStrings.OkButton}" />
                    <Button MinWidth="80"
                            HorizontalContentAlignment="Center"
                            Content="{x:Static res:SharedStrings.CancelButton}"
                            Click="OnCancel"
                            AutomationProperties.Name="{x:Static res:SharedStrings.CancelButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
