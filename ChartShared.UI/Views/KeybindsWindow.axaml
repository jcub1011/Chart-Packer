<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="using:ChartShared.Core.Help"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:kvm="using:ChartShared.UI.ViewModels.Keybinds"
        xmlns:res="using:ChartShared.UI.Resources"
        xmlns:ctl="using:ChartShared.UI.Controls"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="560"
        x:Class="ChartShared.UI.Views.KeybindsWindow"
        x:DataType="kvm:KeybindsWindowViewModel"
        Title="{x:Static res:SharedStrings.KeybindsWindowTitle}"
        Background="{DynamicResource AppBackgroundBrush}"
        Width="760" Height="560"
        MinWidth="520" MinHeight="360"
        ShowInTaskbar="False"
        CanMinimize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        WindowDecorationsTheme="{StaticResource TitleBarDecorations}"
        WindowStartupLocation="CenterOwner">

    <!-- Opened by AvaloniaKeybindsWindowService, as the Settings window is: centered over its owner at the size it last
         closed at, and unable to be minimized, as a modal window with no taskbar entry would have nothing to restore it from.
         Edits are to a copy of the app's keys and only reach them on OK. Escape is handled in code (KeybindsWindow.axaml.cs)
         rather than by a Cancel button's IsCancel, as Escape also ends the wait for a new key. -->

    <Window.Styles>
        <!-- The rail, page header, flat rows, key-caps and footer, shared with the Settings window. -->
        <StyleInclude Source="avares://ChartShared.UI/Styles/Dialogs.axaml" />
    </Window.Styles>

    <Window.DataTemplates>
        <!-- A key of the keyboard view, or the gap in a row of them. -->
        <DataTemplate DataType="kvm:KeycapViewModel">
            <Panel Width="{Binding Width}">
                <Button Classes="mapkey"
                        Classes.bound="{Binding IsBound}"
                        Classes.clashing="{Binding IsClashing}"
                        Classes.fixed="{Binding IsFixed}"
                        Classes.elsewhere="{Binding IsBoundElsewhere}"
                        Classes.selected="{Binding IsSelected}"
                        IsVisible="{Binding IsKey}"
                        Command="{Binding SelectCommand}"
                        Content="{Binding Caption}"
                        ToolTip.Tip="{Binding ToolTipText}"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{Binding Key.Name}" />
            </Panel>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- The title bar, as the Settings window's: the icon (the owner's, set in code), the title and the search box. -->
        <ctl:TitleBar x:Name="WindowTitleBar"
                      HelpPage="{x:Static help:HelpPages.KeyboardShortcuts}"
                      Grid.Row="0"
                      Height="31"
                      BorderThickness="0,0,0,1"
                      BorderBrush="{DynamicResource SubtleBorderBrush}">
            <StackPanel Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center">
                <TextBlock FontSize="12"
                           VerticalAlignment="Center"
                           Text="{x:Static res:SharedStrings.KeybindsWindowTitle}" />
                <TextBox x:Name="SearchBox"
                         Classes="clearButton title-search"
                         chrome:WindowDecorationProperties.ElementRole="User"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchText}"
                         PlaceholderText="{x:Static res:SharedStrings.KeybindsSearchWatermark}"
                         AutomationProperties.Name="{x:Static res:SharedStrings.KeybindsSearchWatermark}">
                    <TextBox.InnerLeftContent>
                        <ctl:LineIcon Data="{StaticResource SearchStroke}" Margin="8,0,0,0" Opacity="0.6" />
                    </TextBox.InnerLeftContent>
                </TextBox>
            </StackPanel>
        </ctl:TitleBar>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <!-- The categories: a name, and how many of its shortcuts differ from the defaults (or, while searching, how many
                 match). A category shows its own shortcuts and those of the ones nested in it, and "All Shortcuts" at the top
                 shows every one. Only the list is by category, so the keyboard view has no use for it. -->
            <Border Grid.Column="0"
                    Width="200"
                    IsVisible="{Binding IsListView}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="0,0,1,0">
                <ListBox Classes="rail"
                         ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory}"
                         AutomationProperties.Name="{x:Static res:SharedStrings.KeybindsCategoriesName}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="kvm:KeybindNodeViewModel">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Label}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Classes="rail-matches"
                                               Text="{Binding MatchCount}"
                                               IsVisible="{Binding HasMatchCount}" />
                                    <Border Classes="rail-count" IsVisible="{Binding HasModified}">
                                        <TextBlock Text="{Binding ModifiedCount}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <!-- The page header: the category picked and the ones nested in it, or the keyboard; and the switch between them. -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="24,18,24,8">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="page-title" Text="{Binding PageTitle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="page-subtitle"
                                   Text="{Binding PageSubtitle}"
                                   IsVisible="{Binding HasPageSubtitle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="{x:Static res:SharedStrings.KeybindsViewName}">
                        <RadioButton Classes="seg"
                                     GroupName="KeybindsView"
                                     IsChecked="{Binding IsListView}"
                                     Content="{x:Static res:SharedStrings.KeybindsListView}" />
                        <RadioButton Classes="seg"
                                     GroupName="KeybindsView"
                                     IsChecked="{Binding IsKeyboardView}"
                                     Content="{x:Static res:SharedStrings.KeybindsKeyboardView}" />
                    </StackPanel>
                </Grid>

                <!-- The list: shortcuts by category, each with its keys, which a key's menu changes or deletes. -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              IsVisible="{Binding IsListView}">
                    <ItemsControl ItemsSource="{Binding Groups}" Margin="24,6,24,20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="22" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="kvm:KeybindGroupViewModel">
                                <StackPanel>
                                    <Border Classes="section" IsVisible="{Binding HasTitle}">
                                        <TextBlock Text="{Binding Title}" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="kvm:KeybindRowViewModel">
                                                <Border Classes="row"
                                                        Classes.locked="{Binding IsLocked}"
                                                        Classes.revealed="{Binding IsRevealed}">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,32" ColumnSpacing="10">
                                                        <Border Grid.Column="0" Classes="row-bar" Classes.modified="{Binding IsModified}" />

                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Classes="row-dim" Text="{Binding Name}" TextWrapping="Wrap" />
                                                            <TextBlock Classes="row-note warning"
                                                                       Text="{Binding ConflictNote}"
                                                                       IsVisible="{Binding HasConflict}" />
                                                        </StackPanel>

                                                        <ItemsControl Grid.Column="2"
                                                                      Classes="row-dim"
                                                                      ItemsSource="{Binding Chips}"
                                                                      VerticalAlignment="Center">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="kvm:KeyChipViewModel">
                                                                    <Button Classes="keycap"
                                                                            Classes.capturing="{Binding IsCapturing}"
                                                                            Content="{Binding Label}"
                                                                            IsEnabled="{Binding Row.IsEditable}"
                                                                            ToolTip.Tip="{x:Static res:SharedStrings.KeybindsChangeToolTip}"
                                                                            AutomationProperties.Name="{Binding Label}">
                                                                        <Button.Flyout>
                                                                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                                                                <MenuItem Header="{x:Static res:SharedStrings.KeybindsChangeBinding}" Command="{Binding ChangeCommand}">
                                                                                    <MenuItem.Icon><ctl:LineIcon Data="{StaticResource PencilStroke}" /></MenuItem.Icon>
                                                                                </MenuItem>
                                                                                <MenuItem Header="{x:Static res:SharedStrings.KeybindsDeleteBinding}" Command="{Binding RemoveCommand}">
                                                                                    <MenuItem.Icon><ctl:LineIcon Data="{StaticResource TrashStroke}" /></MenuItem.Icon>
                                                                                </MenuItem>
                                                                            </MenuFlyout>
                                                                        </Button.Flyout>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- What stands in for a key when there are none: the gesture a fixed row names, a prompt while a
                                                             key to add is awaited, or that there's nothing set. -->
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <Border Classes="chip large" IsVisible="{Binding HasOverrideText}">
                                                                <TextBlock Text="{Binding OverrideText}" />
                                                            </Border>
                                                            <Button Classes="keycap capturing"
                                                                    IsVisible="{Binding IsCapturingNew}"
                                                                    Content="{x:Static res:SharedStrings.KeybindsPressKey}" />
                                                            <TextBlock Classes="muted"
                                                                       FontStyle="Italic"
                                                                       IsVisible="{Binding IsUnbound}"
                                                                       Text="{x:Static res:SharedStrings.KeybindsUnbound}" />
                                                            <TextBlock Classes="muted"
                                                                       IsVisible="{Binding IsLocked}"
                                                                       Text="{x:Static res:SharedStrings.KeybindsFixed}"
                                                                       ToolTip.Tip="{x:Static res:SharedStrings.KeybindsFixedToolTip}" />
                                                            <!-- Fixed width, so the keys don't shift when the button appears. -->
                                                            <Panel Width="32">
                                                                <Button Classes="tool"
                                                                        Command="{Binding ResetCommand}"
                                                                        IsVisible="{Binding IsModified}"
                                                                        ToolTip.Tip="{x:Static res:SharedStrings.KeybindsResetToolTip}"
                                                                        AutomationProperties.Name="{x:Static res:SharedStrings.KeybindsResetToolTip}">
                                                                    <ctl:LineIcon Data="{StaticResource UndoStroke}" />
                                                                </Button>
                                                            </Panel>
                                                        </StackPanel>

                                                        <!-- Fixed width too, so the buttons line up down the list when a shortcut can't take another key. -->
                                                        <Panel Grid.Column="4" VerticalAlignment="Center">
                                                            <Button Classes="tool reveal"
                                                                    Command="{Binding AddCommand}"
                                                                    IsVisible="{Binding CanAdd}"
                                                                    ToolTip.Tip="{x:Static res:SharedStrings.KeybindsAddToolTip}"
                                                                    AutomationProperties.Name="{x:Static res:SharedStrings.KeybindsAddToolTip}">
                                                                <ctl:LineIcon Data="{StaticResource AddStroke}" />
                                                            </Button>
                                                        </Panel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- The keyboard: which modifier keys are held, the keys tinted by what has them, and for the key picked what
                     is on it, with a list to bind another shortcut to it. -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              IsVisible="{Binding IsKeyboardView}">
                    <StackPanel Margin="24,6,24,20" Spacing="16" DataContext="{Binding Map}" x:DataType="kvm:KeyboardMapViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                <ToggleButton Classes="filterChip" IsChecked="{Binding Ctrl}" Content="Ctrl" />
                                <ToggleButton Classes="filterChip" IsChecked="{Binding Shift}" Content="Shift" />
                                <ToggleButton Classes="filterChip" IsChecked="{Binding Alt}" Content="Alt" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Classes="swatch bound" />
                                    <TextBlock Classes="row-description" Text="{x:Static res:SharedStrings.KeybindsMapLegendBound}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Classes="swatch clashing" />
                                    <TextBlock Classes="row-description" Text="{x:Static res:SharedStrings.KeybindsMapLegendShared}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Classes="swatch elsewhere" />
                                    <TextBlock Classes="row-description" Text="{x:Static res:SharedStrings.KeybindsMapLegendElsewhere}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Classes="swatch fixed" />
                                    <TextBlock Classes="row-description" Text="{x:Static res:SharedStrings.KeybindsMapLegendFixed}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,0,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="kvm:KeycapRowViewModel">
                                        <ItemsControl ItemsSource="{Binding Keys}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel IsVisible="{Binding HasOtherKeys}">
                            <Border Classes="section" Margin="0,0,0,8">
                                <TextBlock Text="{x:Static res:SharedStrings.KeybindsMapOtherKeys}" />
                            </Border>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding OtherKeys}" Margin="0,0,0,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- The key picked, and what is on it. -->
                        <StackPanel IsVisible="{Binding HasSelection}">
                            <Border Classes="section">
                                <TextBlock Text="{Binding SelectedChordText}" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding Bindings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="kvm:MapBindingViewModel">
                                        <Border Classes="row" Classes.locked="{Binding IsLocked}" Padding="12,7,4,7">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                                <StackPanel Grid.Column="0" Classes="row-dim" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                                    <TextBlock Classes="row-description" Text="{Binding Category}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Classes="muted"
                                                           IsVisible="{Binding IsLocked}"
                                                           VerticalAlignment="Center"
                                                           Text="{x:Static res:SharedStrings.KeybindsFixed}"
                                                           ToolTip.Tip="{x:Static res:SharedStrings.KeybindsFixedToolTip}" />
                                                <Button Grid.Column="2"
                                                        Classes="tool"
                                                        Command="{Binding ShowInListCommand}"
                                                        ToolTip.Tip="{x:Static res:SharedStrings.KeybindsMapShowInList}"
                                                        AutomationProperties.Name="{x:Static res:SharedStrings.KeybindsMapShowInList}">
                                                    <ctl:LineIcon Data="{StaticResource ArrowRightStroke}" />
                                                </Button>
                                                <Button Grid.Column="3"
                                                        Classes="tool"
                                                        Command="{Binding RemoveCommand}"
                                                        IsVisible="{Binding CanRemove}"
                                                        ToolTip.Tip="{x:Static res:SharedStrings.KeybindsMapRemoveFromKey}"
                                                        AutomationProperties.Name="{x:Static res:SharedStrings.KeybindsMapRemoveFromKey}">
                                                    <ctl:LineIcon Data="{StaticResource ClearStroke}" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="muted"
                                       Margin="0,10,0,0"
                                       IsVisible="{Binding IsUnboundSelection}"
                                       Text="{Binding UnboundText}" />
                            <TextBlock Classes="row-description"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding HasElsewhere}"
                                       Text="{Binding ElsewhereText}" />
                            <!-- A drop-down with a search box, as there are too many shortcuts to look down for one. -->
                            <Button x:Name="AssignButton"
                                    Margin="0,12,0,0"
                                    Width="320"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Stretch"
                                    IsVisible="{Binding CanAssign}"
                                    AutomationProperties.Name="{Binding AssignText}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="{Binding AssignText}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                    <ctl:LineIcon Grid.Column="1" Data="{StaticResource ChevronDownStroke}" Opacity="0.7" />
                                </Grid>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft" Opened="OnAssignOpened">
                                        <StackPanel Width="304" Spacing="8">
                                            <TextBox x:Name="AssignSearchBox"
                                                     Classes="clearButton"
                                                     VerticalContentAlignment="Center"
                                                     Text="{Binding AssignSearch}"
                                                     PlaceholderText="{x:Static res:SharedStrings.KeybindsMapAssignSearch}"
                                                     AutomationProperties.Name="{x:Static res:SharedStrings.KeybindsMapAssignSearch}">
                                                <TextBox.InnerLeftContent>
                                                    <ctl:LineIcon Data="{StaticResource SearchStroke}" Margin="8,0,0,0" Opacity="0.6" />
                                                </TextBox.InnerLeftContent>
                                            </TextBox>
                                            <ListBox ItemsSource="{Binding FilteredAssignChoices}"
                                                     SelectedItem="{Binding AssignTo}"
                                                     MaxHeight="240"
                                                     SelectionChanged="OnAssignPicked"
                                                     AutomationProperties.Name="{Binding AssignText}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate DataType="kvm:KeybindRowViewModel">
                                                        <StackPanel Spacing="1">
                                                            <TextBlock Text="{Binding Name}" />
                                                            <TextBlock Classes="row-description" Text="{Binding Category}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock Classes="muted"
                                                       Margin="4,0,0,4"
                                                       IsVisible="{Binding HasNoAssignMatches}"
                                                       Text="{x:Static res:SharedStrings.KeybindsMapAssignNoMatches}" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <TextBlock Classes="muted"
                                   IsVisible="{Binding !HasSelection}"
                                   Text="{x:Static res:SharedStrings.KeybindsMapPickKey}" />
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="1"
                           Classes="muted centered"
                           Margin="20"
                           VerticalAlignment="Center"
                           IsVisible="{Binding HasNoMatches}"
                           Text="{Binding NoMatchesText}" />
            </Grid>
        </Grid>

        <!-- No default button: Enter must reach a key being set rather than close the window. On the left, why a key was refused,
             what an import did, or a note on the key just set. -->
        <Border Grid.Row="2" Classes="toolbar" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <TextBlock Grid.Column="0"
                           Classes="footer-status"
                           Margin="4,0,0,0"
                           Text="{Binding StatusMessage}"
                           IsVisible="{Binding HasStatus}"
                           ToolTip.Tip="{Binding StatusMessage}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <!-- Icon buttons, as the rows' are, each named by its tooltip. A folder to read from and one to write to
                         are the icons the apps use for input and output elsewhere. -->
                    <Button Classes="tool"
                            Command="{Binding ImportCommand}"
                            ToolTip.Tip="{x:Static res:SharedStrings.KeybindsImportToolTip}"
                            AutomationProperties.Name="{x:Static res:SharedStrings.KeybindsImportToolTip}">
                        <ctl:LineIcon Data="{StaticResource InputFolderStroke}" />
                    </Button>
                    <Button Classes="tool"
                            Command="{Binding ExportCommand}"
                            ToolTip.Tip="{x:Static res:SharedStrings.KeybindsExportToolTip}"
                            AutomationProperties.Name="{x:Static res:SharedStrings.KeybindsExportToolTip}">
                        <ctl:LineIcon Data="{StaticResource OutputFolderStroke}" />
                    </Button>
                    <Button Classes="tool"
                            Command="{Binding ResetAllCommand}"
                            ToolTip.Tip="{x:Static res:SharedStrings.KeybindsResetAllButton}"
                            AutomationProperties.Name="{x:Static res:SharedStrings.KeybindsResetAllButton}">
                        <ctl:LineIcon Data="{StaticResource TrashStroke}" />
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button MinWidth="80"
                            HorizontalContentAlignment="Center"
                            Content="{x:Static res:SharedStrings.CancelButton}"
                            Click="OnCancel"
                            AutomationProperties.Name="{x:Static res:SharedStrings.CancelButton}" />
                    <Button Classes="accent"
                            MinWidth="80"
                            HorizontalContentAlignment="Center"
                            Content="{x:Static res:SharedStrings.OkButton}"
                            Click="OnOk"
                            AutomationProperties.Name="{x:Static res:SharedStrings.OkButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
