<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChartShared.UI.ViewModels"
        xmlns:res="using:ChartShared.UI.Resources"
        xmlns:ui="using:ChartShared.UI.Controls"
        xmlns:hw="using:ChartShared.UI.Controls.Highway"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="580"
        x:Class="ChartShared.UI.Views.CalibrationWindow"
        x:DataType="vm:CalibrationViewModel"
        Title="{x:Static res:SharedStrings.CalibrationWindowTitle}"
        Background="{DynamicResource AppBackgroundBrush}"
        Width="760" Height="580"
        MinWidth="640" MinHeight="500"
        ShowInTaskbar="False"
        CanMinimize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        WindowDecorationsTheme="{StaticResource TitleBarDecorations}"
        WindowStartupLocation="CenterOwner">

    <!-- The calibration tool (charter-spec C11), which both apps open. It can't be minimized: a modal window with no
         taskbar entry would have nothing to restore it from, leaving its owner disabled. -->

    <Window.Styles>
        <!-- The sections and the highway's tile, as the song inspector has them. -->
        <StyleInclude Source="avares://ChartShared.UI/Styles/Inspector.axaml" />

        <!-- A section's controls, grouped as a settings row is. -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource ToolbarGroupBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- The steps: flat toolbar buttons, wide enough for their labels. -->
        <Style Selector="Button.tool.step">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Lit while calibration is held off, whether by the button or by Space. -->
        <Style Selector="Button.hold.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
        </Style>
        <Style Selector="Button.hold.active">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- The title bar, as the main window's is: the icon (the owner's, set in code) and the title. -->
        <ui:TitleBar x:Name="WindowTitleBar"
                     Grid.Row="0"
                     Height="31"
                     BorderThickness="0,0,0,1"
                     BorderBrush="{DynamicResource SubtleBorderBrush}">
            <TextBlock Margin="8,0,12,0"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Text="{x:Static res:SharedStrings.CalibrationWindowTitle}" />
        </ui:TitleBar>

        <Grid Grid.Row="1" ColumnDefinitions="280,*">
            <!-- The highway, as the song's preview draws it. Only watched: a press doesn't scrub it, nor does Shift show
                 its whole chart. -->
            <Border Grid.Column="0" Classes="artTile" Margin="12,12,0,12">
                <Panel>
                    <hw:NoteHighwayView x:Name="Highway"
                                        Scene="{Binding Scene}"
                                        IsHitTestVisible="False" />
                    <Border Classes="banner"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,10,0,0"
                            IsHitTestVisible="False"
                            IsVisible="{Binding IsCalibrationOff}">
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   Text="{x:Static res:SharedStrings.CalibrationOffBadge}" />
                    </Border>
                </Panel>
            </Border>

            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,0,20,16">
                    <TextBlock Classes="section" Text="{x:Static res:SharedStrings.CalibrationDeviceCaption}" />
                    <Border Classes="card">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <PathIcon Grid.Column="0"
                                      Width="14" Height="14"
                                      Opacity="0.7"
                                      VerticalAlignment="Center"
                                      Data="{StaticResource VolumeIconGeometry}" />
                            <TextBlock Grid.Column="1"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding DeviceName}"
                                       ToolTip.Tip="{Binding DeviceName}" />
                        </Grid>
                    </Border>

                    <!-- The latency: a box to drag or type in, as the inspector's offsets are, steps, and a slider, each within
                         ±500 ms (AudioLatencyFile.MaxMilliseconds). -->
                    <TextBlock Classes="section" Text="{x:Static res:SharedStrings.CalibrationLatencyLabel}" />
                    <Border Classes="card">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="6">
                                <PathIcon Grid.Column="0" Opacity="0.7" VerticalAlignment="Center" Data="{StaticResource OffsetIconGeometry}" />
                                <NumericUpDown Grid.Column="1"
                                               ui:DragScrub.IsEnabled="True"
                                               Width="80"
                                               ShowButtonSpinner="False"
                                               VerticalAlignment="Center"
                                               Value="{Binding Value}"
                                               Minimum="-500"
                                               Maximum="500"
                                               Increment="1"
                                               FormatString="+0;−0;0"
                                               ParsingNumberStyle="Integer"
                                               ClipValueToMinMax="True"
                                               AutomationProperties.Name="{x:Static res:SharedStrings.CalibrationLatencyLabel}">
                                    <ToolTip.Tip>
                                        <StackPanel Spacing="6">
                                            <TextBlock TextWrapping="Wrap" Text="{x:Static res:SharedStrings.CalibrationLatencyToolTip}" />
                                            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static res:SharedStrings.OffsetControlsHelp}" />
                                        </StackPanel>
                                    </ToolTip.Tip>
                                </NumericUpDown>
                                <TextBlock Grid.Column="2" Classes="muted" VerticalAlignment="Center" Text="{x:Static res:SharedStrings.CalibrationLatencyUnit}" />
                                <Button Grid.Column="3"
                                        Classes="nudge"
                                        Command="{Binding RevertCommand}"
                                        ToolTip.Tip="{x:Static res:SharedStrings.CalibrationRevertToolTip}"
                                        ToolTip.ShowOnDisabled="True"
                                        AutomationProperties.Name="{x:Static res:SharedStrings.CalibrationRevertToolTip}">
                                    <PathIcon Width="12" Height="12" Data="{StaticResource RevertIconGeometry}" />
                                </Button>
                                <Border Grid.Column="5" Classes="toolbar-group">
                                    <ItemsControl ItemsSource="{x:Static vm:CalibrationViewModel.Steps}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:LatencyStep">
                                                <Button Classes="tool step"
                                                        Content="{Binding Label}"
                                                        Command="{Binding $parent[Window].((vm:CalibrationViewModel)DataContext).NudgeCommand}"
                                                        CommandParameter="{Binding Amount}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Grid>
                            <Slider Value="{Binding Value}"
                                    Minimum="-500"
                                    Maximum="500"
                                    SmallChange="1"
                                    LargeChange="10"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    AutomationProperties.Name="{x:Static res:SharedStrings.CalibrationLatencyLabel}" />
                            <TextBlock Classes="note" Text="{x:Static res:SharedStrings.CalibrationKeysHint}" />
                        </StackPanel>
                    </Border>

                    <!-- Held, the notes are drawn with no latency, to see how far it moves them; let go, they go back. -->
                    <TextBlock Classes="section" Text="{x:Static res:SharedStrings.CalibrationCompareSection}" />
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <Button x:Name="HoldButton"
                                    Classes="labelled hold"
                                    Classes.active="{Binding IsCalibrationOff}"
                                    HorizontalAlignment="Left"
                                    Focusable="False"
                                    AutomationProperties.Name="{x:Static res:SharedStrings.CalibrationHoldOffButton}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ui:LineIcon Data="{StaticResource ViewStroke}" VerticalAlignment="Center" />
                                    <TextBlock VerticalAlignment="Center" Text="{x:Static res:SharedStrings.CalibrationHoldOffButton}" />
                                </StackPanel>
                            </Button>
                            <TextBlock Classes="note" Text="{x:Static res:SharedStrings.CalibrationHoldOffHint}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="section" Text="{x:Static res:SharedStrings.CalibrationHowSection}" />
                    <TextBlock Classes="note" Text="{x:Static res:SharedStrings.CalibrationInstructions}" />

                    <Border Classes="banner error" Margin="0,16,0,0" IsVisible="{Binding HasMessage}">
                        <TextBlock TextWrapping="Wrap" Text="{Binding Message}" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Reset at the left; Cancel and Save at the right, as the other dialogs have them. -->
        <Border Grid.Row="2" Classes="toolbar" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0"
                        Content="{x:Static res:SharedStrings.CalibrationReset}"
                        Command="{Binding ResetCommand}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button MinWidth="80"
                            HorizontalContentAlignment="Center"
                            Content="{x:Static res:SharedStrings.CancelButton}"
                            IsCancel="True"
                            Click="OnCancel" />
                    <Button MinWidth="80"
                            HorizontalContentAlignment="Center"
                            Classes="accent"
                            Content="{x:Static res:SharedStrings.CalibrationSave}"
                            Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
