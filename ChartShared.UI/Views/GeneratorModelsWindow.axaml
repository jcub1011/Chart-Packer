<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChartShared.UI.ViewModels"
        xmlns:res="using:ChartShared.UI.Resources"
        xmlns:ui="using:ChartShared.UI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="520"
        x:Class="ChartShared.UI.Views.GeneratorModelsWindow"
        x:DataType="vm:GeneratorModelsViewModel"
        Title="{Binding Title}"
        Background="{DynamicResource AppBackgroundBrush}"
        Width="560" Height="520"
        MinWidth="440" MinHeight="380"
        ShowInTaskbar="False"
        CanMinimize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        WindowDecorationsTheme="{StaticResource TitleBarDecorations}"
        WindowStartupLocation="CenterOwner">

    <!-- The generator model storage dialog (issue #154), which both apps share: what folder
         holds the models, and their import, export, rename and delete. It can't be minimized:
         a modal window with no taskbar entry would have nothing to restore it from. -->

    <Grid RowDefinitions="Auto,*,Auto">
        <ui:TitleBar x:Name="WindowTitleBar"
                     Grid.Row="0"
                     Height="31"
                     BorderThickness="0,0,0,1"
                     BorderBrush="{DynamicResource SubtleBorderBrush}">
            <TextBlock Margin="8,0,12,0"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding Title}" />
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="16,12,16,8" Spacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Text="{x:Static res:SharedStrings.GeneratorModelsFolderLabel}" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Folder}" />
                <Button Grid.Column="2"
                        Margin="8,0,0,0"
                        MinWidth="70"
                        HorizontalContentAlignment="Center"
                        Content="{x:Static res:SharedStrings.GeneratorModelsChangeFolder}"
                        Command="{Binding ChangeFolderCommand}" />
                <Button Grid.Column="3"
                        Margin="8,0,0,0"
                        MinWidth="70"
                        HorizontalContentAlignment="Center"
                        Content="{x:Static res:SharedStrings.GeneratorModelsOpenFolder}"
                        Command="{Binding OpenFolderCommand}" />
            </Grid>

            <ListBox MinHeight="160"
                     MaxHeight="280"
                     ItemsSource="{Binding Models}"
                     SelectedItem="{Binding SelectedModel}"
                     SelectionMode="Single">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:GeneratorModelRowViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <TextBlock Grid.Column="0"
                                       Margin="0,0,8,0"
                                       Opacity="0.6"
                                       Text="{Binding TypeLabel}" />
                            <TextBlock Grid.Column="1"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Name}" />
                            <TextBlock Grid.Column="2"
                                       Margin="8,0,8,0"
                                       Opacity="0.6"
                                       Text="{Binding SizeText}" />
                            <TextBlock Grid.Column="3"
                                       Opacity="0.6"
                                       Text="{Binding ModifiedText}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Opacity="0.6"
                       IsVisible="{Binding !HasModels}"
                       Text="{x:Static res:SharedStrings.GeneratorModelsEmpty}" />

            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Text="{x:Static res:SharedStrings.GeneratorModelsTypeLabel}" />
                <ComboBox Grid.Column="1"
                          MinWidth="130"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding AvailableTypes}"
                          SelectedItem="{Binding NewType}" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Text="{x:Static res:SharedStrings.GeneratorModelsNameLabel}" />
                <TextBox Grid.Column="3"
                         Text="{Binding NewName}" />
                <Button Grid.Column="4"
                        Margin="8,0,0,0"
                        MinWidth="80"
                        HorizontalContentAlignment="Center"
                        Content="{x:Static res:SharedStrings.GeneratorModelsRename}"
                        Command="{Binding RenameCommand}" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button MinWidth="80"
                        HorizontalContentAlignment="Center"
                        Content="{x:Static res:SharedStrings.GeneratorModelsImport}"
                        Command="{Binding ImportCommand}" />
                <Button MinWidth="80"
                        HorizontalContentAlignment="Center"
                        Content="{x:Static res:SharedStrings.GeneratorModelsExport}"
                        Command="{Binding ExportCommand}" />
                <Button MinWidth="80"
                        HorizontalContentAlignment="Center"
                        Content="{x:Static res:SharedStrings.GeneratorModelsDelete}"
                        Command="{Binding DeleteCommand}" />
                <Button MinWidth="80"
                        HorizontalContentAlignment="Center"
                        Content="{x:Static res:SharedStrings.GeneratorModelsRefresh}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>

            <TextBlock TextWrapping="Wrap"
                       Opacity="0.8"
                       Text="{Binding Status}" />
        </StackPanel>

        <Border Grid.Row="2" Classes="toolbar" BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button MinWidth="80"
                        HorizontalContentAlignment="Center"
                        IsCancel="True"
                        Content="{x:Static res:SharedStrings.GeneratorModelsCloseButton}"
                        Click="OnClose" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
