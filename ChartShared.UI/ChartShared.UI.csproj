<Project Sdk="Microsoft.NET.Sdk">
  <!-- Avalonia UI shared by Chart Packer and Chart Builder: the theme, icons, dialogs, pickers, settings
       window, and the highway's and waveforms' drawing. Code moves here from an app when the other app first
       needs it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChartShared.Audio\ChartShared.Audio.csproj" />
    <ProjectReference Include="..\ChartShared.Core\ChartShared.Core.csproj" />
    <ProjectReference Include="..\ChartShared.Video\ChartShared.Video.csproj" />
  </ItemGroup>

  <!-- The Reduce preview and change strip moved here from Chart Builder; its tests still cover their helpers. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ChartBuilder.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\SharedStrings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>ChartShared.UI.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>SharedStrings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)SharedStrings.Designer.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The language server's design-time build doesn't run CoreResGen, which is what adds the
       generated SharedStrings class to the compile; hand it the last build's copy. -->
  <ItemGroup Condition="'$(DesignTimeBuild)' == 'true'">
    <Compile Include="$(IntermediateOutputPath)SharedStrings.Designer.cs"
             Condition="Exists('$(IntermediateOutputPath)SharedStrings.Designer.cs')" />
  </ItemGroup>
</Project>
