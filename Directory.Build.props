<Project>
  <!-- Shared by every project. Chart Packer and Chart Builder ship together, so they carry one version. -->
  <PropertyGroup>
    <!-- The program version. This is the only place it is defined; everything else reads it from the build. -->
    <Version>1.0.0</Version>
    <!-- Keep the informational version a plain semver, without the SDK's "+<commit sha>" suffix. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
