<Project Sdk="MSTest.Sdk/4.4.1">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- MSTest.Sdk picks its packages' versions; this raises code coverage's. -->
    <MicrosoftTestingExtensionsCodeCoverageVersion>18.11.2</MicrosoftTestingExtensionsCodeCoverageVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChartPacker.Audio\ChartPacker.Audio.csproj" />
    <ProjectReference Include="..\ChartPacker.Core\ChartPacker.Core.csproj" />
    <ProjectReference Include="..\ChartPacker.Video\ChartPacker.Video.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Audio\Fixtures\*.ogg;Audio\Fixtures\*.opus;Audio\Fixtures\*.mp3" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Video\Fixtures\*.mp4;Video\Fixtures\*.webm" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Update="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Update="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Update="MSTest.TestAdapter" Version="4.5.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Update="MSTest.TestFramework" Version="4.5.1" />
  </ItemGroup>

</Project>
