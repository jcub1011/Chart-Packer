<Project Sdk="Microsoft.NET.Sdk">
  <!-- The instrument devices' backends (charter-spec C19): game controllers through SDL3's joystick subsystem, and MIDI
       input through winmm on Windows. Chart Builder's own rather than a ChartShared project, as only Chart Builder
       plays instruments. The SDL3 package is the one Audio uses, so there's one copy of its native library. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The SDL3 bindings take pointers, and winmm calls back through a function pointer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ppy.SDL3-CS" />
    <PackageReference Include="Serilog" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChartShared.Core\ChartShared.Core.csproj" />
  </ItemGroup>
</Project>
