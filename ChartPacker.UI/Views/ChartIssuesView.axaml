<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ChartPacker.UI.ViewModels"
             xmlns:res="using:ChartPacker.Resources"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="480"
             x:Class="ChartPacker.UI.Views.ChartIssuesView"
             x:DataType="vm:ChartIssuesViewModel">
    <!-- A chart's findings (GitHub issue #53), Chart Builder's Findings tab and the chart issues window alike: grouped by
         reading the chart file, the chart as a whole, then each part and difficulty, each group under its heading. One
         virtualizing list, headings among the rows, so only the rows on screen are made, however many findings there are. -->

    <UserControl.Styles>
        <StyleInclude Source="avares://ChartPacker.UI/Styles/Severity.axaml" />
        <Style Selector="ListBox.issues">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,0,8,8" />
        </Style>
        <!-- Rows aren't picked, only acted on: no highlight. -->
        <Style Selector="ListBox.issues ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="ListBox.issues ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.issues ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.issues ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- A finding's row, with a bar on its left coloured by how serious it is (Styles/Severity.axaml). -->
        <Style Selector="Border.finding">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style Selector="Border.group">
            <Setter Property="Padding" Value="4,10,4,4" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <TextBlock Classes="muted"
                   FontSize="12"
                   Margin="12"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{x:Static res:SharedStrings.ChartIssuesNone}"
                   IsVisible="{Binding !HasFindings}" />
        <ListBox Classes="issues"
                 ItemsSource="{Binding Rows}"
                 IsVisible="{Binding HasFindings}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="{x:Static res:SharedStrings.ChartIssuesListName}">
            <ListBox.DataTemplates>
                <DataTemplate DataType="vm:FindingGroup">
                    <Border Classes="group">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                            <TextBlock Grid.Column="1" Classes="muted" FontSize="11" VerticalAlignment="Center" Text="{Binding Counts}" />
                        </Grid>
                    </Border>
                </DataTemplate>
                <DataTemplate DataType="vm:FindingItem">
                    <!-- Its fixes are on its right-click menu, filled as the row asks for it (ChartIssuesView.axaml.cs), so
                         they're of the chart as it is then. It isn't shown where the list can't fix anything. -->
                    <Border Classes="finding severity" Classes.warning="{Binding IsWarning}" Classes.error="{Binding IsError}">
                        <Border.ContextMenu>
                            <ContextMenu Opening="OnFindingMenuOpening" />
                        </Border.ContextMenu>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6">
                            <TextBlock Grid.Row="0" Grid.Column="0" FontSize="12" TextWrapping="Wrap" Text="{Binding Message}" />
                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="muted" FontSize="11" Text="{Binding RuleId}" />
                                <TextBlock Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding Where}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <Button Classes="labelled"
                                        FontSize="12"
                                        Content="{x:Static res:SharedStrings.FindingGoToButton}"
                                        Command="{Binding GoToCommand}"
                                        IsVisible="{Binding CanGoTo}"
                                        ToolTip.Tip="{x:Static res:SharedStrings.FindingGoToToolTip}"
                                        AutomationProperties.Name="{x:Static res:SharedStrings.FindingGoToToolTip}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.DataTemplates>
        </ListBox>
    </Panel>
</UserControl>
