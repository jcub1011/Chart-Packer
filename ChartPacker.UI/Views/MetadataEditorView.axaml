<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ChartPacker.UI.ViewModels"
             xmlns:res="using:ChartPacker.Resources"
             xmlns:ui="using:ChartPacker.UI.Controls"
             xmlns:conv="using:ChartPacker.UI.Converters"
             xmlns:meta="using:ChartPacker.Core.Metadata"
             mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="400"
             x:Class="ChartPacker.UI.Views.MetadataEditorView"
             x:DataType="vm:MetadataEditorViewModel">
    <!-- A song inspector's metadata, Chart Packer's and Chart Builder's: the difficulties as icons, then a row per other
         key, edited in place, and a row to add a key. The inspector around it shows the section's heading. -->

    <UserControl.Resources>
        <conv:DifficultyGlyphConverter x:Key="DifficultyGlyph"
                                       Guitar="{StaticResource InstrumentGuitarGeometry}"
                                       Bass="{StaticResource InstrumentBassGeometry}"
                                       Rhythm="{StaticResource InstrumentRhythmGeometry}"
                                       Drums="{StaticResource InstrumentDrumsGeometry}"
                                       ProDrums="{StaticResource InstrumentProDrumsGeometry}"
                                       Keys="{StaticResource InstrumentKeysGeometry}"
                                       ProKeys="{StaticResource InstrumentProKeysGeometry}"
                                       Vocals="{StaticResource InstrumentVocalsGeometry}"
                                       Harmonies="{StaticResource InstrumentHarmoniesGeometry}"
                                       Dance="{StaticResource InstrumentDanceGeometry}"
                                       Band="{StaticResource InstrumentBandGeometry}" />
        <!-- A chart difficulty's letter: E, M, H, X. -->
        <conv:DifficultyBrushConverter x:Key="DifficultyLetterBrush"
                                       Level0="{StaticResource DifficultyEasyBrush}"
                                       Level1="{StaticResource DifficultyMediumBrush}"
                                       Level2="{StaticResource DifficultyHardBrush}"
                                       Level3="{StaticResource DifficultyExpertBrush}" />
        <!-- A song.ini tier, 0 to 6 and up; unset is grey. -->
        <conv:DifficultyBrushConverter x:Key="DifficultyTierBrush"
                                       Level0="{StaticResource DifficultyTier0Brush}"
                                       Level1="{StaticResource DifficultyTier1Brush}"
                                       Level2="{StaticResource DifficultyTier2Brush}"
                                       Level3="{StaticResource DifficultyTier3Brush}"
                                       Level4="{StaticResource DifficultyTier4Brush}"
                                       Level5="{StaticResource DifficultyTier5Brush}"
                                       Level6="{StaticResource DifficultyTier6Brush}"
                                       Fallback="{StaticResource DifficultyUnsetBrush}" />
        <!-- "Expert   1,234 notes": a list's labels line up in a column, for an ItemsControl that's a shared size scope. -->
        <DataTemplate x:Key="NoteCountRowTemplate" x:DataType="vm:NoteCountRow">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="NoteCountLabel" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Classes="muted" Text="{Binding Label}" />
                <TextBlock Grid.Column="1" Text="{Binding Count}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://ChartPacker.UI/Styles/Inspector.axaml" />
    </UserControl.Styles>

    <StackPanel>
        <!-- An icon per song.ini difficulty, which the rows below leave out. Clicking one sets it. -->
        <StackPanel Spacing="2" Margin="0,0,0,10" IsVisible="{Binding ShowInstruments}">
            <ItemsControl ItemsSource="{Binding Instruments}"
                          AutomationProperties.Name="{x:Static res:SharedStrings.InstrumentsListName}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InstrumentDifficultyViewModel">
                        <Button Classes="instrument"
                                Classes.absent="{Binding !IsCharted}"
                                IsVisible="{Binding IsShown}"
                                IsEnabled="{Binding CanEdit}"
                                ToolTip.ShowOnDisabled="True"
                                AutomationProperties.Name="{Binding AccessibleName}">
                            <ToolTip.Tip>
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Name}" />
                                    <TextBlock Classes="muted" Text="{Binding Key}" />
                                    <TextBlock TextWrapping="Wrap"
                                               Text="{Binding KeyDescription}"
                                               IsVisible="{Binding KeyDescription, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <TextBlock TextWrapping="Wrap" Text="{Binding ValueNote}" IsVisible="{Binding HasValueNote}" />
                                    <ItemsControl Margin="0,4,0,0"
                                                  Grid.IsSharedSizeScope="True"
                                                  ItemsSource="{Binding NoteCounts}"
                                                  ItemTemplate="{StaticResource NoteCountRowTemplate}"
                                                  IsVisible="{Binding HasNoteCounts}" />
                                    <TextBlock TextWrapping="Wrap" Classes="muted" Text="{x:Static res:SharedStrings.InstrumentNotCharted}" IsVisible="{Binding !IsCharted}" />
                                </StackPanel>
                            </ToolTip.Tip>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <StackPanel Spacing="8">
                                        <StackPanel>
                                            <TextBlock Classes="highwayHeader" Text="{Binding Name}" />
                                            <TextBlock Classes="muted" FontSize="12" Text="{Binding Key}" />
                                        </StackPanel>
                                        <ItemsControl Grid.IsSharedSizeScope="True"
                                                      ItemsSource="{Binding NoteCounts}"
                                                      ItemTemplate="{StaticResource NoteCountRowTemplate}"
                                                      IsVisible="{Binding HasNoteCounts}" />
                                        <!-- ? unsets it; 0 to 6 set it, closing the flyout. -->
                                        <ItemsControl ItemsSource="{Binding Presets}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:DifficultyPresetViewModel">
                                                    <Button Classes="preset"
                                                            Classes.current="{Binding IsCurrent}"
                                                            Command="{Binding Command}"
                                                            CommandParameter="{Binding Tier}"
                                                            Click="OnDifficultyChosen"
                                                            AutomationProperties.Name="{Binding Text}">
                                                        <Border Classes="presetFace"
                                                                Classes.unset="{Binding Tier, Converter={x:Static ObjectConverters.IsNull}}"
                                                                Background="{Binding Tier, Converter={StaticResource DifficultyTierBrush}}">
                                                            <TextBlock Text="{Binding Text}" />
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- A tier past the buttons. Enter sets it and leaves the flyout open. -->
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock VerticalAlignment="Center" Text="{x:Static res:SharedStrings.DifficultyOtherLabel}" />
                                            <NumericUpDown Width="110"
                                                           VerticalAlignment="Center"
                                                           Value="{Binding OtherValue}"
                                                           Increment="1"
                                                           Minimum="0"
                                                           Maximum="2147483647"
                                                           FormatString="0"
                                                           AutomationProperties.Name="{x:Static res:SharedStrings.DifficultyOtherLabel}">
                                                <NumericUpDown.KeyBindings>
                                                    <KeyBinding Gesture="Enter" Command="{Binding ApplyOtherCommand}" />
                                                </NumericUpDown.KeyBindings>
                                            </NumericUpDown>
                                            <Button Classes="nudge"
                                                    Content="{x:Static res:SharedStrings.DifficultySetButton}"
                                                    Command="{Binding ApplyOtherCommand}"
                                                    Click="OnDifficultyChosen" />
                                            <Button Classes="nudge"
                                                    Command="{Binding RevertCommand}"
                                                    IsVisible="{Binding IsEdited}"
                                                    Click="OnDifficultyChosen"
                                                    ToolTip.Tip="{x:Static res:SharedStrings.DifficultyRevertButton}"
                                                    AutomationProperties.Name="{x:Static res:SharedStrings.DifficultyRevertButton}">
                                                <PathIcon Width="12" Height="12" Data="{StaticResource RevertIconGeometry}" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Classes="instrumentFace" Spacing="4">
                                <Panel Width="50" Height="44" HorizontalAlignment="Center">
                                    <Border Classes="instrumentCircle" Classes.edited="{Binding IsEdited}">
                                        <PathIcon Data="{Binding Glyph, Converter={StaticResource DifficultyGlyph}}" />
                                    </Border>
                                    <Border Classes="instrumentTag" IsVisible="{Binding HasTag}">
                                        <TextBlock Text="{Binding Tag}" />
                                    </Border>
                                    <Border Classes="instrumentBadge"
                                            Classes.unset="{Binding Tier, Converter={x:Static ObjectConverters.IsNull}}"
                                            Background="{Binding Tier, Converter={StaticResource DifficultyTierBrush}}">
                                        <TextBlock Text="{Binding BadgeText}" />
                                    </Border>
                                </Panel>
                                <!-- "Guitar - EMHX": the letters are always shown whole; a long name gives way to them. -->
                                <DockPanel HorizontalAlignment="Center">
                                    <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Letters}" IsVisible="{Binding HasLetters}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ChartedDifficultyLetter">
                                                <TextBlock Classes="difficultyLetter"
                                                           Text="{Binding Text}"
                                                           Foreground="{Binding Difficulty, Converter={StaticResource DifficultyLetterBrush}}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock DockPanel.Dock="Right"
                                               Classes="instrumentName"
                                               Text="{x:Static res:SharedStrings.InstrumentCaptionSeparator}"
                                               IsVisible="{Binding HasLetters}" />
                                    <TextBlock Classes="instrumentName" Text="{Binding Name}" />
                                </DockPanel>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="nudge"
                    HorizontalAlignment="Left"
                    Content="{Binding InstrumentsToggleText}"
                    Command="{Binding ToggleShowAllInstrumentsCommand}"
                    IsVisible="{Binding HasHiddenInstruments}" />
            <!-- The difficulties have icons rather than rows, so their validation failures are listed here. -->
            <ItemsControl ItemsSource="{Binding HiddenIssues}"
                          IsVisible="{Binding HasHiddenIssues}"
                          Margin="0,4,0,0"
                          AutomationProperties.Name="{x:Static res:SharedStrings.HiddenIssuesListName}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MetadataIssueRow">
                        <Border Classes="metadataRow invalid" Margin="0,1">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{Binding QuickFixHeader}" Command="{Binding QuickFixCommand}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Classes="issue" FontWeight="SemiBold" Text="{Binding Key}" />
                                <TextBlock Grid.Column="1" Classes="issue" Text="{Binding Message}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <TextBlock Classes="muted" Text="{Binding MetadataNote}" IsVisible="{Binding HasMetadataNote}" />
        <ItemsControl ItemsSource="{Binding Metadata}"
                      Grid.IsSharedSizeScope="True"
                      AutomationProperties.Name="{x:Static res:SharedStrings.MetadataListName}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MetadataRowViewModel">
                    <!-- A value that fails validation is marked orange, with why under it. -->
                    <Border Classes="metadataRow" Classes.invalid="{Binding HasIssue}" Margin="0,1">
                        <!-- Quick Fix puts the key's fix in the drafts; it's there on every row, disabled where there's none. -->
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding QuickFixHeader}" Command="{Binding QuickFixCommand}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid RowDefinitions="Auto,Auto">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MetadataKey" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MetadataActions" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Classes="marker"
                                       Margin="0,2,0,0"
                                       Text="{Binding Marker}" />
                            <TextBlock Grid.Column="1"
                                       Classes="muted"
                                       Classes.removed="{Binding IsRemoved}"
                                       MaxWidth="220"
                                       Margin="0,2,16,0"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Key}">
                                <!-- The key in full (it may be trimmed), and what it does when it's a known key. -->
                                <ToolTip.Tip>
                                    <StackPanel Spacing="2">
                                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Key}" />
                                        <TextBlock TextWrapping="Wrap" Text="{Binding KeyDescription}" IsVisible="{Binding HasKeyDescription}" />
                                    </StackPanel>
                                </ToolTip.Tip>
                            </TextBlock>

                            <!-- Tags like <color=#FDFD96FF> are rendered and times are formatted; the tooltip shows the value as stored. -->
                            <Button Grid.Column="2"
                                    Classes="value"
                                    Command="{Binding BeginEditCommand}"
                                    IsVisible="{Binding !IsEditing}"
                                    ToolTip.Tip="{Binding ToolTip}"
                                    AutomationProperties.Name="{Binding Key}">
                                <Panel>
                                    <TextBlock TextWrapping="Wrap"
                                               Classes.removed="{Binding IsRemoved}"
                                               ui:RichTextMarkup.Text="{Binding DisplayValue}"
                                               IsVisible="{Binding ShowRichValue}" />
                                    <TextBlock TextWrapping="Wrap"
                                               Classes="distinct"
                                               Classes.removed="{Binding IsRemoved}"
                                               Text="{Binding DisplayValue}"
                                               IsVisible="{Binding ShowDistinct}" />
                                </Panel>
                            </Button>
                            <StackPanel Grid.Column="2" IsVisible="{Binding IsEditing}">
                                <!-- Enter or leaving the box keeps the text; Escape drops it. -->
                                <TextBox Classes="inline"
                                         Text="{Binding EditText}"
                                         PlaceholderText="{Binding EditPlaceholder}"
                                         IsVisible="{Binding IsEditing}"
                                         ui:FocusWhenShown.IsEnabled="True"
                                         LostFocus="OnEditLostFocus"
                                         AutomationProperties.Name="{Binding Key}">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding CommitCommand}" />
                                        <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3"
                                        Orientation="Horizontal"
                                        Margin="4,0,0,0"
                                        IsVisible="{Binding ShowActions}">
                                <Button Classes="icon"
                                        Command="{Binding AutoSetSongLengthCommand}"
                                        IsVisible="{Binding ShowAutoSetLength}"
                                        ToolTip.Tip="{x:Static res:SharedStrings.AutoSetLengthToolTip}"
                                        AutomationProperties.Name="{x:Static res:SharedStrings.AutoSetLengthButton}">
                                    <PathIcon Width="12" Height="12" Data="{StaticResource AutoLengthIconGeometry}" />
                                </Button>
                                <Button Classes="icon"
                                        Command="{Binding RevertCommand}"
                                        IsVisible="{Binding IsChanged}"
                                        ToolTip.Tip="{x:Static res:SharedStrings.RevertRowToolTip}"
                                        AutomationProperties.Name="{x:Static res:SharedStrings.RevertRowToolTip}">
                                    <PathIcon Width="12" Height="12" Data="{StaticResource RevertIconGeometry}" />
                                </Button>
                                <Button Classes="icon"
                                        Command="{Binding RemoveCommand}"
                                        IsVisible="{Binding CanRemove}"
                                        ToolTip.Tip="{x:Static res:SharedStrings.RemoveRowToolTip}"
                                        AutomationProperties.Name="{x:Static res:SharedStrings.RemoveRowToolTip}">
                                    <PathIcon Width="12" Height="12" Data="{StaticResource RemoveIconGeometry}" />
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" IsVisible="{Binding !IsEditing}">
                                <TextBlock Classes="issue" Text="{Binding Issue}" IsVisible="{Binding HasIssue}" />
                                <TextBlock Classes="hint" Text="{Binding Hint}" IsVisible="{Binding HasHint}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- New row: key and value, both checked before anything goes into the drafts.
             The key box suggests the known keys not already in use, and takes any other key typed. -->
        <StackPanel Margin="14,6,0,0" Spacing="4" IsVisible="{Binding IsAdding}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <AutoCompleteBox x:Name="NewKeyBox"
                                 Grid.Column="0"
                                 Width="220"
                                 Text="{Binding NewKey}"
                                 ItemsSource="{Binding AvailableKeys}"
                                 ValueMemberBinding="{Binding Key, DataType=meta:KnownKey}"
                                 FilterMode="Contains"
                                 MinimumPrefixLength="0"
                                 MaxDropDownHeight="320"
                                 PlaceholderText="{x:Static res:SharedStrings.NewKeyWatermark}"
                                 IsVisible="{Binding IsAdding}"
                                 ui:FocusWhenShown.IsEnabled="True"
                                 ToolTip.Tip="{x:Static res:SharedStrings.NewKeyToolTip}"
                                 AutomationProperties.Name="{x:Static res:SharedStrings.NewKeyWatermark}">
                    <AutoCompleteBox.ItemTemplate>
                        <!-- A fixed width: the list is virtualised, so sizing to content would
                             resize the dropdown to the widest visible item as it scrolls. -->
                        <DataTemplate x:DataType="meta:KnownKey">
                            <StackPanel Width="300" Margin="0,2" Spacing="1">
                                <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Key}" />
                                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding Description}" />
                            </StackPanel>
                        </DataTemplate>
                    </AutoCompleteBox.ItemTemplate>
                </AutoCompleteBox>
                <TextBox x:Name="NewValueBox"
                         Grid.Column="1"
                         Text="{Binding NewValue}"
                         PlaceholderText="{x:Static res:SharedStrings.NewValueWatermark}"
                         AutomationProperties.Name="{x:Static res:SharedStrings.NewValueWatermark}">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding CommitAddCommand}" />
                        <KeyBinding Gesture="Escape" Command="{Binding CancelAddCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="2"
                        Content="{x:Static res:SharedStrings.AddButton}"
                        Command="{Binding CommitAddCommand}"
                        AutomationProperties.Name="{x:Static res:SharedStrings.AddButton}" />
                <Button Grid.Column="3"
                        Content="{x:Static res:SharedStrings.CancelButton}"
                        Command="{Binding CancelAddCommand}"
                        AutomationProperties.Name="{x:Static res:SharedStrings.CancelButton}" />
            </Grid>
            <TextBlock Classes="error" Text="{Binding NewRowError}" IsVisible="{Binding HasNewRowError}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="10,4,0,0" Spacing="8">
            <Button Classes="icon"
                    Command="{Binding BeginAddCommand}"
                    IsVisible="{Binding ShowAddRow}"
                    AutomationProperties.Name="{x:Static res:SharedStrings.AddRowButton}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Width="12" Height="12" Data="{StaticResource AddIconGeometry}" />
                    <TextBlock Text="{x:Static res:SharedStrings.AddRowButton}" />
                </StackPanel>
            </Button>
            <!-- With no song_length row there's no row button, so Auto Set is offered here; it adds the row. -->
            <Button Classes="icon"
                    Command="{Binding AutoSetSongLengthCommand}"
                    IsVisible="{Binding ShowAutoSetLengthFallback}"
                    ToolTip.Tip="{x:Static res:SharedStrings.AutoSetLengthToolTip}"
                    AutomationProperties.Name="{x:Static res:SharedStrings.AutoSetLengthButton}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Width="12" Height="12" Data="{StaticResource AutoLengthIconGeometry}" />
                    <TextBlock Text="{x:Static res:SharedStrings.AutoSetLengthButton}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
