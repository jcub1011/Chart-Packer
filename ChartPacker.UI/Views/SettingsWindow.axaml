<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:svm="using:ChartPacker.ViewModels.Settings"
        xmlns:res="using:ChartPacker.Resources"
        xmlns:ctl="using:ChartPacker.Controls"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="560"
        x:Class="ChartPacker.Views.SettingsWindow"
        x:DataType="svm:SettingsWindowViewModel"
        Title="{x:Static res:SharedStrings.SettingsWindowTitle}"
        Background="{DynamicResource AppBackgroundBrush}"
        Width="820" Height="560"
        MinWidth="560" MinHeight="360"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.settings-heading">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <!-- One setting. Outlined in the accent while it has a change that OK or Apply hasn't written yet. -->
        <Style Selector="Border.setting-row">
            <Setter Property="Background" Value="{DynamicResource ToolbarGroupBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8,6,8" />
        </Style>
        <Style Selector="Border.setting-row.modified">
            <Setter Property="BorderBrush" Value="#998B5CF6" />
        </Style>
        <Style Selector="TextBlock.setting-description">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Locked while the toggle it depends on is off: dimmed, with a note saying which toggle that is. -->
        <Style Selector="Border.setting-row.locked StackPanel.setting-text">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="TextBlock.setting-locked">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TreeViewItem" x:DataType="svm:SettingsCategoryViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
        </Style>
    </Window.Styles>

    <!-- Editors, one per kind of setting; SettingEditorFactory picks the view model. Each is shown inside a
         settings row (the row template below), which adds the label, description and reset button. -->
    <Window.DataTemplates>
        <DataTemplate DataType="svm:ToggleSettingViewModel">
            <CheckBox IsChecked="{Binding Value}" AutomationProperties.Name="{Binding Label}" />
        </DataTemplate>
        <DataTemplate DataType="svm:IntegerSettingViewModel">
            <NumericUpDown Value="{Binding Value}"
                           Minimum="{Binding Minimum}"
                           Maximum="{Binding Maximum}"
                           Increment="1"
                           FormatString="0"
                           ParsingNumberStyle="Integer"
                           ClipValueToMinMax="True"
                           Width="110"
                           AutomationProperties.Name="{Binding Label}" />
        </DataTemplate>
        <DataTemplate DataType="svm:RangeSettingViewModel">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Slider Value="{Binding Value}"
                        Minimum="{Binding Minimum}"
                        Maximum="{Binding Maximum}"
                        SmallChange="{Binding SmallChange}"
                        LargeChange="{Binding SmallChange}"
                        Width="180"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding Label}" />
                <TextBlock Text="{Binding ValueText}" MinWidth="40" TextAlignment="Right" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="svm:ChoiceSettingViewModel">
            <ComboBox ItemsSource="{Binding Choices}"
                      SelectedIndex="{Binding SelectedIndex}"
                      MinWidth="160"
                      AutomationProperties.Name="{Binding Label}" />
        </DataTemplate>
        <DataTemplate DataType="svm:TextSettingViewModel">
            <TextBox Text="{Binding Value}"
                     PlaceholderText="{Binding Placeholder}"
                     Width="220"
                     AutomationProperties.Name="{Binding Label}" />
        </DataTemplate>
        <DataTemplate DataType="svm:FolderSettingViewModel">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding DisplayText}"
                           Classes.muted="{Binding IsEmpty}"
                           MaxWidth="280"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           ToolTip.Tip="{Binding DisplayText}" />
                <Button Command="{Binding BrowseCommand}"
                        Content="{x:Static res:SharedStrings.SettingsBrowseButton}"
                        AutomationProperties.Name="{Binding Label}" />
            </StackPanel>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Classes="toolbar">
            <TextBox x:Name="SearchBox"
                     Classes="clearButton"
                     VerticalContentAlignment="Center"
                     Text="{Binding SearchText}"
                     PlaceholderText="{x:Static res:SharedStrings.SettingsSearchWatermark}"
                     AutomationProperties.Name="{x:Static res:SharedStrings.SettingsSearchWatermark}">
                <TextBox.InnerLeftContent>
                    <ctl:LineIcon Data="{StaticResource SearchStroke}" Margin="8,0,0,0" Opacity="0.6" />
                </TextBox.InnerLeftContent>
            </TextBox>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="220,*">
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="0,0,1,0">
                <TreeView ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          Margin="4,8"
                          AutomationProperties.Name="{x:Static res:SharedStrings.SettingsCategoriesName}">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate DataType="svm:SettingsCategoryViewModel" ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Label}" />
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <Panel Grid.Column="1">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Groups}" Margin="20,14,20,20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="20" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="svm:SettingsGroupViewModel">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="settings-heading" Text="{Binding Title}" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <!-- The row. Its editor comes from Window.DataTemplates, by the setting's kind. -->
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="svm:SettingViewModel">
                                                <Border Classes="setting-row" Classes.modified="{Binding IsModified}" Classes.locked="{Binding !IsEnabled}">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                            <StackPanel Classes="setting-text" Spacing="2">
                                                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                                                <TextBlock Classes="setting-description"
                                                                           Text="{Binding Description}"
                                                                           IsVisible="{Binding HasDescription}" />
                                                            </StackPanel>
                                                            <TextBlock Classes="setting-locked"
                                                                       Text="{Binding LockedNote}"
                                                                       IsVisible="{Binding !IsEnabled}" />
                                                        </StackPanel>
                                                        <ContentControl Grid.Column="1" Content="{Binding}" VerticalAlignment="Center" IsEnabled="{Binding IsEnabled}" />
                                                        <!-- Fixed width, so the editor doesn't shift when the button appears. -->
                                                        <Panel Grid.Column="2" Width="32" VerticalAlignment="Center">
                                                            <Button Classes="tool"
                                                                    Command="{Binding ResetCommand}"
                                                                    IsVisible="{Binding !IsDefault}"
                                                                    ToolTip.Tip="{x:Static res:SharedStrings.SettingsResetToolTip}"
                                                                    AutomationProperties.Name="{x:Static res:SharedStrings.SettingsResetToolTip}">
                                                                <ctl:LineIcon Data="{StaticResource UndoStroke}" />
                                                            </Button>
                                                        </Panel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Classes="muted centered"
                           Margin="20"
                           VerticalAlignment="Center"
                           IsVisible="{Binding HasNoMatches}"
                           Text="{Binding NoMatchesText}" />
            </Panel>
        </Grid>

        <!-- No default button: Enter in the search or number boxes shouldn't close the window. -->
        <Border Grid.Row="2" Classes="toolbar" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="accent"
                        MinWidth="80"
                        HorizontalContentAlignment="Center"
                        Content="{x:Static res:SharedStrings.OkButton}"
                        Click="OnOk"
                        AutomationProperties.Name="{x:Static res:SharedStrings.OkButton}" />
                <Button MinWidth="80"
                        HorizontalContentAlignment="Center"
                        Content="{x:Static res:SharedStrings.CancelButton}"
                        IsCancel="True"
                        Click="OnCancel"
                        AutomationProperties.Name="{x:Static res:SharedStrings.CancelButton}" />
                <Button MinWidth="80"
                        HorizontalContentAlignment="Center"
                        Content="{x:Static res:SharedStrings.ApplyButton}"
                        Command="{Binding ApplyCommand}"
                        AutomationProperties.Name="{x:Static res:SharedStrings.ApplyButton}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
