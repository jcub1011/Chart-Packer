<Project Sdk="Microsoft.NET.Sdk">
  <!-- Avalonia UI shared by Chart Packer and Chart Builder: the theme, icons, dialogs, pickers, settings
       window, and the highway's and waveforms' drawing. Code moves here from an app when the other app first
       needs it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChartPacker.Audio\ChartPacker.Audio.csproj" />
    <ProjectReference Include="..\ChartPacker.Core\ChartPacker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\SharedStrings.resx">
      <!-- Named after the class's namespace rather than this project's root namespace (ChartPacker.UI),
           so the generated class's ResourceManager finds it. -->
      <LogicalName>ChartPacker.Resources.SharedStrings.resources</LogicalName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>ChartPacker.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>SharedStrings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)SharedStrings.Designer.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The language server's design-time build doesn't run CoreResGen, which is what adds the
       generated SharedStrings class to the compile; hand it the last build's copy. -->
  <ItemGroup Condition="'$(DesignTimeBuild)' == 'true'">
    <Compile Include="$(IntermediateOutputPath)SharedStrings.Designer.cs"
             Condition="Exists('$(IntermediateOutputPath)SharedStrings.Designer.cs')" />
  </ItemGroup>
</Project>
