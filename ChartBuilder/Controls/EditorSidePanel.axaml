<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:res="using:ChartBuilder.Resources"
                    xmlns:ctl="using:ChartPacker.UI.Controls"
                    xmlns:bctl="using:ChartBuilder.Controls">

    <!-- The Editor's side panels (EditorSidePanel.cs): compact tabs along the top, like a docked tool window, or,
         collapsed, a narrow strip along the window's edge with the tabs' titles turned on their side. -->
    <ControlTheme x:Key="{x:Type bctl:EditorSidePanel}" TargetType="bctl:EditorSidePanel">
        <!-- The tabs are in one row, which scrolls when the panel is too narrow for them. -->
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <DockPanel Name="PART_Expanded" Background="{DynamicResource SurfaceBrush}">
                        <!-- The tab strip's band, with the collapse button at its right. -->
                        <Border DockPanel.Dock="Top"
                                MinHeight="34"
                                Background="{DynamicResource ToolbarBrush}"
                                BorderBrush="{DynamicResource SubtleBorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*,Auto">
                                <!-- EditorSidePanel.cs scrolls it sideways with the mouse wheel. -->
                                <ScrollViewer Name="PART_TabScroller"
                                              Grid.Column="0"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                                </ScrollViewer>
                                <Button Grid.Column="1"
                                        Classes="tool"
                                        Margin="0,3,4,0"
                                        VerticalAlignment="Top"
                                        Command="{TemplateBinding ToggleCommand}"
                                        ToolTip.Tip="{x:Static res:Strings.CollapsePanelToolTip}"
                                        AutomationProperties.Name="{x:Static res:Strings.CollapsePanelToolTip}">
                                    <ctl:LineIcon Name="PART_Chevron" Data="{DynamicResource PanelCollapseStroke}" />
                                </Button>
                            </Grid>
                        </Border>
                        <ContentPresenter Name="PART_SelectedContentHost"
                                          Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                    </DockPanel>
                    <Border Name="PART_Strip"
                            Width="{x:Static bctl:EditorSidePanel.StripWidth}"
                            Background="{DynamicResource ToolbarBrush}"
                            BorderBrush="{DynamicResource SubtleBorderBrush}">
                        <!-- Each tab's title, scrolling with the mouse wheel when they don't fit; the strip is too
                             narrow for a scroll bar. EditorSidePanel.cs handles their clicks. -->
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                            <ItemsControl Name="PART_StripTabs"
                                          Margin="0,4"
                                          ItemsSource="{TemplateBinding StripTabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="bctl:EditorSidePanelStripTab">
                                        <Button Classes="strip-tab"
                                                Padding="4,8"
                                                CornerRadius="4"
                                                Background="Transparent"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                ToolTip.Tip="{x:Static res:Strings.ExpandPanelToolTip}"
                                                AutomationProperties.Name="{Binding Title}">
                                            <!-- Here rather than in the theme, which can't reach into the button's own template. -->
                                            <Button.Styles>
                                                <Style Selector="Button.strip-tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                    <Setter Property="Background" Value="{DynamicResource ToolHoverBrush}" />
                                                </Style>
                                            </Button.Styles>
                                            <LayoutTransformControl>
                                                <LayoutTransformControl.LayoutTransform>
                                                    <RotateTransform Angle="90" />
                                                </LayoutTransformControl.LayoutTransform>
                                                <TextBlock Text="{Binding Title}" />
                                            </LayoutTransformControl>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <!-- Expanded, or only the strip. Set here rather than on the parts, which a style can't override. -->
        <Style Selector="^ /template/ Border#PART_Strip">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>
        <Style Selector="^:collapsed /template/ Border#PART_Strip">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:collapsed /template/ DockPanel#PART_Expanded">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Along the right edge: the chevron points that way, and the strip's line is on its inner side. -->
        <Style Selector="^:right /template/ ctl|LineIcon#PART_Chevron">
            <Setter Property="RenderTransform" Value="scaleX(-1)" />
        </Style>
        <Style Selector="^:right /template/ Border#PART_Strip">
            <Setter Property="BorderThickness" Value="1,0,0,0" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
