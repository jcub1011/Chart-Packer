<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:res="using:ChartBuilder.Resources"
                    xmlns:ctl="using:ChartShared.UI.Controls"
                    xmlns:bctl="using:ChartBuilder.Controls">

    <!-- The Editor's side panels (EditorSidePanel.cs): compact tabs along the top, like a docked tool window, with the pin at
         their right. Auto-hiding, a narrow strip along the window's edge with the tabs' titles turned on their side, the
         panel flying out beside it over the chart, raised by a shadow, with a grip on its inner edge to size it. -->
    <ControlTheme x:Key="{x:Type bctl:EditorSidePanel}" TargetType="bctl:EditorSidePanel">
        <!-- The tabs are in one row, in the order they were dragged to, which scrolls when the panel is too narrow. -->
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <bctl:EditorSidePanelTabsPanel />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>
                    <Border Name="PART_Strip"
                            DockPanel.Dock="Left"
                            Width="{x:Static bctl:EditorSidePanel.StripWidth}"
                            Background="{DynamicResource ToolbarBrush}"
                            BorderBrush="{DynamicResource SubtleBorderBrush}">
                        <!-- Each tab's title, scrolling with the mouse wheel when they don't fit; the strip is too narrow for a
                             scroll bar. EditorSidePanel.cs handles their clicks. -->
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                            <ItemsControl Name="PART_StripTabs"
                                          Margin="0,4"
                                          ItemsSource="{TemplateBinding StripTabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="bctl:EditorSidePanelStripTab">
                                        <Button Classes="strip-tab"
                                                Classes.active="{Binding IsActive}"
                                                Padding="4,8"
                                                CornerRadius="4"
                                                Background="Transparent"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                ToolTip.Tip="{x:Static res:Strings.ExpandPanelToolTip}"
                                                AutomationProperties.Name="{Binding Title}">
                                            <!-- Here rather than in the theme, which can't reach into the button's own template. -->
                                            <Button.Styles>
                                                <Style Selector="Button.strip-tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                    <Setter Property="Background" Value="{DynamicResource ToolHoverBrush}" />
                                                </Style>
                                                <Style Selector="Button.strip-tab.active /template/ ContentPresenter#PART_ContentPresenter">
                                                    <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                </Style>
                                            </Button.Styles>
                                            <LayoutTransformControl>
                                                <LayoutTransformControl.LayoutTransform>
                                                    <RotateTransform Angle="90" />
                                                </LayoutTransformControl.LayoutTransform>
                                                <TextBlock Text="{Binding Title}" />
                                            </LayoutTransformControl>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Border Name="PART_Flyout" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}">
                        <DockPanel>
                            <!-- Flown out, the inner edge sizes the panel, as the splitter does while it's pinned. -->
                            <Thumb Name="PART_ResizeGrip"
                                   DockPanel.Dock="Right"
                                   Width="5"
                                   Cursor="SizeWestEast"
                                   Background="Transparent">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Border Background="{TemplateBinding Background}" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                            <DockPanel>
                                <!-- The tab strip's band, with the pin at its right. -->
                                <Border DockPanel.Dock="Top"
                                        MinHeight="34"
                                        Background="{DynamicResource ToolbarBrush}"
                                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <!-- EditorSidePanel.cs scrolls it sideways with the mouse wheel, and drags its tabs. Its
                                             scroll bar stays in the collapsed state, floating over the band's foot with no extra
                                             padding. -->
                                        <ScrollViewer Name="PART_TabScroller"
                                                      Grid.Column="0"
                                                      AllowAutoHide="True"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Disabled">
                                            <ScrollViewer.Styles>
                                                <!-- Keep the horizontal bar collapsed even while the pointer is over it. -->
                                                <Style Selector="ScrollBar:horizontal[IsExpanded=true] /template/ Grid#Root">
                                                    <Setter Property="Background" Value="Transparent" />
                                                </Style>
                                                <Style Selector="ScrollBar:horizontal[IsExpanded=true] /template/ Rectangle#TrackRect">
                                                    <Setter Property="Opacity" Value="0" />
                                                </Style>
                                                <Style Selector="ScrollBar:horizontal[IsExpanded=true] /template/ Thumb">
                                                    <Setter Property="Background" Value="{DynamicResource ScrollBarPanningThumbBackground}" />
                                                    <Setter Property="RenderTransform" Value="{DynamicResource HorizontalSmallScrollThumbScaleTransform}" />
                                                </Style>
                                                <Style Selector="ScrollBar:horizontal[IsExpanded=true] /template/ RepeatButton">
                                                    <Setter Property="Opacity" Value="0" />
                                                </Style>
                                                <!-- A tab being dragged along the row. -->
                                                <Style Selector="TabItem.dragging">
                                                    <Setter Property="Opacity" Value="0.6" />
                                                    <Setter Property="Cursor" Value="SizeWestEast" />
                                                </Style>
                                            </ScrollViewer.Styles>
                                            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                                        </ScrollViewer>
                                        <Button Name="PART_PinButton"
                                                Grid.Column="1"
                                                Classes="tool"
                                                Margin="0,3,4,0"
                                                VerticalAlignment="Top"
                                                ToolTip.Tip="{x:Static res:Strings.PanelAutoHideToolTip}"
                                                AutomationProperties.Name="{x:Static res:Strings.PanelAutoHideToolTip}">
                                            <ctl:LineIcon Name="PART_Pin" Data="{DynamicResource PinStroke}" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <ContentPresenter Name="PART_SelectedContentHost"
                                                  Content="{TemplateBinding SelectedContent}"
                                                  ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                            </DockPanel>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </ControlTemplate>
        </Setter>

        <!-- Pinned: the panel itself, and no strip or grip. -->
        <Style Selector="^ /template/ Border#PART_Strip">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>
        <Style Selector="^ /template/ Thumb#PART_ResizeGrip">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Auto-hiding: the strip, and the panel only while it's flown out, over the chart. The pin lies on its side. -->
        <Style Selector="^:autohide /template/ Border#PART_Strip">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:autohide /template/ Border#PART_Flyout">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:autohide:open /template/ Border#PART_Flyout">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="BoxShadow" Value="0 0 18 0 #66000000" />
        </Style>
        <Style Selector="^:autohide:open /template/ Thumb#PART_ResizeGrip">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:autohide /template/ ctl|LineIcon#PART_Pin">
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>
        <Style Selector="^:autohide /template/ Button#PART_PinButton">
            <Setter Property="ToolTip.Tip" Value="{x:Static res:Strings.PanelPinToolTip}" />
            <Setter Property="AutomationProperties.Name" Value="{x:Static res:Strings.PanelPinToolTip}" />
        </Style>

        <!-- Along the right edge: the strip on the outer side, its line and the grip on the inner. -->
        <Style Selector="^:right /template/ Border#PART_Strip">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
        </Style>
        <Style Selector="^:right /template/ Thumb#PART_ResizeGrip">
            <Setter Property="DockPanel.Dock" Value="Left" />
        </Style>
        <Style Selector="^:right:autohide:open /template/ Border#PART_Flyout">
            <Setter Property="BorderThickness" Value="1,0,0,0" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
