<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChartBuilder.ViewModels"
             xmlns:res="using:ChartBuilder.Resources"
             xmlns:sres="using:ChartShared.UI.Resources"
             xmlns:ui="using:ChartShared.UI.Controls"
             xmlns:bctl="using:ChartBuilder.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="900"
             x:Class="ChartBuilder.Views.ArtView"
             x:DataType="vm:ArtViewModel">

    <!-- The Art tab (charter-spec C1): the album art, the background image and the background video, a section each, the
         video playing against the song. An empty tile has Choose; a tile's right-click menu has Replace, Remove and Revert
         to saved. Under the video, its start, to line it up with the audio. Each change is an undo step, saved with the
         song. -->
    <UserControl.Styles>
        <StyleInclude Source="avares://ChartShared.UI/Styles/Inspector.axaml" />
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- A slot: its tile, its file, and for the video, where in it the song starts. -->
        <DataTemplate x:Key="SlotTemplate" x:DataType="vm:ArtSlotViewModel">
            <StackPanel Spacing="4">
                <Border Classes="artTile" AutomationProperties.Name="{Binding Title}">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static res:Strings.ArtReplaceMenu}" Command="{Binding ChooseCommand}">
                                <MenuItem.Icon><ui:LineIcon Data="{StaticResource ReplaceStroke}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{x:Static res:Strings.ArtRemoveMenu}" Command="{Binding RemoveCommand}">
                                <MenuItem.Icon><ui:LineIcon Data="{StaticResource TrashStroke}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{x:Static res:Strings.ArtRevertMenu}" Command="{Binding RevertCommand}">
                                <MenuItem.Icon><ui:LineIcon Data="{StaticResource RevertStroke}" /></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <!-- As wide as the tab and shaped like the picture it shows, so the picture fills it, but no taller than
                         wide; while there's none, a square for the art and 16:9 for a background. -->
                    <bctl:AspectPanel AspectRatio="{Binding AspectRatio}">
                        <Image Source="{Binding Image}" Stretch="Uniform" IsVisible="{Binding HasImage}" />
                        <ui:VideoFrameView Playback="{Binding Video}"
                                           Timeline="{Binding Timeline}"
                                           Clock="{Binding Clock}"
                                           IsVisible="{Binding HasVideo}" />
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Margin="8"
                                    Spacing="8"
                                    IsVisible="{Binding HasNote}">
                            <TextBlock Classes="muted note"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Text="{Binding Note}" />
                            <Button HorizontalAlignment="Center"
                                    Content="{x:Static res:Strings.ArtChooseButton}"
                                    Command="{Binding ChooseCommand}"
                                    IsVisible="{Binding IsEmpty}" />
                        </StackPanel>
                    </bctl:AspectPanel>
                </Border>
                <!-- The file's name, marked while it's a pending change, and its size. -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4" IsVisible="{Binding HasFile}">
                    <TextBlock Grid.Column="0" Classes="marker" VerticalAlignment="Center" Text="{Binding Marker}" />
                    <TextBlock Grid.Column="1"
                               Classes="muted note artName"
                               VerticalAlignment="Center"
                               Text="{Binding FileName}"
                               ToolTip.Tip="{Binding FileName}" />
                    <Border Grid.Column="2" Classes="chip" IsVisible="{Binding FileSize, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{Binding FileSize}" />
                    </Border>
                </Grid>
                <!-- Under the background video: where in it the song starts, marked while it's a pending change. The
                     video shows each value as it's typed or dragged; it's set as one undo step once left alone. -->
                <Panel IsVisible="{Binding ShowsVideoStart}">
                    <Grid DataContext="{Binding VideoStart}"
                          x:DataType="vm:VideoStartViewModel"
                          ColumnDefinitions="Auto,*,Auto,Auto"
                          ColumnSpacing="4">
                        <TextBlock Grid.Column="0" Classes="marker" VerticalAlignment="Center" Text="{Binding Marker}" />
                        <TextBlock Grid.Column="1"
                                   Classes="muted note"
                                   VerticalAlignment="Center"
                                   Text="{x:Static res:Strings.ArtVideoStartLabel}" />
                        <NumericUpDown Grid.Column="2"
                                       ui:DragScrub.IsEnabled="True"
                                       Width="96"
                                       ShowButtonSpinner="False"
                                       VerticalAlignment="Center"
                                       Value="{Binding StartMs}"
                                       IsEnabled="{Binding CanEdit}"
                                       Increment="1"
                                       Minimum="{x:Static vm:VideoStartViewModel.MinStartMs}"
                                       Maximum="{x:Static vm:VideoStartViewModel.MaxStartMs}"
                                       FormatString="+0;-0;0"
                                       ParsingNumberStyle="Integer"
                                       AutomationProperties.Name="{x:Static res:Strings.ArtVideoStartLabel}">
                            <ToolTip.Tip>
                                <StackPanel MaxWidth="320" Spacing="6">
                                    <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.ArtVideoStartToolTip}" />
                                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static sres:SharedStrings.OffsetControlsHelp}" />
                                </StackPanel>
                            </ToolTip.Tip>
                        </NumericUpDown>
                        <Button Grid.Column="3"
                                Classes="nudge"
                                Command="{Binding RevertCommand}"
                                ToolTip.Tip="{x:Static res:Strings.ArtVideoStartRevertToolTip}"
                                AutomationProperties.Name="{x:Static res:Strings.ArtVideoStartRevertToolTip}">
                            <ui:LineIcon Width="12" Height="12" Data="{StaticResource RevertStroke}" />
                        </Button>
                    </Grid>
                </Panel>
                <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <bctl:PanelSectionStack TabKey="art">
            <bctl:PanelSection Key="album-art" Header="{Binding AlbumArt.Title}" Padding="12,8,12,12">
                <ContentControl Content="{Binding AlbumArt}" ContentTemplate="{StaticResource SlotTemplate}" />
            </bctl:PanelSection>
            <bctl:PanelSection Key="background-image" Header="{Binding BackgroundImage.Title}" Padding="12,8,12,12">
                <ContentControl Content="{Binding BackgroundImage}" ContentTemplate="{StaticResource SlotTemplate}" />
            </bctl:PanelSection>
            <bctl:PanelSection Key="background-video" Header="{Binding BackgroundVideo.Title}" Padding="12,8,12,12">
                <ContentControl Content="{Binding BackgroundVideo}" ContentTemplate="{StaticResource SlotTemplate}" />
            </bctl:PanelSection>
        </bctl:PanelSectionStack>
    </ScrollViewer>
</UserControl>
