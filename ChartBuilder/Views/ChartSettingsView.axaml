<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChartBuilder.ViewModels"
             xmlns:res="using:ChartBuilder.Resources"
             xmlns:ui="using:ChartPacker.UI.Controls"
             xmlns:uiviews="using:ChartPacker.UI.Views"
             xmlns:conv="using:ChartPacker.UI.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="900"
             x:Class="ChartBuilder.Views.ChartSettingsView"
             x:DataType="vm:EditorWindowViewModel"
             Focusable="True"
             FocusAdorner="{x:Null}"
             ui:CommitOnClickAway.IsEnabled="True">

    <!-- Chart settings (charter-spec C1): everything a chart needs, each change an undo step as it's made: the parts, a
         row each with its rating; the song's metadata, as Chart Packer's inspector edits it; and its tracks, with their
         mix. The timing (the resolution, the delay and the tempo map) is in the Tempo map tab. Each field's label is above it, as the panel can be narrow. Focusable so a click on
         empty space can take focus from an edit box, which commits it. -->
    <UserControl.Styles>
        <StyleInclude Source="avares://ChartPacker.UI/Styles/Inspector.axaml" />
        <Style Selector="TextBlock.section-heading">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style Selector="Border.section">
            <Setter Property="Background" Value="{DynamicResource ToolbarGroupBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="StackPanel.field">
            <Setter Property="Spacing" Value="4" />
        </Style>
        <!-- A part's rating while the part is unticked: faded, as it can't be picked. -->
        <Style Selector="Button.preset:disabled Border.presetFace">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- A song.ini tier, 0 to 6 and up; unset is grey. -->
        <conv:DifficultyBrushConverter x:Key="DifficultyTierBrush"
                                       Level0="{StaticResource DifficultyTier0Brush}"
                                       Level1="{StaticResource DifficultyTier1Brush}"
                                       Level2="{StaticResource DifficultyTier2Brush}"
                                       Level3="{StaticResource DifficultyTier3Brush}"
                                       Level4="{StaticResource DifficultyTier4Brush}"
                                       Level5="{StaticResource DifficultyTier5Brush}"
                                       Level6="{StaticResource DifficultyTier6Brush}"
                                       Fallback="{StaticResource DifficultyUnsetBrush}" />
        <!-- A part's rating: its tier's swatch, ? while it's unrated, as the flyout it opens shows each tier. -->
        <DataTemplate x:Key="RatingTemplate" x:DataType="vm:ChartRatingViewModel">
            <Button Classes="preset"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{x:Static res:Strings.ChartSettingsDifficultyToolTip}"
                    AutomationProperties.Name="{Binding Name}">
                <Border Classes="presetFace"
                        Classes.unset="{Binding Tier, Converter={x:Static ObjectConverters.IsNull}}"
                        Background="{Binding Tier, Converter={StaticResource DifficultyTierBrush}}">
                    <TextBlock Text="{Binding Text}" />
                </Border>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <uiviews:DifficultyPicker />
                    </Flyout>
                </Button.Flyout>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,14" Spacing="10">
            <!-- A row per part: ticked when the chart has it, with its rating beside it, which opens the inspector's
                 difficulty flyout. -->
            <TextBlock Classes="section-heading" Text="{x:Static res:Strings.ChartSettingsSectionParts}" />
            <Border Classes="section">
                <StackPanel Spacing="8" Grid.IsSharedSizeScope="True">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="PartRating" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="2" Classes="muted" FontSize="12" Text="{x:Static res:Strings.ChartSettingsDifficultyHeader}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ChartSettings.Parts}"
                                  AutomationProperties.Name="{x:Static res:Strings.ChartSettingsSectionParts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChartPartRowViewModel">
                                <StackPanel Spacing="4" Margin="0,2">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="PartRating" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Classes="marker" VerticalAlignment="Center" Text="{Binding Marker}" />
                                        <CheckBox Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Content="{Binding Label}"
                                                  IsChecked="{Binding IsChecked}"
                                                  ToolTip.Tip="{x:Static res:Strings.ChartSettingsPartToolTip}" />
                                        <ContentControl Grid.Column="2"
                                                        Content="{Binding Rating}"
                                                        ContentTemplate="{StaticResource RatingTemplate}"
                                                        IsEnabled="{Binding IsChecked}" />
                                    </Grid>
                                    <!-- Pro drums have a rating of their own, diff_drums_real, beside the drums'. -->
                                    <Grid ColumnSpacing="6" IsVisible="{Binding HasProDifficulty}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="PartRating" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1"
                                                   Margin="28,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="{x:Static res:Strings.ChartSettingsProDrumsDifficultyLabel}" />
                                        <ContentControl Grid.Column="2"
                                                        Content="{Binding ProRating}"
                                                        ContentTemplate="{StaticResource RatingTemplate}"
                                                        IsEnabled="{Binding IsChecked}" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Classes="field" IsVisible="{Binding ChartSettings.HasDrums}">
                        <TextBlock Text="{x:Static res:Strings.ChartSettingsDrumsLabel}" />
                        <ComboBox MinWidth="120"
                                  ItemsSource="{Binding ChartSettings.DrumsVariants}"
                                  SelectedItem="{Binding ChartSettings.SelectedDrums}"
                                  ToolTip.Tip="{x:Static res:Strings.ChartSettingsDrumsToolTip}"
                                  AutomationProperties.Name="{x:Static res:Strings.ChartSettingsDrumsLabel}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The song's metadata, as Chart Packer's inspector edits it; Revert and Remove are on a row's right-click menu. -->
            <TextBlock Classes="section-heading" Text="{x:Static res:Strings.ChartSettingsSectionMetadata}" />
            <Border Classes="section">
                <uiviews:MetadataEditorView DataContext="{Binding Metadata.MetadataEditor}" />
            </Border>

            <!-- The song's tracks, with their mix; Replace and Remove are on a row's right-click menu. -->
            <TextBlock Classes="section-heading" Text="{x:Static res:Strings.ChartSettingsSectionTracks}" />
            <Border Classes="section">
                <StackPanel Spacing="4">
                    <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12" Text="{x:Static res:Strings.ChartSettingsTracksNote}" />
                    <uiviews:TrackListView Tracks="{Binding Tracks.Tracks}"
                                           RemovedTracks="{Binding Tracks.RemovedTracks}"
                                           AddTrackOptions="{Binding Tracks.AddTrackOptions}"
                                           CanEdit="{Binding Tracks.CanEdit}"
                                           ActionsInContextMenu="True"
                                           PositionSeconds="{Binding Playback.PositionSeconds}"
                                           LengthSeconds="{Binding Playback.LengthSeconds}"
                                           ReplaceTrackCommand="{Binding Tracks.ReplaceTrackCommand}"
                                           RemoveTrackCommand="{Binding Tracks.RemoveTrackCommand}"
                                           RestoreTrackCommand="{Binding Tracks.RestoreTrackCommand}" />
                    <TextBlock Classes="error" Text="{Binding Tracks.Error}" IsVisible="{Binding Tracks.HasError}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
