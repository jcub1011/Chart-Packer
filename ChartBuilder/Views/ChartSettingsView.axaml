<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChartBuilder.ViewModels"
             xmlns:res="using:ChartBuilder.Resources"
             xmlns:ui="using:ChartShared.UI.Controls"
             xmlns:uiviews="using:ChartShared.UI.Views"
             xmlns:conv="using:ChartShared.UI.Converters"
             xmlns:bctl="using:ChartBuilder.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="900"
             x:Class="ChartBuilder.Views.ChartSettingsView"
             x:DataType="vm:EditorWindowViewModel"
             Focusable="True"
             FocusAdorner="{x:Null}"
             ui:CommitOnClickAway.IsEnabled="True">

    <!-- Chart settings (charter-spec C1): everything a chart needs, each change an undo step as it's made: the parts, a
         row each with its rating; the song's metadata, as Chart Packer's inspector edits it; and its tracks, with their
         mix. The timing (the resolution, the delay and the tempo map) is in the Tempo map tab. Each field's label is above it, as the panel can be narrow. Focusable so a click on
         empty space can take focus from an edit box, which commits it. -->
    <UserControl.Styles>
        <StyleInclude Source="avares://ChartShared.UI/Styles/Inspector.axaml" />
        <Style Selector="StackPanel.field">
            <Setter Property="Spacing" Value="4" />
        </Style>
        <!-- A part's rating while the part is off: faded, as it can't be picked. -->
        <Style Selector="Button.preset:disabled Border.presetFace">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <!-- The parts: a row each, part of the section rather than a box in it, the part's checkbox at its left and its
             rating at its right, lit under the pointer. The checkbox keeps the theme's height: its box sits in a slot that
             tall at its top, so a taller checkbox would leave the box above its label. -->
        <Style Selector="Border.partRow">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,0,6,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.partRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource ToolHoverBrush}" />
        </Style>
        <Style Selector="Border.partRow CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <!-- The rating swatch reads smaller in a row than in the difficulty flyout. -->
        <Style Selector="Border.partRow Border.presetFace">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Border.partRow Border.presetFace TextBlock">
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- A song.ini tier, 0 to 6 and up; unset is grey. -->
        <conv:DifficultyBrushConverter x:Key="DifficultyTierBrush"
                                       Level0="{StaticResource DifficultyTier0Brush}"
                                       Level1="{StaticResource DifficultyTier1Brush}"
                                       Level2="{StaticResource DifficultyTier2Brush}"
                                       Level3="{StaticResource DifficultyTier3Brush}"
                                       Level4="{StaticResource DifficultyTier4Brush}"
                                       Level5="{StaticResource DifficultyTier5Brush}"
                                       Level6="{StaticResource DifficultyTier6Brush}"
                                       Fallback="{StaticResource DifficultyUnsetBrush}" />
        <!-- A part's rating: its tier's swatch, ? while it's unrated, as the flyout it opens shows each tier. -->
        <DataTemplate x:Key="RatingTemplate" x:DataType="vm:ChartRatingViewModel">
            <Button Classes="preset"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{x:Static res:Strings.ChartSettingsDifficultyToolTip}"
                    AutomationProperties.Name="{Binding Name}">
                <Border Classes="presetFace"
                        Classes.unset="{Binding Tier, Converter={x:Static ObjectConverters.IsNull}}"
                        Background="{Binding Tier, Converter={StaticResource DifficultyTierBrush}}">
                    <TextBlock Text="{Binding Text}" />
                </Border>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <uiviews:DifficultyPicker />
                    </Flyout>
                </Button.Flyout>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <bctl:PanelSectionStack TabKey="chart-settings">
            <!-- A row per part: checked when the chart has it, with its rating at its right, which opens the inspector's
                 difficulty flyout. Drums are three rows sharing one part: 4-lane, Pro and 5-lane, one checked at a time. -->
            <bctl:PanelSection Key="parts" Header="{x:Static res:Strings.ChartSettingsSectionParts}" Padding="4,4,4,12">
                <StackPanel Spacing="8">
                    <ItemsControl Classes="parts"
                                  ItemsSource="{Binding ChartSettings.PartChips}"
                                  AutomationProperties.Name="{x:Static res:Strings.ChartSettingsSectionParts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChartPartChipViewModel">
                                <Border Classes="partRow">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                        <CheckBox Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  Content="{Binding Label}"
                                                  IsChecked="{Binding IsChecked}"
                                                  ToolTip.Tip="{x:Static res:Strings.ChartSettingsPartToolTip}"
                                                  AutomationProperties.Name="{Binding Label}" />
                                        <!-- A change not saved yet. -->
                                        <TextBlock Grid.Column="1"
                                                   Classes="marker"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Marker}"
                                                   IsVisible="{Binding Marker, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        <ContentControl Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Content="{Binding Rating}"
                                                        ContentTemplate="{StaticResource RatingTemplate}"
                                                        IsEnabled="{Binding IsChecked}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="muted"
                               Margin="8,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Text="{x:Static res:Strings.ChartSettingsDrumsToolTip}"
                               IsVisible="{Binding ChartSettings.HasDrums}" />
                </StackPanel>
            </bctl:PanelSection>

            <!-- The song's metadata, as Chart Packer's inspector edits it. -->
            <bctl:PanelSection Key="metadata" Header="{x:Static res:Strings.ChartSettingsSectionMetadata}" Padding="12,8,12,12">
                <uiviews:MetadataEditorView DataContext="{Binding Metadata.MetadataEditor}" />
            </bctl:PanelSection>

            <!-- The song's tracks, with their mix; Replace and Remove are on a row's right-click menu. -->
            <bctl:PanelSection Key="tracks" Header="{x:Static res:Strings.ChartSettingsSectionTracks}" Padding="12,8,12,12">
                <StackPanel Spacing="4">
                    <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12" Text="{x:Static res:Strings.ChartSettingsTracksNote}" />
                    <uiviews:TrackListView Tracks="{Binding Tracks.Tracks}"
                                           RemovedTracks="{Binding Tracks.RemovedTracks}"
                                           AddTrackOptions="{Binding Tracks.AddTrackOptions}"
                                           CanEdit="{Binding Tracks.CanEdit}"
                                           ActionsInContextMenu="True"
                                           PositionSeconds="{Binding Playback.PositionSeconds}"
                                           LengthSeconds="{Binding Playback.LengthSeconds}"
                                           ReplaceTrackCommand="{Binding Tracks.ReplaceTrackCommand}"
                                           RemoveTrackCommand="{Binding Tracks.RemoveTrackCommand}"
                                           RestoreTrackCommand="{Binding Tracks.RestoreTrackCommand}" />
                    <TextBlock Classes="error" Text="{Binding Tracks.Error}" IsVisible="{Binding Tracks.HasError}" />
                </StackPanel>
            </bctl:PanelSection>
        </bctl:PanelSectionStack>
    </ScrollViewer>
</UserControl>
