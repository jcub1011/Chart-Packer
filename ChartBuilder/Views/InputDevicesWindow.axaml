<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChartBuilder.ViewModels"
        xmlns:res="using:ChartBuilder.Resources"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
        x:Class="ChartBuilder.Views.InputDevicesWindow"
        x:DataType="vm:InputDevicesViewModel"
        Icon="/Assets/ChartBuilder.ico"
        Title="{x:Static res:Strings.InputDevicesWindowTitle}"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        Width="900" Height="640"
        MinWidth="680" MinHeight="480">

    <!-- The Input devices window (charter-spec C19 item 2): the devices on the left, each profile's actions and the
         controls bound to them on the right. Bind takes the next control pressed on any device. -->
    <Window.Styles>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Border.chip.missing">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Button.chip-remove">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="ToggleButton.bind">
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="16">
        <!-- What Bind did, and the question when a control another action has was pressed. -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,12,0,0">
            <TextBlock Grid.Column="0"
                       Text="{Binding Status}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasPendingMove}">
                <Button Content="{x:Static res:Strings.InputMoveConfirm}" Command="{Binding ConfirmMoveCommand}" />
                <Button Content="{x:Static res:Strings.InputMoveCancel}" Command="{Binding CancelMoveCommand}" />
            </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="320,*" ColumnSpacing="16">
            <!-- The devices: a meter of what each is doing, and its own settings. -->
            <DockPanel Grid.Column="0">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Classes="heading" VerticalAlignment="Center" Text="{x:Static res:Strings.InputDevicesHeading}" />
                    <Button Grid.Column="1"
                            Classes="labelled"
                            Content="{x:Static res:Strings.InputRescanButton}"
                            ToolTip.Tip="{x:Static res:Strings.InputRescanToolTip}"
                            Command="{Binding RescanCommand}" />
                </Grid>
                <TextBlock DockPanel.Dock="Bottom"
                           Classes="muted"
                           FontSize="12"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Text="{x:Static res:Strings.InputDevicesHint}" />
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:InputDeviceRow">
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip.Tip="{Binding Name}" />
                                            <ProgressBar Grid.Column="1"
                                                         Width="56"
                                                         MinWidth="0"
                                                         Height="6"
                                                         Minimum="0"
                                                         Maximum="1"
                                                         VerticalAlignment="Center"
                                                         Value="{Binding Activity}"
                                                         AutomationProperties.Name="{x:Static res:Strings.InputActivityLabel}" />
                                        </Grid>
                                        <TextBlock Classes="caption" Text="{Binding Detail}" Classes.warning="{Binding HasProblem}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasOffset}">
                                            <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.InputOffsetLabel}" ToolTip.Tip="{x:Static res:Strings.InputOffsetToolTip}" />
                                            <NumericUpDown Grid.Column="1" Width="110" Minimum="-250" Maximum="250" Increment="1"
                                                           ParsingNumberStyle="Integer" FormatString="0" ClipValueToMinMax="True"
                                                           Value="{Binding OffsetMs}"
                                                           AutomationProperties.Name="{x:Static res:Strings.InputOffsetLabel}" />
                                        </Grid>
                                        <!-- A MIDI device's velocities: the floor against crosstalk, the retrigger time, and accents and ghosts. -->
                                        <Expander Header="{x:Static res:Strings.InputMidiSettings}" IsVisible="{Binding IsMidi}" HorizontalAlignment="Stretch">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                                <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="{x:Static res:Strings.InputMinVelocityLabel}" ToolTip.Tip="{x:Static res:Strings.InputMinVelocityToolTip}" />
                                                <NumericUpDown Grid.Row="0" Grid.Column="1" Width="110" Minimum="1" Maximum="127" Increment="1" ParsingNumberStyle="Integer" FormatString="0" ClipValueToMinMax="True" Value="{Binding MinVelocity}" />
                                                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{x:Static res:Strings.InputRetriggerLabel}" ToolTip.Tip="{x:Static res:Strings.InputRetriggerToolTip}" />
                                                <NumericUpDown Grid.Row="1" Grid.Column="1" Width="110" Minimum="0" Maximum="100" Increment="1" ParsingNumberStyle="Integer" FormatString="0" ClipValueToMinMax="True" Value="{Binding RetriggerMs}" />
                                                <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="{x:Static res:Strings.InputAccentLabel}" />
                                                <NumericUpDown Grid.Row="2" Grid.Column="1" Width="110" Minimum="1" Maximum="127" Increment="1" ParsingNumberStyle="Integer" FormatString="0" ClipValueToMinMax="True" Value="{Binding AccentVelocity}" />
                                                <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="{x:Static res:Strings.InputGhostLabel}" />
                                                <NumericUpDown Grid.Row="3" Grid.Column="1" Width="110" Minimum="0" Maximum="126" Increment="1" ParsingNumberStyle="Integer" FormatString="0" ClipValueToMinMax="True" Value="{Binding GhostVelocity}" />
                                            </Grid>
                                        </Expander>
                                        <Button Classes="labelled"
                                                Content="{x:Static res:Strings.InputPresetGeneralMidiButton}"
                                                ToolTip.Tip="{x:Static res:Strings.InputPresetGeneralMidiToolTip}"
                                                IsVisible="{Binding IsMidi}"
                                                Command="{Binding UseGeneralMidiCommand}" />
                                        <Button Classes="labelled"
                                                Content="{x:Static res:Strings.InputPresetGuitarButton}"
                                                ToolTip.Tip="{x:Static res:Strings.InputPresetGuitarToolTip}"
                                                IsVisible="{Binding IsController}"
                                                Command="{Binding UseGuitarLayoutCommand}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- Each profile's actions, and the controls bound to each. -->
            <TabControl Grid.Column="1" ItemsSource="{Binding Profiles}">
                <TabControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InputProfileTab">
                        <TextBlock Text="{Binding Header}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:InputProfileTab">
                        <DockPanel>
                            <Button DockPanel.Dock="Bottom"
                                    HorizontalAlignment="Right"
                                    Margin="0,8,0,0"
                                    Classes="labelled"
                                    Content="{x:Static res:Strings.InputResetProfileButton}"
                                    Command="{Binding $parent[Window].((vm:InputDevicesViewModel)DataContext).ResetProfileCommand}"
                                    CommandParameter="{Binding}" />
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding Actions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:InputActionRow">
                                            <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="12" MinHeight="32">
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Label}" />
                                                <ItemsControl Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding Chips}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel ItemSpacing="6" LineSpacing="4" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:InputBindingChip">
                                                            <Border Classes="chip" Classes.missing="{Binding !IsConnected}" ToolTip.Tip="{Binding ToolTip}">
                                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                                    <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                                                                    <Button Classes="chip-remove"
                                                                            Content="✕"
                                                                            ToolTip.Tip="{x:Static res:Strings.InputRemoveBindingToolTip}"
                                                                            AutomationProperties.Name="{x:Static res:Strings.InputRemoveBindingToolTip}"
                                                                            Command="{Binding $parent[Window].((vm:InputDevicesViewModel)DataContext).RemoveBindingCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ToggleButton Grid.Column="2"
                                                              Classes="bind"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding IsListening, Mode=OneWay}"
                                                              Content="{Binding BindText}"
                                                              Command="{Binding $parent[Window].((vm:InputDevicesViewModel)DataContext).BindCommand}"
                                                              CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
