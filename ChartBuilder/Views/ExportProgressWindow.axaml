<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ChartBuilder.ViewModels"
        xmlns:res="using:ChartBuilder.Resources"
        xmlns:sres="using:ChartShared.UI.Resources"
        mc:Ignorable="d"
        x:Class="ChartBuilder.Views.ExportProgressWindow"
        x:DataType="vm:ExportProgressViewModel"
        Title="{x:Static res:Strings.ExportProgressTitle}"
        Background="{DynamicResource AppBackgroundBrush}"
        SizeToContent="Height"
        Width="440"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!-- Export progress: what Pack is doing after the export dialog closes, with Cancel. -->
    <StackPanel Margin="20" Spacing="14">
        <TextBlock VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{Binding StatusText}"
                   AutomationProperties.Name="{Binding StatusText}" />
        <ProgressBar Minimum="0"
                     Maximum="100"
                     Value="{Binding ProgressValue}"
                     ShowProgressText="False"
                     AutomationProperties.Name="{Binding StatusText}" />
        <!-- Cancel stops the export; nothing is written. -->
        <Button HorizontalAlignment="Right"
                MinWidth="80"
                HorizontalContentAlignment="Center"
                Content="{x:Static sres:SharedStrings.CancelButton}"
                Command="{Binding CancelCommand}"
                AutomationProperties.Name="{x:Static sres:SharedStrings.CancelButton}" />
    </StackPanel>
</Window>
