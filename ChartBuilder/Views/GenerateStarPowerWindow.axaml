<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChartBuilder.ViewModels"
        xmlns:res="using:ChartBuilder.Resources"
        xmlns:sres="using:ChartShared.UI.Resources"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="260"
        x:Class="ChartBuilder.Views.GenerateStarPowerWindow"
        x:DataType="vm:GenerateStarPowerViewModel"
        Icon="/Assets/ChartBuilder.ico"
        Title="{Binding Title}"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        Width="360">

    <!-- Generate star power's options (charter-spec C8 item 1), from a 5-fret or keys lane's Edit menu. -->
    <StackPanel Margin="20" Spacing="14">
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{x:Static res:Strings.GenerateStarPowerIntro}" />

        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{x:Static res:Strings.GenerateStarPowerSpacingLabel}" />
            <NumericUpDown Grid.Row="0"
                           Grid.Column="1"
                           Value="{Binding Spacing}"
                           Minimum="10"
                           Maximum="60"
                           Increment="5"
                           FormatString="0"
                           ParsingNumberStyle="Integer"
                           ToolTip.Tip="{x:Static res:Strings.GenerateStarPowerSpacingToolTip}"
                           AutomationProperties.Name="{x:Static res:Strings.GenerateStarPowerSpacingLabel}" />
            <CheckBox Grid.Row="1"
                      Grid.Column="0"
                      Grid.ColumnSpan="2"
                      Content="{x:Static res:Strings.GenerateStarPowerSpikesLabel}"
                      IsChecked="{Binding PlanForSpikes}"
                      ToolTip.Tip="{x:Static res:Strings.GenerateStarPowerSpikesToolTip}" />
            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{x:Static res:Strings.GenerateScopeLabel}" />
            <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Text="{Binding ScopeText}" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="accent"
                    Content="{x:Static res:Strings.GenerateButton}"
                    IsDefault="True"
                    Click="OnGenerate"
                    AutomationProperties.Name="{x:Static res:Strings.GenerateButton}" />
            <Button Content="{x:Static sres:SharedStrings.CancelButton}"
                    IsCancel="True"
                    Click="OnCancel"
                    AutomationProperties.Name="{x:Static sres:SharedStrings.CancelButton}" />
        </StackPanel>
    </StackPanel>
</Window>
