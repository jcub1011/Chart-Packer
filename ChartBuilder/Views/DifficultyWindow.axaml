<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChartBuilder.ViewModels"
        xmlns:res="using:ChartBuilder.Resources"
        xmlns:views="using:ChartBuilder.Views"
        xmlns:ui="using:ChartShared.UI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
        x:Class="ChartBuilder.Views.DifficultyWindow"
        x:DataType="vm:DifficultyViewModel"
        Icon="/Assets/ChartBuilder.ico"
        Title="{x:Static res:Strings.DifficultyWindowTitle}"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        Width="900"
        Height="640"
        MinWidth="420"
        MinHeight="400"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        WindowDecorationsTheme="{StaticResource TitleBarDecorations}">

    <!-- The difficulty analysis in a window of its own, wide enough for the graph to show the song in detail. Space plays
         or pauses. -->
    <Grid RowDefinitions="Auto,*">
        <!-- The title bar, as the Editor's is: the icon and the title. -->
        <ui:TitleBar x:Name="WindowTitleBar"
                     Grid.Row="0"
                     Height="31"
                     BorderThickness="0,0,0,1"
                     BorderBrush="{DynamicResource SubtleBorderBrush}">
            <TextBlock Margin="8,0,12,0"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Text="{x:Static res:Strings.DifficultyWindowTitle}" />
        </ui:TitleBar>
        <!-- Already in a window of its own, it doesn't offer to open one. -->
        <views:DifficultyView Grid.Row="1" CanPopOut="False" />
    </Grid>
</Window>
