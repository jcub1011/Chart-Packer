<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChartBuilder.ViewModels"
        xmlns:res="using:ChartBuilder.Resources"
        xmlns:ctl="using:ChartPacker.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="520"
        x:Class="ChartBuilder.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{x:Static res:Strings.AppName}"
        Background="{DynamicResource AppBackgroundBrush}"
        Width="760" Height="520"
        MinWidth="480" MinHeight="360">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewChartCommand}" />
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <!-- The home screen's tiles: a large line icon over its label, outlined like a toolbar group.
             "primary" is the main action, tinted like a checked toolbar button. Tooltips show even when
             disabled, so a tile that isn't available yet can say why. -->
        <Style Selector="Button.launch">
            <Setter Property="Width" Value="132" />
            <Setter Property="Height" Value="112" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource ToolbarGroupBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
        </Style>
        <Style Selector="Button.launch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#232431" />
            <Setter Property="BorderBrush" Value="#4A4D66" />
        </Style>
        <Style Selector="Button.launch:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="#4A4D66" />
        </Style>
        <Style Selector="Button.launch:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        </Style>
        <Style Selector="Button.launch.primary">
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
            <Setter Property="BorderBrush" Value="#668B5CF6" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style Selector="Button.launch.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#558B5CF6" />
            <Setter Property="BorderBrush" Value="#998B5CF6" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style Selector="Button.launch.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
            <Setter Property="BorderBrush" Value="#998B5CF6" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style Selector="Button.launch TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <!-- The home screen (charter-spec §8). The chart editor replaces it once a song is open. -->
    <Grid RowDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="480"
                    Margin="24"
                    Spacing="12">
            <TextBlock HorizontalAlignment="Center"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Text="{x:Static res:Strings.AppName}" />
            <TextBlock Classes="muted centered" Text="{x:Static res:Strings.HomeTagline}" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,0"
                        Spacing="12">
                <Button Classes="launch primary"
                        Command="{Binding NewChartCommand}"
                        ToolTip.Tip="{x:Static res:Strings.HomeNewChartToolTip}"
                        AutomationProperties.Name="{x:Static res:Strings.HomeNewChartButton}">
                    <StackPanel Spacing="10">
                        <Viewbox Width="32" Height="32">
                            <ctl:LineIcon Data="{StaticResource NewChartStroke}" StrokeThickness="1.25" />
                        </Viewbox>
                        <TextBlock Text="{x:Static res:Strings.HomeNewChartButton}" />
                    </StackPanel>
                </Button>
                <!-- Disabled until Chart Builder can open songs (CM2), which binds it to an open command. -->
                <Button Classes="launch"
                        IsEnabled="False"
                        ToolTip.Tip="{x:Static res:Strings.HomeOpenChartComingToolTip}"
                        AutomationProperties.Name="{x:Static res:Strings.HomeOpenChartButton}">
                    <StackPanel Spacing="10">
                        <Viewbox Width="32" Height="32">
                            <ctl:LineIcon Data="{StaticResource InputFolderStroke}" StrokeThickness="1.25" />
                        </Viewbox>
                        <TextBlock Text="{x:Static res:Strings.HomeOpenChartButton}" />
                    </StackPanel>
                </Button>
                <Button Classes="launch"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip.Tip="{x:Static res:Strings.HomeSettingsToolTip}"
                        AutomationProperties.Name="{x:Static res:Strings.HomeSettingsButton}">
                    <StackPanel Spacing="10">
                        <Viewbox Width="32" Height="32">
                            <ctl:LineIcon Data="{StaticResource SettingsStroke}" StrokeThickness="1.25" />
                        </Viewbox>
                        <TextBlock Text="{x:Static res:Strings.HomeSettingsButton}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Border Classes="banner"
                    Classes.error="{Binding IsError}"
                    Margin="0,8,0,0"
                    IsVisible="{Binding HasMessage}">
                <SelectableTextBlock TextWrapping="Wrap" Text="{Binding Message}" />
            </Border>
        </StackPanel>

        <!-- The hint, in a strip along the bottom like Chart Packer's notice bar. -->
        <Border Grid.Row="1"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource ToolbarBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}"
                Padding="12,6">
            <TextBlock Classes="muted centered" Text="{x:Static res:Strings.HomeHint}" />
        </Border>
    </Grid>
</Window>
