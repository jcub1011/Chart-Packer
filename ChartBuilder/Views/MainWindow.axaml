<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChartBuilder.ViewModels"
        xmlns:res="using:ChartBuilder.Resources"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="520"
        x:Class="ChartBuilder.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{x:Static res:Strings.AppName}"
        Background="{DynamicResource AppBackgroundBrush}"
        Width="760" Height="520"
        MinWidth="480" MinHeight="360">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewChartCommand}" />
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}" />
    </Window.KeyBindings>

    <!-- The home screen (charter-spec §8). The chart editor replaces it once a song is open. -->
    <Grid RowDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="480"
                    Margin="24"
                    Spacing="12">
            <TextBlock HorizontalAlignment="Center"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Text="{x:Static res:Strings.AppName}" />
            <TextBlock Classes="muted centered" Text="{x:Static res:Strings.HomeTagline}" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"
                        Spacing="8">
                <Button Classes="accent"
                        Content="{x:Static res:Strings.HomeNewChartButton}"
                        Command="{Binding NewChartCommand}"
                        ToolTip.Tip="{x:Static res:Strings.HomeNewChartToolTip}" />
                <Button Content="{x:Static res:Strings.HomeSettingsButton}"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip.Tip="{x:Static res:Strings.HomeSettingsToolTip}" />
            </StackPanel>
            <Border Classes="banner"
                    Classes.error="{Binding IsError}"
                    Margin="0,8,0,0"
                    IsVisible="{Binding HasMessage}">
                <SelectableTextBlock TextWrapping="Wrap" Text="{Binding Message}" />
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Classes="muted centered"
                   Margin="24,0,24,16"
                   Text="{x:Static res:Strings.HomeHint}" />
    </Grid>
</Window>
