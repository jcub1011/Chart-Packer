<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChartBuilder.ViewModels"
             xmlns:res="using:ChartBuilder.Resources"
             xmlns:ui="using:ChartPacker.UI.Controls"
             xmlns:uiviews="using:ChartPacker.UI.Views"
             xmlns:sres="using:ChartPacker.Resources"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="700"
             x:Class="ChartBuilder.Views.ChartInspectorView"
             x:DataType="vm:ChartInspectorViewModel"
             Focusable="True"
             FocusAdorner="{x:Null}"
             ui:CommitOnClickAway.IsEnabled="True">

    <!-- The Chart Inspector (charter-spec C1, §4.5), laid out like Chart Packer's inspector (SongDetailView) without the
         background, note highway and lyric lane, which the editor itself shows. The metadata, ratings, delay and album
         art are edited here, each a pending change until the song is saved; the tracks and files are listed.
         Focusable so a click on empty space can take focus from an edit box, which commits it. -->
    <UserControl.Styles>
        <StyleInclude Source="avares://ChartPacker.UI/Styles/Inspector.axaml" />
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.detail">
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,14">
            <SelectableTextBlock FontSize="18"
                                 FontWeight="SemiBold"
                                 TextWrapping="Wrap"
                                 Text="{Binding Title}" />
            <TextBlock Classes="muted note"
                       Margin="0,2,0,0"
                       ui:RichTextMarkup.Prefix="{x:Static res:Strings.InspectorCharterPrefix}"
                       ui:RichTextMarkup.Text="{Binding Charter}"
                       IsVisible="{Binding HasCharter}" />
            <TextBlock Classes="muted note"
                       Margin="0,2,0,0"
                       Text="{Binding Subtitle}"
                       ToolTip.Tip="{Binding Subtitle}" />

            <!-- The album art tile, with its caption and actions below: Replace, Remove, then Undo while there's a change. -->
            <StackPanel Margin="0,16,0,0" Spacing="6" HorizontalAlignment="Left" MaxWidth="260">
                <Border Classes="artTile" Width="128" Height="128">
                    <Panel>
                        <Image Source="{Binding ArtImage}" Stretch="Uniform" IsVisible="{Binding HasArtImage}" />
                        <StackPanel VerticalAlignment="Center" Spacing="6" IsVisible="{Binding !HasArtImage}">
                            <PathIcon Width="36" Height="36" Opacity="0.35" Data="{StaticResource AlbumArtIconGeometry}" />
                            <TextBlock Classes="muted note"
                                       Margin="8,0"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Text="{Binding ArtNote}" />
                        </StackPanel>
                    </Panel>
                </Border>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                    <TextBlock Grid.Column="0" Classes="marker" VerticalAlignment="Center" Text="{Binding ArtMarker}" />
                    <TextBlock Grid.Column="1"
                               Classes="muted note artName"
                               VerticalAlignment="Center"
                               Text="{Binding ArtFileName, TargetNullValue={x:Static res:Strings.InspectorAlbumArt}}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" IsVisible="{Binding CanEdit}">
                        <Button Classes="captionAction"
                                Command="{Binding ReplaceArtCommand}"
                                ToolTip.Tip="{x:Static res:Strings.InspectorReplaceArtToolTip}"
                                AutomationProperties.Name="{x:Static res:Strings.InspectorReplaceArtToolTip}">
                            <PathIcon Data="{StaticResource ReplaceIconGeometry}" />
                        </Button>
                        <Button Classes="captionAction"
                                Command="{Binding RemoveArtCommand}"
                                ToolTip.Tip="{x:Static res:Strings.InspectorRemoveArtToolTip}"
                                AutomationProperties.Name="{x:Static res:Strings.InspectorRemoveArtToolTip}">
                            <PathIcon Data="{StaticResource TrashIconGeometry}" />
                        </Button>
                        <!-- Hidden by Button.captionAction.revert:disabled unless there's a change to undo. -->
                        <Button Classes="captionAction revert"
                                Command="{Binding RevertArtCommand}"
                                ToolTip.Tip="{x:Static res:Strings.InspectorRevertArtToolTip}"
                                AutomationProperties.Name="{x:Static res:Strings.InspectorRevertArtToolTip}">
                            <PathIcon Data="{StaticResource RevertIconGeometry}" />
                        </Button>
                    </StackPanel>
                </Grid>
                <TextBlock Classes="error" Text="{Binding ArtError}" IsVisible="{Binding HasArtError}" />
            </StackPanel>

            <!-- The tracks, with the delay: how much later than its notes the chart plays against them. -->
            <TextBlock Classes="section" Text="{x:Static res:Strings.InspectorTracksHeading}" />
            <StackPanel Spacing="4" Margin="0,0,0,8">
                <TextBlock Text="{x:Static res:Strings.InspectorDelayLabel}" />
                <NumericUpDown HorizontalAlignment="Left"
                               Width="160"
                               Value="{Binding DelayMs}"
                               Increment="1"
                               Minimum="-86399999"
                               Maximum="86399999"
                               FormatString="0"
                               IsEnabled="{Binding CanEdit}"
                               ToolTip.Tip="{x:Static res:Strings.InspectorDelayToolTip}"
                               AutomationProperties.Name="{x:Static res:Strings.InspectorDelayLabel}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Tracks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InspectorFileRow">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2">
                            <StackPanel Grid.Column="0">
                                <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip.Tip="{Binding Name}" />
                                <TextBlock Classes="muted detail" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Classes="muted note" VerticalAlignment="Center" Text="{Binding Size}" IsVisible="{Binding HasSize}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="muted note" Text="{x:Static res:Strings.InspectorNoTracks}" IsVisible="{Binding HasNoTracks}" />

            <TextBlock Classes="section" Text="{x:Static res:Strings.InspectorChartFilesHeading}" />
            <ItemsControl ItemsSource="{Binding ChartFiles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InspectorFileRow">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2">
                            <TextBlock Grid.Column="0" TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip.Tip="{Binding Name}" />
                            <TextBlock Grid.Column="1" Classes="muted note" Text="{Binding Size}" IsVisible="{Binding HasSize}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="muted note" Text="{x:Static res:Strings.InspectorNoChartFiles}" IsVisible="{Binding HasNoChartFiles}" />
            <TextBlock Classes="muted note" Margin="0,4,0,0" Text="{x:Static res:Strings.InspectorImportNote}" IsVisible="{Binding IsImport}" />

            <TextBlock Classes="section" Text="{x:Static res:Strings.InspectorOtherFilesHeading}" />
            <ItemsControl ItemsSource="{Binding OtherFiles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InspectorFileRow">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2">
                            <TextBlock Grid.Column="0" TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip.Tip="{Binding Name}" />
                            <TextBlock Grid.Column="1" Classes="muted note" Text="{Binding Size}" IsVisible="{Binding HasSize}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="muted note" Text="{x:Static res:Strings.InspectorNoOtherFiles}" IsVisible="{Binding HasNoOtherFiles}" />
            <TextBlock Classes="muted note" Margin="0,6,0,0" Text="{x:Static res:Strings.InspectorFilesReadOnlyNote}" />

            <!-- The findings counted, not listed (GitHub issue #53): View issues lists them in a window of their own. -->
            <TextBlock Classes="section" Text="{x:Static res:Strings.InspectorFindingsHeading}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,4">
                <TextBlock Grid.Column="0" Classes="note" VerticalAlignment="Center" Text="{Binding Findings.Issues.Headline}" />
                <Button Grid.Column="1"
                        Classes="labelled"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Content="{x:Static sres:SharedStrings.ChartIssuesViewButton}"
                        Command="{Binding ViewIssuesCommand}"
                        ToolTip.Tip="{x:Static sres:SharedStrings.ChartIssuesViewToolTip}" />
            </Grid>

            <TextBlock Classes="section" Text="{Binding MetadataEditor.MetadataHeader}" />
            <uiviews:MetadataEditorView DataContext="{Binding MetadataEditor}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
