<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:ChartBuilder.Resources"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="700"
             x:Class="ChartBuilder.Views.ChartInspectorView">

    <!-- The Chart Inspector, laid out like Chart Packer's inspector (SongDetailView) without the background,
         note highway and lyric lane, which the editor itself shows. Only the layout so far: every section is a
         placeholder until the editor has a chart to show. -->
    <UserControl.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Margin" Value="0,22,0,8" />
        </Style>
        <Style Selector="TextBlock.placeholder">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,14">
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Text="{x:Static res:Strings.InspectorNoChart}" />
            <TextBlock Classes="muted placeholder"
                       Margin="0,2,0,0"
                       Text="{x:Static res:Strings.InspectorNoChartPath}" />

            <!-- The album art tile, with its caption below. -->
            <StackPanel Margin="0,16,0,0" Spacing="6" HorizontalAlignment="Left">
                <Border Width="128"
                        Height="128"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                        Background="{DynamicResource ToolbarGroupBrush}">
                    <PathIcon Width="36" Height="36" Opacity="0.35" Data="{StaticResource AlbumArtIconGeometry}" />
                </Border>
                <TextBlock Classes="muted placeholder" Text="{x:Static res:Strings.InspectorAlbumArt}" />
            </StackPanel>

            <TextBlock Classes="section" Text="{x:Static res:Strings.InspectorTracksHeading}" />
            <TextBlock Classes="muted placeholder" Text="{x:Static res:Strings.InspectorSectionPlaceholder}" />

            <TextBlock Classes="section" Text="{x:Static res:Strings.InspectorChartFilesHeading}" />
            <TextBlock Classes="muted placeholder" Text="{x:Static res:Strings.InspectorSectionPlaceholder}" />

            <TextBlock Classes="section" Text="{x:Static res:Strings.InspectorOtherFilesHeading}" />
            <TextBlock Classes="muted placeholder" Text="{x:Static res:Strings.InspectorSectionPlaceholder}" />

            <TextBlock Classes="section" Text="{x:Static res:Strings.InspectorFindingsHeading}" />
            <TextBlock Classes="muted placeholder" Text="{x:Static res:Strings.InspectorSectionPlaceholder}" />

            <TextBlock Classes="section" Text="{x:Static res:Strings.InspectorMetadataHeading}" />
            <TextBlock Classes="muted placeholder" Text="{x:Static res:Strings.InspectorSectionPlaceholder}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
