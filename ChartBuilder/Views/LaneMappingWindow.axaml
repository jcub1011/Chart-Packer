<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChartBuilder.ViewModels"
        xmlns:res="using:ChartBuilder.Resources"
        xmlns:sres="using:ChartShared.UI.Resources"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="320"
        x:Class="ChartBuilder.Views.LaneMappingWindow"
        x:DataType="vm:LaneMappingViewModel"
        Icon="/Assets/ChartBuilder.ico"
        Title="{x:Static res:Strings.LaneMappingTitle}"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        Width="360">

    <!-- A paste between 5-fret and GHL (charter-spec C15 item 3): where each lane of the passage goes. -->
    <StackPanel Margin="20" Spacing="14">
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding Intro}" />

        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LaneMappingRow">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding Label}" />
                        <ComboBox Grid.Column="1" Width="140"
                                  ItemsSource="{Binding Choices}"
                                  SelectedItem="{Binding Target}"
                                  DisplayMemberBinding="{Binding Label, x:DataType=vm:LaneChoice}"
                                  AutomationProperties.Name="{Binding Label}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="accent"
                    Content="{x:Static res:Strings.LaneMappingPasteButton}"
                    IsDefault="True"
                    Click="OnPaste"
                    AutomationProperties.Name="{x:Static res:Strings.LaneMappingPasteButton}" />
            <Button Content="{x:Static sres:SharedStrings.CancelButton}"
                    IsCancel="True"
                    Click="OnCancel"
                    AutomationProperties.Name="{x:Static sres:SharedStrings.CancelButton}" />
        </StackPanel>
    </StackPanel>
</Window>
