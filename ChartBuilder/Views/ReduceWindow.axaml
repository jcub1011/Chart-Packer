<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChartBuilder.ViewModels"
        xmlns:svm="using:ChartShared.UI.ViewModels"
        xmlns:sv="using:ChartShared.UI.Views"
        xmlns:res="using:ChartBuilder.Resources"
        xmlns:sres="using:ChartShared.UI.Resources"
        xmlns:ui="using:ChartShared.UI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="600"
        x:Class="ChartBuilder.Views.ReduceWindow"
        x:DataType="vm:ReduceViewModel"
        Icon="/Assets/ChartBuilder.ico"
        Title="{Binding Title}"
        Background="{DynamicResource AppBackgroundBrush}"
        Width="780" Height="600"
        MinWidth="660" MinHeight="460"
        ShowInTaskbar="False"
        CanMinimize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        WindowDecorationsTheme="{StaticResource TitleBarDecorations}"
        WindowStartupLocation="CenterOwner">

    <!-- Reduce (charter-spec C9 item 2). On the left, what to reduce and by which rules; on the right, the draft as it
         stands, each change drawing it again over the target: its difficulties against each other, and its findings.
         Opened from Settings, it's the left alone, on the defaults. It can't be minimized: a modal window with no taskbar
         entry would have nothing to restore it from. -->
    <Window.Styles>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- The title bar, as the main window's is: the icon (the owner's, set in code) and the title. -->
        <ui:TitleBar x:Name="WindowTitleBar"
                     Grid.Row="0"
                     Height="31"
                     BorderThickness="0,0,0,1"
                     BorderBrush="{DynamicResource SubtleBorderBrush}">
            <TextBlock Margin="8,0,12,0"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding Title}" />
        </ui:TitleBar>

        <!-- The rules, the draft as it stands, and, when it's shown, a splitter and the preview; the code-behind sizes the
             last three as the preview is shown or hidden. -->
        <Grid x:Name="Body" Grid.Row="1" ColumnDefinitions="340,*,Auto,0">
            <!-- What to reduce, and the rules. -->
            <Border x:Name="SetupPane"
                    Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,14,16,16" Spacing="12">
                        <TextBlock Classes="note" Text="{x:Static res:Strings.ReduceIntro}" IsVisible="{Binding IsOne}" />
                        <TextBlock Classes="note" Text="{x:Static res:Strings.ReduceAllIntro}" IsVisible="{Binding IsAll}" />
                        <TextBlock Classes="note" Text="{x:Static res:Strings.ReduceDefaultsIntro}" IsVisible="{Binding IsDefaults}" />

                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="caption" VerticalAlignment="Center"
                                       Text="{x:Static res:Strings.ReduceFamilyLabel}" IsVisible="{Binding IsDefaults}" />
                            <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" IsVisible="{Binding IsDefaults}"
                                      ItemsSource="{Binding FamilyChoices}"
                                      SelectedItem="{Binding SelectedFamily}"
                                      DisplayMemberBinding="{Binding Label, x:DataType=svm:FamilyChoice}"
                                      AutomationProperties.Name="{x:Static res:Strings.ReduceFamilyLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="caption" VerticalAlignment="Center"
                                       Text="{x:Static res:Strings.ReduceToLabel}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding ToChoices}"
                                      SelectedItem="{Binding SelectedTo}"
                                      DisplayMemberBinding="{Binding Label, x:DataType=vm:TargetChoice}"
                                      AutomationProperties.Name="{x:Static res:Strings.ReduceToLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="caption" VerticalAlignment="Center"
                                       Text="{x:Static res:Strings.ReduceFromLabel}" IsVisible="{Binding IsOne}" />
                            <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" IsVisible="{Binding IsOne}"
                                      ItemsSource="{Binding FromChoices}"
                                      SelectedItem="{Binding SelectedFrom}"
                                      DisplayMemberBinding="{Binding Label, x:DataType=svm:DifficultyChoice}"
                                      AutomationProperties.Name="{x:Static res:Strings.ReduceFromLabel}" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Classes="caption" VerticalAlignment="Center"
                                       Text="{x:Static res:Strings.ReduceScopeLabel}" IsVisible="{Binding IsRun}" />
                            <ComboBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" IsVisible="{Binding IsRun}"
                                      ItemsSource="{Binding ScopeChoices}"
                                      SelectedItem="{Binding SelectedScope}"
                                      DisplayMemberBinding="{Binding Label, x:DataType=vm:ScopeChoice}"
                                      AutomationProperties.Name="{x:Static res:Strings.ReduceScopeLabel}" />
                        </Grid>

                        <!-- Reduce all: the difficulties to fill. -->
                        <ItemsControl ItemsSource="{Binding Toggles}" IsVisible="{Binding IsAll}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="16" LineSpacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TargetToggle">
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The rules, for the target, or in Reduce all for the difficulty picked. -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,6,0,0">
                            <TextBlock Classes="heading" VerticalAlignment="Center" Text="{x:Static res:Strings.ReduceRulesHeading}" />
                            <ComboBox Grid.Column="1" Width="132"
                                      IsVisible="{Binding IsAll}"
                                      ItemsSource="{Binding RulesForChoices}"
                                      SelectedItem="{Binding SelectedRulesFor}"
                                      DisplayMemberBinding="{Binding Label, x:DataType=svm:DifficultyChoice}"
                                      ToolTip.Tip="{x:Static res:Strings.ReduceRulesForLabel}"
                                      AutomationProperties.Name="{x:Static res:Strings.ReduceRulesForLabel}" />
                        </Grid>

                        <!-- The rules themselves, as Chart Packer's Generate difficulties shows them too. -->
                        <sv:ReductionRulesView DataContext="{Binding Rules}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- The draft as it stands: what it holds, its difficulties against each other, and its findings. -->
            <ScrollViewer Grid.Column="1" MinWidth="260" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsRun}">
                <StackPanel Margin="20,14,20,16" Spacing="8">
                    <TextBlock Classes="heading" Text="{x:Static res:Strings.ReduceDraftHeading}" />
                    <ItemsControl ItemsSource="{Binding SummaryLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Expert down to Easy, each a little easier than the one above it, if all's well. -->
                    <StackPanel Spacing="8" Margin="0,12,0,0" IsVisible="{Binding HasCheck}">
                        <TextBlock Classes="heading" Text="{x:Static res:Strings.ReduceDifficultiesHeading}" />
                        <sv:DifficultyLadderView DataContext="{Binding Ladder}" />
                    </StackPanel>

                    <!-- The draft's findings: the rule, the difficulty, and what's wrong. -->
                    <StackPanel Spacing="8" Margin="0,12,0,0" IsVisible="{Binding HasCheck}">
                        <TextBlock Classes="heading" Text="{x:Static res:Strings.ReduceFindingsHeading}" />
                        <TextBlock Classes="note" Text="{x:Static res:Strings.ReduceNoFindings}" IsVisible="{Binding HasNoFindings}" />
                        <ItemsControl ItemsSource="{Binding Findings}" IsVisible="{Binding HasFindings}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <!-- Each goes to where it is in the preview, as the Editor's playtest problems do. -->
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReduceFindingRow">
                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Background="Transparent"
                                            Padding="6,4"
                                            CornerRadius="4"
                                            Command="{Binding $parent[ItemsControl].((vm:ReduceViewModel)DataContext).GoToFindingCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{x:Static res:Strings.ReduceFindingGoToToolTip}"
                                            AutomationProperties.Name="{Binding Message}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border Grid.Column="0" Classes="chip large" VerticalAlignment="Top" Margin="0,1,0,0">
                                                <TextBlock Text="{Binding RuleId}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Classes="caption" Text="{Binding Place}" />
                                                <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding Message}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="labelled"
                                HorizontalAlignment="Left"
                                Content="{Binding MoreFindings}"
                                Command="{Binding ShowAllFindingsCommand}"
                                IsVisible="{Binding HasMoreFindings}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter x:Name="PreviewSplitter"
                          Grid.Column="2"
                          Width="4"
                          IsVisible="False"
                          ResizeDirection="Columns"
                          Background="{DynamicResource SubtleBorderBrush}" />

            <!-- The preview: the source and the drafts as highways, played with the song, and the strip of where they changed,
                 as Chart Packer's Generate difficulties shows it too. -->
            <sv:ReductionPreviewView x:Name="PreviewPane"
                                     Grid.Column="3"
                                     IsVisible="False"
                                     DataContext="{Binding Preview}" />
        </Grid>

        <!-- Reset and the preview at the left; Cancel and Apply (or Save) at the right, as the other dialogs have them. -->
        <Border Grid.Row="2" Classes="toolbar" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button MinWidth="80"
                            HorizontalContentAlignment="Center"
                            Content="{x:Static res:Strings.ReduceResetButton}"
                            Command="{Binding ResetCommand}"
                            ToolTip.Tip="{x:Static res:Strings.ReduceResetToolTip}"
                            AutomationProperties.Name="{x:Static res:Strings.ReduceResetButton}" />
                    <ToggleButton IsVisible="{Binding IsRun}"
                                  IsChecked="{Binding Preview.IsExpanded, FallbackValue=False}"
                                  ToolTip.Tip="{x:Static res:Strings.ReducePreviewToolTip}"
                                  AutomationProperties.Name="{x:Static res:Strings.ReducePreviewButton}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Width="14" Height="14" Data="{StaticResource HighwayIconGeometry}" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.ReducePreviewButton}" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button MinWidth="80"
                            HorizontalContentAlignment="Center"
                            Content="{x:Static sres:SharedStrings.CancelButton}"
                            Command="{Binding CancelCommand}"
                            IsCancel="True"
                            AutomationProperties.Name="{x:Static sres:SharedStrings.CancelButton}" />
                    <Button MinWidth="80"
                            HorizontalContentAlignment="Center"
                            Classes="accent"
                            Content="{Binding ApplyLabel}"
                            Command="{Binding ApplyCommand}"
                            IsDefault="True"
                            AutomationProperties.Name="{Binding ApplyLabel}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
