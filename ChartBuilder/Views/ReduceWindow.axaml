<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChartBuilder.ViewModels"
        xmlns:res="using:ChartBuilder.Resources"
        xmlns:sres="using:ChartShared.UI.Resources"
        xmlns:ui="using:ChartShared.UI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="600"
        x:Class="ChartBuilder.Views.ReduceWindow"
        x:DataType="vm:ReduceViewModel"
        Icon="/Assets/ChartBuilder.ico"
        Title="{Binding Title}"
        Background="{DynamicResource AppBackgroundBrush}"
        Width="780" Height="600"
        MinWidth="660" MinHeight="460"
        ShowInTaskbar="False"
        CanMinimize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        WindowDecorationsTheme="{StaticResource TitleBarDecorations}"
        WindowStartupLocation="CenterOwner">

    <!-- Reduce (charter-spec C9 item 2). On the left, what to reduce and by which rules; on the right, the draft as it
         stands, each change drawing it again over the target: its difficulties against each other, and its findings.
         Opened from Settings, it's the left alone, on the defaults. It can't be minimized: a modal window with no taskbar
         entry would have nothing to restore it from. -->
    <Window.Styles>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- A rule's name: wrapped rather than cut short, beside its control. -->
        <Style Selector="Grid.fields > TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Grid.fields > ComboBox, Grid.fields > NumericUpDown">
            <Setter Property="Width" Value="132" />
        </Style>
        <Style Selector="CheckBox.rule">
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style Selector="CheckBox.rule > TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- The rules, grouped as a settings row is. -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource ToolbarGroupBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <!-- A difficulty on the ladder: the draft's own marked as the library marks its selection, with the accent's bar
             at its left; one no easier than the one above it marked as a failing row is. -->
        <Style Selector="Border.rung">
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="10,6,8,6" />
        </Style>
        <Style Selector="Border.rung.draft">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentTintFaintBrush}" />
        </Style>
        <Style Selector="Border.rung.outOfOrder">
            <Setter Property="BorderBrush" Value="{DynamicResource InvalidBrush}" />
            <Setter Property="Background" Value="{DynamicResource InvalidTintBrush}" />
        </Style>
        <Style Selector="Border.rung TextBlock.name">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.rung.draft TextBlock.name">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- Its peak notes a second, as a bar against the part's highest: in the accent for the draft, faint for the rest. -->
        <Style Selector="ProgressBar.peak">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="6" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ToolHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleBorderBrush}" />
        </Style>
        <Style Selector="Border.rung.draft ProgressBar.peak">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Border.rung.outOfOrder ProgressBar.peak">
            <Setter Property="Foreground" Value="{DynamicResource InvalidBrush}" />
        </Style>

        <Style Selector="TextBlock.warning">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- The title bar, as the main window's is: the icon (the owner's, set in code) and the title. -->
        <ui:TitleBar x:Name="WindowTitleBar"
                     Grid.Row="0"
                     Height="31"
                     BorderThickness="0,0,0,1"
                     BorderBrush="{DynamicResource SubtleBorderBrush}">
            <TextBlock Margin="8,0,12,0"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding Title}" />
        </ui:TitleBar>

        <Grid x:Name="Body" Grid.Row="1" ColumnDefinitions="340,*">
            <!-- What to reduce, and the rules. -->
            <Border x:Name="SetupPane"
                    Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,14,16,16" Spacing="12">
                        <TextBlock Classes="note" Text="{x:Static res:Strings.ReduceIntro}" IsVisible="{Binding IsOne}" />
                        <TextBlock Classes="note" Text="{x:Static res:Strings.ReduceAllIntro}" IsVisible="{Binding IsAll}" />
                        <TextBlock Classes="note" Text="{x:Static res:Strings.ReduceDefaultsIntro}" IsVisible="{Binding IsDefaults}" />

                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="caption" VerticalAlignment="Center"
                                       Text="{x:Static res:Strings.ReduceFamilyLabel}" IsVisible="{Binding IsDefaults}" />
                            <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" IsVisible="{Binding IsDefaults}"
                                      ItemsSource="{Binding FamilyChoices}"
                                      SelectedItem="{Binding SelectedFamily}"
                                      DisplayMemberBinding="{Binding Label, x:DataType=vm:FamilyChoice}"
                                      AutomationProperties.Name="{x:Static res:Strings.ReduceFamilyLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="caption" VerticalAlignment="Center"
                                       Text="{x:Static res:Strings.ReduceToLabel}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding ToChoices}"
                                      SelectedItem="{Binding SelectedTo}"
                                      DisplayMemberBinding="{Binding Label, x:DataType=vm:TargetChoice}"
                                      AutomationProperties.Name="{x:Static res:Strings.ReduceToLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="caption" VerticalAlignment="Center"
                                       Text="{x:Static res:Strings.ReduceFromLabel}" IsVisible="{Binding IsOne}" />
                            <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" IsVisible="{Binding IsOne}"
                                      ItemsSource="{Binding FromChoices}"
                                      SelectedItem="{Binding SelectedFrom}"
                                      DisplayMemberBinding="{Binding Label, x:DataType=vm:DifficultyChoice}"
                                      AutomationProperties.Name="{x:Static res:Strings.ReduceFromLabel}" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Classes="caption" VerticalAlignment="Center"
                                       Text="{x:Static res:Strings.ReduceScopeLabel}" IsVisible="{Binding IsRun}" />
                            <ComboBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" IsVisible="{Binding IsRun}"
                                      ItemsSource="{Binding ScopeChoices}"
                                      SelectedItem="{Binding SelectedScope}"
                                      DisplayMemberBinding="{Binding Label, x:DataType=vm:ScopeChoice}"
                                      AutomationProperties.Name="{x:Static res:Strings.ReduceScopeLabel}" />
                        </Grid>

                        <!-- Reduce all: the difficulties to fill. -->
                        <ItemsControl ItemsSource="{Binding Toggles}" IsVisible="{Binding IsAll}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="16" LineSpacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TargetToggle">
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The rules, for the target, or in Reduce all for the difficulty picked. -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,6,0,0">
                            <TextBlock Classes="heading" VerticalAlignment="Center" Text="{x:Static res:Strings.ReduceRulesHeading}" />
                            <ComboBox Grid.Column="1" Width="132"
                                      IsVisible="{Binding IsAll}"
                                      ItemsSource="{Binding RulesForChoices}"
                                      SelectedItem="{Binding SelectedRulesFor}"
                                      DisplayMemberBinding="{Binding Label, x:DataType=vm:DifficultyChoice}"
                                      ToolTip.Tip="{x:Static res:Strings.ReduceRulesForLabel}"
                                      AutomationProperties.Name="{x:Static res:Strings.ReduceRulesForLabel}" />
                        </Grid>

                        <!-- 5-fret and GHL. -->
                        <Border Classes="card" IsVisible="{Binding IsFrets}">
                            <StackPanel Spacing="8">
                                <Grid Classes="fields" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                    <TextBlock Grid.Row="0" Text="{x:Static res:Strings.ReduceChordSizeLabel}" />
                                    <NumericUpDown Grid.Row="0" Grid.Column="1"
                                                   Value="{Binding MaxChordSize}" Minimum="1" Maximum="{Binding ChordSizeMaximum}"
                                                   Increment="1" FormatString="0" ParsingNumberStyle="Integer" ClipValueToMinMax="True"
                                                   AutomationProperties.Name="{x:Static res:Strings.ReduceChordSizeLabel}" />
                                    <TextBlock Grid.Row="1" Text="{Binding LaneLimitLabel}" />
                                    <ComboBox Grid.Row="1" Grid.Column="1"
                                              ItemsSource="{Binding LaneLimitChoices}"
                                              SelectedItem="{Binding HighestLane}"
                                              DisplayMemberBinding="{Binding Label, x:DataType=vm:LaneLimitChoice}"
                                              AutomationProperties.Name="{Binding LaneLimitLabel}" />
                                    <TextBlock Grid.Row="2" Text="{x:Static res:Strings.ReduceThinningLabel}" />
                                    <ComboBox Grid.Row="2" Grid.Column="1"
                                              ItemsSource="{Binding DivisionChoices}"
                                              SelectedItem="{Binding Thinning}"
                                              DisplayMemberBinding="{Binding Label, x:DataType=vm:DivisionChoice}"
                                              AutomationProperties.Name="{x:Static res:Strings.ReduceThinningLabel}" />
                                    <TextBlock Grid.Row="3" Text="{x:Static res:Strings.ReduceMinGapLabel}" />
                                    <NumericUpDown Grid.Row="3" Grid.Column="1"
                                                   Value="{Binding MinGapMs}" Minimum="0" Maximum="{Binding MinGapMaximum}"
                                                   Increment="10" FormatString="0" ParsingNumberStyle="Integer" ClipValueToMinMax="True"
                                                   AutomationProperties.Name="{x:Static res:Strings.ReduceMinGapLabel}" />
                                </Grid>
                                <CheckBox Classes="rule" IsChecked="{Binding KeepForcedHopoAndTap}">
                                    <TextBlock Text="{x:Static res:Strings.ReduceKeepForcing}" />
                                </CheckBox>
                                <CheckBox Classes="rule" IsChecked="{Binding KeepShortSustains}">
                                    <TextBlock Text="{x:Static res:Strings.ReduceKeepShortSustains}" />
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <!-- Drums. -->
                        <Border Classes="card" IsVisible="{Binding IsDrums}">
                            <Grid Classes="fields" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                <TextBlock Grid.Row="0" Text="{x:Static res:Strings.ReducePadsLabel}" />
                                <NumericUpDown Grid.Row="0" Grid.Column="1"
                                               Value="{Binding PadsPerHit}" Minimum="1" Maximum="5"
                                               Increment="1" FormatString="0" ParsingNumberStyle="Integer" ClipValueToMinMax="True"
                                               AutomationProperties.Name="{x:Static res:Strings.ReducePadsLabel}" />
                                <TextBlock Grid.Row="1" Text="{x:Static res:Strings.ReduceThinningLabel}" />
                                <ComboBox Grid.Row="1" Grid.Column="1"
                                          ItemsSource="{Binding DivisionChoices}"
                                          SelectedItem="{Binding Thinning}"
                                          DisplayMemberBinding="{Binding Label, x:DataType=vm:DivisionChoice}"
                                          AutomationProperties.Name="{x:Static res:Strings.ReduceThinningLabel}" />
                                <TextBlock Grid.Row="2" Text="{x:Static res:Strings.ReduceMinGapLabel}" />
                                <NumericUpDown Grid.Row="2" Grid.Column="1"
                                               Value="{Binding MinGapMs}" Minimum="0" Maximum="{Binding MinGapMaximum}"
                                               Increment="10" FormatString="0" ParsingNumberStyle="Integer" ClipValueToMinMax="True"
                                               AutomationProperties.Name="{x:Static res:Strings.ReduceMinGapLabel}" />
                                <TextBlock Grid.Row="3" Text="{x:Static res:Strings.ReduceKickLabel}" />
                                <ComboBox Grid.Row="3" Grid.Column="1"
                                          ItemsSource="{Binding KickChoices}"
                                          SelectedItem="{Binding KickThinning}"
                                          DisplayMemberBinding="{Binding Label, x:DataType=vm:DivisionChoice}"
                                          AutomationProperties.Name="{x:Static res:Strings.ReduceKickLabel}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- The draft as it stands: what it holds, its difficulties against each other, and its findings. -->
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsRun}">
                <StackPanel Margin="20,14,20,16" Spacing="8">
                    <TextBlock Classes="heading" Text="{x:Static res:Strings.ReduceDraftHeading}" />
                    <ItemsControl ItemsSource="{Binding SummaryLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Expert down to Easy, each a little easier than the one above it, if all's well. -->
                    <StackPanel Spacing="8" Margin="0,12,0,0" IsVisible="{Binding HasCheck}">
                        <TextBlock Classes="heading" Text="{x:Static res:Strings.ReduceDifficultiesHeading}" />
                        <ItemsControl ItemsSource="{Binding Ratings}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReduceRatingRow">
                                    <Border Classes="rung" Classes.draft="{Binding IsDraft}" Classes.outOfOrder="{Binding IsOutOfOrder}">
                                        <Grid ColumnDefinitions="72,*,76,Auto" ColumnSpacing="12">
                                            <TextBlock Grid.Column="0" Classes="name" Text="{Binding Difficulty}" />
                                            <ProgressBar Grid.Column="1" Classes="peak"
                                                         Minimum="0" Maximum="1" Value="{Binding Share}"
                                                         ToolTip.Tip="{x:Static res:Strings.ReducePeakToolTip}" />
                                            <TextBlock Grid.Column="2" FontSize="12" Opacity="0.7" VerticalAlignment="Center"
                                                       TextAlignment="Right" Text="{Binding Peak}"
                                                       ToolTip.Tip="{x:Static res:Strings.ReducePeakToolTip}" />
                                            <Border Grid.Column="3" Classes="chip large" MinWidth="22"
                                                    ToolTip.Tip="{x:Static res:Strings.ReduceTierToolTip}">
                                                <TextBlock HorizontalAlignment="Center" Text="{Binding Tier}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="warning" Text="{Binding OrderWarning}" IsVisible="{Binding HasOrderWarning}" />
                    </StackPanel>

                    <!-- The draft's findings: the rule, the difficulty, and what's wrong. -->
                    <StackPanel Spacing="8" Margin="0,12,0,0" IsVisible="{Binding HasCheck}">
                        <TextBlock Classes="heading" Text="{x:Static res:Strings.ReduceFindingsHeading}" />
                        <TextBlock Classes="note" Text="{x:Static res:Strings.ReduceNoFindings}" IsVisible="{Binding HasNoFindings}" />
                        <ItemsControl ItemsSource="{Binding Findings}" IsVisible="{Binding HasFindings}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReduceFindingRow">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Border Grid.Column="0" Classes="chip large" VerticalAlignment="Top" Margin="0,1,0,0">
                                            <TextBlock Text="{Binding RuleId}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Classes="caption" Text="{Binding Difficulty}" />
                                            <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding Message}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="note" Text="{Binding MoreFindings}" IsVisible="{Binding HasMoreFindings}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Reset at the left; Cancel and Apply (or Save) at the right, as the other dialogs have them. -->
        <Border Grid.Row="2" Classes="toolbar" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0"
                        MinWidth="80"
                        HorizontalContentAlignment="Center"
                        Content="{x:Static res:Strings.ReduceResetButton}"
                        Command="{Binding ResetCommand}"
                        ToolTip.Tip="{x:Static res:Strings.ReduceResetToolTip}"
                        AutomationProperties.Name="{x:Static res:Strings.ReduceResetButton}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button MinWidth="80"
                            HorizontalContentAlignment="Center"
                            Content="{x:Static sres:SharedStrings.CancelButton}"
                            Command="{Binding CancelCommand}"
                            IsCancel="True"
                            AutomationProperties.Name="{x:Static sres:SharedStrings.CancelButton}" />
                    <Button MinWidth="80"
                            HorizontalContentAlignment="Center"
                            Classes="accent"
                            Content="{Binding ApplyLabel}"
                            Command="{Binding ApplyCommand}"
                            IsDefault="True"
                            AutomationProperties.Name="{Binding ApplyLabel}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
