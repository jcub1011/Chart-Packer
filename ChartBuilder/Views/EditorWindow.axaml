<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChartBuilder.ViewModels"
        xmlns:views="using:ChartBuilder.Views"
        xmlns:res="using:ChartBuilder.Resources"
        xmlns:ctl="using:ChartShared.UI.Controls"
        xmlns:uiviews="using:ChartShared.UI.Views"
        xmlns:bctl="using:ChartBuilder.Controls"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="ChartBuilder.Views.EditorWindow"
        x:DataType="vm:EditorWindowViewModel"
        Icon="/Assets/ChartBuilder.ico"
        Title="{Binding Title}"
        Background="{DynamicResource AppBackgroundBrush}"
        Width="1280" Height="800"
        MinWidth="720" MinHeight="480"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        WindowDecorationsTheme="{StaticResource TitleBarDecorations}"
        WindowStartupLocation="CenterScreen"
        bctl:PanelLayout.Store="{Binding PanelLayout}">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewChartCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenChartCommand}" />
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenProgramSettingsCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <!-- Centred messages standing in for content that isn't built yet. -->
        <Style Selector="StackPanel.placeholder">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="16" />
            <Setter Property="Spacing" Value="4" />
        </Style>
        <!-- The message bar: flat, one line, and clickable anywhere to open Messages, like Chart Packer's job summary
             line. -->
        <Style Selector="Button.message-bar">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.message-bar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        </Style>
        <Style Selector="Button.message-bar:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolPressedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        </Style>
        <!-- A pending song.ini change the user reverted: listed, struck through, until it's restored. -->
        <Style Selector="SelectableTextBlock.reverted">
            <Setter Property="TextDecorations" Value="Strikethrough" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>
    </Window.Styles>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!-- Toolbar (0), panels (1), splitter (2), timeline (3), message bar (4). EditorWindow.axaml.cs indexes these. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="160" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="160" MinHeight="80" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The title bar and the toolbar. The code-behind refits the panels as they change height, the toolbar wrapping as
             the window narrows. -->
        <StackPanel x:Name="TopBand" Grid.Row="0">
            <!-- The window draws its own title bar (TitleBar): the icon, the File and Edit menus, and the window's title and
                 the program version. Dragging anywhere but the menus, the title and the version moves the window. Layered
                 over the progress of a song being opened, see-through so it shows. -->
            <Panel x:Name="TitleBand">
                <ctl:BusyBar Foreground="{DynamicResource AccentTintBrush}"
                             IsActive="{Binding IsLoading}"
                             AutomationProperties.Name="{Binding LoadingText}" />
                <ctl:TitleBar Icon="/Assets/ChartBuilder.ico" AppName="{x:Static res:Strings.AppName}" Background="Transparent">
                    <ctl:TitleBar.Menu>
                        <!-- Off while a song opens, as what's chosen would act on the Editor being left. -->
                        <Menu chrome:WindowDecorationProperties.ElementRole="User" IsEnabled="{Binding !IsOpening}">
                            <MenuItem Header="{x:Static res:Strings.MenuFile}">
                                <MenuItem Header="{x:Static res:Strings.MenuNewChart}" Command="{Binding NewChartCommand}" InputGesture="Ctrl+N">
                                    <MenuItem.Icon><ctl:LineIcon Data="{StaticResource NewChartStroke}" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{x:Static res:Strings.MenuOpen}" Command="{Binding OpenChartCommand}" InputGesture="Ctrl+O">
                                    <MenuItem.Icon><ctl:LineIcon Data="{StaticResource InputFolderStroke}" /></MenuItem.Icon>
                                </MenuItem>
                                <!-- The songs opened lately, the latest first. Each opens with the menu's OpenRecentCommand, found up
                                     the logical tree ($parent), as the submenu's popup isn't under the menu in the visual tree. -->
                                <MenuItem Header="{x:Static res:Strings.MenuOpenRecent}" ItemsSource="{Binding Recent}" IsEnabled="{Binding HasRecent}">
                                    <MenuItem.Icon><ctl:LineIcon Data="{StaticResource RecentStroke}" /></MenuItem.Icon>
                                    <MenuItem.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RecentSongItem">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" MinWidth="240">
                                                <TextBlock Grid.Column="0" MaxWidth="360" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding OpenedText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </MenuItem.ItemTemplate>
                                    <MenuItem.ItemContainerTheme>
                                        <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:RecentSongItem">
                                            <Setter Property="ToolTip.Tip" Value="{Binding ToolTip}" />
                                            <Setter Property="Command" Value="{Binding $parent[Menu].((vm:EditorWindowViewModel)DataContext).OpenRecentCommand}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                        </ControlTheme>
                                    </MenuItem.ItemContainerTheme>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{x:Static res:Strings.MenuSave}" Command="{Binding SaveCommand}" InputGesture="Ctrl+S">
                                    <MenuItem.Icon><ctl:LineIcon Data="{StaticResource SaveStroke}" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{x:Static res:Strings.MenuSaveAndPack}"
                                          Command="{Binding SaveAndPackCommand}"
                                          ToolTip.Tip="{Binding SaveAndPackToolTip}"
                                          ToolTip.ShowOnDisabled="True">
                                    <MenuItem.Icon><ctl:LineIcon Data="{StaticResource PackStroke}" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{x:Static res:Strings.MenuExportCopy}"
                                          Command="{Binding ExportCopyCommand}"
                                          ToolTip.Tip="{Binding ExportCopyToolTip}"
                                          ToolTip.ShowOnDisabled="True">
                                    <MenuItem.Icon><ctl:LineIcon Data="{StaticResource OutputFolderStroke}" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <!-- Settings is the program's, last under File as in Chart Packer; the chart's are a tab in the
                                     left panel. Its Ctrl+, isn't shown, as Avalonia would print it as Ctrl+OemComma. -->
                                <MenuItem Header="{x:Static res:Strings.MenuSettings}" Command="{Binding OpenProgramSettingsCommand}">
                                    <MenuItem.Icon><ctl:LineIcon Data="{StaticResource SettingsStroke}" /></MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            <MenuItem Header="{x:Static res:Strings.MenuEdit}">
                                <MenuItem Header="{x:Static res:Strings.MenuUndo}" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z">
                                    <MenuItem.Icon><ctl:LineIcon Data="{StaticResource UndoStroke}" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{x:Static res:Strings.MenuRedo}" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y">
                                    <MenuItem.Icon><ctl:LineIcon Data="{StaticResource UndoStroke}" RenderTransform="scaleX(-1)" /></MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                        </Menu>
                    </ctl:TitleBar.Menu>
                    <!-- Left-aligned, so the version follows the title, and the title is trimmed when they don't fit. The title
                         is a button (title-link, in Theme.axaml) that shows the song in the file manager; a new chart's, with
                         nowhere to show, is plain text. The version opens the releases page. -->
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8"
                          Margin="6,0,0,0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center">
                        <Button Grid.Column="0"
                                Classes="title-link"
                                chrome:WindowDecorationProperties.ElementRole="User"
                                Command="{Binding ShowSongCommand}"
                                ToolTip.Tip="{Binding ShowSongToolTip}"
                                AutomationProperties.Name="{Binding ShowSongToolTip}">
                            <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                        </Button>
                        <ctl:VersionLink Grid.Column="1" chrome:WindowDecorationProperties.ElementRole="User" />
                    </Grid>
                </ctl:TitleBar>
            </Panel>

            <!-- The toolbar's groups wrap onto more rows as the window narrows, rather than scrolling. -->
            <Border Classes="toolbar">
                <WrapPanel ItemSpacing="8" LineSpacing="6">
                    <WrapPanel.Styles>
                        <Style Selector="ToggleButton.labelled">
                            <Setter Property="Height" Value="28" />
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                        <Style Selector="ToggleButton.labelled:checked /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                        </Style>
                        <!-- Between the rows of choices of the place tool's options. -->
                        <Style Selector="Border.choice-divider">
                            <Setter Property="Width" Value="1" />
                            <Setter Property="Margin" Value="4,5" />
                            <Setter Property="Background" Value="{DynamicResource SubtleBorderBrush}" />
                        </Style>
                    </WrapPanel.Styles>

                    <!-- The editing tools (charter-spec §4.5: EditorTools), one picked at a time, as icons whose tips name
                         them. Beside the Phrase tool is the kind of phrase it adds, of those the part in focus can have
                         (C8). Generate fills and Generate star power are in each lane's Edit menu, as they work on the
                         lane's part. -->
                    <Border Classes="toolbar-group">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <ToggleButton Classes="tool" IsChecked="{Binding Editor.IsSelectTool}" AutomationProperties.Name="{x:Static res:Strings.ToolSelect}">
                                <ToolTip.Tip>
                                    <StackPanel MaxWidth="320" Spacing="4">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.ToolSelect}" />
                                        <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.ToolSelectToolTip}" />
                                    </StackPanel>
                                </ToolTip.Tip>
                                <ctl:LineIcon Data="{StaticResource PointerStroke}" />
                            </ToggleButton>
                            <ToggleButton Classes="tool" IsChecked="{Binding Editor.IsPlaceTool}" AutomationProperties.Name="{x:Static res:Strings.ToolPlace}">
                                <ToolTip.Tip>
                                    <StackPanel MaxWidth="320" Spacing="4">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.ToolPlace}" />
                                        <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.ToolPlaceToolTip}" />
                                    </StackPanel>
                                </ToolTip.Tip>
                                <ctl:LineIcon Data="{StaticResource PencilStroke}" />
                            </ToggleButton>
                            <ToggleButton Classes="tool" IsChecked="{Binding Editor.IsEraseTool}" AutomationProperties.Name="{x:Static res:Strings.ToolErase}">
                                <ToolTip.Tip>
                                    <StackPanel MaxWidth="320" Spacing="4">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.ToolErase}" />
                                        <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.ToolEraseToolTip}" />
                                    </StackPanel>
                                </ToolTip.Tip>
                                <ctl:LineIcon Data="{StaticResource EraserStroke}" />
                            </ToggleButton>
                            <ToggleButton Classes="tool" IsChecked="{Binding Editor.IsPhraseTool}" AutomationProperties.Name="{x:Static res:Strings.ToolPhrase}">
                                <ToolTip.Tip>
                                    <StackPanel MaxWidth="320" Spacing="4">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.ToolPhrase}" />
                                        <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.ToolPhraseToolTip}" />
                                    </StackPanel>
                                </ToolTip.Tip>
                                <ctl:LineIcon Data="{StaticResource HighlighterStroke}" />
                            </ToggleButton>
                            <ComboBox VerticalAlignment="Center"
                                      Height="28"
                                      MinWidth="124"
                                      ItemsSource="{Binding Editor.PhraseKindChoices}"
                                      SelectedItem="{Binding Editor.SelectedPhraseKind}"
                                      DisplayMemberBinding="{Binding Label, x:DataType=vm:PhraseKindChoice}"
                                      ToolTip.Tip="{x:Static res:Strings.ToolPhraseKindToolTip}"
                                      AutomationProperties.Name="{x:Static res:Strings.ToolPhraseKindName}" />
                            <ToggleButton Classes="tool" IsChecked="{Binding Editor.IsTempoTool}" AutomationProperties.Name="{x:Static res:Strings.ToolTempo}">
                                <ToolTip.Tip>
                                    <StackPanel MaxWidth="320" Spacing="4">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.ToolTempo}" />
                                        <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.ToolTempoToolTip}" />
                                    </StackPanel>
                                </ToolTip.Tip>
                                <ctl:LineIcon Data="{StaticResource MetronomeStroke}" />
                            </ToggleButton>
                            <ToggleButton Classes="tool" IsChecked="{Binding Editor.IsSyncTool}" AutomationProperties.Name="{x:Static res:Strings.ToolSync}">
                                <ToolTip.Tip>
                                    <StackPanel MaxWidth="320" Spacing="4">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.ToolSync}" />
                                        <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.ToolSyncToolTip}" />
                                    </StackPanel>
                                </ToolTip.Tip>
                                <ctl:LineIcon Data="{StaticResource LinkStroke}" />
                            </ToggleButton>
                            <ToggleButton Classes="tool" IsChecked="{Binding Editor.IsLoopTool}" AutomationProperties.Name="{x:Static res:Strings.ToolLoopName}">
                                <ToolTip.Tip>
                                    <StackPanel MaxWidth="320" Spacing="4">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.ToolLoop}" />
                                        <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.ToolLoopToolTip}" />
                                    </StackPanel>
                                </ToolTip.Tip>
                                <ctl:LineIcon Data="{StaticResource LoopRegionStroke}" />
                            </ToggleButton>
                        </StackPanel>
                    </Border>

                    <!-- The place tool's options on a 5-fret or GHL lane, while the place tool is picked: what the chord a
                         note goes in is made, whether it's an open note, and what a drag does. -->
                    <Border Classes="toolbar-group" IsVisible="{Binding Editor.ShowsFretPlaceOptions}">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <ToggleButton Classes="labelled" Content="{x:Static res:Strings.PlaceNatural}" IsChecked="{Binding Editor.IsNaturalPlace}" ToolTip.Tip="{x:Static res:Strings.PlaceNaturalToolTip}" />
                            <ToggleButton Classes="labelled" Content="{x:Static res:Strings.PlaceHopo}" IsChecked="{Binding Editor.IsHopoPlace}" ToolTip.Tip="{x:Static res:Strings.PlaceHopoToolTip}" />
                            <ToggleButton Classes="labelled" Content="{x:Static res:Strings.PlaceStrum}" IsChecked="{Binding Editor.IsStrumPlace}" ToolTip.Tip="{x:Static res:Strings.PlaceStrumToolTip}" />
                            <ToggleButton Classes="labelled" Content="{x:Static res:Strings.PlaceTap}" IsChecked="{Binding Editor.IsTapPlace}" ToolTip.Tip="{x:Static res:Strings.PlaceTapToolTip}" />
                            <Border Classes="choice-divider" />
                            <ToggleButton Classes="labelled" Content="{x:Static res:Strings.PlaceOpen}" IsChecked="{Binding Editor.PlaceOpen}" ToolTip.Tip="{x:Static res:Strings.PlaceOpenToolTip}" />
                            <Border Classes="choice-divider" />
                            <ToggleButton Classes="labelled" Content="{x:Static res:Strings.PlaceDragRun}" IsChecked="{Binding Editor.IsRunDrag}" ToolTip.Tip="{x:Static res:Strings.PlaceDragRunToolTip}" />
                            <ToggleButton Classes="labelled" Content="{x:Static res:Strings.PlaceDragSustain}" IsChecked="{Binding Editor.IsSustainDrag}" ToolTip.Tip="{x:Static res:Strings.PlaceDragSustainToolTip}" />
                        </StackPanel>
                    </Border>

                    <!-- The place tool's options on a drums lane, while the place tool is picked: cymbal or tom on Pro
                         drums, the pad's dynamics, and a 2× kick on Expert. -->
                    <Border Classes="toolbar-group" IsVisible="{Binding Editor.ShowsDrumPlaceOptions}">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding Editor.ShowsTomChoice}">
                                <ToggleButton Classes="labelled" Content="{x:Static res:Strings.PlaceCymbal}" IsChecked="{Binding Editor.IsCymbalPlace}" ToolTip.Tip="{x:Static res:Strings.PlaceCymbalToolTip}" />
                                <ToggleButton Classes="labelled" Content="{x:Static res:Strings.PlaceTom}" IsChecked="{Binding Editor.IsTomPlace}" ToolTip.Tip="{x:Static res:Strings.PlaceTomToolTip}" />
                                <Border Classes="choice-divider" />
                            </StackPanel>
                            <ToggleButton Classes="labelled" Content="{x:Static res:Strings.PlaceNormal}" IsChecked="{Binding Editor.IsNormalPlace}" ToolTip.Tip="{x:Static res:Strings.PlaceNormalToolTip}" />
                            <ToggleButton Classes="labelled" Content="{x:Static res:Strings.PlaceAccent}" IsChecked="{Binding Editor.IsAccentPlace}" ToolTip.Tip="{x:Static res:Strings.PlaceAccentToolTip}" />
                            <ToggleButton Classes="labelled" Content="{x:Static res:Strings.PlaceGhost}" IsChecked="{Binding Editor.IsGhostPlace}" ToolTip.Tip="{x:Static res:Strings.PlaceGhostToolTip}" />
                            <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding Editor.ShowsDoubleKickChoice}">
                                <Border Classes="choice-divider" />
                                <ToggleButton Classes="labelled" Content="{x:Static res:Strings.PlaceDoubleKick}" IsChecked="{Binding Editor.PlaceDoubleKick}" ToolTip.Tip="{x:Static res:Strings.PlaceDoubleKickToolTip}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- The grid notes snap to (charter-spec C4 item 4), on while the magnet is lit: [ and ] step through it. -->
                    <Border Classes="toolbar-group">
                        <StackPanel Orientation="Horizontal" Spacing="2" Height="28">
                            <ToggleButton Classes="tool" IsChecked="{Binding Editor.IsSnapOn}" AutomationProperties.Name="{x:Static res:Strings.SnapLabel}">
                                <ToolTip.Tip>
                                    <StackPanel MaxWidth="320" Spacing="4">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.SnapLabel}" />
                                        <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.SnapButtonToolTip}" />
                                    </StackPanel>
                                </ToolTip.Tip>
                                <ctl:LineIcon Data="{StaticResource QuantizeStroke}" />
                            </ToggleButton>
                            <ComboBox VerticalAlignment="Center"
                                      MinWidth="76"
                                      ItemsSource="{Binding Editor.SnapChoices}"
                                      SelectedItem="{Binding Editor.SelectedSnap}"
                                      DisplayMemberBinding="{Binding Label, x:DataType=vm:SnapChoice}"
                                      ToolTip.Tip="{x:Static res:Strings.SnapToolTip}"
                                      AutomationProperties.Name="{x:Static res:Strings.SnapLabel}" />
                        </StackPanel>
                    </Border>

                    <!-- Audio assist (charter-spec C14): snap to onset (O), on while the phi is lit, and Nudge to onsets
                         (Shift+O). A proposed tempo map and Find first downbeat are in the Tempo map tab. -->
                    <Border Classes="toolbar-group" IsVisible="{Binding Editor.AudioAssist.HasAudio}">
                        <StackPanel Orientation="Horizontal" Spacing="2" Height="28">
                            <ToggleButton Classes="tool" IsChecked="{Binding Editor.AudioAssist.IsSnapToOnset}" AutomationProperties.Name="{x:Static res:Strings.SnapToOnsetLabel}">
                                <ToolTip.Tip>
                                    <StackPanel MaxWidth="320" Spacing="4">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.SnapToOnsetLabel}" />
                                        <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.SnapToOnsetToolTip}" />
                                    </StackPanel>
                                </ToolTip.Tip>
                                <ctl:LineIcon Data="{StaticResource OnsetStroke}" />
                            </ToggleButton>
                            <Button Classes="labelled"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Content="{x:Static res:Strings.NudgeToOnsetsButton}"
                                    Command="{Binding Editor.AudioAssist.NudgeCommand}"
                                    ToolTip.Tip="{x:Static res:Strings.NudgeToOnsetsToolTip}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="toolbar-group">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="tool"
                                    Command="{Binding UndoCommand}"
                                    ToolTip.Tip="{x:Static res:Strings.UndoToolTip}"
                                    AutomationProperties.Name="{x:Static res:Strings.UndoButton}">
                                <ctl:LineIcon Data="{StaticResource UndoStroke}" />
                            </Button>
                            <!-- Redo is Undo's arrow mirrored. -->
                            <Button Classes="tool"
                                    Command="{Binding RedoCommand}"
                                    ToolTip.Tip="{x:Static res:Strings.RedoToolTip}"
                                    AutomationProperties.Name="{x:Static res:Strings.RedoButton}">
                                <ctl:LineIcon Data="{StaticResource UndoStroke}" RenderTransform="scaleX(-1)" />
                            </Button>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Border>
        </StackPanel>

        <Grid x:Name="PanelsGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Chart settings and Art (0), splitter (1), the chart (2), splitter (3), Properties (4).
                     EditorWindow.axaml.cs indexes these, and sizes the side columns. -->
                <ColumnDefinition Width="300" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="280" MinWidth="180" />
            </Grid.ColumnDefinitions>

            <!-- Left panel: Chart settings (the parts, metadata and tracks), the Art, the sections and other text events, and
                 the timing and the tempo and time signature changes (charter-spec C1; C8 items 3, 5 and 6; C4). Each tab's key
                 is EditorWindowViewModel's, and keeps its place wherever it's dragged. Pinned, it's in its column;
                 auto-hiding, EditorWindow.axaml.cs lays it over the chart. -->
            <bctl:EditorSidePanel x:Name="LeftPanel"
                                  Grid.Column="0"
                                  LayoutKey="left"
                                  IsAutoHide="{Binding IsLeftPanelAutoHide}"
                                  IsOpen="{Binding IsLeftPanelOpen}"
                                  PanelWidth="{Binding LeftPanelWidth}"
                                  SelectedKey="{Binding LeftPanelTab}">
                <TabItem bctl:EditorSidePanel.Key="chart-settings" Header="{x:Static res:Strings.ChartSettingsTab}">
                    <views:ChartSettingsView />
                </TabItem>
                <TabItem bctl:EditorSidePanel.Key="art" Header="{x:Static res:Strings.ArtTab}">
                    <views:ArtView DataContext="{Binding Art}" />
                </TabItem>
                <TabItem bctl:EditorSidePanel.Key="sections" Header="{x:Static res:Strings.SectionsTab}">
                    <views:SectionsView DataContext="{Binding Sections}" />
                </TabItem>
                <TabItem bctl:EditorSidePanel.Key="tempo-map" Header="{x:Static res:Strings.TempoMapTab}">
                    <views:TempoMapView DataContext="{Binding TempoMap}" />
                </TabItem>
            </bctl:EditorSidePanel>

            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          Width="4"
                          Background="{DynamicResource SubtleBorderBrush}"
                          IsVisible="{Binding !IsLeftPanelAutoHide}" />

            <!-- The chart: its lanes, each a part's highway or a vocal part, docked as the user arranges them. Over them,
                 while Generate fills or Generate star power runs (charter-spec C6 item 5, C8 item 1), a bar to keep, drop,
                 add or cancel its proposals. -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top"
                        IsVisible="{Binding Editor.IsProposalRunActive}"
                        Background="{DynamicResource ToolbarBrush}"
                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,4">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Editor.ProposalRunText}" />
                        <TextBlock Grid.Column="1"
                                   Classes="muted"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding Editor.ProposalRunHint}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <Button Classes="labelled"
                                    Content="{x:Static res:Strings.ProposalRunPrevious}"
                                    Command="{Binding Editor.PreviousProposalCommand}"
                                    ToolTip.Tip="{x:Static res:Strings.ProposalRunPreviousToolTip}" />
                            <Button Classes="labelled"
                                    Content="{x:Static res:Strings.ProposalRunNext}"
                                    Command="{Binding Editor.NextProposalCommand}"
                                    ToolTip.Tip="{x:Static res:Strings.ProposalRunNextToolTip}" />
                            <Button Classes="labelled" Content="{x:Static res:Strings.FillRunKeepAll}" Command="{Binding Editor.KeepAllProposalsCommand}" />
                            <Button Classes="labelled" Content="{x:Static res:Strings.FillRunDropAll}" Command="{Binding Editor.DropAllProposalsCommand}" />
                            <Button Classes="labelled accent"
                                    Content="{Binding Editor.ProposalRunAdd}"
                                    Command="{Binding Editor.AddProposalsCommand}"
                                    ToolTip.Tip="{Binding Editor.ProposalRunAddToolTip}" />
                            <Button Classes="labelled" Content="{x:Static res:Strings.FillRunCancel}" Command="{Binding Editor.CancelProposalsCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- While a proposed tempo map is reviewed (charter-spec C14 item 4): what it is, and to adjust, accept or
                     discard it. -->
                <Border DockPanel.Dock="Top"
                        IsVisible="{Binding Editor.AudioAssist.IsProposalActive}"
                        Background="{DynamicResource ToolbarBrush}"
                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Editor.AudioAssist.ProposalText}" />
                            <TextBlock Classes="muted" FontSize="12" Text="{x:Static res:Strings.ProposalRunHint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Classes="labelled" Content="{x:Static res:Strings.ProposalDouble}" Command="{Binding Editor.AudioAssist.DoubleProposalCommand}" />
                            <Button Classes="labelled" Content="{x:Static res:Strings.ProposalHalve}" Command="{Binding Editor.AudioAssist.HalveProposalCommand}" />
                            <Button Classes="labelled" Content="◀" Command="{Binding Editor.AudioAssist.ProposalDownbeatEarlierCommand}" ToolTip.Tip="{x:Static res:Strings.ProposalDownbeatEarlierToolTip}" />
                            <Button Classes="labelled" Content="▶" Command="{Binding Editor.AudioAssist.ProposalDownbeatLaterCommand}" ToolTip.Tip="{x:Static res:Strings.ProposalDownbeatLaterToolTip}" />
                            <Button Classes="labelled" Content="{x:Static res:Strings.ProposalReset}" Command="{Binding Editor.AudioAssist.ResetProposalCommand}" />
                            <Button Classes="labelled accent"
                                    Content="{x:Static res:Strings.ProposalAccept}"
                                    Command="{Binding Editor.AudioAssist.AcceptProposalCommand}"
                                    ToolTip.Tip="{x:Static res:Strings.ProposalAcceptToolTip}" />
                            <Button Classes="labelled" Content="{x:Static res:Strings.ProposalDiscard}" Command="{Binding Editor.AudioAssist.DiscardProposalCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Where Find first downbeat thinks measure 1 starts (charter-spec C14 item 5), to apply as a lead-in or a delay. -->
                <Border DockPanel.Dock="Top"
                        IsVisible="{Binding Editor.AudioAssist.HasDownbeat}"
                        Background="{DynamicResource ToolbarBrush}"
                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Editor.AudioAssist.DownbeatText}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Classes="labelled" Content="◀" Command="{Binding Editor.AudioAssist.DownbeatEarlierCommand}" ToolTip.Tip="{x:Static res:Strings.ProposalDownbeatEarlierToolTip}" />
                            <Button Classes="labelled" Content="▶" Command="{Binding Editor.AudioAssist.DownbeatLaterCommand}" ToolTip.Tip="{x:Static res:Strings.ProposalDownbeatLaterToolTip}" />
                            <Button Classes="labelled accent"
                                    Content="{x:Static res:Strings.DownbeatLeadIn}"
                                    Command="{Binding Editor.AudioAssist.ApplyLeadInCommand}"
                                    ToolTip.Tip="{x:Static res:Strings.DownbeatLeadInToolTip}" />
                            <Button Classes="labelled"
                                    Content="{x:Static res:Strings.DownbeatDelay}"
                                    Command="{Binding Editor.AudioAssist.ApplyDelayCommand}"
                                    ToolTip.Tip="{x:Static res:Strings.DownbeatDelayToolTip}" />
                            <Button Classes="labelled" Content="{x:Static res:Strings.DownbeatDismiss}" Command="{Binding Editor.AudioAssist.DismissDownbeatCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Panel>
                    <bctl:LaneDockHost x:Name="LaneHost"
                                       Lanes="{Binding Lanes}"
                                       IsVisible="{Binding Lanes.HasLanes}"
                                       SplitterBrush="{DynamicResource SubtleBorderBrush}"
                                       GuideBrush="{DynamicResource ToolbarGroupBrush}"
                                       GuideBorderBrush="{DynamicResource SubtleBorderBrush}"
                                       AccentBrush="{DynamicResource AccentTextBrush}"
                                       PreviewBrush="{DynamicResource AccentTintBrush}" />
                    <StackPanel Classes="placeholder" IsVisible="{Binding !Lanes.HasLanes}">
                        <TextBlock Classes="centered" FontWeight="SemiBold" Text="{x:Static res:Strings.NoLanesOpen}" />
                        <TextBlock Classes="muted centered" FontSize="12" Text="{x:Static res:Strings.NoLanesOpenHint}" />
                        <Button Classes="labelled"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Center"
                                bctl:LaneMenu.Items="{Binding Lanes.AddMenu}"
                                AutomationProperties.Name="{x:Static res:Strings.AddLaneButton}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ctl:LineIcon Data="{StaticResource AddStroke}" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.AddLaneButton}" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft" />
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Panel>
            </DockPanel>

            <GridSplitter Grid.Column="3"
                          ResizeDirection="Columns"
                          Width="4"
                          Background="{DynamicResource SubtleBorderBrush}"
                          IsVisible="{Binding !IsRightPanelAutoHide}" />

            <!-- Right panel: Properties, which shows what's selected (charter-spec C3 item 4), and the song.ini changes
                 waiting to be saved (C17 item 2), each of which can be reverted. -->
            <bctl:EditorSidePanel x:Name="RightPanel"
                                  Grid.Column="4"
                                  LayoutKey="right"
                                  IsAutoHide="{Binding IsRightPanelAutoHide}"
                                  IsOpen="{Binding IsRightPanelOpen}"
                                  PanelWidth="{Binding RightPanelWidth}"
                                  IsRightEdge="True">
                <TabItem bctl:EditorSidePanel.Key="properties" Header="{x:Static res:Strings.PropertiesTab}">
                    <Panel>
                        <StackPanel Classes="placeholder" IsVisible="{Binding Editor.Properties.IsEmpty}">
                            <TextBlock Classes="centered" FontWeight="SemiBold" Text="{x:Static res:Strings.PropertiesNothingSelected}" />
                            <TextBlock Classes="muted centered"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Text="{x:Static res:Strings.PropertiesNothingSelectedHint}" />
                        </StackPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !Editor.Properties.IsEmpty}">
                            <views:PropertiesView DataContext="{Binding Editor.Properties}" />
                        </ScrollViewer>
                    </Panel>
                </TabItem>
                <!-- The chart's findings, searched and filtered as Chart Packer's chart issues window has them. -->
                <TabItem bctl:EditorSidePanel.Key="findings" Header="{x:Static res:Strings.FindingsTab}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <bctl:PanelSectionStack TabKey="findings">
                            <bctl:PanelSection Key="findings" Header="{x:Static res:Strings.FindingsTab}" Fills="True" FillMinHeight="240">
                                <uiviews:ChartIssuesPanel DataContext="{Binding Findings.Issues}" />
                            </bctl:PanelSection>
                        </bctl:PanelSectionStack>
                    </ScrollViewer>
                </TabItem>
                <TabItem bctl:EditorSidePanel.Key="pending-changes" Header="{x:Static res:Strings.PendingChangesTab}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <bctl:PanelSectionStack TabKey="pending-changes">
                            <bctl:PanelSection Key="pending-changes" Header="{x:Static res:Strings.PendingChangesHeading}" Fills="True" FillMinHeight="200">
                                <!-- The list virtualizes, in its own scroller, with the hint below it. -->
                                <DockPanel Margin="12,8">
                                    <TextBlock DockPanel.Dock="Top"
                                               Classes="muted"
                                               FontSize="12"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               Text="{x:Static res:Strings.PendingChangesNone}"
                                               IsVisible="{Binding !HasPendingChanges}" />
                                    <TextBlock DockPanel.Dock="Bottom"
                                               Classes="muted"
                                               FontSize="12"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               Text="{x:Static res:Strings.PendingChangesHint}"
                                               IsVisible="{Binding HasPendingChanges}" />
                                    <ScrollViewer Margin="0,6,0,0" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasPendingChanges}">
                                        <ItemsControl ItemsSource="{Binding PendingChanges}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PendingChangeItem">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,2" ToolTip.Tip="{Binding Reason}">
                                                        <SelectableTextBlock Grid.Column="0"
                                                                             FontSize="12"
                                                                             VerticalAlignment="Center"
                                                                             Text="{Binding Text}"
                                                                             TextWrapping="Wrap"
                                                                             Classes.reverted="{Binding IsReverted}" />
                                                        <Button Grid.Column="1"
                                                                Classes="labelled"
                                                                FontSize="12"
                                                                Content="{x:Static res:Strings.PendingChangeRevertButton}"
                                                                Command="{Binding RevertCommand}"
                                                                IsVisible="{Binding IsApplied}"
                                                                ToolTip.Tip="{Binding NotRevertableReason}"
                                                                ToolTip.ShowOnDisabled="True" />
                                                        <Button Grid.Column="1"
                                                                Classes="labelled"
                                                                FontSize="12"
                                                                Content="{x:Static res:Strings.PendingChangeRestoreButton}"
                                                                Command="{Binding RestoreCommand}"
                                                                IsVisible="{Binding IsReverted}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </bctl:PanelSection>
                        </bctl:PanelSectionStack>
                    </ScrollViewer>
                </TabItem>
                <!-- The highway preview (charter-spec C18), docked; it also opens in a window of its own. -->
                <TabItem bctl:EditorSidePanel.Key="preview" Header="{x:Static res:Strings.PreviewTab}">
                    <views:PreviewView DataContext="{Binding Editor.Preview}" />
                </TabItem>
                <!-- The difficulty analysis of a five-fret lane, docked; it also opens in a window of its own. -->
                <TabItem bctl:EditorSidePanel.Key="difficulty" Header="{x:Static res:Strings.DifficultyTab}">
                    <views:DifficultyView DataContext="{Binding Editor.Difficulty}" />
                </TabItem>
            </bctl:EditorSidePanel>
        </Grid>

        <GridSplitter Grid.Row="2"
                      ResizeDirection="Rows"
                      Height="4"
                      Background="{DynamicResource SubtleBorderBrush}" />

        <!-- The transport bar (charter-spec C3 item 6) over the timeline, the full width of the window: the whole mix's
             waveform and the chart's beats, with the overview of the lane in focus (C3 item 2), to play and scrub through
             the song. -->
        <DockPanel Grid.Row="3" Background="{DynamicResource SurfaceBrush}">
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource ToolbarBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,2">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <WrapPanel Grid.Column="0" ItemSpacing="8" VerticalAlignment="Center">
                        <Button Classes="tool"
                                Command="{Binding Playback.PlayPauseCommand}"
                                ToolTip.Tip="{Binding Playback.PlayPauseToolTip}"
                                AutomationProperties.Name="{x:Static res:Strings.PlayPauseButton}">
                            <Panel>
                                <ctl:LineIcon Width="12" Height="12" Data="{StaticResource PlayStroke}" IsVisible="{Binding !Playback.IsPlaying}" />
                                <ctl:LineIcon Width="12" Height="12" Data="{StaticResource PauseStroke}" IsVisible="{Binding Playback.IsPlaying}" />
                            </Panel>
                        </Button>
                        <ToggleButton Classes="tool"
                                      IsChecked="{Binding Editor.IsRecordArmed, Mode=OneWay}"
                                      Command="{Binding Editor.ToggleRecordCommand}"
                                      ToolTip.Tip="{Binding Editor.RecordToolTip}"
                                      AutomationProperties.Name="{x:Static res:Strings.RecordButton}">
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource DifficultyHardBrush}" />
                        </ToggleButton>
                        <!-- Playtest (charter-spec C19 item 4): on, playing judges the focused lane as played. Never on with Record;
                             both can be off. -->
                        <ToggleButton Classes="tool"
                                      IsChecked="{Binding Editor.Playtest.IsArmed, Mode=OneWay}"
                                      Command="{Binding Editor.TogglePlaytestCommand}"
                                      ToolTip.Tip="{Binding Editor.Playtest.ToolTip}"
                                      AutomationProperties.Name="{x:Static res:Strings.PlaytestButton}">
                            <PathIcon Width="16" Height="16" Data="{StaticResource PlaytestIconGeometry}" />
                        </ToggleButton>
                        <!-- The drop-downs are centred on the row, as Fluent puts a ComboBox at the top of it. -->
                        <ComboBox VerticalAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  Height="28"
                                  ItemsSource="{Binding Editor.RecordModeChoices}"
                                  SelectedItem="{Binding Editor.SelectedRecordMode}"
                                  DisplayMemberBinding="{Binding Label, x:DataType=vm:RecordModeChoice}"
                                  MinWidth="100"
                                  ToolTip.Tip="{x:Static res:Strings.RecordModeToolTip}"
                                  AutomationProperties.Name="{x:Static res:Strings.RecordModeToolTip}" />
                        <!-- Quantize, lit while on: record mode puts what's played on the grid beside it; off, it's kept as
                             played. The grid is also what Quantize in the note menu uses. -->
                        <ToggleButton Classes="tool"
                                      IsChecked="{Binding Editor.IsRecordQuantized}"
                                      AutomationProperties.Name="{x:Static res:Strings.QuantizeLabel}">
                            <ToolTip.Tip>
                                <StackPanel MaxWidth="320" Spacing="4">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.QuantizeLabel}" />
                                    <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.QuantizeToolTip}" />
                                </StackPanel>
                            </ToolTip.Tip>
                            <ctl:LineIcon Data="{StaticResource QuantizeRecordStroke}" />
                        </ToggleButton>
                        <ComboBox VerticalAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  Height="28"
                                  ItemsSource="{Binding Editor.SnapChoices}"
                                  SelectedItem="{Binding Editor.SelectedQuantize}"
                                  DisplayMemberBinding="{Binding Label, x:DataType=vm:SnapChoice}"
                                  MinWidth="80"
                                  ToolTip.Tip="{x:Static res:Strings.QuantizeResolutionToolTip}"
                                  AutomationProperties.Name="{x:Static res:Strings.QuantizeResolutionToolTip}" />
                        <!-- What the playtest found (charter-spec C19 item 4): the pass's stats, the problems, to go to, and Clear,
                             which forgets them. -->
                        <TextBlock Classes="muted"
                                   VerticalAlignment="Center"
                                   Text="{Binding Editor.Playtest.StatsText}"
                                   IsVisible="{Binding Editor.Playtest.HasFeedback}" />
                        <Button Classes="labelled"
                                Content="{x:Static res:Strings.PlaytestProblemsButton}"
                                IsVisible="{Binding Editor.Playtest.HasProblems}"
                                ToolTip.Tip="{x:Static res:Strings.PlaytestProblemsToolTip}"
                                AutomationProperties.Name="{x:Static res:Strings.PlaytestProblemsButton}">
                            <Button.Flyout>
                                <Flyout Placement="TopEdgeAlignedLeft">
                                    <ScrollViewer MaxHeight="360" MinWidth="260">
                                        <ItemsControl ItemsSource="{Binding Editor.Playtest.Problems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PlaytestProblemRow">
                                                    <Button HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            Background="Transparent"
                                                            Padding="10,4"
                                                            CornerRadius="4"
                                                            Command="{Binding $parent[ItemsControl].((vm:EditorWindowViewModel)DataContext).Editor.Playtest.GoToProblemCommand}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.Name="{Binding What}">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                            <TextBlock Grid.Column="0" Text="{Binding What}" />
                                                            <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Where}" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Classes="labelled"
                                Content="{x:Static res:Strings.PlaytestClearButton}"
                                Command="{Binding Editor.Playtest.ClearCommand}"
                                IsVisible="{Binding Editor.Playtest.HasFeedback}"
                                ToolTip.Tip="{x:Static res:Strings.PlaytestClearToolTip}"
                                AutomationProperties.Name="{x:Static res:Strings.PlaytestClearToolTip}" />
                        <ComboBox VerticalAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  Height="28"
                                  ItemsSource="{Binding Playback.SpeedPercents}"
                                  SelectedItem="{Binding Playback.SpeedPercent}"
                                  IsEnabled="{Binding Playback.IsReady}"
                                  MinWidth="80"
                                  ToolTip.Tip="{x:Static res:Strings.SpeedToolTip}"
                                  AutomationProperties.Name="{x:Static res:Strings.SpeedToolTip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="x:Int32">
                                    <TextBlock Text="{Binding StringFormat={x:Static res:Strings.SpeedPercentFormat}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <!-- Keep pitch (Chart Packer's pitch icon), loop, metronome and hit sounds, each lit while on. -->
                        <ToggleButton Classes="tool"
                                      IsChecked="{Binding Playback.PitchCorrection}"
                                      IsEnabled="{Binding Playback.IsReady}"
                                      AutomationProperties.Name="{x:Static res:Strings.PitchCorrectionLabel}">
                            <ToolTip.Tip>
                                <StackPanel MaxWidth="320" Spacing="4">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.PitchCorrectionLabel}" />
                                    <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.PitchCorrectionToolTip}" />
                                </StackPanel>
                            </ToolTip.Tip>
                            <PathIcon Width="14" Height="14" Data="{StaticResource PitchCorrectionIconGeometry}" />
                        </ToggleButton>
                        <ToggleButton Classes="tool"
                                      IsChecked="{Binding Playback.IsLooping}"
                                      IsEnabled="{Binding Playback.HasLoop}"
                                      ToolTip.ShowOnDisabled="True"
                                      AutomationProperties.Name="{x:Static res:Strings.LoopLabel}">
                            <ToolTip.Tip>
                                <StackPanel MaxWidth="320" Spacing="4">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.LoopLabel}" />
                                    <TextBlock TextWrapping="Wrap" Text="{Binding Playback.LoopToolTip}" />
                                </StackPanel>
                            </ToolTip.Tip>
                            <ctl:LineIcon Data="{StaticResource LoopStroke}" />
                        </ToggleButton>
                        <ToggleButton Classes="tool"
                                      IsChecked="{Binding Playback.IsMetronomeOn}"
                                      IsEnabled="{Binding Playback.IsReady}"
                                      AutomationProperties.Name="{x:Static res:Strings.MetronomeLabel}">
                            <ToolTip.Tip>
                                <StackPanel MaxWidth="320" Spacing="4">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.MetronomeLabel}" />
                                    <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.MetronomeToolTip}" />
                                </StackPanel>
                            </ToolTip.Tip>
                            <ctl:LineIcon Data="{StaticResource MetronomeStroke}" />
                        </ToggleButton>
                        <ToggleButton Classes="tool"
                                      IsChecked="{Binding Playback.IsHitSoundsOn}"
                                      IsEnabled="{Binding Playback.IsReady}"
                                      AutomationProperties.Name="{x:Static res:Strings.HitSoundsLabel}">
                            <ToolTip.Tip>
                                <StackPanel MaxWidth="320" Spacing="4">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.HitSoundsLabel}" />
                                    <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.HitSoundsToolTip}" />
                                </StackPanel>
                            </ToolTip.Tip>
                            <ctl:LineIcon Data="{StaticResource HitSoundsStroke}" />
                        </ToggleButton>
                        <Button Classes="tool"
                                ToolTip.Tip="{x:Static res:Strings.VolumeToolTip}"
                                AutomationProperties.Name="{x:Static res:Strings.VolumeToolTip}">
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <StackPanel Spacing="8" MinWidth="220">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.MasterVolumeLabel}" />
                                        <Slider Minimum="0"
                                                Maximum="1"
                                                SmallChange="0.05"
                                                LargeChange="0.1"
                                                Value="{Binding Playback.Volume, Mode=TwoWay}"
                                                ToolTip.Tip="{x:Static res:Strings.MasterVolumeLabel}"
                                                AutomationProperties.Name="{x:Static res:Strings.MasterVolumeLabel}" />
                                        <TextBlock Classes="muted" Text="{Binding Playback.VolumeText}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <ctl:LineIcon Data="{StaticResource VolumeStroke}" />
                        </Button>
                        <Button Classes="labelled"
                                Command="{Binding Playback.OpenCalibrationCommand}"
                                ToolTip.Tip="{x:Static res:Strings.LatencyToolTip}"
                                AutomationProperties.Name="{x:Static res:Strings.LatencyToolTip}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="muted" VerticalAlignment="Center" Text="{x:Static res:Strings.LatencyLabel}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding Playback.LatencyText}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <!-- The playhead's tick, then its time. Figures all one width, and the tick room for seven digits, so the
                         bar isn't laid out again each time the position changes while it plays. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Classes="muted" FontSize="12" FontFeatures="tnum" MinWidth="88" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding Editor.PlayheadTickText}" />
                        <TextBlock FontSize="12" FontFeatures="tnum" VerticalAlignment="Center" Text="{Binding Playback.PositionText}" />
                    </StackPanel>
                </Grid>
            </Border>
            <bctl:TimelineView Margin="8,4,8,8"
                               Cursor="SizeWestEast"
                               Position="{Binding Playback.PositionSeconds}"
                               Length="{Binding Playback.LengthSeconds}"
                               IsPlaying="{Binding Playback.IsPlaying}"
                               Clock="{Binding Playback.Clock}"
                               WheelUpIsLater="{Binding Editor.WheelUpIsLater}"
                               Waveform="{Binding Playback.Waveform}"
                               Beats="{Binding Playback.Beats}"
                               Overview="{Binding Editor.Overview}"
                               FindingMarks="{Binding Findings.Marks}"
                               VisibleStart="{Binding Editor.VisibleStart}"
                               VisibleEnd="{Binding Editor.VisibleEnd}"
                               Loop="{Binding Playback.Loop}"
                               LoopBrush="{DynamicResource LoopRegionLineBrush}"
                               SpanBrush="{DynamicResource AccentTintBrush}"
                               WaveformBrush="{DynamicResource WaveformBrush}"
                               BeatBrush="{DynamicResource SubtleBorderBrush}"
                               MeasureBrush="#4A4D66"
                               TickBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               PlayheadBrush="{DynamicResource AccentTextBrush}"
                               ToolTip.Tip="{x:Static res:Strings.TimelineToolTip}"
                               AutomationProperties.Name="{x:Static res:Strings.TimelineHeading}" />
        </DockPanel>

        <!-- The latest thing the editor said, on one line that's always there, so nothing above it moves when a message
             comes or goes: why an edit was refused, what a key did, or how a save went. Clicking it shows them all. -->
        <Button x:Name="MessageBar"
                Grid.Row="4"
                Classes="message-bar"
                Command="{Binding ShowMessagesCommand}"
                ToolTip.Tip="{x:Static res:Strings.MessageBarToolTip}"
                AutomationProperties.Name="{x:Static res:Strings.MessageBarToolTip}">
            <!-- Margins rather than column spacing, so the placeholder lines up with a message's time. -->
            <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,0,12,0">
                <Border Grid.Column="0"
                        Classes="severity"
                        Classes.warning="{Binding Messages.Latest.IsWarning, FallbackValue=False}"
                        Classes.error="{Binding Messages.Latest.IsError, FallbackValue=False}"
                        IsVisible="{Binding Messages.HasLatest}"
                        Margin="9,5,0,5"
                        Width="3" />
                <TextBlock Grid.Column="1"
                           Classes="muted"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Text="{Binding Messages.Latest.TimeText, FallbackValue=''}"
                           IsVisible="{Binding Messages.HasLatest}" />
                <TextBlock Grid.Column="2"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"
                           Text="{Binding Messages.Latest.Summary, FallbackValue=''}"
                           IsVisible="{Binding Messages.HasLatest}" />
                <TextBlock Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Classes="muted"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"
                           Text="{x:Static res:Strings.MessageBarEmpty}"
                           IsVisible="{Binding !Messages.HasLatest}" />
            </Grid>
        </Button>

        <!-- While a song opens, the window under the title bar takes the pointer, so the song being left isn't edited
             meanwhile; the code-behind keeps it below the title bar, whatever its height, and holds the keys. While it's
             read and its Editor made, rather than asking the user, it's dimmed, with a spinner and what's opening, as the
             title bar's progress runs. Both are moved on the render thread (Spinner, BusyBar), as the Editor is made on
             the UI thread. -->
        <Panel x:Name="LoadingOverlay"
               Grid.Row="0"
               Grid.RowSpan="5"
               Background="Transparent"
               IsVisible="{Binding IsOpening}">
            <Border Background="{DynamicResource AppBackgroundBrush}" Opacity="0.85" IsVisible="{Binding IsLoading}" />
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        IsVisible="{Binding IsLoading}">
                <ctl:Spinner Classes="spinner"
                             IsActive="{Binding IsLoading}"
                             Width="36" Height="36" StrokeThickness="3"
                             HorizontalAlignment="Center" />
                <TextBlock Classes="muted centered"
                           MaxWidth="480"
                           TextWrapping="Wrap"
                           Text="{Binding LoadingText}" />
            </StackPanel>
        </Panel>
    </Grid>
</Window>
