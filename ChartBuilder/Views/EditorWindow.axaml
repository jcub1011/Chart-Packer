<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChartBuilder.ViewModels"
        xmlns:views="using:ChartBuilder.Views"
        xmlns:res="using:ChartBuilder.Resources"
        xmlns:ctl="using:ChartPacker.Controls"
        xmlns:bctl="using:ChartBuilder.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="ChartBuilder.Views.EditorWindow"
        x:DataType="vm:EditorWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding Title}"
        Background="{DynamicResource AppBackgroundBrush}"
        Width="1280" Height="800"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenProgramSettingsCommand}" />
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    </Window.KeyBindings>

    <Window.Resources>
        <bctl:LaneMenuConverter x:Key="LaneMenu" Check="{StaticResource CheckStroke}" />
    </Window.Resources>

    <Window.Styles>
        <!-- Centred messages standing in for content that isn't built yet. -->
        <Style Selector="StackPanel.placeholder">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="16" />
            <Setter Property="Spacing" Value="4" />
        </Style>
    </Window.Styles>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!-- Toolbar (0), panels (1), splitter (2), timeline (3). EditorWindow.axaml.cs indexes these. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="160" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="160" MinHeight="80" />
        </Grid.RowDefinitions>

        <!-- The toolbar, and a notice under it while there is one. The code-behind refits the panels as this
             changes height. -->
        <StackPanel x:Name="TopBand" Grid.Row="0">
            <!-- The toolbar's groups wrap onto more rows as the window narrows, rather than scrolling. -->
            <Border Classes="toolbar">
                <WrapPanel ItemSpacing="8" LineSpacing="6">
                    <!-- Which program this is, and its version. -->
                    <Border Classes="toolbar-group" Padding="8,3">
                        <StackPanel Orientation="Horizontal" Spacing="8" Height="28">
                            <Image Width="20"
                                   Height="20"
                                   VerticalAlignment="Center"
                                   Source="/Assets/avalonia-logo.ico"
                                   AutomationProperties.Name="{x:Static res:Strings.AppName}" />
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Static res:Strings.AppName}" />
                            <TextBlock Classes="muted" VerticalAlignment="Center" FontSize="12" Text="{Binding VersionText}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="toolbar-group">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="tool"
                                    ToolTip.Tip="{x:Static res:Strings.SettingsMenuToolTip}"
                                    AutomationProperties.Name="{x:Static res:Strings.SettingsMenuButton}">
                                <ctl:LineIcon Data="{StaticResource SettingsStroke}" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuItem Header="{x:Static res:Strings.ChartSettingsMenuItem}"
                                                  Command="{Binding OpenChartSettingsCommand}"
                                                  ToolTip.Tip="{x:Static res:Strings.ComingSoonToolTip}"
                                                  ToolTip.ShowOnDisabled="True" />
                                        <MenuItem Header="{x:Static res:Strings.ProgramSettingsMenuItem}"
                                                  Command="{Binding OpenProgramSettingsCommand}"
                                                  InputGesture="Ctrl+OemComma" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <!-- Which lanes are shown. A placeholder until its controls are built. -->
                            <Button Classes="tool"
                                    ToolTip.Tip="{x:Static res:Strings.ViewMenuToolTip}"
                                    AutomationProperties.Name="{x:Static res:Strings.ViewMenuButton}">
                                <ctl:LineIcon Data="{StaticResource ViewStroke}" />
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <TextBlock Classes="muted" Text="{x:Static res:Strings.ViewMenuPlaceholder}" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- The editing tools (charter-spec §4.5: EditorTools). Placeholders until the editor can edit. -->
                    <Border Classes="toolbar-group">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <StackPanel.Styles>
                                <Style Selector="Button.labelled">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="ToolTip.Tip" Value="{x:Static res:Strings.ComingSoonToolTip}" />
                                    <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
                                </Style>
                            </StackPanel.Styles>
                            <Button Classes="labelled" Content="{x:Static res:Strings.ToolSelect}" />
                            <Button Classes="labelled" Content="{x:Static res:Strings.ToolPlace}" />
                            <Button Classes="labelled" Content="{x:Static res:Strings.ToolErase}" />
                            <Button Classes="labelled" Content="{x:Static res:Strings.ToolSustain}" />
                            <Button Classes="labelled" Content="{x:Static res:Strings.ToolPhrase}" />
                            <Button Classes="labelled" Content="{x:Static res:Strings.ToolTempo}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="toolbar-group">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="tool"
                                    Command="{Binding UndoCommand}"
                                    ToolTip.Tip="{x:Static res:Strings.UndoToolTip}"
                                    AutomationProperties.Name="{x:Static res:Strings.UndoButton}">
                                <ctl:LineIcon Data="{StaticResource UndoStroke}" />
                            </Button>
                            <!-- Redo is Undo's arrow mirrored. -->
                            <Button Classes="tool"
                                    Command="{Binding RedoCommand}"
                                    ToolTip.Tip="{x:Static res:Strings.RedoToolTip}"
                                    AutomationProperties.Name="{x:Static res:Strings.RedoButton}">
                                <ctl:LineIcon Data="{StaticResource UndoStroke}" RenderTransform="scaleX(-1)" />
                            </Button>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Border>

            <!-- Something to tell the user, like Chart Packer's notice bar, until they dismiss it. -->
            <Border IsVisible="{Binding HasNotice}"
                    BorderThickness="0,0,0,1"
                    Background="{DynamicResource ToolbarBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    Padding="12,4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <SelectableTextBlock Grid.Column="0"
                                         Text="{Binding Notice}"
                                         TextTrimming="CharacterEllipsis"
                                         ToolTip.Tip="{Binding Notice}"
                                         VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Classes="tool"
                            Command="{Binding DismissNoticeCommand}"
                            ToolTip.Tip="{x:Static res:Strings.DismissNoticeToolTip}"
                            AutomationProperties.Name="{x:Static res:Strings.DismissNoticeToolTip}">
                        <ctl:LineIcon Data="{StaticResource ClearStroke}" />
                    </Button>
                </Grid>
            </Border>
        </StackPanel>

        <Grid x:Name="PanelsGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Chart Inspector (0), splitter (1), the chart (2), splitter (3), Properties (4).
                     EditorWindow.axaml.cs indexes these, and sizes the side columns. -->
                <ColumnDefinition Width="300" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="280" MinWidth="180" />
            </Grid.ColumnDefinitions>

            <!-- Left panel: Chart Inspector. -->
            <bctl:EditorSidePanel Grid.Column="0"
                                  Title="{x:Static res:Strings.ChartInspectorTab}"
                                  IsCollapsed="{Binding IsLeftPanelCollapsed}"
                                  ToggleCommand="{Binding ToggleLeftPanelCommand}">
                <views:ChartInspectorView />
            </bctl:EditorSidePanel>

            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          Width="4"
                          Background="{DynamicResource SubtleBorderBrush}"
                          IsVisible="{Binding !IsLeftPanelCollapsed}" />

            <!-- The chart: its lanes, each a part's highway or a vocal part, docked as the user arranges them. -->
            <Panel Grid.Column="2">
                <bctl:LaneDockHost x:Name="LaneHost"
                                   Lanes="{Binding Lanes}"
                                   IsVisible="{Binding Lanes.HasLanes}"
                                   SplitterBrush="{DynamicResource SubtleBorderBrush}"
                                   GuideBrush="{DynamicResource ToolbarGroupBrush}"
                                   GuideBorderBrush="{DynamicResource SubtleBorderBrush}"
                                   AccentBrush="{DynamicResource AccentTextBrush}"
                                   PreviewBrush="{DynamicResource AccentTintBrush}" />
                <StackPanel Classes="placeholder" IsVisible="{Binding !Lanes.HasLanes}">
                    <TextBlock Classes="centered" FontWeight="SemiBold" Text="{x:Static res:Strings.NoLanesOpen}" />
                    <TextBlock Classes="muted centered" FontSize="12" Text="{x:Static res:Strings.NoLanesOpenHint}" />
                    <Button Classes="labelled"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="{x:Static res:Strings.AddLaneButton}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ctl:LineIcon Data="{StaticResource AddStroke}" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.AddLaneButton}" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft"
                                        ItemsSource="{Binding Lanes.AddMenu, Converter={StaticResource LaneMenu}}" />
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Panel>

            <GridSplitter Grid.Column="3"
                          ResizeDirection="Columns"
                          Width="4"
                          Background="{DynamicResource SubtleBorderBrush}"
                          IsVisible="{Binding !IsRightPanelCollapsed}" />

            <!-- Right panel: Properties, which will show whatever is selected. -->
            <bctl:EditorSidePanel Grid.Column="4"
                                  Title="{x:Static res:Strings.PropertiesTab}"
                                  IsCollapsed="{Binding IsRightPanelCollapsed}"
                                  ToggleCommand="{Binding ToggleRightPanelCommand}"
                                  IsRightEdge="True">
                <StackPanel Classes="placeholder">
                    <TextBlock Classes="centered" FontWeight="SemiBold" Text="{x:Static res:Strings.PropertiesNothingSelected}" />
                    <TextBlock Classes="muted centered"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Text="{x:Static res:Strings.PropertiesNothingSelectedHint}" />
                </StackPanel>
            </bctl:EditorSidePanel>
        </Grid>

        <GridSplitter Grid.Row="2"
                      ResizeDirection="Rows"
                      Height="4"
                      Background="{DynamicResource SubtleBorderBrush}" />

        <!-- The timeline, the full width of the window: the notes over the whole mix's waveform, to scrub through
             the song. A placeholder ruler and waveform so far. -->
        <DockPanel Grid.Row="3" Background="{DynamicResource SurfaceBrush}">
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource ToolbarBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,4">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="caption" VerticalAlignment="Center" Text="{x:Static res:Strings.TimelineHeading}" />
                    <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center" Text="{Binding PositionText}" />
                </Grid>
            </Border>
            <bctl:TimelinePlaceholder Margin="8,4,8,8"
                                      Cursor="Hand"
                                      Position="{Binding TimelinePosition}"
                                      Length="{Binding TimelineLength}"
                                      WaveformBrush="{DynamicResource WaveformBrush}"
                                      TickBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                      PlayheadBrush="{DynamicResource AccentTextBrush}"
                                      ToolTip.Tip="{x:Static res:Strings.TimelineToolTip}"
                                      AutomationProperties.Name="{x:Static res:Strings.TimelineHeading}" />
        </DockPanel>
    </Grid>
</Window>
