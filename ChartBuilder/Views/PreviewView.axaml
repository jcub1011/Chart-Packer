<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChartBuilder.ViewModels"
             xmlns:res="using:ChartBuilder.Resources"
             xmlns:sres="using:ChartShared.UI.Resources"
             xmlns:hw="using:ChartShared.UI.Controls.Highway"
             xmlns:ctl="using:ChartShared.UI.Controls"
             xmlns:bctl="using:ChartBuilder.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="600"
             x:Class="ChartBuilder.Views.PreviewView"
             x:DataType="vm:PreviewViewModel">

    <UserControl.Styles>
        <!-- The band along the top: what's shown, and the button that opens it in a window of its own. -->
        <Style Selector="Border.view-band">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
    </UserControl.Styles>

    <!-- The highway preview (charter-spec C18): the part shown, then practice and its speed, how far ahead it looks and the
         suggested rating, and the game-style highway, played with the editor's clock, filling the rest. -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="view-band">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalAlignment="Center">
                <ComboBox Grid.Column="0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding TrackChoices}"
                          SelectedItem="{Binding SelectedTrack}"
                          DisplayMemberBinding="{Binding Label, x:DataType=vm:PreviewTrackChoice}"
                          ToolTip.Tip="{x:Static res:Strings.PreviewTrackToolTip}"
                          AutomationProperties.Name="{x:Static res:Strings.PreviewTrackToolTip}" />
                <Button x:Name="PopOutButton"
                        Grid.Column="1"
                        Classes="tool"
                        VerticalAlignment="Center"
                        Command="{Binding OpenWindowCommand}"
                        ToolTip.Tip="{x:Static res:Strings.PreviewOpenWindowToolTip}"
                        AutomationProperties.Name="{x:Static res:Strings.PreviewOpenWindowToolTip}">
                    <ctl:LineIcon Data="{StaticResource PopOutStroke}" />
                </Button>
            </Grid>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <bctl:PanelSectionStack TabKey="preview">
                <bctl:PanelSection Key="playback" Header="{x:Static res:Strings.PreviewPlaybackSection}" Padding="12,8,12,12">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <ToggleButton Grid.Column="0"
                                          Classes="labelled"
                                          Content="{x:Static res:Strings.PreviewPractice}"
                                          IsChecked="{Binding IsPractice}"
                                          ToolTip.Tip="{x:Static res:Strings.PreviewPracticeToolTip}" />
                            <ComboBox Grid.Column="1"
                                      HorizontalAlignment="Left"
                                      MinWidth="90"
                                      ItemsSource="{Binding Playback.SpeedPercents}"
                                      SelectedItem="{Binding Playback.SpeedPercent}"
                                      IsEnabled="{Binding Playback.IsReady}"
                                      ToolTip.Tip="{x:Static res:Strings.SpeedToolTip}"
                                      AutomationProperties.Name="{x:Static res:Strings.SpeedToolTip}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:Int32">
                                        <TextBlock Text="{Binding StringFormat={x:Static res:Strings.SpeedPercentFormat}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <!-- How far ahead the highway looks, with what it's set to. -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0"
                                       Classes="muted"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Text="{x:Static res:Strings.LaneLookAheadLabel}" />
                            <ctl:LookAheadSlider Grid.Column="1"
                                    LookAhead="{Binding LookAhead}"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="{x:Static res:Strings.LaneLookAheadToolTip}"
                                    AutomationProperties.Name="{x:Static res:Strings.LaneLookAheadLabel}" />
                            <TextBlock Grid.Column="2"
                                       FontSize="12"
                                       FontFeatures="tnum"
                                       VerticalAlignment="Center"
                                       Text="{Binding LookAhead, StringFormat={x:Static sres:SharedStrings.LookAheadFormat}}" />
                        </Grid>
                        <!-- The suggested rating (charter-spec C18 item 3), with what it was worked out from in its tooltip. -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasSuggestion}">
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding SuggestionText}"
                                       ToolTip.Tip="{Binding SuggestionBasis}" />
                            <Button Grid.Column="1"
                                    Classes="labelled"
                                    FontSize="12"
                                    Content="{Binding UseSuggestionText}"
                                    Command="{Binding UseSuggestionCommand}"
                                    IsVisible="{Binding UseSuggestionText, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    ToolTip.Tip="{x:Static res:Strings.SuggestedRatingUseToolTip}" />
                        </Grid>
                    </StackPanel>
                </bctl:PanelSection>

                <bctl:PanelSection Key="highway" Header="{x:Static res:Strings.PreviewHighwaySection}" Fills="True" FillMinHeight="260">
                    <Panel>
                        <hw:NoteHighwayView x:Name="Highway"
                                            Scene="{Binding Scene}"
                                            Clock="{Binding Clock}"
                                            LookAhead="{Binding LookAhead}"
                                            LengthSeconds="{Binding Playback.LengthSeconds}" />
                        <TextBlock Classes="muted centered"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="16"
                                   Text="{x:Static res:Strings.PreviewNothingToShow}"
                                   IsVisible="{Binding !HasScene}" />
                    </Panel>
                </bctl:PanelSection>
            </bctl:PanelSectionStack>
        </ScrollViewer>
    </DockPanel>
</UserControl>
