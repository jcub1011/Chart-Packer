<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChartBuilder.ViewModels"
        xmlns:res="using:ChartBuilder.Resources"
        xmlns:svc="using:ChartBuilder.Services"
        xmlns:kb="using:ChartShared.UI.Keybinds"
        xmlns:sres="using:ChartShared.UI.Resources"
        xmlns:ui="using:ChartShared.UI.Controls"
        xmlns:hw="using:ChartShared.UI.Controls.Highway"
        xmlns:bctl="using:ChartBuilder.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
        x:Class="ChartBuilder.Views.GeneratePhrasesWindow"
        x:DataType="vm:GeneratePhrasesViewModel"
        Icon="/Assets/ChartBuilder.ico"
        Title="{Binding Title}"
        Background="{DynamicResource AppBackgroundBrush}"
        Width="1100"
        Height="760"
        MinWidth="1024"
        MinHeight="600"
        ShowInTaskbar="False"
        CanMinimize="False"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        WindowDecorationsTheme="{StaticResource TitleBarDecorations}"
        WindowStartupLocation="CenterOwner">

    <!-- Generate star power and Generate fills (charter-spec C6 item 5, C8 item 1): a highway preview of the result on the
         right, and on the left the proposals to keep or drop. The window is built from fixed bands, so keeping or dropping
         a proposal, showing a warning, or asking to regenerate never moves the list, the preview or the timeline. -->
    <Window.DataTemplates>
        <!-- The options only one generator draws; the mode picker and Regenerate are common to both. -->
        <DataTemplate DataType="vm:GenerateStarPowerViewModel" x:DataType="vm:GenerateStarPowerViewModel">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="caption"
                           VerticalAlignment="Center"
                           Text="{x:Static res:Strings.GenerateStarPowerSpacingLabel}" />
                <NumericUpDown Width="96"
                               VerticalAlignment="Center"
                               Value="{Binding Spacing}"
                               Minimum="10"
                               Maximum="60"
                               Increment="5"
                               FormatString="0"
                               ParsingNumberStyle="Integer"
                               ToolTip.Tip="{x:Static res:Strings.GenerateStarPowerSpacingToolTip}"
                               AutomationProperties.Name="{x:Static res:Strings.GenerateStarPowerSpacingLabel}" />
                <Border Width="1" Height="18" Background="{DynamicResource SubtleBorderBrush}" />
                <CheckBox VerticalAlignment="Center"
                          Content="{x:Static res:Strings.GenerateStarPowerSpikesLabel}"
                          IsChecked="{Binding PlanForSpikes}"
                          ToolTip.Tip="{x:Static res:Strings.GenerateStarPowerSpikesToolTip}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:GenerateFillsViewModel" x:DataType="vm:GenerateFillsViewModel">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="caption"
                           VerticalAlignment="Center"
                           Text="{x:Static res:Strings.GenerateFillsSpacingLabel}" />
                <NumericUpDown Width="88"
                               VerticalAlignment="Center"
                               Value="{Binding Spacing}"
                               Minimum="{Binding MinSpacing}"
                               Maximum="{Binding MaxSpacing}"
                               Increment="1"
                               FormatString="0"
                               ParsingNumberStyle="Integer"
                               ToolTip.Tip="{x:Static res:Strings.GenerateFillsSpacingToolTip}"
                               AutomationProperties.Name="{x:Static res:Strings.GenerateFillsSpacingLabel}" />
                <Border Width="1" Height="18" Background="{DynamicResource SubtleBorderBrush}" />
                <TextBlock Classes="caption"
                           VerticalAlignment="Center"
                           Text="{x:Static res:Strings.GenerateFillsLengthLabel}" />
                <NumericUpDown Width="88"
                               VerticalAlignment="Center"
                               Value="{Binding Length}"
                               Minimum="{Binding MinLength}"
                               Maximum="{Binding MaxLength}"
                               Increment="1"
                               FormatString="0"
                               ParsingNumberStyle="Integer"
                               ToolTip.Tip="{x:Static res:Strings.GenerateFillsLengthToolTip}"
                               AutomationProperties.Name="{x:Static res:Strings.GenerateFillsLengthLabel}" />
                <Border Width="1" Height="18" Background="{DynamicResource SubtleBorderBrush}" />
                <TextBlock Classes="caption"
                           VerticalAlignment="Center"
                           Text="{x:Static res:Strings.GenerateFillsEndLabel}" />
                <ComboBox Width="120"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding EndChoices}"
                          SelectedItem="{Binding SelectedEnd}"
                          DisplayMemberBinding="{Binding Label, x:DataType=vm:FillEndChoice}"
                          ToolTip.Tip="{x:Static res:Strings.GenerateFillsEndToolTip}"
                          AutomationProperties.Name="{x:Static res:Strings.GenerateFillsEndLabel}" />
            </StackPanel>
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Styles>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- A proposal is a row rather than a card: its 3px bar says which generator proposed it, and its colours say
             whether it's selected. Both are always laid out, so neither switching changes the row's size. -->
        <Style Selector="Border.region-row">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.region-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource ToolbarGroupBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}" />
        </Style>
        <Style Selector="Border.region-row.selected">
            <Setter Property="Background" Value="{DynamicResource AccentTintFaintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
        </Style>
        <Style Selector="Border.region-row.selected:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
        </Style>
        <Style Selector="Border.region-row.dropped StackPanel.rowText">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Border.keep-bar">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.keep-bar.lit">
            <Setter Property="Background" Value="{DynamicResource StarPowerBrush}" />
        </Style>
        <Style Selector="Border.keep-bar.lit.proposal">
            <Setter Property="Background" Value="{DynamicResource ProposalBrush}" />
        </Style>

        <!-- The chip on a lead-in's row: cyan when the kept plan charges its hard passage, amber when it falls short. -->
        <Style Selector="Border.status-chip > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StarPowerBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.status-chip.low">
            <Setter Property="Background" Value="{DynamicResource WarningTintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
        </Style>
        <Style Selector="Border.status-chip.low > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
        </Style>

        <!-- The whole row is a button, for jumping to it; its own look is the Border's, so the button stays flat. -->
        <Style Selector="Button.region-click">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.region-click:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.region-click:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.region-click:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Button.region-click:focus-visible Border.region-row">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
        <!-- The title bar, as the other windows' is: the icon and the title. -->
        <ui:TitleBar x:Name="WindowTitleBar"
                     Grid.Row="0"
                     Height="31"
                     BorderThickness="0,0,0,1"
                     BorderBrush="{DynamicResource SubtleBorderBrush}">
            <TextBlock Margin="8,0,12,0"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding Title}" />
        </ui:TitleBar>

        <!-- The options the plan is worked out with, in one fixed-height bar: the generator's own, then the mode both
             share. Regenerate's question opens beside it, so asking never adds a row. -->
        <Border Grid.Row="1" Classes="toolbar" Padding="12,8">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                <ContentControl Grid.Column="0"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Left"
                                Content="{Binding}" />
                <Border Grid.Column="1" Width="1" Height="18" Background="{DynamicResource SubtleBorderBrush}" />
                <TextBlock Grid.Column="2"
                           Classes="caption"
                           VerticalAlignment="Center"
                           Text="{Binding ModeLabel}" />
                <ComboBox Grid.Column="3"
                          Width="150"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding ModeChoices}"
                          SelectedItem="{Binding SelectedMode}"
                          DisplayMemberBinding="{Binding Label, x:DataType=vm:GenerationModeChoice}"
                          AutomationProperties.Name="{Binding ModeLabel}" />
                <Button x:Name="RegenerateButton"
                        Grid.Column="4"
                        Classes="labelled"
                        VerticalAlignment="Center"
                        Click="OnRegenerateClick"
                        ToolTip.Tip="{x:Static res:Strings.GenerateRegenerateToolTip}"
                        AutomationProperties.Name="{x:Static res:Strings.GenerateRegenerate}">
                    <FlyoutBase.AttachedFlyout>
                        <Flyout Placement="BottomEdgeAlignedRight" Closed="OnRegenerateFlyoutClosed">
                            <StackPanel Width="270" Spacing="10">
                                <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.GenerateRegenerateConfirm}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                    <Button Classes="labelled accent"
                                            Content="{x:Static res:Strings.GenerateRegenerateConfirmYes}"
                                            Click="OnConfirmRegenerate" />
                                    <Button Classes="labelled"
                                            Content="{x:Static res:Strings.GenerateRegenerateConfirmNo}"
                                            Click="OnKeepProposals" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ui:LineIcon Width="13" Height="13" Data="{StaticResource GenerateStroke}" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.GenerateRegenerate}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- On the left: the proposals, in a ledger that scrolls on its own. On the right: the highway preview of the
             result. Both panes begin with a 40 high band, so their headings line up. -->
        <Grid Grid.Row="2" ColumnDefinitions="340,*">
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <Grid Grid.Row="0"
                          Height="40"
                          Margin="12,0"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <TextBlock Grid.Column="0"
                                   Classes="heading"
                                   VerticalAlignment="Center"
                                   Text="{Binding RegionsHeading}" />
                        <Border Grid.Column="1" Classes="chip large" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ScopeText}" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Padding="12,2,12,6"
                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        IsEnabled="{Binding HasProposals}">
                                <Button Classes="tool"
                                        Command="{Binding PreviousRegionCommand}"
                                        ToolTip.Tip="{x:Static res:Strings.GeneratePreviousRegionToolTip}"
                                        AutomationProperties.Name="{x:Static res:Strings.GeneratePreviousRegionToolTip}">
                                    <ui:LineIcon Width="12" Height="12" Data="{StaticResource ArrowLeftStroke}" />
                                </Button>
                                <Button Classes="tool"
                                        Command="{Binding NextRegionCommand}"
                                        ToolTip.Tip="{x:Static res:Strings.GenerateNextRegionToolTip}"
                                        AutomationProperties.Name="{x:Static res:Strings.GenerateNextRegionToolTip}">
                                    <ui:LineIcon Width="12" Height="12" Data="{StaticResource ArrowRightStroke}" />
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        IsEnabled="{Binding HasProposals}">
                                <Button Classes="labelled"
                                        Content="{x:Static res:Strings.GenerateKeepAll}"
                                        Command="{Binding KeepAllCommand}" />
                                <Button Classes="labelled"
                                        Content="{x:Static res:Strings.GenerateDropAll}"
                                        Command="{Binding DropAllCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Regions}" Margin="12,0,12,10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProposalRowViewModel">
                                    <Button Classes="region-click"
                                            Command="{Binding SelectCommand}"
                                            ToolTip.Tip="{x:Static res:Strings.GenerateRegionJumpToolTip}"
                                            AutomationProperties.Name="{Binding TimeText}">
                                        <Border Classes="region-row"
                                                Classes.selected="{Binding IsSelected}"
                                                Classes.dropped="{Binding !IsKept}">
                                            <Grid ColumnDefinitions="3,Auto,*">
                                                <Border Grid.Column="0"
                                                        Classes="keep-bar"
                                                        Classes.lit="{Binding IsKept}"
                                                        Classes.proposal="{Binding ProposalAccent}" />
                                                <CheckBox Grid.Column="1"
                                                          VerticalAlignment="Center"
                                                          Margin="10,0,0,0"
                                                          IsChecked="{Binding IsKept, Mode=OneWay}"
                                                          Command="{Binding ToggleCommand}"
                                                          ToolTip.Tip="{x:Static res:Strings.GenerateKeepToolTip}"
                                                          AutomationProperties.Name="{x:Static res:Strings.GenerateKeepToolTip}" />
                                                <StackPanel Grid.Column="2"
                                                            Classes="rowText"
                                                            Margin="8,6,10,6"
                                                            Spacing="1"
                                                            VerticalAlignment="Center">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <TextBlock FontSize="12"
                                                                   FontFeatures="tnum"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Text="{Binding TimeText}" />
                                                        <TextBlock Grid.Column="1"
                                                                   FontSize="11"
                                                                   Opacity="0.7"
                                                                   MaxWidth="150"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Text="{Binding RoleText}" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <TextBlock FontSize="11"
                                                                   Opacity="0.65"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Text="{Binding DetailText}" />
                                                        <Border Grid.Column="1"
                                                                Classes="chip large status-chip"
                                                                Classes.low="{Binding ChipLow}"
                                                                IsVisible="{Binding HasChip}">
                                                            <TextBlock Text="{Binding ChipText}" />
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- The phrases already in the chart: pinned below the list, with a cap of its own, so a long list
                         never hides them and it never pushes the list around. -->
                    <Border Grid.Row="3"
                            IsVisible="{Binding HasExisting}"
                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="12,8,12,10">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="2">
                            <TextBlock Grid.Row="0"
                                       Classes="caption"
                                       Text="{Binding ExistingHeading}" />
                            <ScrollViewer Grid.Row="1"
                                          MaxHeight="96"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ExistingRegions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ExistingProposalItem">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,3,0,0">
                                                <StackPanel Grid.Column="0" Spacing="1">
                                                    <TextBlock FontSize="12"
                                                               FontFeatures="tnum"
                                                               Text="{Binding TimeText}" />
                                                    <TextBlock FontSize="11" Opacity="0.65" Text="{Binding StatusText}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           FontSize="11"
                                                           FontFeatures="tnum"
                                                           Opacity="0.65"
                                                           Text="{Binding LengthText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Height="40"
                            Padding="12,0"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <TextBlock Grid.Column="0"
                                       Classes="heading"
                                       VerticalAlignment="Center"
                                       Text="{x:Static res:Strings.GeneratePreviewHeading}" />
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <StackPanel.Resources>
                                    <!-- Fluent's horizontal slider puts 15 of its own above and below the track, which
                                         would leave the track below the bar's centre line; together these make it 20 high. -->
                                    <x:Double x:Key="SliderHorizontalHeight">20</x:Double>
                                    <GridLength x:Key="SliderPreContentMargin">0</GridLength>
                                    <GridLength x:Key="SliderPostContentMargin">0</GridLength>
                                </StackPanel.Resources>
                                <Button Classes="tool"
                                        Command="{Binding Playback.PlayPauseCommand}"
                                        IsEnabled="{Binding Playback.IsReady}"
                                        kb:Shortcut.Tip="{Binding Playback.PlayPauseToolTip}" kb:Shortcut.Action="{x:Static kb:SharedKeys.PlayPause}"
                                        AutomationProperties.Name="{x:Static res:Strings.PlayPauseButton}">
                                    <Panel>
                                        <ui:LineIcon Width="12" Height="12" Data="{StaticResource PlayStroke}" IsVisible="{Binding !Playback.IsPlaying}" />
                                        <ui:LineIcon Width="12" Height="12" Data="{StaticResource PauseStroke}" IsVisible="{Binding Playback.IsPlaying}" />
                                    </Panel>
                                </Button>
                                <TextBlock FontSize="12"
                                           FontFeatures="tnum"
                                           VerticalAlignment="Center"
                                           MinWidth="112"
                                           TextAlignment="Right"
                                           Text="{Binding Playback.PositionText}" />
                                <Border Width="1" Height="18" Background="{DynamicResource SubtleBorderBrush}" />
                                <TextBlock Classes="caption"
                                           VerticalAlignment="Center"
                                           Text="{x:Static res:Strings.GenerateLookAheadLabel}" />
                                <ui:LookAheadSlider Width="130"
                                        VerticalAlignment="Center"
                                        LookAhead="{Binding LookAhead}"
                                        ToolTip.Tip="{x:Static res:Strings.GenerateLookAheadToolTip}"
                                        AutomationProperties.Name="{x:Static res:Strings.GenerateLookAheadLabel}" />
                                <TextBlock FontSize="12"
                                           FontFeatures="tnum"
                                           VerticalAlignment="Center"
                                           MinWidth="38"
                                           Text="{Binding LookAhead, StringFormat={x:Static sres:SharedStrings.LookAheadFormat}}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Panel Grid.Row="1">
                        <hw:NoteHighwayView x:Name="Highway"
                                            AutomationProperties.Name="{Binding PreviewAutomationName}"
                                            Scene="{Binding Scene}"
                                            Clock="{Binding Clock}"
                                            LookAhead="{Binding LookAhead}"
                                            LengthSeconds="{Binding LengthSeconds}"
                                            SelectedPhrase="{Binding SelectedBand}"
                                            Scrubbed="OnHighwayScrubbed" />
                        <Border Classes="banner"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="420"
                                Margin="24"
                                Padding="20,18"
                                CornerRadius="8"
                                IsHitTestVisible="False"
                                IsVisible="{Binding !HasProposals}">
                            <StackPanel Spacing="6">
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Text="{x:Static res:Strings.GenerateEmptyHeading}" />
                                <TextBlock Classes="note"
                                           TextAlignment="Center"
                                           Text="{Binding EmptyText}" />
                            </StackPanel>
                        </Border>
                    </Panel>
                </Grid>
            </Border>
        </Grid>

        <!-- The whole song: the proposals, and for star power the meter and the hard passages. -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Margin="12,6,12,8" Spacing="4">
                <TextBlock Classes="caption" Text="{x:Static res:Strings.GenerateTimelineHeading}" />
                <bctl:TimelineView x:Name="Timeline"
                                   Height="108"
                                   AutomationProperties.Name="{Binding TimelineAutomationName}"
                                   Cursor="SizeWestEast"
                                   Position="{Binding Playback.PositionSeconds, Mode=TwoWay}"
                                   Length="{Binding LengthSeconds}"
                                   IsPlaying="{Binding Playback.IsPlaying}"
                                   Clock="{Binding Clock}"
                                   WheelUpIsLater="True"
                                   Waveform="{Binding Playback.Waveform}"
                                   Beats="{Binding Playback.Beats}"
                                   Overview="{Binding Overview}"
                                   StarPowerExtras="{Binding TimelineExtras}"
                                   WaveformBrush="{DynamicResource WaveformBrush}"
                                   BeatBrush="{DynamicResource SubtleBorderBrush}"
                                   MeasureBrush="#4A4D66"
                                   TickBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   PlayheadBrush="{DynamicResource AccentTextBrush}" />
            </StackPanel>
        </Border>

        <!-- What applying does, and the way to do it. The notice line's height is kept whether or not it says anything,
             so a warning or an error never grows the footer. -->
        <Border Grid.Row="4" Classes="toolbar" BorderThickness="0,1,0,0" Padding="12,4" Height="48">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding SummaryText}" />
                    <Grid Height="16">
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource WarningTextBrush}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding WarningText}"
                                   ToolTip.Tip="{Binding WarningText}"
                                   IsVisible="{Binding HasWarningOnly}" />
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding StatusText}"
                                   ToolTip.Tip="{Binding StatusText}"
                                   IsVisible="{Binding HasStatus}" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button MinWidth="80"
                            HorizontalContentAlignment="Center"
                            Content="{x:Static sres:SharedStrings.CancelButton}"
                            IsCancel="True"
                            Click="OnCancel" />
                    <Button Classes="accent"
                            MinWidth="140"
                            HorizontalContentAlignment="Center"
                            Content="{Binding ApplyText}"
                            IsEnabled="{Binding CanApply}"
                            Click="OnApply"
                            kb:Shortcut.Tip="{Binding ApplyToolTip}" kb:Shortcut.Action="{x:Static svc:BuilderKeys.ApplyPhrases}"
                            AutomationProperties.Name="{Binding ApplyText}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
