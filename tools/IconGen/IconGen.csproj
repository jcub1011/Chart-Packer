<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders the program icons from the Material Symbols sources in Sources/ (see README.md). Never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned here rather than in Directory.Packages.props: the apps get Skia through Avalonia, and a central
         version would apply to them too the moment one referenced SkiaSharp directly. -->
    <PackageReference Include="SkiaSharp" VersionOverride="4.153.1" />
  </ItemGroup>
</Project>
