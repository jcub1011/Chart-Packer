<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="using:ChartShared.Core.Help"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ChartPacker.ViewModels"
        xmlns:res="using:ChartPacker.Resources"
        xmlns:ctl="using:ChartShared.UI.Controls"
        xmlns:conv="using:ChartShared.UI.Converters"
        xmlns:pc="using:ChartPacker.Controls"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="480"
        x:Class="ChartPacker.Views.OptimizeWindow"
        x:DataType="vm:OptimizeWindowViewModel"
        Title="{x:Static res:Strings.OptimizeWindowTitle}"
        Background="{DynamicResource AppBackgroundBrush}"
        Width="1120" Height="720"
        MinWidth="860" MinHeight="480"
        ShowInTaskbar="False"
        CanMinimize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        WindowDecorationsTheme="{StaticResource TitleBarDecorations}"
        WindowStartupLocation="CenterOwner">

    <!-- It can't be minimized: a modal window with no taskbar entry would have nothing to restore it from, leaving its
         owner disabled. -->

    <Window.Resources>
        <!-- Sliders as short as the rows they sit in, as the inspector's are, without the room Fluent keeps over and
             under one for tick marks. -->
        <x:Double x:Key="SliderHorizontalHeight">20</x:Double>
        <GridLength x:Key="SliderPreContentMargin">4</GridLength>
        <GridLength x:Key="SliderPostContentMargin">4</GridLength>
    </Window.Resources>

    <Window.Styles>
        <!-- The inspector's section headings and icon buttons, for the settings. -->
        <StyleInclude Source="avares://ChartShared.UI/Styles/Inspector.axaml" />

        <Style Selector="TextBlock.warning">
            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.number">
            <Setter Property="FontFeatures" Value="tnum" />
        </Style>

        <!-- A choice of two: radio buttons, so one is always picked, drawn as toggles side by side, as the library's
             All | Any switch is. -->
        <Style Selector="RadioButton.seg">
            <Setter Property="Theme" Value="{StaticResource {x:Type ToggleButton}}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- The one picked: a tint in the accent, as a filter chip that's on is, not a block of it. -->
        <Style Selector="RadioButton.seg:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style Selector="RadioButton.seg:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentTintStrongBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>

        <!-- An optimization: one line, with what it saves at the right. Its settings hang under it from a rule in the
             accent, as a chart's files do in the list, and only while it's on. -->
        <Style Selector="StackPanel.strategy">
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style Selector="TextBlock.saving">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFeatures" Value="tnum" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style Selector="Border.fields">
            <Setter Property="Margin" Value="9,3,0,9" />
            <Setter Property="Padding" Value="17,3,0,3" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
        </Style>
        <Style Selector="Grid.field > TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.field > TextBlock.readout">
            <Setter Property="FontFeatures" Value="tnum" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <!-- An amber notice, as the theme's banner is in the accent. -->
        <Style Selector="Border.banner.warning">
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource WarningTintBrush}" />
        </Style>

        <!-- The size bar: what's kept in grey, what's saved in the accent, what's only predicted in a faint accent. The
             legend under the summary's bar is in the same three. -->
        <Style Selector="pc|SizeBarView">
            <Setter Property="TrackBrush" Value="{DynamicResource ToolHoverBrush}" />
            <Setter Property="KeptBrush" Value="{DynamicResource WaveformBrush}" />
            <Setter Property="SavedBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="PredictedBrush" Value="{DynamicResource AccentTintStrongBrush}" />
        </Style>
        <Style Selector="Border.swatch">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.legend TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- How far through a file a run is, where the chart's size bar was. -->
        <Style Selector="ProgressBar.file">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="6" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ToolHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!-- While a run goes, the spinner takes the icon's place, and cancels under the pointer, as the job window's does. -->
        <Style Selector="Border.title-bar.busy > Grid > Image">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Button.cancel">
            <Setter Property="Width" Value="34" />
            <Setter Property="Padding" Value="6,0,0,0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.cancel ctl|LineIcon">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Button.cancel:pointerover Arc, Button.cancel:focus-visible Arc">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Button.cancel:pointerover ctl|LineIcon, Button.cancel:focus-visible ctl|LineIcon">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.cancel:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolHoverBrush}" />
        </Style>

        <!-- The charts: hover and selection as in the library list (a tint, and a bar in the accent at the left). -->
        <Style Selector="ListBox.charts">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.charts ListBoxItem">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.charts ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolHoverBrush}" />
        </Style>
        <Style Selector="ListBox.charts ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentTintFaintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ListBox.charts ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
        </Style>
        <Style Selector="Border.chart-row">
            <Setter Property="Padding" Value="0,7" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        </Style>
        <!-- The list's column headings, over the row's own columns. -->
        <Style Selector="Grid.columns > TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <!-- What a chart saves: in the accent, as its bar is; quieter while it's a prediction or nothing; amber or red when
             it wants a look. -->
        <Style Selector="TextBlock.saved">
            <Setter Property="FontFeatures" Value="tnum" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.saved.predicted">
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="TextBlock.saved.quiet">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="TextBlock.saved.attention">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
        </Style>
        <Style Selector="TextBlock.saved.failed">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
        </Style>
        <Style Selector="TextBlock.detail.failed, TextBlock.action.failed">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="TextBlock.detail.attention">
            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="TextBlock.action.kept">
            <Setter Property="Opacity" Value="0.6" />
        </Style>

        <!-- A before or after picture: a tile, as the inspector's art is, that keeps its place while the picture is made. -->
        <Style Selector="Border.picture">
            <Setter Property="Background" Value="{DynamicResource ToolbarGroupBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="MinHeight" Value="120" />
        </Style>

        <Style Selector="TextBlock.chip-label.problem">
            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
        </Style>
    </Window.Styles>

    <Window.DataTemplates>
        <!-- One optimization's line: its switch, with an icon and its name; what the files become; what it saves. Under it,
             why it can't run, when it can't. -->
        <DataTemplate DataType="vm:OptimizeStrategyToggle">
            <StackPanel ToolTip.Tip="{Binding Description}">
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" Background="Transparent">
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsOn}"
                              IsEnabled="{Binding IsAvailable}"
                              AutomationProperties.Name="{Binding Title}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <ctl:LineIcon Width="14" Height="14" Opacity="0.7" VerticalAlignment="Center"
                                          Data="{Binding IconKey, Converter={x:Static conv:LineIconConverter.Instance}}" />
                            <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Title}" />
                        </StackPanel>
                    </CheckBox>
                    <Border Grid.Column="1" Classes="chip" HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding HasFormatTag}">
                        <TextBlock Text="{Binding FormatTag}" />
                    </Border>
                    <TextBlock Grid.Column="2" Classes="saving" Text="{Binding SavingText}" />
                </Grid>
                <TextBlock Classes="warning" Margin="28,0,0,4" IsVisible="{Binding IsUnavailable}" Text="{Binding UnavailableText}" />
            </StackPanel>
        </DataTemplate>

        <!-- One chart: its name and what happens to it, its size, the size as a bar, and what it saves. Selected, its
             files are listed under it. -->
        <DataTemplate DataType="vm:OptimizeChartRow">
            <Border Classes="chart-row" ToolTip.Tip="{Binding ToolTip}">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,68,90,118,38" ColumnSpacing="10">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                        <TextBlock Classes="muted detail"
                                   Classes.failed="{Binding IsFailed}"
                                   Classes.attention="{Binding IsAttention}"
                                   FontSize="11"
                                   MinHeight="15"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding Detail}" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Classes="muted number" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Text="{Binding SizeText}" />

                    <Panel Grid.Column="2" VerticalAlignment="Center">
                        <pc:SizeBarView Height="6"
                                        IsVisible="{Binding IsNotWorking}"
                                        Kept="{Binding BarKept}" Saved="{Binding BarSaved}" Predicted="{Binding BarPredicted}" />
                        <ProgressBar Classes="file" Minimum="0" Maximum="1"
                                     IsVisible="{Binding IsWorking}"
                                     Value="{Binding WorkingFraction}" />
                    </Panel>

                    <TextBlock Grid.Column="3" Classes="saved"
                               Classes.predicted="{Binding IsPredicted}"
                               Classes.quiet="{Binding IsQuiet}"
                               Classes.attention="{Binding IsAttention}"
                               Classes.failed="{Binding IsFailed}"
                               Text="{Binding SavingText}" />
                    <TextBlock Grid.Column="4" Classes="muted number" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Text="{Binding PercentText}" />

                    <!-- The breakdown: a click in it is the breakdown's own, and doesn't close the row. -->
                    <pc:QuietBorder Grid.Row="1" Grid.ColumnSpan="5"
                                    Margin="2,8,0,2" Padding="10,0,0,0"
                                    BorderThickness="2,0,0,0"
                                    BorderBrush="{DynamicResource AccentBorderBrush}"
                                    IsVisible="{Binding IsExpanded}">
                      <StackPanel>
                        <ItemsControl ItemsSource="{Binding Files}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:OptimizeFileRow">
                                    <Grid ColumnDefinitions="190,*,Auto" ColumnSpacing="12" Margin="0,2">
                                        <TextBlock Grid.Column="0" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip.Tip="{Binding Name}" />
                                        <TextBlock Grid.Column="1" Classes="action"
                                                   Classes.kept="{Binding IsKept}"
                                                   Classes.failed="{Binding IsFailed}"
                                                   FontSize="12" TextWrapping="Wrap" Text="{Binding Action}" />
                                        <TextBlock Grid.Column="2" Classes="muted number" FontSize="12" Text="{Binding Sizes}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Previews}" IsVisible="{Binding HasPreviews}" />
                      </StackPanel>
                    </pc:QuietBorder>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One of a chart's pictures as it is beside as it would be: an image, or a video a frame at a time. -->
        <DataTemplate DataType="vm:OptimizeMediaPreviewViewModel">
            <StackPanel Margin="0,12,0,4" Spacing="6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsVideo}">
                        <TextBlock Classes="muted number" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" Text="{Binding FrameText}" />
                        <Button Classes="tool" Command="{Binding PreviousFrameCommand}"
                                ToolTip.Tip="{x:Static res:Strings.OptimizePreviewPreviousFrame}"
                                AutomationProperties.Name="{x:Static res:Strings.OptimizePreviewPreviousFrame}">
                            <ctl:LineIcon Data="{StaticResource ArrowLeftStroke}" />
                        </Button>
                        <Button Classes="tool" Command="{Binding NextFrameCommand}"
                                ToolTip.Tip="{x:Static res:Strings.OptimizePreviewNextFrame}"
                                AutomationProperties.Name="{x:Static res:Strings.OptimizePreviewNextFrame}">
                            <ctl:LineIcon Data="{StaticResource ArrowRightStroke}" />
                        </Button>
                    </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                    <Border Grid.Column="0" Classes="picture">
                        <Panel>
                            <Image Source="{Binding Before}" Stretch="Uniform" MaxHeight="300" />
                            <Arc Classes="spinner" Classes.active="{Binding IsLoading}" Width="18" Height="18" StrokeThickness="2" IsVisible="{Binding IsLoading}" />
                        </Panel>
                    </Border>
                    <Border Grid.Column="1" Classes="picture">
                        <Panel>
                            <Image Source="{Binding After}" Stretch="Uniform" MaxHeight="300" />
                            <Arc Classes="spinner" Classes.active="{Binding IsLoading}" Width="18" Height="18" StrokeThickness="2" IsVisible="{Binding IsLoading}" />
                        </Panel>
                    </Border>
                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="muted number" FontSize="11" Text="{Binding BeforeCaption}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="muted number" FontSize="11" Text="{Binding AfterCaption}" />
                </Grid>
                <TextBlock Classes="warning" IsVisible="{Binding HasError}" Text="{Binding ErrorText}" />
            </StackPanel>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- The title bar, as the main window's is, over the progress of what's going on. Layered: the progress, then the
             title bar, see-through so the progress shows, then, while a run goes, the spinner that stops it. -->
        <Panel Grid.Row="0" Height="31">
            <ProgressBar Classes="fill"
                         Margin="0,0,0,1"
                         Minimum="0" Maximum="100"
                         Value="{Binding ProgressValue}"
                         IsIndeterminate="{Binding IsProgressIndeterminate}"
                         IsVisible="{Binding IsWorking}"
                         IsHitTestVisible="False"
                         AutomationProperties.Name="{Binding StatusText}" />

            <ctl:TitleBar x:Name="WindowTitleBar"
                          HelpPage="{x:Static help:HelpPages.Optimize}"
                          Background="Transparent"
                          BorderThickness="0,0,0,1"
                          BorderBrush="{DynamicResource SubtleBorderBrush}"
                          Classes.busy="{Binding IsRunning}"
                          AppName="{x:Static res:Strings.AppName}">
                <TextBlock Margin="8,0,12,0"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{x:Static res:Strings.OptimizeWindowTitle}" />
            </ctl:TitleBar>

            <Button Classes="cancel"
                    Margin="0,0,0,1"
                    chrome:WindowDecorationProperties.ElementRole="User"
                    Command="{Binding StopCommand}"
                    IsVisible="{Binding IsRunning}"
                    ToolTip.Tip="{x:Static res:Strings.OptimizeStopToolTip}"
                    AutomationProperties.Name="{x:Static res:Strings.OptimizeStopButton}">
                <Panel>
                    <Arc Classes="spinner" Classes.active="{Binding IsRunning}" Width="14" Height="14" StrokeThickness="2" />
                    <ctl:LineIcon Data="{StaticResource ClearStroke}" />
                </Panel>
            </Button>
        </Panel>

        <Grid Grid.Row="1" ColumnDefinitions="352,*">
            <!-- Which charts, what to do to them, and where the changed charts go: a side panel, on the library panel's
                 surface. It can't change under a run. -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource SubtleBorderBrush}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding IsNotRunning}">
                    <StackPanel Margin="12,0,14,18">
                        <TextBlock Classes="section" Margin="0,12,0,8" Text="{x:Static res:Strings.OptimizeScopeLabel}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="4" IsVisible="{Binding HasSelection}">
                            <RadioButton Grid.Column="0" Classes="seg" GroupName="Scope" IsChecked="{Binding UseSelection}" Content="{Binding SelectedScopeText}" />
                            <RadioButton Grid.Column="1" Classes="seg" GroupName="Scope" IsChecked="{Binding UseWholeLibrary}" Content="{Binding LibraryScopeText}" />
                        </Grid>
                        <TextBlock Classes="muted number" FontSize="12" IsVisible="{Binding HasNoSelection}" Text="{Binding LibraryScopeText}" />

                        <!-- The heading, with the button that puts the settings back, as an inspector heading has its revert. -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="section" Text="{x:Static res:Strings.OptimizeShrinkLabel}" />
                            <Button Grid.Column="1" Classes="icon" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                    Command="{Binding ResetCommand}"
                                    ToolTip.Tip="{x:Static res:Strings.OptimizeResetButton}"
                                    AutomationProperties.Name="{x:Static res:Strings.OptimizeResetButton}">
                                <ctl:LineIcon Width="12" Height="12" Data="{StaticResource RevertStroke}" />
                            </Button>
                        </Grid>

                        <StackPanel DataContext="{Binding Settings}" x:DataType="vm:OptimizeSettingsViewModel">
                            <!-- Audio. -->
                            <StackPanel Classes="strategy">
                                <ContentControl Content="{Binding Audio}" />
                                <Border Classes="fields" IsVisible="{Binding Audio.IsOn}">
                                    <Grid Classes="field" ColumnDefinitions="76,*" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Classes="muted" Text="{x:Static res:Strings.OptimizeAudioBitrateLabel}" />
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding BitrateChoices}" SelectedItem="{Binding SelectedBitrate}"
                                                  AutomationProperties.Name="{x:Static res:Strings.OptimizeAudioBitrateLabel}" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Stem mixdown. -->
                            <StackPanel Classes="strategy">
                                <ContentControl Content="{Binding StemMixdown}" />
                                <Border Classes="fields" IsVisible="{Binding StemMixdown.IsOn}">
                                    <Grid Classes="field" ColumnDefinitions="76,*" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Classes="muted" Text="{x:Static res:Strings.OptimizeAudioBitrateLabel}" />
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding MixdownBitrateChoices}" SelectedItem="{Binding SelectedMixdownBitrate}"
                                                  AutomationProperties.Name="{x:Static res:Strings.OptimizeMixdownBitrateLabel}" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Video. -->
                            <StackPanel Classes="strategy">
                                <ContentControl Content="{Binding Video}" />
                                <Border Classes="fields" IsVisible="{Binding Video.IsOn}">
                                    <StackPanel Spacing="6">
                                        <Grid Classes="field" ColumnDefinitions="76,*" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Classes="muted" Text="{x:Static res:Strings.OptimizeVideoTargetLabel}" />
                                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding VideoTargets}" SelectedItem="{Binding SelectedVideoTarget}"
                                                      AutomationProperties.Name="{x:Static res:Strings.OptimizeVideoTargetLabel}" />
                                        </Grid>
                                        <Grid Classes="field" ColumnDefinitions="76,*,Auto" ColumnSpacing="8" Background="Transparent"
                                              ToolTip.Tip="{x:Static res:Strings.OptimizeVideoCqDescription}">
                                            <TextBlock Grid.Column="0" Classes="muted" Text="{x:Static res:Strings.OptimizeVideoCqLabel}" />
                                            <Slider Grid.Column="1" Minimum="4" Maximum="63" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    Value="{Binding VideoCq}" AutomationProperties.Name="{x:Static res:Strings.OptimizeVideoCqLabel}" />
                                            <TextBlock Grid.Column="2" Classes="readout" Text="{Binding VideoCqText}" />
                                        </Grid>
                                        <Grid Classes="field" ColumnDefinitions="76,*" ColumnSpacing="8" Background="Transparent"
                                              ToolTip.Tip="{x:Static res:Strings.OptimizeVideoSpeedDescription}">
                                            <TextBlock Grid.Column="0" Classes="muted" Text="{x:Static res:Strings.OptimizeVideoSpeedLabel}" />
                                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding VideoSpeeds}" SelectedItem="{Binding SelectedVideoSpeed}"
                                                      AutomationProperties.Name="{x:Static res:Strings.OptimizeVideoSpeedLabel}" />
                                        </Grid>
                                        <CheckBox FontSize="12"
                                                  IsChecked="{Binding VideoConvertUnsupported}"
                                                  Content="{x:Static res:Strings.OptimizeVideoConvertLabel}"
                                                  ToolTip.Tip="{x:Static res:Strings.OptimizeVideoConvertDescription}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Album art. -->
                            <StackPanel Classes="strategy">
                                <ContentControl Content="{Binding AlbumArt}" />
                                <Border Classes="fields" IsVisible="{Binding AlbumArt.IsOn}">
                                    <StackPanel Spacing="6">
                                        <Grid Classes="field" ColumnDefinitions="76,*,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Classes="muted" Text="{x:Static res:Strings.OptimizeImageQualityLabel}" />
                                            <Slider Grid.Column="1" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    Value="{Binding AlbumArtQuality}" AutomationProperties.Name="{x:Static res:Strings.OptimizeImageQualityLabel}" />
                                            <TextBlock Grid.Column="2" Classes="readout" Text="{Binding AlbumArtQualityText}" />
                                        </Grid>
                                        <Grid Classes="field" ColumnDefinitions="76,*" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Classes="muted" Text="{x:Static res:Strings.OptimizeImageLimitLabel}" />
                                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding AlbumArtLimits}" SelectedItem="{Binding SelectedAlbumArtLimit}"
                                                      AutomationProperties.Name="{x:Static res:Strings.OptimizeImageLimitLabel}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Background images. -->
                            <StackPanel Classes="strategy">
                                <ContentControl Content="{Binding BackgroundArt}" />
                                <Border Classes="fields" IsVisible="{Binding BackgroundArt.IsOn}">
                                    <StackPanel Spacing="6">
                                        <Grid Classes="field" ColumnDefinitions="76,*,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Classes="muted" Text="{x:Static res:Strings.OptimizeImageQualityLabel}" />
                                            <Slider Grid.Column="1" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    Value="{Binding BackgroundArtQuality}" AutomationProperties.Name="{x:Static res:Strings.OptimizeImageQualityLabel}" />
                                            <TextBlock Grid.Column="2" Classes="readout" Text="{Binding BackgroundArtQualityText}" />
                                        </Grid>
                                        <Grid Classes="field" ColumnDefinitions="76,*" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Classes="muted" Text="{x:Static res:Strings.OptimizeImageLimitLabel}" />
                                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding BackgroundArtLimits}" SelectedItem="{Binding SelectedBackgroundArtLimit}"
                                                      AutomationProperties.Name="{x:Static res:Strings.OptimizeImageLimitLabel}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Metadata cleanup: last, as it saves next to nothing. -->
                            <StackPanel Classes="strategy">
                                <ContentControl Content="{Binding Metadata}" />
                                <Border Classes="fields" IsVisible="{Binding Metadata.IsOn}">
                                    <StackPanel Spacing="2">
                                        <CheckBox FontSize="12" IsChecked="{Binding PruneEmptyParts}" Content="{x:Static res:Strings.OptimizePruneEmptyPartsLabel}" />
                                        <CheckBox FontSize="12" IsChecked="{Binding StripEditorEvents}" Content="{x:Static res:Strings.OptimizeStripEditorEventsLabel}" />
                                        <CheckBox FontSize="12" IsChecked="{Binding DropEmptyValues}" Content="{x:Static res:Strings.OptimizeDropEmptyValuesLabel}" />
                                        <CheckBox FontSize="12" IsChecked="{Binding ReplaceLegacyKeys}" Content="{x:Static res:Strings.OptimizeReplaceLegacyKeysLabel}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- How small a saving is still worth acting on: it holds for every optimization above but metadata. -->
                            <Border Margin="0,8,0,0" Padding="0,10,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SubtleBorderBrush}">
                                <Grid Classes="field" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Background="Transparent"
                                      ToolTip.Tip="{x:Static res:Strings.OptimizeMarginDescription}">
                                    <TextBlock Grid.Column="0" Classes="muted" Text="{x:Static res:Strings.OptimizeMarginLabel}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="90" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding MarginPercent}" AutomationProperties.Name="{x:Static res:Strings.OptimizeMarginLabel}" />
                                    <TextBlock Grid.Column="2" Classes="readout" Text="{Binding MarginText}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Where the changed charts go. -->
                        <TextBlock Classes="section" Text="{x:Static res:Strings.OptimizeOutputLabel}" />
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                                <RadioButton Grid.Column="0" Classes="seg" GroupName="Output"
                                             IsChecked="{Binding Settings.UseOutputFolder}"
                                             Content="{x:Static res:Strings.OptimizeToFolder}"
                                             ToolTip.Tip="{x:Static res:Strings.OptimizeToFolderDescription}" />
                                <RadioButton Grid.Column="1" Classes="seg" GroupName="Output"
                                             IsChecked="{Binding Settings.IsInPlace}"
                                             Content="{x:Static res:Strings.OptimizeInPlaceOption}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" IsVisible="{Binding Settings.UseOutputFolder}">
                                <TextBox Grid.Column="0" Text="{Binding Settings.OutputFolder}" PlaceholderText="{x:Static res:Strings.OptimizeOutputFolderPlaceholder}"
                                         AutomationProperties.Name="{x:Static res:Strings.OptimizeOutputLabel}" />
                                <Button Grid.Column="1" Classes="tool" VerticalAlignment="Center"
                                        Command="{Binding BrowseOutputCommand}"
                                        ToolTip.Tip="{x:Static res:Strings.OptimizeBrowseButton}"
                                        AutomationProperties.Name="{x:Static res:Strings.OptimizeBrowseButton}">
                                    <ctl:LineIcon Data="{StaticResource OutputFolderStroke}" />
                                </Button>
                            </Grid>
                            <TextBlock Classes="warning" IsVisible="{Binding HasOutputFolderProblem}" Text="{Binding OutputFolderProblemText}" />
                            <Border Classes="banner warning" IsVisible="{Binding Settings.IsInPlace}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <ctl:LineIcon Grid.Column="0" Width="12" Height="12" Margin="0,3,0,0" VerticalAlignment="Top"
                                                  Foreground="{DynamicResource WarningTextBrush}" Data="{StaticResource WarningStroke}" />
                                    <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap" Text="{x:Static res:Strings.OptimizeInPlaceWarning}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*">
                <!-- What it all comes to: the charts' size before and after, the saving, the size as a bar with what its
                     colours stand for, and how much of the figure is measured. -->
                <Border Grid.Row="0" Padding="16,14" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SubtleBorderBrush}">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <TextBlock Grid.Column="0" Classes="number" FontSize="22" TextTrimming="CharacterEllipsis" Text="{Binding SizesText}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasSaving}">
                                <TextBlock Classes="number" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Text="{Binding SavingText}" />
                                <Border Classes="chip large" VerticalAlignment="Center"
                                        IsVisible="{Binding PercentText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Classes="number" Text="{Binding PercentText}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <pc:SizeBarView Height="10" Margin="0,12,0,10"
                                        Kept="{Binding BarKept}" Saved="{Binding BarSaved}" Predicted="{Binding BarPredicted}"
                                        AutomationProperties.Name="{x:Static res:Strings.OptimizeSummaryBarName}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <StackPanel Grid.Column="0" Classes="legend" Orientation="Horizontal" Spacing="14" IsVisible="{Binding HasSaving}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Classes="swatch" Background="{DynamicResource WaveformBrush}" />
                                    <TextBlock Text="{x:Static res:Strings.OptimizeLegendKept}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Classes="swatch" Background="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="{x:Static res:Strings.OptimizeLegendSaved}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasPredicted}">
                                    <Border Classes="swatch" Background="{DynamicResource AccentTintStrongBrush}" />
                                    <TextBlock Text="{x:Static res:Strings.OptimizeLegendPredicted}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Classes="muted number" FontSize="12"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding CoverageText}" ToolTip.Tip="{Binding CoverageText}" />
                        </Grid>
                        <Border Classes="banner error" Margin="0,10,0,0" IsVisible="{Binding HasError}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <ctl:LineIcon Grid.Column="0" Width="12" Height="12" Margin="0,3,0,0" VerticalAlignment="Top" Data="{StaticResource WarningStroke}" />
                                <SelectableTextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap" Text="{Binding ErrorText}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Search, the order, and a chip per group of charts, as the library's search strip is. With no chip on,
                     every chart is shown; with some on, only theirs. -->
                <Border Grid.Row="1" Padding="12,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SubtleBorderBrush}">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0"
                                 Classes="clearButton"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding SearchText}"
                                 PlaceholderText="{x:Static res:Strings.OptimizeSearchWatermark}"
                                 AutomationProperties.Name="{x:Static res:Strings.OptimizeSearchWatermark}">
                            <TextBox.InnerLeftContent>
                                <ctl:LineIcon Data="{StaticResource SearchStroke}" Margin="8,0,0,0" Opacity="0.6" />
                            </TextBox.InnerLeftContent>
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Escape" Command="{Binding ClearSearchCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>

                        <ComboBox Grid.Column="1" MinWidth="130" VerticalAlignment="Center"
                                  ItemsSource="{Binding SortChoices}" SelectedItem="{Binding SelectedSort}"
                                  ToolTip.Tip="{x:Static res:Strings.OptimizeSortLabel}"
                                  AutomationProperties.Name="{x:Static res:Strings.OptimizeSortLabel}" />

                        <ItemsControl Grid.Column="2" VerticalAlignment="Center" ItemsSource="{Binding Chips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:OptimizeFilterChip">
                                    <ToggleButton Classes="filterChip" IsChecked="{Binding IsOn}" AutomationProperties.Name="{Binding Label}">
                                        <TextBlock Classes="chip-label number" Classes.problem="{Binding IsAlert}" VerticalAlignment="Center" Text="{Binding Label}" />
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- What the list's columns are, over the columns of its rows: inset as a row is, by its bar and padding. -->
                <Border Grid.Row="2" Padding="15,5,12,5" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SubtleBorderBrush}">
                    <Grid Classes="columns" ColumnDefinitions="*,68,90,118,38" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.OptimizeColumnChart}" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{x:Static res:Strings.OptimizeSortSize}" />
                        <TextBlock Grid.Column="3" HorizontalAlignment="Right" Text="{x:Static res:Strings.OptimizeSortSaving}" />
                    </Grid>
                </Border>

                <!-- Every chart, or why there are none to show. -->
                <Panel Grid.Row="3">
                    <ListBox x:Name="ChartList"
                             Classes="charts"
                             SelectionMode="Single,Toggle"
                             ItemsSource="{Binding Rows}"
                             SelectedItem="{Binding SelectedRow}"
                             AutomationProperties.Name="{x:Static res:Strings.OptimizeChartListName}" />
                    <TextBlock Classes="muted centered"
                               VerticalAlignment="Center"
                               Margin="24"
                               TextWrapping="Wrap"
                               IsHitTestVisible="False"
                               Text="{x:Static res:Strings.OptimizeNoCharts}"
                               IsVisible="{Binding HasNoCharts}" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" IsVisible="{Binding HasNoMatches}">
                        <TextBlock Classes="muted centered" Text="{x:Static res:Strings.OptimizeNoMatches}" />
                        <Button HorizontalAlignment="Center" Content="{x:Static res:Strings.OptimizeClearFilters}" Command="{Binding ClearFiltersCommand}" />
                    </StackPanel>
                </Panel>
            </Grid>
        </Grid>

        <!-- What's going on at the left, with the button that pauses measuring; Optimize or Stop, and Close, at the right.
             Padded as the inspector's save bar is. -->
        <Border Grid.Row="2" Classes="toolbar" Padding="12,8" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Arc Classes="spinner" Classes.active="{Binding IsWorking}" Width="14" Height="14" StrokeThickness="2" IsVisible="{Binding IsWorking}" />
                    <TextBlock Classes="number" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"
                               Text="{Binding StatusText}" ToolTip.Tip="{Binding StatusText}" />
                    <Button Classes="tool"
                            Command="{Binding TogglePauseCommand}"
                            IsVisible="{Binding IsMeasuring}"
                            AutomationProperties.Name="{Binding PauseLabel}">
                        <ToolTip.Tip>
                            <ctl:TitledToolTip Title="{Binding PauseLabel}" Description="{x:Static res:Strings.OptimizePauseToolTip}" />
                        </ToolTip.Tip>
                        <Panel>
                            <ctl:LineIcon Data="{StaticResource PauseStroke}" IsVisible="{Binding !IsPaused}" />
                            <ctl:LineIcon Data="{StaticResource PlayStroke}" IsVisible="{Binding IsPaused}" />
                        </Panel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding IsNotRunning}"
                               Text="{Binding BlockedText}" ToolTip.Tip="{Binding BlockedText}" />
                    <Button Classes="labelled"
                            Command="{Binding OpenOutputCommand}"
                            IsVisible="{Binding CanOpenOutput}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ctl:LineIcon Data="{StaticResource OutputFolderStroke}" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.OptimizeOpenOutputButton}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="labelled accent"
                            MinWidth="120"
                            HorizontalContentAlignment="Center"
                            Command="{Binding OptimizeCommand}"
                            ToolTip.Tip="{Binding OptimizeToolTip}"
                            ToolTip.ShowOnDisabled="True"
                            AutomationProperties.Name="{Binding OptimizeLabel}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ctl:LineIcon Data="{StaticResource SqueezeStroke}" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding OptimizeLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="labelled"
                            MinWidth="80"
                            HorizontalContentAlignment="Center"
                            Content="{x:Static res:Strings.OptimizeStopButton}"
                            Command="{Binding StopCommand}"
                            IsVisible="{Binding IsRunning}"
                            ToolTip.Tip="{x:Static res:Strings.OptimizeStopToolTip}" />
                    <Button Classes="labelled"
                            MinWidth="80"
                            HorizontalContentAlignment="Center"
                            Content="{x:Static res:Strings.CloseButton}"
                            Command="{Binding CloseCommand}"
                            IsCancel="True"
                            AutomationProperties.Name="{x:Static res:Strings.CloseButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
