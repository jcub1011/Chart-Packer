<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="using:ChartShared.Core.Help"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ChartPacker.ViewModels"
        xmlns:res="using:ChartPacker.Resources"
        xmlns:ctl="using:ChartShared.UI.Controls"
        mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="760"
        x:Class="ChartPacker.Views.OptimizeWindow"
        x:DataType="vm:OptimizeWindowViewModel"
        Title="{x:Static res:Strings.OptimizeWindowTitle}"
        Background="{DynamicResource AppBackgroundBrush}"
        Width="1040" Height="760"
        MinWidth="780" MinHeight="520"
        ShowInTaskbar="False"
        CanMinimize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        WindowDecorationsTheme="{StaticResource TitleBarDecorations}"
        WindowStartupLocation="CenterOwner">

    <!-- It can't be minimized: a modal window with no taskbar entry would have nothing to restore it from, leaving its
         owner disabled. -->

    <Window.Styles>
        <Style Selector="TextBlock.warning">
            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.problem">
            <Setter Property="Foreground" Value="{DynamicResource InvalidBrush}" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- A section: a surface with a subtle outline, as the main window's panels are. -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="StackPanel.detail">
            <Setter Property="Margin" Value="26,8,0,0" />
            <Setter Property="Spacing" Value="6" />
        </Style>
        <Style Selector="Grid.setting > TextBlock.caption">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Window.DataTemplates>
        <!-- One strategy's estimate: its codecs, the sample it was made from, and what it comes to. -->
        <DataTemplate DataType="vm:OptimizeEstimateSection">
            <StackPanel Spacing="4" Margin="0,0,0,14">
                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                <TextBlock Classes="note" Text="{Binding Sample}" />
                <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:OptimizeEstimateRow">
                            <Grid ColumnDefinitions="*,Auto,150,150" ColumnSpacing="10" Margin="0,3">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <TextBlock FontSize="12" Text="{Binding Codec}" />
                                    <Border Classes="chip" IsVisible="{Binding IsCompatibility}"
                                            ToolTip.Tip="{x:Static res:Strings.OptimizeCompatibilityToolTip}">
                                        <TextBlock Text="{x:Static res:Strings.OptimizeCompatibilityChip}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" FontSize="12" Classes="muted" Text="{Binding Assets}" />
                                <TextBlock Grid.Column="2" FontSize="12" Classes.warning="{Binding IsCost}" Text="{Binding Saving}" />
                                <TextBlock Grid.Column="3" FontSize="12" Classes="muted" Text="{Binding PerChart}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="note" IsVisible="{Binding HasNoRows}" Text="{x:Static res:Strings.OptimizeSavingsNone}" />
                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Total}" />
                <TextBlock Classes="warning" FontSize="12" IsVisible="{Binding HasCompatibilityNote}" Text="{Binding CompatibilityNote}" />
            </StackPanel>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- The title bar, as the main window's is, over the progress of what's going on. Layered: the progress, then the
             title bar, see-through so the progress shows. -->
        <Panel Grid.Row="0" Height="31">
            <ProgressBar Classes="fill"
                         Margin="0,0,0,1"
                         Minimum="0" Maximum="100"
                         Value="{Binding ProgressValue}"
                         IsIndeterminate="{Binding IsProgressIndeterminate}"
                         IsVisible="{Binding IsBusy}"
                         IsHitTestVisible="False"
                         AutomationProperties.Name="{Binding ProgressText}" />

            <ctl:TitleBar x:Name="WindowTitleBar"
                          HelpPage="{x:Static help:HelpPages.Optimize}"
                          Background="Transparent"
                          BorderThickness="0,0,0,1"
                          BorderBrush="{DynamicResource SubtleBorderBrush}"
                          AppName="{x:Static res:Strings.AppName}">
                <TextBlock Margin="8,0,12,0"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{x:Static res:Strings.OptimizeWindowTitle}" />
            </ctl:TitleBar>
        </Panel>

        <Grid Grid.Row="1" ColumnDefinitions="440,*">
            <!-- What to do, and how. -->
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding IsIdle}">
                <StackPanel Margin="12" Spacing="10">
                    <Border Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="heading" Text="{x:Static res:Strings.OptimizeScopeLabel}" />
                            <StackPanel Spacing="4" IsVisible="{Binding HasSelection}">
                                <RadioButton GroupName="Scope" IsChecked="{Binding UseSelection}" Content="{Binding SelectedScopeText}" />
                                <RadioButton GroupName="Scope" IsChecked="{Binding UseWholeLibrary}" Content="{x:Static res:Strings.OptimizeScopeLibrary}"
                                             ToolTip.Tip="{x:Static res:Strings.OptimizeScopeLibraryToolTip}" />
                            </StackPanel>
                            <TextBlock Classes="note" Text="{Binding ScopeText}" />
                        </StackPanel>
                    </Border>

                    <!-- Metadata cleanup. -->
                    <Border Classes="card">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding Metadata.IsOn}" IsEnabled="{Binding Metadata.IsAvailable}" Content="{Binding Metadata.Title}" FontWeight="SemiBold" />
                            <TextBlock Classes="note" Margin="26,0,0,0" Text="{Binding Metadata.Description}" />
                            <StackPanel Classes="detail" IsEnabled="{Binding Metadata.IsOn}">
                                <CheckBox IsChecked="{Binding PruneEmptyParts}" Content="{x:Static res:Strings.OptimizePruneEmptyPartsLabel}" />
                                <CheckBox IsChecked="{Binding StripEditorEvents}" Content="{x:Static res:Strings.OptimizeStripEditorEventsLabel}" />
                                <CheckBox IsChecked="{Binding DropEmptyValues}" Content="{x:Static res:Strings.OptimizeDropEmptyValuesLabel}" />
                                <CheckBox IsChecked="{Binding ReplaceLegacyKeys}" Content="{x:Static res:Strings.OptimizeReplaceLegacyKeysLabel}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Audio. -->
                    <Border Classes="card">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding Audio.IsOn}" IsEnabled="{Binding Audio.IsAvailable}" Content="{Binding Audio.Title}" FontWeight="SemiBold" />
                            <TextBlock Classes="note" Margin="26,0,0,0" Text="{Binding Audio.Description}" />
                            <TextBlock Classes="warning" FontSize="12" Margin="26,2,0,0" IsVisible="{Binding Audio.IsUnavailable}" Text="{Binding Audio.UnavailableText}" />
                            <StackPanel Classes="detail" IsEnabled="{Binding Audio.IsOn}">
                                <Grid Classes="setting" ColumnDefinitions="120,*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Classes="caption" Text="{x:Static res:Strings.OptimizeAudioBitrateLabel}" />
                                    <ComboBox Grid.Column="1" MinWidth="170" ItemsSource="{Binding BitrateChoices}" SelectedItem="{Binding SelectedBitrate}"
                                              AutomationProperties.Name="{x:Static res:Strings.OptimizeAudioBitrateLabel}" />
                                </Grid>
                            </StackPanel>
                            <CheckBox Margin="0,10,0,0" IsChecked="{Binding StemMixdown.IsOn}" IsEnabled="{Binding StemMixdown.IsAvailable}" Content="{Binding StemMixdown.Title}" FontWeight="SemiBold" />
                            <TextBlock Classes="note" Margin="26,0,0,0" Text="{Binding StemMixdown.Description}" />
                            <StackPanel Classes="detail" IsEnabled="{Binding StemMixdown.IsOn}">
                                <Grid Classes="setting" ColumnDefinitions="120,*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Classes="caption" Text="{x:Static res:Strings.OptimizeMixdownBitrateLabel}" />
                                    <ComboBox Grid.Column="1" MinWidth="170" ItemsSource="{Binding MixdownBitrateChoices}" SelectedItem="{Binding SelectedMixdownBitrate}"
                                              AutomationProperties.Name="{x:Static res:Strings.OptimizeMixdownBitrateLabel}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Video. -->
                    <Border Classes="card">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding Video.IsOn}" IsEnabled="{Binding Video.IsAvailable}" Content="{Binding Video.Title}" FontWeight="SemiBold" />
                            <TextBlock Classes="note" Margin="26,0,0,0" Text="{Binding Video.Description}" />
                            <TextBlock Classes="warning" FontSize="12" Margin="26,2,0,0" IsVisible="{Binding Video.IsUnavailable}" Text="{Binding Video.UnavailableText}" />
                            <StackPanel Classes="detail" IsEnabled="{Binding Video.IsOn}">
                                <Grid Classes="setting" ColumnDefinitions="120,*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Classes="caption" Text="{x:Static res:Strings.OptimizeVideoTargetLabel}" />
                                    <ComboBox Grid.Column="1" MinWidth="170" ItemsSource="{Binding VideoTargets}" SelectedItem="{Binding SelectedVideoTarget}"
                                              AutomationProperties.Name="{x:Static res:Strings.OptimizeVideoTargetLabel}" />
                                </Grid>
                                <Grid Classes="setting" ColumnDefinitions="120,*,Auto" ColumnSpacing="8" ToolTip.Tip="{x:Static res:Strings.OptimizeVideoCqDescription}">
                                    <TextBlock Grid.Column="0" Classes="caption" Text="{x:Static res:Strings.OptimizeVideoCqLabel}" />
                                    <Slider Grid.Column="1" Minimum="4" Maximum="63" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding VideoCq}" AutomationProperties.Name="{x:Static res:Strings.OptimizeVideoCqLabel}" />
                                    <TextBlock Grid.Column="2" Classes="caption" MinWidth="48" Text="{Binding VideoCqText}" />
                                </Grid>
                                <CheckBox IsChecked="{Binding VideoConvertUnsupported}" Content="{x:Static res:Strings.OptimizeVideoConvertLabel}"
                                          ToolTip.Tip="{x:Static res:Strings.OptimizeVideoConvertDescription}" />
                                <TextBlock Classes="note" Margin="26,0,0,0" Text="{x:Static res:Strings.OptimizeVideoConvertDescription}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Images. -->
                    <Border Classes="card">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding AlbumArt.IsOn}" IsEnabled="{Binding AlbumArt.IsAvailable}" Content="{Binding AlbumArt.Title}" FontWeight="SemiBold" />
                            <TextBlock Classes="note" Margin="26,0,0,0" Text="{Binding AlbumArt.Description}" />
                            <TextBlock Classes="warning" FontSize="12" Margin="26,2,0,0" IsVisible="{Binding AlbumArt.IsUnavailable}" Text="{Binding AlbumArt.UnavailableText}" />
                            <StackPanel Classes="detail" IsEnabled="{Binding AlbumArt.IsOn}">
                                <Grid Classes="setting" ColumnDefinitions="120,*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Classes="caption" Text="{x:Static res:Strings.OptimizeImageQualityLabel}" />
                                    <Slider Grid.Column="1" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding AlbumArtQuality}" AutomationProperties.Name="{x:Static res:Strings.OptimizeImageQualityLabel}" />
                                    <TextBlock Grid.Column="2" Classes="caption" MinWidth="48" Text="{Binding AlbumArtQualityText}" />
                                </Grid>
                                <Grid Classes="setting" ColumnDefinitions="120,*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Classes="caption" Text="{x:Static res:Strings.OptimizeImageLimitLabel}" />
                                    <ComboBox Grid.Column="1" MinWidth="170" ItemsSource="{Binding AlbumArtLimits}" SelectedItem="{Binding SelectedAlbumArtLimit}"
                                              AutomationProperties.Name="{x:Static res:Strings.OptimizeImageLimitLabel}" />
                                </Grid>
                            </StackPanel>

                            <CheckBox Margin="0,10,0,0" IsChecked="{Binding BackgroundArt.IsOn}" IsEnabled="{Binding BackgroundArt.IsAvailable}" Content="{Binding BackgroundArt.Title}" FontWeight="SemiBold" />
                            <TextBlock Classes="note" Margin="26,0,0,0" Text="{Binding BackgroundArt.Description}" />
                            <TextBlock Classes="warning" FontSize="12" Margin="26,2,0,0" IsVisible="{Binding BackgroundArt.IsUnavailable}" Text="{Binding BackgroundArt.UnavailableText}" />
                            <StackPanel Classes="detail" IsEnabled="{Binding BackgroundArt.IsOn}">
                                <Grid Classes="setting" ColumnDefinitions="120,*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Classes="caption" Text="{x:Static res:Strings.OptimizeImageQualityLabel}" />
                                    <Slider Grid.Column="1" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding BackgroundArtQuality}" AutomationProperties.Name="{x:Static res:Strings.OptimizeImageQualityLabel}" />
                                    <TextBlock Grid.Column="2" Classes="caption" MinWidth="48" Text="{Binding BackgroundArtQualityText}" />
                                </Grid>
                                <Grid Classes="setting" ColumnDefinitions="120,*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Classes="caption" Text="{x:Static res:Strings.OptimizeImageLimitLabel}" />
                                    <ComboBox Grid.Column="1" MinWidth="170" ItemsSource="{Binding BackgroundArtLimits}" SelectedItem="{Binding SelectedBackgroundArtLimit}"
                                              AutomationProperties.Name="{x:Static res:Strings.OptimizeImageLimitLabel}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Savings margin, and where the changed charts go. -->
                    <Border Classes="card">
                        <StackPanel Spacing="10">
                            <Grid Classes="setting" ColumnDefinitions="120,*,Auto" ColumnSpacing="8" ToolTip.Tip="{x:Static res:Strings.OptimizeMarginDescription}">
                                <TextBlock Grid.Column="0" Classes="caption" Text="{x:Static res:Strings.OptimizeMarginLabel}" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding MarginPercent}" AutomationProperties.Name="{x:Static res:Strings.OptimizeMarginLabel}" />
                                <TextBlock Grid.Column="2" Classes="caption" MinWidth="48" Text="{Binding MarginText}" />
                            </Grid>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="heading" Text="{x:Static res:Strings.OptimizeOutputLabel}" />
                                <CheckBox IsChecked="{Binding UseOutputFolder}" Content="{x:Static res:Strings.OptimizeToFolder}"
                                          ToolTip.Tip="{x:Static res:Strings.OptimizeToFolderDescription}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsEnabled="{Binding UseOutputFolder}">
                                    <TextBox Grid.Column="0" Text="{Binding OutputFolder}" PlaceholderText="{x:Static res:Strings.OptimizeOutputFolderPlaceholder}"
                                             AutomationProperties.Name="{x:Static res:Strings.OptimizeOutputLabel}" />
                                    <Button Grid.Column="1" Content="{x:Static res:Strings.OptimizeBrowseButton}" Command="{Binding BrowseOutputCommand}" />
                                </Grid>
                                <TextBlock Classes="warning" FontSize="12" IsVisible="{Binding HasOutputFolderProblem}" Text="{Binding OutputFolderProblemText}" />
                                <TextBlock Classes="warning" FontSize="12" IsVisible="{Binding IsInPlace}" Text="{x:Static res:Strings.OptimizeInPlaceWarning}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- The estimate, and what a run did. -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="0,12,12,12" RowSpacing="10">
                <Border Grid.Row="0" Classes="card">
                    <StackPanel Spacing="8">
                        <Grid Classes="setting" ColumnDefinitions="120,*,Auto" ColumnSpacing="8" IsEnabled="{Binding IsIdle}">
                            <TextBlock Grid.Column="0" Classes="caption" Text="{x:Static res:Strings.OptimizeSamplingLabel}" />
                            <ComboBox Grid.Column="1" MinWidth="200" ItemsSource="{Binding SamplingChoices}" SelectedItem="{Binding SelectedSampling}"
                                      ToolTip.Tip="{x:Static res:Strings.OptimizeSamplingDescription}"
                                      AutomationProperties.Name="{x:Static res:Strings.OptimizeSamplingLabel}" />
                        </Grid>
                        <Grid Classes="setting" ColumnDefinitions="120,*,Auto" ColumnSpacing="8" IsVisible="{Binding IsSingleChartMode}" IsEnabled="{Binding IsIdle}">
                            <TextBlock Grid.Column="0" Classes="caption" Text="{x:Static res:Strings.OptimizeSingleChartLabel}" />
                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding ChartChoices}" SelectedItem="{Binding SelectedChart}"
                                      AutomationProperties.Name="{x:Static res:Strings.OptimizeSingleChartLabel}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Classes="card">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Classes="note" Margin="0,0,0,8"
                                   IsVisible="{Binding !HasEstimate}"
                                   Text="{x:Static res:Strings.OptimizeNoEstimateYet}" />
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <StackPanel IsVisible="{Binding HasEstimate}">
                                    <TextBlock Classes="heading" Text="{x:Static res:Strings.OptimizeSavingsLabel}" />
                                    <Grid ColumnDefinitions="*,Auto,150,150" ColumnSpacing="10" Margin="0,0,0,4">
                                        <TextBlock Grid.Column="0" Classes="caption" Text="{x:Static res:Strings.OptimizeSavingsCodecHeader}" />
                                        <TextBlock Grid.Column="1" Classes="caption" Text="{x:Static res:Strings.OptimizeSavingsFilesHeader}" />
                                        <TextBlock Grid.Column="2" Classes="caption" Text="{x:Static res:Strings.OptimizeSavingsSavesHeader}" />
                                        <TextBlock Grid.Column="3" Classes="caption" Text="{x:Static res:Strings.OptimizeSavingsPerChartHeader}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding EstimateSections}" />
                                </StackPanel>

                                <StackPanel IsVisible="{Binding HasResults}">
                                    <TextBlock Classes="heading" Text="{x:Static res:Strings.OptimizeResultsLabel}" />
                                    <ItemsControl ItemsSource="{Binding Results}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:OptimizeResultRow">
                                                <Grid ColumnDefinitions="*,2*" ColumnSpacing="10" Margin="0,2">
                                                    <TextBlock Grid.Column="0" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               Text="{Binding Name}" ToolTip.Tip="{Binding Name}" />
                                                    <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap" Classes.warning="{Binding IsProblem}" Text="{Binding Status}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Defaults on the left; what's going on in the middle; Estimate, Optimize, Stop and Close on the right. -->
        <Border Grid.Row="2" Classes="toolbar" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button Content="{x:Static res:Strings.OptimizeResetButton}" Command="{Binding ResetCommand}"
                            ToolTip.Tip="{x:Static res:Strings.OptimizeResetToolTip}" />
                    <Button Content="{x:Static res:Strings.OptimizeSaveDefaultsButton}" Command="{Binding SaveDefaultsCommand}"
                            ToolTip.Tip="{x:Static res:Strings.OptimizeSaveDefaultsToolTip}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Arc Classes="spinner active" Width="14" Height="14" StrokeThickness="2" IsVisible="{Binding IsBusy}" />
                    <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" IsVisible="{Binding IsBusy}" Text="{Binding ProgressText}" />
                    <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" IsVisible="{Binding IsIdle}"
                               Classes.warning="{Binding StatusIsProblem}" Text="{Binding StatusText}" ToolTip.Tip="{Binding StatusText}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="{x:Static res:Strings.OptimizeEstimateButton}" Command="{Binding EstimateCommand}"
                            ToolTip.Tip="{x:Static res:Strings.OptimizeEstimateToolTip}" ToolTip.ShowOnDisabled="True" />
                    <Button Classes="accent" Content="{x:Static res:Strings.OptimizeButton}" Command="{Binding OptimizeCommand}"
                            ToolTip.Tip="{x:Static res:Strings.OptimizeButtonToolTip}" ToolTip.ShowOnDisabled="True" />
                    <Button Content="{x:Static res:Strings.OptimizeStopButton}" Command="{Binding StopCommand}" />
                    <Button MinWidth="80"
                            HorizontalContentAlignment="Center"
                            Content="{Binding CloseLabel}"
                            Command="{Binding CloseCommand}"
                            IsCancel="True"
                            AutomationProperties.Name="{Binding CloseLabel}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
