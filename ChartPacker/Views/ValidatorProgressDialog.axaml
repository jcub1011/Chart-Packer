<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ChartPacker.ViewModels"
        xmlns:res="using:ChartPacker.Resources"
        mc:Ignorable="d"
        x:Class="ChartPacker.Views.ValidatorProgressDialog"
        x:DataType="vm:ValidatorWindowViewModel"
        Title="{x:Static res:Strings.ValidatorWindowTitle}"
        SizeToContent="Height"
        Width="400"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Arc Classes="spinner active"
                 Width="12" Height="12" StrokeThickness="2"
                 VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding StatusText}" />
        </StackPanel>
        <ProgressBar Minimum="0"
                     Maximum="{Binding Total}"
                     Value="{Binding Checked}"
                     AutomationProperties.Name="{Binding StatusText}" />
        <!-- Cancel stops the check; nothing opens. -->
        <Button HorizontalAlignment="Right"
                MinWidth="80"
                HorizontalContentAlignment="Center"
                Content="{x:Static res:Strings.CancelButton}"
                IsCancel="True"
                Click="OnCancel"
                AutomationProperties.Name="{x:Static res:Strings.CancelButton}" />
    </StackPanel>
</Window>
