<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ChartPacker.ViewModels"
             xmlns:res="using:ChartPacker.Resources"
             xmlns:ui="using:ChartShared.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="30"
             x:Class="ChartPacker.Views.StatusBarView"
             x:DataType="vm:StatusBarViewModel">

    <UserControl.Styles>
        <!-- The progress fills the bar from the left, behind the text, in the accent's tint. -->
        <Style Selector="ProgressBar.fill">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTintBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>

        <!-- The whole bar is one flat button that opens the progress window. Its hover is a translucent overlay, so the
             progress shows through it. While busy, the text clears the spinner at the left. While a scan runs it's
             disabled, as the window is the job's, but stays plain text rather than greying out. -->
        <Style Selector="Button.bar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.bar.busy">
            <Setter Property="Padding" Value="30,0,12,0" />
        </Style>
        <Style Selector="Button.bar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolHoverBrush}" />
        </Style>
        <Style Selector="Button.bar:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolPressedBrush}" />
        </Style>
        <Style Selector="Button.bar:disabled">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.bar:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>

        <!-- The spinner at the left, over the bar: under the pointer (or focused) it turns into an X that cancels. It
             fills the bar's height inside the top line, so its hover stays below the line. -->
        <Style Selector="Button.cancel">
            <Setter Property="Width" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.cancel ui|LineIcon">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Button.cancel:pointerover Arc, Button.cancel:focus-visible Arc">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Button.cancel:pointerover ui|LineIcon, Button.cancel:focus-visible ui|LineIcon">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.cancel:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolHoverBrush}" />
        </Style>
        <Style Selector="Button.cancel:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolPressedBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- 30 high, line included. Layered: the progress, then the bar's button, then the spinner over its left end. -->
    <Border Height="30"
            BorderThickness="0,1,0,0"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource SubtleBorderBrush}">
        <Panel>
            <ProgressBar Classes="fill"
                         Minimum="0" Maximum="100"
                         Value="{Binding Progress}"
                         IsIndeterminate="{Binding IsIndeterminate}"
                         IsVisible="{Binding IsBusy}"
                         IsHitTestVisible="False"
                         AutomationProperties.Name="{Binding Text}" />

            <!-- Both buttons' tips sit above the bar, at the pointer (StatusBarView.axaml.cs), so they never cover it. -->
            <Button x:Name="BarButton"
                    Classes="bar"
                    Classes.busy="{Binding IsBusy}"
                    Command="{Binding ShowDetailsCommand}"
                    ToolTip.Tip="{x:Static res:Strings.JobDetailsToolTip}"
                    ToolTip.Placement="Custom"
                    AutomationProperties.Name="{x:Static res:Strings.JobDetailsToolTip}"
                    AutomationProperties.HelpText="{Binding Text}">
                <TextBlock Text="{Binding Text}"
                           FontWeight="SemiBold"
                           Classes.muted="{Binding IsMuted}"
                           TextTrimming="CharacterEllipsis" />
            </Button>

            <Button x:Name="CancelButton"
                    Classes="cancel"
                    Command="{Binding CancelCommand}"
                    IsVisible="{Binding IsBusy}"
                    ToolTip.Tip="{Binding CancelToolTip}"
                    ToolTip.Placement="Custom"
                    AutomationProperties.Name="{Binding CancelToolTip}">
                <Panel>
                    <Arc Classes="spinner"
                         Classes.active="{Binding IsBusy}"
                         Width="14" Height="14" StrokeThickness="2" />
                    <ui:LineIcon Data="{StaticResource ClearStroke}" />
                </Panel>
            </Button>
        </Panel>
    </Border>
</UserControl>
