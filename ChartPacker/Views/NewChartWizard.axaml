<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ChartPacker.ViewModels"
        xmlns:res="using:ChartPacker.Resources"
        xmlns:ctl="using:ChartPacker.Controls"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="560"
        x:Class="ChartPacker.Views.NewChartWizard"
        x:DataType="vm:NewChartWizardViewModel"
        Title="{x:Static res:Strings.NewChartWindowTitle}"
        Background="{DynamicResource AppBackgroundBrush}"
        Width="760" Height="560"
        MinWidth="620" MinHeight="480"
        CanMinimize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- The step header: every step's name, the current one in the accent colour. -->
        <Style Selector="TextBlock.step">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.step.current">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style Selector="TextBlock.step-separator">
            <Setter Property="Opacity" Value="0.3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A section's heading, as the inspector heads its sections. -->
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.field">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.warning">
            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.path">
            <Setter Property="TextTrimming" Value="PathSegmentEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The audio files, on the panel's surface, divided by hairlines. -->
        <Style Selector="Border.table">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.file-row">
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style Selector="Border.table.drag-over">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}" />
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
        </Style>

        <Style Selector="Border.art">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- ① Song ─ ② Audio ─ ③ Timing ─ ④ Parts -->
        <Border Grid.Row="0" Classes="toolbar" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="6,4">
                <TextBlock Classes="step" Classes.current="{Binding IsSongStep}" Text="{x:Static res:Strings.NewChartStepSong}" />
                <TextBlock Classes="step-separator" Text="─" />
                <TextBlock Classes="step" Classes.current="{Binding IsAudioStep}" Text="{x:Static res:Strings.NewChartStepAudio}" />
                <TextBlock Classes="step-separator" Text="─" />
                <TextBlock Classes="step" Classes.current="{Binding IsTimingStep}" Text="{x:Static res:Strings.NewChartStepTiming}" />
                <TextBlock Classes="step-separator" Text="─" />
                <TextBlock Classes="step" Classes.current="{Binding IsPartsStep}" Text="{x:Static res:Strings.NewChartStepParts}" />
            </StackPanel>
        </Border>

        <Panel Grid.Row="1" Margin="20,16">
            <!-- ① Song -->
            <Grid ColumnDefinitions="*,24,Auto" IsVisible="{Binding IsSongStep}">
                <StackPanel Grid.Column="0" Spacing="10">
                    <TextBlock Classes="section" Text="{x:Static res:Strings.NewChartSongHeading}" />
                    <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                        <TextBlock Grid.Row="0" Classes="field" Text="{x:Static res:Strings.NewChartNameLabel}" />
                        <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding Name}" AutomationProperties.Name="{x:Static res:Strings.NewChartNameLabel}" />
                        <TextBlock Grid.Row="1" Classes="field" Text="{x:Static res:Strings.NewChartArtistLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Artist}" AutomationProperties.Name="{x:Static res:Strings.NewChartArtistLabel}" />
                        <TextBlock Grid.Row="2" Classes="field" Text="{x:Static res:Strings.NewChartAlbumLabel}" />
                        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Album}" AutomationProperties.Name="{x:Static res:Strings.NewChartAlbumLabel}" />
                        <TextBlock Grid.Row="3" Classes="field" Text="{x:Static res:Strings.NewChartGenreLabel}" />
                        <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding Genre}" AutomationProperties.Name="{x:Static res:Strings.NewChartGenreLabel}" />
                        <TextBlock Grid.Row="4" Classes="field" Text="{x:Static res:Strings.NewChartYearLabel}" />
                        <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding Year}" Width="100" HorizontalAlignment="Left" AutomationProperties.Name="{x:Static res:Strings.NewChartYearLabel}" />
                        <TextBlock Grid.Row="5" Classes="field" Text="{x:Static res:Strings.NewChartCharterLabel}" />
                        <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding Charter}" AutomationProperties.Name="{x:Static res:Strings.NewChartCharterLabel}" />
                    </Grid>
                    <TextBlock Classes="hint" Text="{x:Static res:Strings.NewChartSongHint}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="8" Width="180">
                    <TextBlock Classes="section" Text="{x:Static res:Strings.NewChartArtLabel}" />
                    <Border Classes="art" Width="180" Height="180">
                        <Panel>
                            <Image Source="{Binding ArtPreview}" Stretch="UniformToFill" IsVisible="{Binding HasArt}" />
                            <TextBlock Classes="hint centered"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding !HasArt}"
                                       Text="{x:Static res:Strings.NewChartNoArt}" />
                        </Panel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{x:Static res:Strings.NewChartChooseArtButton}" Command="{Binding PickArtCommand}" />
                        <Button Content="{x:Static res:Strings.NewChartRemoveArtButton}" Command="{Binding ClearArtCommand}" IsVisible="{Binding HasArt}" />
                    </StackPanel>
                    <TextBlock Classes="error" Text="{Binding ArtError}" IsVisible="{Binding HasArtError}" />
                </StackPanel>
            </Grid>

            <!-- ② Audio -->
            <DockPanel IsVisible="{Binding IsAudioStep}">
                <TextBlock DockPanel.Dock="Top" Classes="section" Text="{x:Static res:Strings.NewChartAudioHeading}" />
                <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Button Content="{x:Static res:Strings.NewChartAddFilesButton}" Command="{Binding AddFilesCommand}" />
                        <CheckBox IsChecked="{Binding NoAudio}"
                                  IsEnabled="{Binding !HasFiles}"
                                  VerticalAlignment="Center"
                                  Content="{x:Static res:Strings.NewChartNoAudioLabel}" />
                        <TextBox Text="{Binding LengthText}"
                                 IsEnabled="{Binding NoAudio}"
                                 Width="90"
                                 VerticalAlignment="Center"
                                 AutomationProperties.Name="{x:Static res:Strings.NewChartLengthLabel}"
                                 ToolTip.Tip="{x:Static res:Strings.NewChartLengthToolTip}" />
                    </StackPanel>
                    <TextBlock Classes="hint" Text="{x:Static res:Strings.NewChartAudioHint}" />
                </StackPanel>

                <Border x:Name="AudioDrop" Classes="table" DragDrop.AllowDrop="True">
                    <Panel>
                        <TextBlock Classes="hint centered"
                                   Margin="24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding !HasFiles}"
                                   Text="{x:Static res:Strings.NewChartAudioEmpty}" />
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasFiles}">
                            <ItemsControl ItemsSource="{Binding Files}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NewChartAudioFileViewModel">
                                        <Border Classes="file-row">
                                            <Grid ColumnDefinitions="*,Auto,140,12,Auto,12,20,Auto" RowDefinitions="Auto,Auto">
                                                <TextBlock Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding FileName}"
                                                           ToolTip.Tip="{Binding Path}" />
                                                <TextBlock Grid.Column="1" Classes="step-separator" Margin="8,0" Text="→" />
                                                <ComboBox Grid.Column="2"
                                                          HorizontalAlignment="Stretch"
                                                          ItemsSource="{x:Static vm:NewChartAudioFileViewModel.StemChoices}"
                                                          SelectedItem="{Binding Stem}"
                                                          PlaceholderText="{x:Static res:Strings.NewChartStemPlaceholder}"
                                                          AutomationProperties.Name="{x:Static res:Strings.NewChartStemLabel}" />
                                                <TextBlock Grid.Column="4" Classes="hint" VerticalAlignment="Center" Text="{Binding Details}" />
                                                <Panel Grid.Column="6" VerticalAlignment="Center">
                                                    <Arc Classes="spinner active" Width="14" Height="14" StrokeThickness="2" IsVisible="{Binding IsChecking}" />
                                                    <ctl:LineIcon Data="{StaticResource CheckStroke}" IsVisible="{Binding IsOk}" />
                                                    <TextBlock Classes="warning" Text="⚠" IsVisible="{Binding HasProblem}" ToolTip.Tip="{Binding Problem}" />
                                                </Panel>
                                                <Button Grid.Column="7"
                                                        Classes="tool"
                                                        Margin="6,0,0,0"
                                                        Command="{Binding RemoveCommand}"
                                                        ToolTip.Tip="{x:Static res:Strings.NewChartRemoveFileToolTip}"
                                                        AutomationProperties.Name="{x:Static res:Strings.NewChartRemoveFileToolTip}">
                                                    <ctl:LineIcon Data="{StaticResource ClearStroke}" />
                                                </Button>
                                                <TextBlock Grid.Row="1" Grid.ColumnSpan="8"
                                                           Classes="warning"
                                                           FontSize="12"
                                                           Margin="0,4,0,0"
                                                           Text="{Binding Problem}"
                                                           IsVisible="{Binding HasProblem}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Panel>
                </Border>
            </DockPanel>

            <!-- ③ Timing -->
            <StackPanel Spacing="10" IsVisible="{Binding IsTimingStep}">
                <TextBlock Classes="section" Text="{x:Static res:Strings.NewChartTimingHeading}" />
                <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                    <TextBlock Grid.Row="0" Classes="field" Text="{x:Static res:Strings.NewChartBpmLabel}" />
                    <NumericUpDown Grid.Row="0" Grid.Column="2"
                                   HorizontalAlignment="Left"
                                   Width="140"
                                   Value="{Binding Bpm}"
                                   Minimum="{Binding MinBpm}"
                                   Maximum="{Binding MaxBpm}"
                                   Increment="1"
                                   FormatString="0.###"
                                   ClipValueToMinMax="True"
                                   AutomationProperties.Name="{x:Static res:Strings.NewChartBpmLabel}" />

                    <TextBlock Grid.Row="1" Classes="field" Text="{x:Static res:Strings.NewChartTimeSignatureLabel}" />
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <NumericUpDown Width="110"
                                       Value="{Binding Numerator}"
                                       Minimum="1"
                                       Maximum="{Binding MaxNumerator}"
                                       Increment="1"
                                       FormatString="0"
                                       ParsingNumberStyle="Integer"
                                       ClipValueToMinMax="True"
                                       AutomationProperties.Name="{x:Static res:Strings.NewChartBeatsPerMeasureLabel}" />
                        <TextBlock Classes="field" Text="/" />
                        <ComboBox ItemsSource="{Binding DenominatorChoices}"
                                  SelectedIndex="{Binding DenominatorIndex}"
                                  MinWidth="70"
                                  AutomationProperties.Name="{x:Static res:Strings.NewChartBeatValueLabel}" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Classes="field" Text="{x:Static res:Strings.NewChartResolutionLabel}" />
                    <ComboBox Grid.Row="2" Grid.Column="2"
                              ItemsSource="{Binding ResolutionChoices}"
                              SelectedIndex="{Binding ResolutionIndex}"
                              MinWidth="180"
                              AutomationProperties.Name="{x:Static res:Strings.NewChartResolutionLabel}" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Classes="hint" Text="{x:Static res:Strings.NewChartResolutionHint}" />

                    <TextBlock Grid.Row="4" Classes="field" Text="{x:Static res:Strings.NewChartLeadInLabel}" />
                    <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <NumericUpDown Width="140"
                                       Value="{Binding LeadInMs}"
                                       Minimum="0"
                                       Maximum="{Binding MaxLeadInMs}"
                                       Increment="10"
                                       FormatString="0"
                                       ParsingNumberStyle="Integer"
                                       ClipValueToMinMax="True"
                                       AutomationProperties.Name="{x:Static res:Strings.NewChartLeadInLabel}" />
                        <TextBlock Classes="field" Text="{x:Static res:Strings.NewChartMillisecondsUnit}" />
                    </StackPanel>
                    <TextBlock Grid.Row="5" Grid.Column="2" Classes="hint" Text="{x:Static res:Strings.NewChartLeadInHint}" />
                </Grid>
            </StackPanel>

            <!-- ④ Parts -->
            <StackPanel Spacing="18" IsVisible="{Binding IsPartsStep}">
                <StackPanel Spacing="6">
                    <TextBlock Classes="section" Text="{x:Static res:Strings.NewChartPartsHeading}" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Classes="hint" Text="{x:Static res:Strings.NewChartFiveFretHeading}" />
                            <ItemsControl ItemsSource="{Binding FiveFretParts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NewChartPartViewModel">
                                        <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Label}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Classes="hint" Text="{x:Static res:Strings.NewChartGhlHeading}" />
                            <ItemsControl ItemsSource="{Binding GhlParts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NewChartPartViewModel">
                                        <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Label}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Classes="hint" Text="{x:Static res:Strings.NewChartDrumsHeading}" />
                            <CheckBox IsChecked="{Binding DrumsPart.IsChecked}" Content="{Binding DrumsPart.Label}" />
                            <ComboBox ItemsSource="{Binding DrumsVariantChoices}"
                                      SelectedIndex="{Binding DrumsVariantIndex}"
                                      IsEnabled="{Binding HasDrums}"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="{x:Static res:Strings.NewChartDrumsVariantLabel}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Classes="hint" Text="{x:Static res:Strings.NewChartPartsHint}" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Classes="section" Text="{x:Static res:Strings.NewChartLocationHeading}" />
                    <Grid ColumnDefinitions="Auto,12,*,8,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                        <TextBlock Grid.Row="0" Classes="field" Text="{x:Static res:Strings.NewChartParentLabel}" />
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Classes="path"
                                   Classes.muted="{Binding ParentFolder, Converter={x:Static ObjectConverters.IsNull}}"
                                   Text="{Binding ParentFolder, FallbackValue={x:Static res:Strings.NewChartNoParentDisplay}, TargetNullValue={x:Static res:Strings.NewChartNoParentDisplay}}"
                                   ToolTip.Tip="{Binding ParentFolder}" />
                        <Button Grid.Row="0" Grid.Column="4"
                                Content="{x:Static res:Strings.SettingsBrowseButton}"
                                Command="{Binding BrowseFolderCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.NewChartPickFolderTitle}" />
                        <TextBlock Grid.Row="1" Classes="field" Text="{x:Static res:Strings.NewChartFolderNameLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3"
                                 Text="{Binding FolderName}"
                                 AutomationProperties.Name="{x:Static res:Strings.NewChartFolderNameLabel}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Panel>

        <Border Grid.Row="2" Classes="toolbar" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCreating}">
                        <Arc Classes="spinner active" Width="14" Height="14" StrokeThickness="2" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.NewChartCreating}" />
                    </StackPanel>
                    <TextBlock Classes="warning" Text="{Binding BlockedReason}" IsVisible="{Binding HasBlockedReason}" />
                    <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button MinWidth="80"
                            HorizontalContentAlignment="Center"
                            Content="{x:Static res:Strings.CancelButton}"
                            Command="{Binding CloseCommand}"
                            IsCancel="True"
                            AutomationProperties.Name="{x:Static res:Strings.CancelButton}" />
                    <Button MinWidth="80"
                            HorizontalContentAlignment="Center"
                            Content="{x:Static res:Strings.NewChartBackButton}"
                            Command="{Binding BackCommand}"
                            AutomationProperties.Name="{x:Static res:Strings.NewChartBackButton}" />
                    <Button Classes="accent"
                            MinWidth="96"
                            HorizontalContentAlignment="Center"
                            Content="{x:Static res:Strings.NewChartNextButton}"
                            Command="{Binding NextCommand}"
                            IsVisible="{Binding !IsLastStep}"
                            IsDefault="{Binding !IsLastStep}"
                            ToolTip.Tip="{Binding BlockedReason}"
                            ToolTip.ShowOnDisabled="True"
                            AutomationProperties.Name="{x:Static res:Strings.NewChartNextButton}" />
                    <Button Classes="accent"
                            MinWidth="96"
                            HorizontalContentAlignment="Center"
                            Content="{x:Static res:Strings.NewChartCreateButton}"
                            Command="{Binding CreateCommand}"
                            IsVisible="{Binding IsLastStep}"
                            IsDefault="{Binding IsLastStep}"
                            ToolTip.Tip="{Binding BlockedReason}"
                            ToolTip.ShowOnDisabled="True"
                            AutomationProperties.Name="{x:Static res:Strings.NewChartCreateButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
