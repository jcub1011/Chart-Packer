<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ChartPacker.ViewModels"
             xmlns:res="using:ChartPacker.Resources"
             xmlns:ctl="using:ChartPacker.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="52"
             x:Class="ChartPacker.Views.ToolbarView"
             x:DataType="vm:MainWindowViewModel">

    <!-- Input: where songs are found. Output: where Pack/Unpack write and how. Tools: Merge/Validate/Deduplicate, which open
         their own windows. Metadata: the selection's unsaved edits.
         Input, Output and Tools wrap onto a second row when the window is narrow; Metadata stays at the top right. -->
    <Border Classes="toolbar">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <WrapPanel Grid.Column="0" ItemSpacing="8" LineSpacing="6">
                <Border Classes="toolbar-group">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="tool"
                                Command="{Binding Library.BrowseCommand}"
                                ToolTip.Tip="{x:Static res:Strings.BrowseDialogTitle}"
                                AutomationProperties.Name="{x:Static res:Strings.BrowseDialogTitle}">
                            <ctl:LineIcon Data="{StaticResource InputFolderStroke}" />
                        </Button>
                        <Button Classes="tool"
                                Command="{Binding Library.RescanCommand}"
                                ToolTip.Tip="{x:Static res:Strings.RescanToolTip}"
                                AutomationProperties.Name="{x:Static res:Strings.RescanButton}">
                            <ctl:LineIcon Data="{StaticResource ScanStroke}" />
                        </Button>
                    </StackPanel>
                </Border>

                <Border Classes="toolbar-group">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="tool"
                                Command="{Binding Library.BrowseOutputCommand}"
                                ToolTip.Tip="{x:Static res:Strings.BrowseOutputDialogTitle}"
                                AutomationProperties.Name="{x:Static res:Strings.BrowseOutputDialogTitle}">
                            <ctl:LineIcon Data="{StaticResource OutputFolderStroke}" />
                        </Button>
                        <Button Classes="tool"
                                Command="{Binding Library.ResetOutputCommand}"
                                ToolTip.Tip="{x:Static res:Strings.ResetOutputToolTip}"
                                AutomationProperties.Name="{x:Static res:Strings.ResetOutputToolTip}">
                            <ctl:LineIcon Data="{StaticResource ClearStroke}" />
                        </Button>
                        <Button Classes="labelled accent"
                                Margin="4,0,0,0"
                                Command="{Binding Library.PackCommand}"
                                ToolTip.Tip="{x:Static res:Strings.PackToolTip}"
                                AutomationProperties.Name="{x:Static res:Strings.PackButton}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ctl:LineIcon Data="{StaticResource PackStroke}" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.PackButton}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="labelled"
                                Margin="2,0,0,0"
                                Command="{Binding Library.UnpackCommand}"
                                ToolTip.Tip="{x:Static res:Strings.UnpackToolTip}"
                                AutomationProperties.Name="{x:Static res:Strings.UnpackButton}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ctl:LineIcon Data="{StaticResource UnpackStroke}" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.UnpackButton}" />
                            </StackPanel>
                        </Button>
                        <ComboBox Width="132"
                                  Margin="6,0,0,0"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding Library.OverwriteOptions}"
                                  SelectedItem="{Binding Library.SelectedOverwriteOption}"
                                  ToolTip.Tip="{x:Static res:Strings.OverwriteToolTip}"
                                  AutomationProperties.Name="{x:Static res:Strings.OverwriteLabel}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:OverwriteOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ToggleButton Classes="tool"
                                      Margin="2,0,0,0"
                                      IsChecked="{Binding Library.FlatPackOutput}"
                                      AutomationProperties.Name="{x:Static res:Strings.FlatPackLabel}">
                            <ToolTip.Tip>
                                <StackPanel MaxWidth="320" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{x:Static res:Strings.FlatPackLabel}" />
                                    <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.FlatPackToolTip}" />
                                </StackPanel>
                            </ToolTip.Tip>
                            <ctl:LineIcon Data="{StaticResource FlatStroke}" />
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <Border Classes="toolbar-group">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="labelled"
                                Command="{Binding Library.MergeCommand}"
                                ToolTip.Tip="{x:Static res:Strings.MergeToolTip}"
                                ToolTip.ShowOnDisabled="True"
                                AutomationProperties.Name="{x:Static res:Strings.MergeButton}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ctl:LineIcon Data="{StaticResource MergeStroke}" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.MergeButton}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="labelled"
                                Margin="2,0,0,0"
                                Command="{Binding Library.ValidateCommand}"
                                ToolTip.Tip="{x:Static res:Strings.ValidateToolTip}"
                                ToolTip.ShowOnDisabled="True"
                                AutomationProperties.Name="{x:Static res:Strings.ValidateButton}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ctl:LineIcon Data="{StaticResource CheckStroke}" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.ValidateButton}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="labelled"
                                Margin="2,0,0,0"
                                Command="{Binding Library.DeduplicateCommand}"
                                ToolTip.Tip="{x:Static res:Strings.DedupToolTip}"
                                ToolTip.ShowOnDisabled="True"
                                AutomationProperties.Name="{x:Static res:Strings.DedupButton}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ctl:LineIcon Data="{StaticResource DedupStroke}" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.DedupButton}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <!-- Fixed width, so the spinner appearing doesn't narrow the row and re-wrap the other groups. -->
                <Panel Width="14" VerticalAlignment="Center">
                    <Arc Classes="spinner"
                         Classes.active="{Binding Detail.IsSaving}"
                         IsVisible="{Binding Detail.IsSaving}"
                         Width="14" Height="14" StrokeThickness="2" />
                </Panel>
                <Border Classes="toolbar-group">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="tool"
                                Command="{Binding Detail.DiscardCommand}"
                                ToolTip.Tip="{x:Static res:Strings.DiscardToolTip}"
                                AutomationProperties.Name="{x:Static res:Strings.DiscardButton}">
                            <ctl:LineIcon Data="{StaticResource UndoStroke}" />
                        </Button>
                        <Button Classes="labelled accent"
                                Command="{Binding Detail.SaveCommand}"
                                ToolTip.Tip="{x:Static res:Strings.SaveToolTip}"
                                AutomationProperties.Name="{x:Static res:Strings.SaveButton}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ctl:LineIcon Data="{StaticResource SaveStroke}" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.SaveButton}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <Border Classes="toolbar-group">
                    <Button Classes="tool"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip.Tip="{x:Static res:Strings.SettingsToolTip}"
                            AutomationProperties.Name="{x:Static res:Strings.SettingsButton}">
                        <ctl:LineIcon Data="{StaticResource SettingsStroke}" />
                    </Button>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
