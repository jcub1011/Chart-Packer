<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ChartPacker.ViewModels"
             xmlns:res="using:ChartPacker.Resources"
             xmlns:ctl="using:ChartPacker.UI.Controls"
             xmlns:views="using:ChartPacker.Views"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="52"
             x:Class="ChartPacker.Views.ToolbarView"
             x:DataType="vm:MainWindowViewModel">

    <!-- Input: where songs are found. Output: where Pack/Unpack write and how. Tools: Merge/Validate/Deduplicate, which open
         their own windows. Metadata: the selection's unsaved edits.
         Too narrow for everything on one row (the compact class, set by ToolbarView.axaml.cs), the labelled buttons
         (Pack, Unpack, Merge, Validate, Deduplicate, Edit Chart, Save) drop their labels; narrower still, Input, Output
         and Tools wrap onto a second row. Metadata stays at the top right.
         Every item's tooltip is its name over a short description (TitledToolTip). -->
    <UserControl.Styles>
        <!-- An icon-only labelled button is the size of a tool button; its tooltip and name still say what it is. -->
        <Style Selector="views|ToolbarView.compact Button.labelled">
            <Setter Property="Width" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <!-- Only the button's own label: a tooltip is a logical child of its button, so any TextBlock in it would match too. -->
        <Style Selector="views|ToolbarView.compact Button.labelled TextBlock.label">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </UserControl.Styles>

    <Border Classes="toolbar">
        <Grid x:Name="ToolbarGrid" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <WrapPanel x:Name="ToolsRow" Grid.Column="0" ItemSpacing="8" LineSpacing="6">
                <Border Classes="toolbar-group">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="tool"
                                Command="{Binding Library.BrowseCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.BrowseButton}">
                            <ToolTip.Tip>
                                <ctl:TitledToolTip Title="{x:Static res:Strings.BrowseButton}" Description="{x:Static res:Strings.BrowseToolTip}" />
                            </ToolTip.Tip>
                            <ctl:LineIcon Data="{StaticResource InputFolderStroke}" />
                        </Button>
                        <Button Classes="tool"
                                Command="{Binding Library.RescanCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.RescanButton}">
                            <ToolTip.Tip>
                                <ctl:TitledToolTip Title="{x:Static res:Strings.RescanButton}" Description="{x:Static res:Strings.RescanToolTip}" />
                            </ToolTip.Tip>
                            <ctl:LineIcon Data="{StaticResource ScanStroke}" />
                        </Button>
                    </StackPanel>
                </Border>

                <Border Classes="toolbar-group">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="tool"
                                Command="{Binding Library.BrowseOutputCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.BrowseOutputButton}">
                            <ToolTip.Tip>
                                <ctl:TitledToolTip Title="{x:Static res:Strings.BrowseOutputButton}" Description="{x:Static res:Strings.BrowseOutputToolTip}" />
                            </ToolTip.Tip>
                            <ctl:LineIcon Data="{StaticResource OutputFolderStroke}" />
                        </Button>
                        <Button Classes="tool"
                                Command="{Binding Library.ResetOutputCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.ResetOutputButton}">
                            <ToolTip.Tip>
                                <ctl:TitledToolTip Title="{x:Static res:Strings.ResetOutputButton}" Description="{x:Static res:Strings.ResetOutputToolTip}" />
                            </ToolTip.Tip>
                            <ctl:LineIcon Data="{StaticResource ClearStroke}" />
                        </Button>
                        <Button Classes="labelled accent"
                                Margin="4,0,0,0"
                                Command="{Binding Library.PackCommand}"
                                ToolTip.ShowOnDisabled="True"
                                AutomationProperties.Name="{x:Static res:Strings.PackButton}">
                            <ToolTip.Tip>
                                <ctl:TitledToolTip Title="{x:Static res:Strings.PackButton}" Description="{x:Static res:Strings.PackToolTip}" />
                            </ToolTip.Tip>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ctl:LineIcon Data="{StaticResource PackStroke}" />
                                <TextBlock Classes="label" VerticalAlignment="Center" Text="{x:Static res:Strings.PackButton}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="labelled"
                                Margin="2,0,0,0"
                                Command="{Binding Library.UnpackCommand}"
                                ToolTip.ShowOnDisabled="True"
                                AutomationProperties.Name="{x:Static res:Strings.UnpackButton}">
                            <ToolTip.Tip>
                                <ctl:TitledToolTip Title="{x:Static res:Strings.UnpackButton}" Description="{x:Static res:Strings.UnpackToolTip}" />
                            </ToolTip.Tip>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ctl:LineIcon Data="{StaticResource UnpackStroke}" />
                                <TextBlock Classes="label" VerticalAlignment="Center" Text="{x:Static res:Strings.UnpackButton}" />
                            </StackPanel>
                        </Button>
                        <ComboBox Width="132"
                                  Height="28"
                                  MinHeight="28"
                                  Margin="6,0,0,0"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding Library.OverwriteOptions}"
                                  SelectedItem="{Binding Library.SelectedOverwriteOption}"
                                  AutomationProperties.Name="{x:Static res:Strings.OverwriteLabel}">
                            <ToolTip.Tip>
                                <ctl:TitledToolTip Title="{x:Static res:Strings.OverwriteLabel}" Description="{x:Static res:Strings.OverwriteToolTip}" />
                            </ToolTip.Tip>
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:OverwriteOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ToggleButton Classes="tool"
                                      Margin="2,0,0,0"
                                      IsChecked="{Binding Library.FlatPackOutput}"
                                      AutomationProperties.Name="{x:Static res:Strings.FlatPackLabel}">
                            <ToolTip.Tip>
                                <ctl:TitledToolTip Title="{x:Static res:Strings.FlatPackLabel}" Description="{x:Static res:Strings.FlatPackToolTip}" />
                            </ToolTip.Tip>
                            <ctl:LineIcon Data="{StaticResource FlatStroke}" />
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <Border Classes="toolbar-group">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="labelled"
                                Command="{Binding Library.MergeCommand}"
                                ToolTip.ShowOnDisabled="True"
                                AutomationProperties.Name="{x:Static res:Strings.MergeButton}">
                            <ToolTip.Tip>
                                <ctl:TitledToolTip Title="{x:Static res:Strings.MergeButton}" Description="{x:Static res:Strings.MergeToolTip}" />
                            </ToolTip.Tip>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ctl:LineIcon Data="{StaticResource MergeStroke}" />
                                <TextBlock Classes="label" VerticalAlignment="Center" Text="{x:Static res:Strings.MergeButton}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="labelled"
                                Margin="2,0,0,0"
                                Command="{Binding Library.ValidateCommand}"
                                ToolTip.ShowOnDisabled="True"
                                AutomationProperties.Name="{x:Static res:Strings.ValidateButton}">
                            <ToolTip.Tip>
                                <ctl:TitledToolTip Title="{x:Static res:Strings.ValidateButton}" Description="{x:Static res:Strings.ValidateToolTip}" />
                            </ToolTip.Tip>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ctl:LineIcon Data="{StaticResource CheckStroke}" />
                                <TextBlock Classes="label" VerticalAlignment="Center" Text="{x:Static res:Strings.ValidateButton}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="labelled"
                                Margin="2,0,0,0"
                                Command="{Binding Library.DeduplicateCommand}"
                                ToolTip.ShowOnDisabled="True"
                                AutomationProperties.Name="{x:Static res:Strings.DedupButton}">
                            <ToolTip.Tip>
                                <ctl:TitledToolTip Title="{x:Static res:Strings.DedupButton}" Description="{x:Static res:Strings.DedupToolTip}" />
                            </ToolTip.Tip>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ctl:LineIcon Data="{StaticResource DedupStroke}" />
                                <TextBlock Classes="label" VerticalAlignment="Center" Text="{x:Static res:Strings.DedupButton}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="labelled"
                                Margin="2,0,0,0"
                                Command="{Binding Library.EditChartCommand}"
                                ToolTip.ShowOnDisabled="True"
                                AutomationProperties.Name="{x:Static res:Strings.EditChartButton}">
                            <ToolTip.Tip>
                                <ctl:TitledToolTip Title="{x:Static res:Strings.EditChartButton}" Description="{Binding Library.EditChartToolTip}" />
                            </ToolTip.Tip>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ctl:LineIcon Data="{StaticResource EditChartStroke}" />
                                <TextBlock Classes="label" VerticalAlignment="Center" Text="{x:Static res:Strings.EditChartButton}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <StackPanel x:Name="TrailingTools" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <!-- Fixed width, so the spinner appearing doesn't narrow the row and re-wrap the other groups. -->
                <Panel Width="14" VerticalAlignment="Center">
                    <Arc Classes="spinner"
                         Classes.active="{Binding Detail.IsSaving}"
                         IsVisible="{Binding Detail.IsSaving}"
                         Width="14" Height="14" StrokeThickness="2" />
                </Panel>
                <Border Classes="toolbar-group">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="tool"
                                Command="{Binding Detail.DiscardCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.DiscardButton}">
                            <ToolTip.Tip>
                                <ctl:TitledToolTip Title="{x:Static res:Strings.DiscardButton}" Description="{x:Static res:Strings.DiscardToolTip}" />
                            </ToolTip.Tip>
                            <ctl:LineIcon Data="{StaticResource UndoStroke}" />
                        </Button>
                        <Button Classes="labelled accent"
                                Command="{Binding Detail.SaveCommand}"
                                ToolTip.ShowOnDisabled="True"
                                AutomationProperties.Name="{x:Static res:Strings.SaveButton}">
                            <ToolTip.Tip>
                                <ctl:TitledToolTip Title="{x:Static res:Strings.SaveButton}" Description="{x:Static res:Strings.SaveToolTip}" />
                            </ToolTip.Tip>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ctl:LineIcon Data="{StaticResource SaveStroke}" />
                                <TextBlock Classes="label" VerticalAlignment="Center" Text="{x:Static res:Strings.SaveButton}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <Border Classes="toolbar-group">
                    <Button Classes="tool"
                            Command="{Binding OpenSettingsCommand}"
                            AutomationProperties.Name="{x:Static res:Strings.SettingsButton}">
                        <ToolTip.Tip>
                            <ctl:TitledToolTip Title="{x:Static res:Strings.SettingsButton}" Description="{x:Static res:Strings.SettingsToolTip}" />
                        </ToolTip.Tip>
                        <ctl:LineIcon Data="{StaticResource SettingsStroke}" />
                    </Button>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
