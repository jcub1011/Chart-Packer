<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ChartPacker.ViewModels"
             xmlns:conv="using:ChartPacker.Converters"
             xmlns:ctl="using:ChartPacker.Controls"
             xmlns:res="using:ChartPacker.Resources"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="600"
             x:Class="ChartPacker.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

    <UserControl.Resources>
        <conv:EntryKindToIconConverter x:Key="EntryKindToIcon"
                                       SngFile="{StaticResource SngIconGeometry}"
                                       SongFolder="{StaticResource FolderIconGeometry}" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.path">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="PathSegmentEllipsis" />
        </Style>

        <!-- Selected rows are tinted, not filled, and get a violet bar on the left. The bar is always
             there (transparent), so selecting doesn't shift the row. -->
        <Style Selector="ListBox#EntryList ListBoxItem">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ListBox#EntryList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolHoverBrush}" />
        </Style>
        <Style Selector="ListBox#EntryList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush">
                <SolidColorBrush Color="{DynamicResource SystemAccentColor}" />
            </Setter>
        </Style>
        <Style Selector="ListBox#EntryList ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#558B5CF6" />
        </Style>

        <Style Selector="Border.art-tile">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ToolbarGroupBrush}" />
        </Style>

        <!-- Play/stop on the art: a dark round chip that shows while the tile is hovered, and stays while its song plays.
             It is smaller than the tile so the rest of the tile still selects the row. -->
        <Style Selector="Button.tilePlay">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#CC000000" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.art-tile:pointerover Button.tilePlay, Button.tilePlay.active, Button.tilePlay:focus-visible">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.tilePlay:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F0000000" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.tilePlay:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <SolidColorBrush Color="{DynamicResource SystemAccentColor}" />
            </Setter>
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.tilePlay PathIcon">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
        </Style>

        <!-- The entry's kind is a chip in the accent for a .sng, or manila for a folder; Border.chip itself is in Theme.axaml. -->
        <Style Selector="Border.chip.sng">
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.chip.sng > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.chip.folder">
            <Setter Property="Background" Value="{DynamicResource FolderTintBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.chip.folder > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FolderTextBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- The filter button is tinted while a filter narrows the list, with the number of filters in a badge. -->
        <Style Selector="Button.tool.active">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style Selector="Button.tool.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="MinWidth" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,2,2,0" />
            <Setter Property="Background">
                <SolidColorBrush Color="{DynamicResource SystemAccentColor}" />
            </Setter>
        </Style>
        <Style Selector="Border.badge > TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The sort and filter flyout. -->
        <Style Selector="StackPanel.filter-section">
            <Setter Property="Spacing" Value="6" />
        </Style>
        <Style Selector="StackPanel.filter-section TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.filter-section NumericUpDown">
            <Setter Property="ShowButtonSpinner" Value="False" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- Where songs are read from and where Pack/Unpack write; both are chosen from the toolbar. -->
        <Border DockPanel.Dock="Top"
                Padding="12,10"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SubtleBorderBrush}">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Classes="caption"
                               VerticalAlignment="Center"
                               Text="{x:Static res:Strings.InputLabel}" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Classes="path"
                               Classes.muted="{Binding ShowPrompt}"
                               Text="{Binding FolderPath, TargetNullValue={x:Static res:Strings.FolderPathWatermark}}"
                               ToolTip.Tip="{Binding FolderPath}" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Classes="caption"
                               VerticalAlignment="Center"
                               Text="{x:Static res:Strings.OutputLabel}" />
                    <!-- Muted while it's the default (next to the scanned songs) rather than a chosen folder. -->
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Classes="path"
                               Classes.muted="{Binding !HasCustomOutputFolder}"
                               Text="{Binding EffectiveOutputFolder, TargetNullValue={x:Static res:Strings.OutputWatermark}}">
                        <ToolTip.Tip>
                            <StackPanel MaxWidth="360" Spacing="2">
                                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
                                           Text="{Binding EffectiveOutputFolder, TargetNullValue={x:Static res:Strings.OutputWatermark}}" />
                                <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.OutputToolTip}" />
                            </StackPanel>
                        </ToolTip.Tip>
                    </TextBlock>
                </Grid>

                <Border Classes="banner" IsVisible="{Binding IsStale}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <PathIcon Grid.Column="0"
                                  Width="12" Height="12"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource InfoIconGeometry}" />
                        <TextBlock Grid.Column="1"
                                   FontSize="12"
                                   Text="{x:Static res:Strings.StaleHint}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Search, and the sort and filter flyout. -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding ShowFilterBar}">
                    <TextBox x:Name="SearchBox"
                             Grid.Column="0"
                             Classes="clearButton"
                             VerticalContentAlignment="Center"
                             Text="{Binding Filter.SearchText}"
                             PlaceholderText="{x:Static res:Strings.SearchWatermark}"
                             AutomationProperties.Name="{x:Static res:Strings.SearchName}">
                        <TextBox.InnerLeftContent>
                            <ctl:LineIcon Data="{StaticResource SearchStroke}" Margin="8,0,0,0" Opacity="0.6" />
                        </TextBox.InnerLeftContent>
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Escape" Command="{Binding Filter.ClearSearchCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>

                    <Button Grid.Column="1"
                            Classes="tool"
                            Classes.active="{Binding Filter.HasActiveFilters}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{x:Static res:Strings.FilterToolTip}"
                            AutomationProperties.Name="{x:Static res:Strings.FilterToolTip}">
                        <Panel Width="32" Height="32">
                            <ctl:LineIcon Data="{StaticResource FilterStroke}" HorizontalAlignment="Center" />
                            <Border Classes="badge" IsVisible="{Binding Filter.HasActiveFilters}">
                                <TextBlock Text="{Binding Filter.ActiveFilterCount}" />
                            </Border>
                        </Panel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Width="300" Spacing="14" Margin="2">
                                        <StackPanel Classes="filter-section">
                                            <TextBlock Classes="caption" Text="{x:Static res:Strings.SortByLabel}" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                <ComboBox Grid.Column="0"
                                                          HorizontalAlignment="Stretch"
                                                          ItemsSource="{Binding Filter.SortOptions}"
                                                          SelectedItem="{Binding Filter.SelectedSortOption}"
                                                          AutomationProperties.Name="{x:Static res:Strings.SortByLabel}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:LibrarySortOption">
                                                            <TextBlock Text="{Binding Label}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <ToggleButton Grid.Column="1"
                                                              Classes="tool"
                                                              IsChecked="{Binding Filter.SortDescending}"
                                                              ToolTip.Tip="{x:Static res:Strings.SortDescendingToolTip}"
                                                              AutomationProperties.Name="{x:Static res:Strings.SortDescendingToolTip}">
                                                    <Panel>
                                                        <ctl:LineIcon Data="{StaticResource SortAscendingStroke}" IsVisible="{Binding !Filter.SortDescending}" />
                                                        <ctl:LineIcon Data="{StaticResource SortDescendingStroke}" IsVisible="{Binding Filter.SortDescending}" />
                                                    </Panel>
                                                </ToggleButton>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Classes="filter-section">
                                            <TextBlock Classes="caption" Text="{x:Static res:Strings.FilterTypeLabel}" />
                                            <StackPanel Orientation="Horizontal" Spacing="16">
                                                <CheckBox Content="{x:Static res:Strings.FilterKindSng}" IsChecked="{Binding Filter.ShowSng}" />
                                                <CheckBox Content="{x:Static res:Strings.FilterKindFolder}" IsChecked="{Binding Filter.ShowFolders}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Classes="filter-section">
                                            <TextBlock Classes="caption" Text="{x:Static res:Strings.FilterTextLabel}" />
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="4">
                                                <TextBlock Grid.Row="0" Classes="label" Text="{x:Static res:Strings.FieldTitle}" />
                                                <TextBox Grid.Row="0" Grid.Column="1" Classes="clearButton" Text="{Binding Filter.TitleContains}"
                                                         AutomationProperties.Name="{x:Static res:Strings.FieldTitle}" />
                                                <TextBlock Grid.Row="1" Classes="label" Text="{x:Static res:Strings.FieldArtist}" />
                                                <TextBox Grid.Row="1" Grid.Column="1" Classes="clearButton" Text="{Binding Filter.ArtistContains}"
                                                         AutomationProperties.Name="{x:Static res:Strings.FieldArtist}" />
                                                <TextBlock Grid.Row="2" Classes="label" Text="{x:Static res:Strings.FieldAlbum}" />
                                                <TextBox Grid.Row="2" Grid.Column="1" Classes="clearButton" Text="{Binding Filter.AlbumContains}"
                                                         AutomationProperties.Name="{x:Static res:Strings.FieldAlbum}" />
                                                <TextBlock Grid.Row="3" Classes="label" Text="{x:Static res:Strings.FieldGenre}" />
                                                <TextBox Grid.Row="3" Grid.Column="1" Classes="clearButton" Text="{Binding Filter.GenreContains}"
                                                         AutomationProperties.Name="{x:Static res:Strings.FieldGenre}" />
                                                <TextBlock Grid.Row="4" Classes="label" Text="{x:Static res:Strings.FieldCharter}" />
                                                <TextBox Grid.Row="4" Grid.Column="1" Classes="clearButton" Text="{Binding Filter.CharterContains}"
                                                         AutomationProperties.Name="{x:Static res:Strings.FieldCharter}" />
                                            </Grid>
                                        </StackPanel>

                                        <!-- Min and max, both optional. Empty means no limit. -->
                                        <StackPanel Classes="filter-section">
                                            <TextBlock Classes="caption" Text="{x:Static res:Strings.FilterRangeLabel}" />
                                            <Grid ColumnDefinitions="Auto,*,Auto,*,28" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Margin="0,0,4,0" Text="{x:Static res:Strings.FieldYear}" />
                                                <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding Filter.YearMin}" Maximum="9999" FormatString="0"
                                                               PlaceholderText="{x:Static res:Strings.FilterMinWatermark}" />
                                                <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" Text="{x:Static res:Strings.FilterRangeSeparator}" />
                                                <NumericUpDown Grid.Row="0" Grid.Column="3" Value="{Binding Filter.YearMax}" Maximum="9999" FormatString="0"
                                                               PlaceholderText="{x:Static res:Strings.FilterMaxWatermark}" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Margin="0,0,4,0" Text="{x:Static res:Strings.FieldLength}" />
                                                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Filter.LengthMin}" Increment="0.5" FormatString="0.#"
                                                               PlaceholderText="{x:Static res:Strings.FilterMinWatermark}" />
                                                <TextBlock Grid.Row="1" Grid.Column="2" Classes="label" Text="{x:Static res:Strings.FilterRangeSeparator}" />
                                                <NumericUpDown Grid.Row="1" Grid.Column="3" Value="{Binding Filter.LengthMax}" Increment="0.5" FormatString="0.#"
                                                               PlaceholderText="{x:Static res:Strings.FilterMaxWatermark}" />
                                                <TextBlock Grid.Row="1" Grid.Column="4" Classes="label muted" Text="{x:Static res:Strings.FilterLengthUnit}" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Margin="0,0,4,0" Text="{x:Static res:Strings.FieldSize}" />
                                                <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Filter.SizeMin}" FormatString="0.#"
                                                               PlaceholderText="{x:Static res:Strings.FilterMinWatermark}" />
                                                <TextBlock Grid.Row="2" Grid.Column="2" Classes="label" Text="{x:Static res:Strings.FilterRangeSeparator}" />
                                                <NumericUpDown Grid.Row="2" Grid.Column="3" Value="{Binding Filter.SizeMax}" FormatString="0.#"
                                                               PlaceholderText="{x:Static res:Strings.FilterMaxWatermark}" />
                                                <TextBlock Grid.Row="2" Grid.Column="4" Classes="label muted" Text="{x:Static res:Strings.FilterSizeUnit}" />
                                            </Grid>
                                        </StackPanel>

                                        <CheckBox Content="{x:Static res:Strings.FilterOnlyUnsaved}" IsChecked="{Binding Filter.OnlyUnsaved}" />

                                        <Button HorizontalAlignment="Right"
                                                Content="{x:Static res:Strings.ResetFilters}"
                                                Command="{Binding Filter.ClearFiltersCommand}"
                                                IsEnabled="{Binding Filter.HasActiveFilters}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Padding="12,5"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SubtleBorderBrush}"
                IsVisible="{Binding ShowStatus}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Arc Classes="spinner"
                     Classes.active="{Binding IsScanning}"
                     IsVisible="{Binding IsScanning}"
                     Width="10" Height="10" StrokeThickness="2"
                     VerticalAlignment="Center" />
                <TextBlock Classes="muted" FontSize="12" Text="{Binding StatusText}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Panel>
            <ListBox x:Name="EntryList"
                     Background="Transparent"
                     ItemsSource="{Binding Entries}"
                     Selection="{Binding Selection}"
                     SelectionMode="Multiple"
                     AutomationProperties.Name="{x:Static res:Strings.LibraryListName}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LibraryItemViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"
                              ToolTip.Tip="{Binding Entry.FullPath}">
                            <!-- Album art, or the kind glyph when there's none (or it hasn't loaded yet). -->
                            <Border Grid.Column="0" Classes="art-tile">
                                <Panel>
                                    <PathIcon Width="16" Height="16"
                                              Opacity="0.8"
                                              IsVisible="{Binding !HasAlbumArt}"
                                              Data="{Binding Entry.Kind, Converter={StaticResource EntryKindToIcon}}" />
                                    <Image Source="{Binding AlbumArt}"
                                           Stretch="UniformToFill"
                                           IsVisible="{Binding HasAlbumArt}" />
                                    <Button Classes="tilePlay"
                                            Classes.active="{Binding IsPreviewing}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Command="{Binding $parent[ListBox].((vm:LibraryViewModel)DataContext).TogglePreviewCommand, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{x:Static res:Strings.PlayToolTip}">
                                        <Panel>
                                            <PathIcon Data="{StaticResource PlayIconGeometry}"
                                                      IsVisible="{Binding !IsPreviewing}"
                                                      ToolTip.Tip="{x:Static res:Strings.PlayToolTip}" />
                                            <PathIcon Data="{StaticResource StopIconGeometry}"
                                                      IsVisible="{Binding IsPreviewing}"
                                                      ToolTip.Tip="{x:Static res:Strings.StopToolTip}" />
                                        </Panel>
                                    </Button>
                                </Panel>
                            </Border>
                            <!-- Text on the left, chips on the right: the kind on the title line, the length and size on the detail line. -->
                            <Grid Grid.Column="1"
                                  ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                                  ColumnSpacing="8" RowSpacing="2"
                                  VerticalAlignment="Center">
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Grid.Row="0" Grid.Column="1"
                                        Classes="chip"
                                        Classes.sng="{Binding IsSng}"
                                        Classes.folder="{Binding !IsSng}">
                                    <TextBlock Text="{Binding KindLabel}" />
                                </Border>

                                <!-- Artist · charter, or a loading note until the metadata is read. The charter can carry
                                     rich-text tags (colours, bold…), which are drawn rather than shown. -->
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Classes="muted"
                                           Text="{Binding Details}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding ShowDetails}" />
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Classes="muted"
                                           ctl:RichTextMarkup.Prefix="{Binding BylinePrefix}"
                                           ctl:RichTextMarkup.Text="{Binding Charter}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding ShowByline}" />
                                <StackPanel Grid.Row="1" Grid.Column="1"
                                            Orientation="Horizontal" Spacing="4"
                                            HorizontalAlignment="Right">
                                    <Border Classes="chip" IsVisible="{Binding HasLength}">
                                        <TextBlock Text="{Binding LengthText}" />
                                    </Border>
                                    <Border Classes="chip" IsVisible="{Binding HasSize}">
                                        <TextBlock Text="{Binding SizeText}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <!-- Unsaved metadata changes. -->
                            <Ellipse Grid.Column="2"
                                     Width="8" Height="8"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding HasDrafts}"
                                     ToolTip.Tip="{x:Static res:Strings.UnsavedToolTip}">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{DynamicResource SystemAccentColor}" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Classes="muted centered"
                       VerticalAlignment="Center"
                       Margin="16"
                       Text="{x:Static res:Strings.LibraryPrompt}"
                       IsVisible="{Binding ShowPrompt}" />

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="12"
                        IsVisible="{Binding ShowCenteredSpinner}">
                <Arc Classes="spinner"
                     Classes.active="{Binding ShowCenteredSpinner}"
                     Width="36" Height="36" StrokeThickness="3"
                     HorizontalAlignment="Center" />
                <TextBlock Classes="muted centered" Text="{x:Static res:Strings.Scanning}" />
            </StackPanel>

            <TextBlock Classes="muted centered"
                       VerticalAlignment="Center"
                       Margin="16"
                       Text="{x:Static res:Strings.NotScannedHint}"
                       IsVisible="{Binding ShowNotScanned}" />

            <TextBlock Classes="muted centered"
                       VerticalAlignment="Center"
                       Margin="16"
                       Text="{x:Static res:Strings.EmptyFolder}"
                       IsVisible="{Binding ShowEmpty}" />

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="16"
                        Spacing="10"
                        IsVisible="{Binding ShowNoMatches}">
                <TextBlock Classes="muted centered" Text="{x:Static res:Strings.NoMatches}" TextWrapping="Wrap" />
                <Button HorizontalAlignment="Center"
                        Content="{x:Static res:Strings.ClearFilters}"
                        Command="{Binding Filter.ClearAllCommand}" />
            </StackPanel>

            <TextBlock Classes="centered"
                       VerticalAlignment="Center"
                       Margin="16"
                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                       Text="{Binding ErrorMessage}"
                       IsVisible="{Binding HasError}" />
        </Panel>
    </DockPanel>
</UserControl>
