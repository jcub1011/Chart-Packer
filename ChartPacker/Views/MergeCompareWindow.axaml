<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ChartPacker.ViewModels"
        xmlns:res="using:ChartPacker.Resources"
        xmlns:sres="using:ChartShared.UI.Resources"
        xmlns:ctl="using:ChartPacker.Controls"
        xmlns:ui="using:ChartShared.UI.Controls"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="640"
        x:Class="ChartPacker.Views.MergeCompareWindow"
        x:DataType="vm:MergeCompareViewModel"
        Title="{Binding Title}"
        Background="{DynamicResource AppBackgroundBrush}"
        Width="1200" Height="640"
        MinWidth="720" MinHeight="420"
        CanMinimize="False"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        WindowDecorationsTheme="{StaticResource TitleBarDecorations}"
        WindowStartupLocation="CenterOwner">

    <!-- It can't be minimized: a modal window with no taskbar entry would have nothing to restore it from, leaving its
         owner disabled.
         As in the Merge window, nothing comes and goes in a way that moves anything else: what the window is doing, or
         what to know about the audio, is one line in the footer. Only resizing the window moves the controls, which
         wrap a group at a time. -->

    <Window.Styles>
        <!-- Kept in the layout, but not seen or clicked, so nothing moves when it shows. -->
        <Style Selector=":is(Control).slot-hidden">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style Selector="ui|LineIcon.warn">
            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
        </Style>

        <!-- A song's name before its part picker, trimmed when it's long; the whole name is in its tooltip. -->
        <Style Selector="TextBlock.picker-caption">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxWidth" Value="160" />
        </Style>

        <!-- The view's buttons, flat inside one outlined group as the toolbar groups are: zoom as icons, then which
             stretch of the song to show, as words. -->
        <Style Selector="Border.toolbar-group Button.view">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.toolbar-group Button.view:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolHoverBrush}" />
        </Style>
        <Style Selector="Border.toolbar-group Button.view:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolPressedBrush}" />
        </Style>
        <Style Selector="Rectangle.group-divider">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="3,5" />
            <Setter Property="Fill" Value="{DynamicResource SubtleBorderBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- The title bar, as the Merge window's is, over the audio's progress: the icon (the owner's, set in code) and
             what's lined up with what. Layered: the progress, then the title bar, see-through so the progress shows. -->
        <Panel Grid.Row="0" Height="31">
            <ProgressBar Classes="fill"
                         Margin="0,0,0,1"
                         IsIndeterminate="True"
                         IsVisible="{Binding IsLoadingAudio}"
                         IsHitTestVisible="False"
                         AutomationProperties.Name="{x:Static res:Strings.MergeAligningAudio}" />

            <ui:TitleBar x:Name="WindowTitleBar"
                         Background="Transparent"
                         BorderThickness="0,0,0,1"
                         BorderBrush="{DynamicResource SubtleBorderBrush}"
                         AppName="{x:Static res:Strings.AppName}">
                <TextBlock Margin="8,0,12,0"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Heading}" />
            </ui:TitleBar>
        </Panel>

        <!-- The parts compared, each after its song's name; the offset, with the links to jump to and Undo; then the
             view and how to drag. Short of room, whole groups wrap onto another line. -->
        <Border Grid.Row="1" Classes="toolbar">
            <WrapPanel ItemSpacing="16" LineSpacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Classes="caption picker-caption"
                               Text="{Binding ReferenceName}"
                               ToolTip.Tip="{Binding ReferenceName}" />
                    <ComboBox MinWidth="140"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding ReferenceParts}"
                              SelectedItem="{Binding SelectedReferencePart}"
                              AutomationProperties.Name="{x:Static res:Strings.MergeCompareReferencePartName}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:ComparePartOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Classes="caption picker-caption"
                               Text="{Binding SongName}"
                               ToolTip.Tip="{Binding SongName}" />
                    <ComboBox MinWidth="140"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding SongParts}"
                              SelectedItem="{Binding SelectedSongPart}"
                              AutomationProperties.Name="{x:Static res:Strings.MergeCompareSongPartName}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:ComparePartOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Classes="caption" VerticalAlignment="Center" Text="{x:Static res:Strings.MergeAlignmentLabel}" />
                    <NumericUpDown ui:DragScrub.IsEnabled="True"
                                   Width="84"
                                   ShowButtonSpinner="False"
                                   VerticalAlignment="Center"
                                   Value="{Binding Offset}"
                                   Increment="1"
                                   Minimum="-2147483648"
                                   Maximum="2147483647"
                                   FormatString="+0;-0;0"
                                   AutomationProperties.Name="{x:Static res:Strings.MergeAlignmentOffsetName}">
                        <ToolTip.Tip>
                            <StackPanel MaxWidth="320" Spacing="6">
                                <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.MergeAlignmentOffsetToolTip}" />
                                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static sres:SharedStrings.OffsetControlsHelp}" />
                            </StackPanel>
                        </ToolTip.Tip>
                    </NumericUpDown>
                    <TextBlock Classes="muted" VerticalAlignment="Center" Text="{x:Static res:Strings.HighwayOffsetUnit}" />

                    <!-- Where each of the song's links would put it, as a menu, as the Merge window's headers offer the
                         links themselves. Kept in place for a song with none. -->
                    <Button Classes="labelled"
                            Classes.slot-hidden="{Binding !HasEstimates}"
                            IsEnabled="{Binding HasEstimates}"
                            ToolTip.Tip="{x:Static res:Strings.MergeCompareJumpTo}"
                            AutomationProperties.Name="{x:Static res:Strings.MergeCompareJumpButton}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.MergeCompareJumpButton}" />
                            <ui:LineIcon Data="{StaticResource ChevronDownStroke}" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft" ItemsSource="{Binding Estimates}">
                                <!-- The menu's presenter has the window's DataContext, as a flyout takes its button's;
                                     each item's is its estimate. -->
                                <MenuFlyout.ItemContainerTheme>
                                    <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:CompareEstimate">
                                        <Setter Property="Header" Value="{Binding Label}" />
                                        <Setter Property="Command" Value="{Binding $parent[MenuFlyoutPresenter].((vm:MergeCompareViewModel)DataContext).JumpCommand, FallbackValue={x:Null}}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                    </ControlTheme>
                                </MenuFlyout.ItemContainerTheme>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="labelled"
                            Command="{Binding RevertCommand}"
                            Content="{x:Static res:Strings.MergeCompareRevertButton}"
                            ToolTip.Tip="{x:Static res:Strings.MergeCompareRevertToolTip}"
                            AutomationProperties.Name="{x:Static res:Strings.MergeCompareRevertButton}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Classes="toolbar-group" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="tool"
                                    Click="OnZoomOut"
                                    ToolTip.Tip="{x:Static res:Strings.MergeCompareZoomOut}"
                                    AutomationProperties.Name="{x:Static res:Strings.MergeCompareZoomOut}">
                                <ui:LineIcon Data="{StaticResource SubtractStroke}" />
                            </Button>
                            <Button Classes="tool"
                                    Click="OnZoomIn"
                                    ToolTip.Tip="{x:Static res:Strings.MergeCompareZoomIn}"
                                    AutomationProperties.Name="{x:Static res:Strings.MergeCompareZoomIn}">
                                <ui:LineIcon Data="{StaticResource AddStroke}" />
                            </Button>
                            <Rectangle Classes="group-divider" />
                            <Button Classes="view"
                                    Click="OnShowStart"
                                    Content="{x:Static res:Strings.MergeCompareShowStart}"
                                    AutomationProperties.Name="{x:Static res:Strings.MergeCompareShowStart}" />
                            <Button Classes="view"
                                    Click="OnShowAll"
                                    Content="{x:Static res:Strings.MergeCompareShowAll}"
                                    AutomationProperties.Name="{x:Static res:Strings.MergeCompareShowAll}" />
                        </StackPanel>
                    </Border>

                    <!-- How to line the song up, in the tooltip, so the timeline gets the height. -->
                    <Panel Background="Transparent"
                           VerticalAlignment="Center"
                           ToolTip.Tip="{Binding Description}"
                           AutomationProperties.HelpText="{Binding Description}">
                        <ui:LineIcon Width="14" Height="14" Opacity="0.55" Data="{StaticResource InfoStroke}" />
                    </Panel>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Both songs on one timeline, flush on the surface as the library's list is. -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" Padding="8">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ctl:AlignmentTimelineView x:Name="Timeline"
                                           ReferenceName="{Binding ReferenceName}"
                                           SongName="{Binding SongName}"
                                           ReferenceWaveform="{Binding ReferenceWaveform}"
                                           SongWaveform="{Binding SongWaveform}"
                                           ReferenceNotes="{Binding SelectedReferencePart.Notes, FallbackValue={x:Null}}"
                                           SongNotes="{Binding SelectedSongPart.Notes, FallbackValue={x:Null}}"
                                           OffsetSeconds="{Binding OffsetSeconds}"
                                           VerticalAlignment="Top"
                                           AutomationProperties.Name="{x:Static res:Strings.MergeCompareTimelineName}" />
            </ScrollViewer>
        </Border>

        <!-- One line: the audio being read, or what to know about it, all of it in the tooltip; then Use This Offset and
             Cancel. -->
        <Border Grid.Row="3" Classes="toolbar" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Grid Grid.Column="0" ColumnDefinitions="16,*" ColumnSpacing="8" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding AudioMessage}">
                    <Panel Grid.Column="0" VerticalAlignment="Center">
                        <Arc Classes="spinner" Classes.active="{Binding IsLoadingAudio}" IsVisible="{Binding IsLoadingAudio}" Width="14" Height="14" StrokeThickness="2" />
                        <ui:LineIcon Classes="warn" Data="{StaticResource WarningStroke}" IsVisible="{Binding HasAudioMessage}" />
                    </Panel>
                    <TextBlock Grid.Column="1"
                               Classes="muted"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{x:Static res:Strings.MergeAligningAudio}"
                               IsVisible="{Binding IsLoadingAudio}" />
                    <TextBlock Grid.Column="1"
                               FontSize="12"
                               Foreground="{DynamicResource WarningTextBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding AudioMessage}"
                               IsVisible="{Binding HasAudioMessage}" />
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="accent"
                            MinWidth="96"
                            HorizontalContentAlignment="Center"
                            Content="{x:Static res:Strings.MergeCompareApplyButton}"
                            Command="{Binding ApplyCommand}"
                            IsDefault="True"
                            AutomationProperties.Name="{x:Static res:Strings.MergeCompareApplyButton}" />
                    <Button MinWidth="80"
                            HorizontalContentAlignment="Center"
                            Content="{x:Static sres:SharedStrings.CancelButton}"
                            Command="{Binding CancelCommand}"
                            IsCancel="True"
                            AutomationProperties.Name="{x:Static sres:SharedStrings.CancelButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
