<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ChartPacker.ViewModels"
        xmlns:res="using:ChartPacker.Resources"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
        x:Class="ChartPacker.Views.JobProgressWindow"
        x:DataType="vm:JobViewModel"
        Title="{x:Static res:Strings.JobProgressWindowTitle}"
        Background="{DynamicResource AppBackgroundBrush}"
        Width="640" Height="520"
        MinWidth="420" MinHeight="280"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.status.attention, TextBlock.group-heading.attention">
            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
        </Style>
        <Style Selector="TextBlock.status.failed, TextBlock.group-heading.failed">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
        </Style>
        <Style Selector="TextBlock.message">
            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
        </Style>
        <Style Selector="TextBlock.message.error">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
        </Style>
        <Style Selector="TextBlock.group-heading">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="IsExpanded" Value="True" />
        </Style>
    </Window.Styles>

    <Window.DataTemplates>
        <!-- A group's body: its rows, or "None" while it has none. -->
        <DataTemplate DataType="vm:JobResultGroup">
            <Panel>
                <TextBlock Classes="muted" Text="{x:Static res:Strings.JobGroupEmpty}" IsVisible="{Binding !HasRows}" />
                <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}" />
            </Panel>
        </DataTemplate>
        <DataTemplate DataType="vm:JobItemRow">
            <Grid ColumnDefinitions="20,Auto,*" ColumnSpacing="8" Margin="0,3">
                <TextBlock Grid.Column="0"
                           Classes="status"
                           Classes.attention="{Binding IsAttention}"
                           Classes.failed="{Binding IsFailed}"
                           Classes.muted="{Binding IsCanceled}"
                           FontWeight="Bold"
                           Text="{Binding Glyph}" />
                <TextBlock Grid.Column="1"
                           FontWeight="SemiBold"
                           MaxWidth="220"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding Name}"
                           Text="{Binding Name}" />
                <StackPanel Grid.Column="2">
                    <SelectableTextBlock Opacity="0.8" TextWrapping="Wrap" Text="{Binding Detail}" />
                    <ItemsControl ItemsSource="{Binding Messages}" IsVisible="{Binding HasMessages}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="vm:JobMessageRow">
            <TextBlock Classes="message"
                       Classes.error="{Binding IsError}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="{Binding Text}" />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Classes="toolbar">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SummaryText}"
                               FontWeight="SemiBold"
                               Classes.muted="{Binding IsWaiting}"
                               TextWrapping="Wrap" />
                    <ProgressBar Value="{Binding Progress}"
                                 Minimum="0" Maximum="100"
                                 IsVisible="{Binding IsRunning}" />
                </StackPanel>
                <Button Grid.Column="1"
                        VerticalAlignment="Center"
                        Content="{x:Static res:Strings.CancelButton}"
                        Command="{Binding CancelCommand}"
                        IsVisible="{Binding IsRunning}"
                        AutomationProperties.Name="{x:Static res:Strings.CancelButton}" />
            </Grid>
        </Border>

        <!-- One section per outcome, so each kind is easy to find. -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.Name="{x:Static res:Strings.JobResultsListName}">
            <StackPanel Margin="16,12" Spacing="10">
                <Expander Content="{Binding Completed}">
                    <Expander.Header>
                        <TextBlock Classes="group-heading" Text="{Binding Completed.Title}" />
                    </Expander.Header>
                </Expander>
                <Expander Content="{Binding Skipped}">
                    <Expander.Header>
                        <TextBlock Classes="group-heading attention" Text="{Binding Skipped.Title}" />
                    </Expander.Header>
                </Expander>
                <Expander Content="{Binding Failed}">
                    <Expander.Header>
                        <TextBlock Classes="group-heading failed" Text="{Binding Failed.Title}" />
                    </Expander.Header>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Classes="toolbar" BorderThickness="0,1,0,0">
            <Button HorizontalAlignment="Right"
                    MinWidth="80"
                    HorizontalContentAlignment="Center"
                    Content="{x:Static res:Strings.CloseButton}"
                    IsCancel="True"
                    Click="OnClose"
                    AutomationProperties.Name="{x:Static res:Strings.CloseButton}" />
        </Border>
    </Grid>
</Window>
