<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="using:ChartShared.Core.Help"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ChartPacker.ViewModels"
        xmlns:res="using:ChartPacker.Resources"
        xmlns:sres="using:ChartShared.UI.Resources"
        xmlns:ctl="using:ChartShared.UI.Controls"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="560"
        x:Class="ChartPacker.Views.JobProgressWindow"
        x:DataType="vm:JobViewModel"
        Title="{x:Static res:Strings.JobProgressWindowTitle}"
        Background="{DynamicResource AppBackgroundBrush}"
        Width="760" Height="560"
        MinWidth="560" MinHeight="320"
        ShowInTaskbar="False"
        CanMinimize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        WindowDecorationsTheme="{StaticResource TitleBarDecorations}"
        WindowStartupLocation="CenterOwner">

    <!-- It can't be minimized: with no taskbar entry, a minimized window would have nothing to restore it from. -->

    <Window.Styles>
        <!-- While a job runs, the spinner takes the icon's place. The icon is see-through rather than hidden, so its
             column keeps its width and the summary doesn't move. -->
        <Style Selector="Border.title-bar.busy > Grid > Image">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <!-- The spinner, over the icon: under the pointer (or focused) it turns into an X that cancels. It fills the
             icon's column (12 + 16 + 6), padded so the spinner centres where the icon does, and the bar's height inside
             the bottom line. -->
        <Style Selector="Button.cancel">
            <Setter Property="Width" Value="34" />
            <Setter Property="Padding" Value="6,0,0,0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.cancel ctl|LineIcon">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Button.cancel:pointerover Arc, Button.cancel:focus-visible Arc">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Button.cancel:pointerover ctl|LineIcon, Button.cancel:focus-visible ctl|LineIcon">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.cancel:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolHoverBrush}" />
        </Style>
        <Style Selector="Button.cancel:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolPressedBrush}" />
        </Style>

        <!-- An outcome chip's label is coloured once it has something in it: amber for skipped, red for failed. -->
        <Style Selector="TextBlock.outcome.attention">
            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
        </Style>
        <Style Selector="TextBlock.outcome.failed">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
        </Style>

        <Style Selector="ListBox.results">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Rows: hover and selection as in the library list (tint and a violet bar on the left). The
             separator is on the row inside the padding, so it's inset from the bar. -->
        <Style Selector="ListBox.results ListBoxItem">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.results ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolHoverBrush}" />
        </Style>
        <Style Selector="ListBox.results ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ListBox.results ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentTintStrongBrush}" />
        </Style>
        <Style Selector="Border.result-row">
            <Setter Property="Padding" Value="0,9" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        </Style>

        <!-- The round status mark at the start of a row: green, amber, red, or grey when canceled. -->
        <Style Selector="Border.status-badge">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="#2E4ADE80" />
        </Style>
        <Style Selector="Border.status-badge > TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#4ADE80" />
        </Style>
        <Style Selector="Border.status-badge.attention">
            <Setter Property="Background" Value="#2EFBBF24" />
        </Style>
        <Style Selector="Border.status-badge.attention > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
        </Style>
        <Style Selector="Border.status-badge.failed">
            <Setter Property="Background" Value="#2EF87171" />
        </Style>
        <Style Selector="Border.status-badge.failed > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
        </Style>
        <Style Selector="Border.status-badge.canceled">
            <Setter Property="Background" Value="{DynamicResource ToolHoverBrush}" />
        </Style>
        <Style Selector="Border.status-badge.canceled > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>

        <Style Selector="TextBlock.message">
            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
        </Style>
        <Style Selector="TextBlock.message.error">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
        </Style>
    </Window.Styles>

    <Window.DataTemplates>
        <!-- One item: its status mark, its name, what happened, and any warnings or errors. -->
        <DataTemplate DataType="vm:JobItemRow">
            <Border Classes="result-row">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Grid.Column="0"
                            Classes="status-badge"
                            Classes.attention="{Binding IsAttention}"
                            Classes.failed="{Binding IsFailed}"
                            Classes.canceled="{Binding IsCanceled}">
                        <TextBlock Text="{Binding Glyph}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Name}"
                                   Text="{Binding Name}" />
                        <SelectableTextBlock FontSize="12"
                                             Opacity="0.7"
                                             TextWrapping="Wrap"
                                             Text="{Binding Detail}" />
                        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Messages}" IsVisible="{Binding HasMessages}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- A warning or error: the rule as a chip, then the message. -->
        <DataTemplate DataType="vm:JobMessageRow">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Border Grid.Column="0"
                        Classes="chip large"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                    <TextBlock Text="{Binding RuleId}" />
                </Border>
                <TextBlock Grid.Column="1"
                           Classes="message"
                           Classes.error="{Binding IsError}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Text="{Binding Message}" />
            </Grid>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- The title bar, as the main window's is, over the job's progress: the icon (the owner's, set in code), or
             while a job runs the spinner that cancels it, then the summary. Dragging anywhere but the spinner moves the
             window. Layered: the progress, then the title bar, see-through so the progress shows, then the spinner. -->
        <Panel Grid.Row="0" Height="31">
            <ProgressBar Classes="fill"
                         Margin="0,0,0,1"
                         Minimum="0" Maximum="100"
                         Value="{Binding Progress}"
                         IsVisible="{Binding IsRunning}"
                         IsHitTestVisible="False"
                         AutomationProperties.Name="{Binding SummaryText}" />

            <ctl:TitleBar x:Name="WindowTitleBar"
                          HelpPage="{x:Static help:HelpPages.JobProgress}"
                          Background="Transparent"
                          BorderThickness="0,0,0,1"
                          BorderBrush="{DynamicResource SubtleBorderBrush}"
                          Classes.busy="{Binding IsRunning}"
                          AppName="{x:Static res:Strings.AppName}">
                <TextBlock Margin="8,0,12,0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Classes.muted="{Binding IsWaiting}"
                           Text="{Binding SummaryText}" />
            </ctl:TitleBar>

            <Button Classes="cancel"
                    Margin="0,0,0,1"
                    chrome:WindowDecorationProperties.ElementRole="User"
                    Command="{Binding CancelCommand}"
                    IsVisible="{Binding IsRunning}"
                    ToolTip.Tip="{x:Static res:Strings.CancelJobToolTip}"
                    AutomationProperties.Name="{x:Static res:Strings.CancelJobToolTip}">
                <Panel>
                    <Arc Classes="spinner"
                         Classes.active="{Binding IsRunning}"
                         Width="14" Height="14" StrokeThickness="2" />
                    <ctl:LineIcon Data="{StaticResource ClearStroke}" />
                </Panel>
            </Button>
        </Panel>

        <!-- Search, and a chip per outcome, as the library's search strip is. With no chip on, every outcome is shown;
             with some on, only theirs. -->
        <Border Grid.Row="1"
                Padding="6"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SubtleBorderBrush}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0"
                         Classes="clearButton"
                         VerticalContentAlignment="Center"
                         Text="{Binding Results.SearchText}"
                         PlaceholderText="{x:Static res:Strings.JobSearchWatermark}"
                         AutomationProperties.Name="{x:Static res:Strings.JobSearchWatermark}">
                    <TextBox.InnerLeftContent>
                        <ctl:LineIcon Data="{StaticResource SearchStroke}" Margin="8,0,0,0" Opacity="0.6" />
                    </TextBox.InnerLeftContent>
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Escape" Command="{Binding Results.ClearSearchCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>

                <ItemsControl Grid.Column="1"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding Results.Chips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:JobOutcomeChip">
                            <ToggleButton Classes="filterChip"
                                          IsChecked="{Binding IsOn}"
                                          AutomationProperties.Name="{Binding Label}">
                                <TextBlock Classes="outcome"
                                           Classes.attention="{Binding IsAttention}"
                                           Classes.failed="{Binding IsFailed}"
                                           VerticalAlignment="Center"
                                           Text="{Binding Label}" />
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Every item in one list, problems first, or why there are none. Double-clicking a row selects its song in
             the main window's library (JobProgressWindow.axaml.cs). -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}">
            <Panel>
                <ListBox x:Name="ResultList"
                         Classes="results"
                         ItemsSource="{Binding Results.Rows}"
                         AutomationProperties.Name="{x:Static res:Strings.JobResultsListName}" />
                <TextBlock Classes="muted centered"
                           VerticalAlignment="Center"
                           Margin="16"
                           IsHitTestVisible="False"
                           Text="{x:Static res:Strings.JobGroupEmpty}"
                           IsVisible="{Binding !Results.HasRows}" />
                <TextBlock Classes="muted centered"
                           VerticalAlignment="Center"
                           Margin="16"
                           IsHitTestVisible="False"
                           Text="{Binding Results.NoMatchesText}"
                           IsVisible="{Binding Results.HasNoMatches}" />
            </Panel>
        </Border>

        <!-- How many items are listed, or shown of them; then Cancel, while a job runs, and Close. -->
        <Border Grid.Row="3" Classes="toolbar" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Grid.Column="0"
                           Classes="muted"
                           Margin="4,0,0,0"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Results.CountText}"
                           IsVisible="{Binding Results.HasRows}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button MinWidth="80"
                            HorizontalContentAlignment="Center"
                            Content="{x:Static sres:SharedStrings.CancelButton}"
                            Command="{Binding CancelCommand}"
                            IsVisible="{Binding IsRunning}"
                            ToolTip.Tip="{x:Static res:Strings.CancelJobToolTip}"
                            AutomationProperties.Name="{x:Static res:Strings.CancelJobToolTip}" />
                    <Button MinWidth="80"
                            HorizontalContentAlignment="Center"
                            Content="{x:Static res:Strings.CloseButton}"
                            IsCancel="True"
                            Click="OnClose"
                            AutomationProperties.Name="{x:Static res:Strings.CloseButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
