<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="using:ChartPacker.Resources"
        mc:Ignorable="d"
        x:Class="ChartPacker.Views.MessageDialog"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        MinWidth="360"
        MaxWidth="480">
    <StackPanel Margin="20" Spacing="20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <!-- OK is the only choice, so Enter and Escape both close it. -->
        <Button HorizontalAlignment="Right"
                MinWidth="80"
                HorizontalContentAlignment="Center"
                Classes="accent"
                Content="{x:Static res:Strings.OkButton}"
                IsDefault="True"
                IsCancel="True"
                Click="OnOk"
                AutomationProperties.Name="{x:Static res:Strings.OkButton}" />
    </StackPanel>
</Window>
