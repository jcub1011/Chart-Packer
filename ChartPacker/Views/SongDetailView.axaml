<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ChartPacker.ViewModels"
             xmlns:res="using:ChartPacker.Resources"
             xmlns:ctl="using:ChartPacker.Controls"
             xmlns:meta="using:ChartPacker.Core.Metadata"
             xmlns:conv="using:ChartPacker.Converters"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="600"
             x:Class="ChartPacker.Views.SongDetailView"
             x:DataType="vm:SongDetailViewModel"
             Focusable="True"
             FocusAdorner="{x:Null}"
             ToolTip.ServiceEnabled="False">
    <!-- Focusable so a click on empty space can take focus from an edit box, which commits it. Tooltips don't pop up
         over the panel: TipStrip shows them along its bottom instead. -->

    <UserControl.Resources>
        <conv:DifficultyGlyphConverter x:Key="DifficultyGlyph"
                                       Guitar="{StaticResource InstrumentGuitarGeometry}"
                                       Bass="{StaticResource InstrumentBassGeometry}"
                                       Rhythm="{StaticResource InstrumentRhythmGeometry}"
                                       Drums="{StaticResource InstrumentDrumsGeometry}"
                                       ProDrums="{StaticResource InstrumentProDrumsGeometry}"
                                       Keys="{StaticResource InstrumentKeysGeometry}"
                                       ProKeys="{StaticResource InstrumentProKeysGeometry}"
                                       Vocals="{StaticResource InstrumentVocalsGeometry}"
                                       Harmonies="{StaticResource InstrumentHarmoniesGeometry}"
                                       Dance="{StaticResource InstrumentDanceGeometry}"
                                       Band="{StaticResource InstrumentBandGeometry}" />
        <!-- A chart difficulty's letter: E, M, H, X. -->
        <conv:DifficultyBrushConverter x:Key="DifficultyLetterBrush"
                                       Level0="{StaticResource DifficultyEasyBrush}"
                                       Level1="{StaticResource DifficultyMediumBrush}"
                                       Level2="{StaticResource DifficultyHardBrush}"
                                       Level3="{StaticResource DifficultyExpertBrush}" />
        <!-- A song.ini tier, 0 to 6 and up; unset is grey. -->
        <conv:DifficultyBrushConverter x:Key="DifficultyTierBrush"
                                       Level0="{StaticResource DifficultyTier0Brush}"
                                       Level1="{StaticResource DifficultyTier1Brush}"
                                       Level2="{StaticResource DifficultyTier2Brush}"
                                       Level3="{StaticResource DifficultyTier3Brush}"
                                       Level4="{StaticResource DifficultyTier4Brush}"
                                       Level5="{StaticResource DifficultyTier5Brush}"
                                       Level6="{StaticResource DifficultyTier6Brush}"
                                       Fallback="{StaticResource DifficultyUnsetBrush}" />

        <!-- The note highway's options, shared by its button in the background's caption and in its own row's. Always
             below the button, never flipped over the highway, so the lanes stay in sight while the offsets are set;
             short of room it shrinks and scrolls instead. -->
        <Flyout x:Key="HighwayOptionsFlyout"
                x:DataType="vm:SongDetailViewModel"
                Placement="BottomEdgeAlignedRight"
                PlacementConstraintAdjustment="SlideX, FlipX, ResizeY"
                FlyoutPresenterClasses="highwayFlyout"
                Opened="OnHighwayOptionsOpened"
                Closed="OnHighwayOptionsClosed">
            <!-- Focusable, so a click on its empty space or a label (or Enter in an offset box) can take
                 focus from the offset box without closing the flyout. -->
            <StackPanel Classes="highwayOptions"
                        Spacing="8"
                        Background="Transparent"
                        Focusable="True"
                        PointerPressed="OnOffsetFlyoutPressed"
                        AutomationProperties.Name="{x:Static res:Strings.HighwayOptionsName}">
                <TextBlock Classes="highwayHeader" Text="{x:Static res:Strings.HighwayInstrumentsHeader}" />
                <ItemsControl ItemsSource="{Binding Highway.Rows}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HighwayRowViewModel">
                            <Grid ColumnDefinitions="110,140,Auto,Auto,Auto,130" ColumnSpacing="6">
                                <CheckBox Grid.Column="0"
                                          Content="{Binding Name}"
                                          IsChecked="{Binding IsChecked}" />
                                <ComboBox Grid.Column="1"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding Difficulties}"
                                          SelectedIndex="{Binding DifficultyIndex}"
                                          AutomationProperties.Name="{Binding Name}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DifficultyOption">
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <NumericUpDown Grid.Column="2"
                                               ctl:DragScrub.IsEnabled="True"
                                               Width="72"
                                               ShowButtonSpinner="False"
                                               VerticalAlignment="Center"
                                               Value="{Binding Offset}"
                                               IsEnabled="{Binding CanEdit}"
                                               Increment="1"
                                               Minimum="-2147483648"
                                               Maximum="2147483647"
                                               FormatString="+0;-0;0"
                                               AutomationProperties.Name="{x:Static res:Strings.HighwayOffsetName}">
                                    <!-- What it moves, then, muted, the ways to change it, which every offset box shares. -->
                                    <ToolTip.Tip>
                                        <StackPanel MaxWidth="320" Spacing="6">
                                            <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.HighwayOffsetToolTip}" />
                                            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static res:Strings.OffsetControlsHelp}" />
                                        </StackPanel>
                                    </ToolTip.Tip>
                                </NumericUpDown>
                                <TextBlock Grid.Column="3" Classes="muted" VerticalAlignment="Center" Text="{x:Static res:Strings.HighwayOffsetUnit}" />
                                <Button Grid.Column="4"
                                        Classes="nudge"
                                        Command="{Binding RevertOffsetCommand}"
                                        ToolTip.Tip="{x:Static res:Strings.HighwayRevertOffsetToolTip}"
                                        AutomationProperties.Name="{x:Static res:Strings.HighwayRevertOffsetToolTip}">
                                    <PathIcon Width="12" Height="12" Data="{StaticResource RevertIconGeometry}" />
                                </Button>
                                <!-- The track drawn behind the instrument's notes: its own, or one picked for this song. -->
                                <ComboBox Grid.Column="5"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding WaveformPicker.Options}"
                                          SelectedIndex="{Binding WaveformPicker.Index}"
                                          IsEnabled="{Binding $parent[ItemsControl].((vm:SongDetailViewModel)DataContext).Player.AreLaneWaveformsShown, FallbackValue=False}"
                                          ToolTip.Tip="{x:Static res:Strings.LaneWaveformPickerToolTip}"
                                          AutomationProperties.Name="{x:Static res:Strings.LaneWaveformName}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WaveformOption">
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="finding" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Text="{Binding Highway.Problem}" IsVisible="{Binding Highway.HasProblem}" />
                <TextBlock Classes="muted" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Text="{Binding Highway.Note}" IsVisible="{Binding Highway.HasNote}" />
                <!-- Shared with the lyrics lane's waveform button, and a setting; only while track waveforms are read. -->
                <CheckBox Content="{x:Static res:Strings.ShowLaneWaveformsLabel}"
                          IsChecked="{Binding Player.ShowLaneWaveforms}"
                          IsEnabled="{Binding Player.ShowWaveforms}"
                          ToolTip.Tip="{Binding Player.LaneWaveformsToolTip}"
                          ToolTip.ShowOnDisabled="True" />
                <Grid ColumnDefinitions="110,*" ColumnSpacing="6">
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{x:Static res:Strings.HighwayNoteSpeedLabel}" />
                    <Slider Grid.Column="1"
                            Minimum="0.5"
                            Maximum="3"
                            SmallChange="0.1"
                            LargeChange="0.5"
                            Value="{Binding Highway.NoteSpeed}"
                            AutomationProperties.Name="{x:Static res:Strings.HighwayNoteSpeedLabel}" />
                </Grid>
                <TextBlock Classes="muted" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" FontSize="12" Text="{x:Static res:Strings.HighwayFootnote}" />
            </StackPanel>
        </Flyout>
        <!-- "Expert   1,234 notes": a list's labels line up in a column, for an ItemsControl that's a shared size scope. -->
        <DataTemplate x:Key="NoteCountRowTemplate" x:DataType="vm:NoteCountRow">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="NoteCountLabel" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Classes="muted" Text="{Binding Label}" />
                <TextBlock Grid.Column="1" Text="{Binding Count}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- A flyout floats over the panel, and can cover the tip strip, so its tips pop up as usual. -->
        <Style Selector="FlyoutPresenter">
            <Setter Property="ToolTip.ServiceEnabled" Value="True" />
        </Style>
        <!-- The tip of what's under the pointer, over the bottom of the panel: its background is see-through, so the
             rows under it still show, its words aren't. -->
        <Style Selector="ctl|ToolTipStrip">
            <Setter Property="Background" Value="{DynamicResource ToolTipStripBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="TextElement.FontSize" Value="12" />
        </Style>

        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Margin" Value="0,22,0,8" />
        </Style>
        <Style Selector="TextBlock.finding">
            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
        </Style>
        <Style Selector="TextBlock.finding.error">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- A metadata row whose value fails validation: an orange bar at its left, a faint tint, and why under it. -->
        <Style Selector="Border.metadataRow">
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="2,0,0,0" />
        </Style>
        <Style Selector="Border.metadataRow.invalid">
            <Setter Property="BorderBrush" Value="{DynamicResource InvalidBrush}" />
            <Setter Property="Background" Value="{DynamicResource InvalidTintBrush}" />
        </Style>
        <Style Selector="TextBlock.issue">
            <Setter Property="Foreground" Value="{DynamicResource InvalidBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <!-- Row markers: * edited, + added; removed rows are struck through. -->
        <Style Selector="TextBlock.marker">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground">
                <SolidColorBrush Color="{DynamicResource SystemAccentColor}" />
            </Setter>
        </Style>
        <Style Selector="TextBlock.removed">
            <Setter Property="TextDecorations" Value="Strikethrough" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="TextBlock.distinct">
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>

        <!-- A metadata value: reads as plain text, and is a button so it can be clicked or tabbed to for editing. -->
        <Style Selector="Button.value">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Margin" Value="-4,0,0,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Ibeam" />
        </Style>
        <Style Selector="Button.value:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <!-- Fluent shrinks a pressed button a little; across a full-width value that reads as the row sliding. -->
        <Style Selector="Button.value:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Button.value:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListMediumBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <!-- Read-only (e.g. while saving, or a removed row) should still read normally. -->
        <Style Selector="Button.value:disabled">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.value:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>

        <!-- A value's edit box, sized so its text lands exactly where Button.value's did: border 1 +
             padding 3,1 matches that padding of 4,2, and there's no minimum size, so the row doesn't
             move when editing starts. The focus border is drawn behind the text, so it doesn't shift either. -->
        <Style Selector="TextBox.inline">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="3,1" />
            <Setter Property="Margin" Value="-4,0,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="Border.artTile">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <!-- A tile's actions, small and flat beside its file's name in its caption: Replace, Remove, then Undo. -->
        <Style Selector="Button.captionAction">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.captionAction:pointerover, Button.captionAction:focus-visible">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.captionAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
        </Style>
        <Style Selector="Button.captionAction:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Button.captionAction:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListMediumBrush}" />
        </Style>
        <!-- Remove stays in place, dimmed, when there's nothing to remove, so the buttons don't move;
             Undo is only there while there's a change to undo. -->
        <Style Selector="Button.captionAction:disabled">
            <Setter Property="Opacity" Value="0.3" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.captionAction:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.captionAction.revert:disabled">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.captionAction PathIcon">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
        </Style>

        <!-- The caption under a tile: its file's name, which gives way on a narrow tile, then its size
             (and the background's Image | Video switch), which are always shown whole. -->
        <Style Selector="Border.mediaCaption">
            <Setter Property="Padding" Value="0,6,0,0" />
        </Style>
        <Style Selector="Border.mediaCaption TextBlock.marker, Border.mediaCaption TextBlock.artName">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.artName">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- The background's Image | Video switch: radio buttons, so one is always picked, drawn as
             compact icon toggles with the one shown in the accent. -->
        <Style Selector="RadioButton.backgroundKind">
            <Setter Property="Theme" Value="{StaticResource {x:Type ToggleButton}}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="RadioButton.backgroundKind PathIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>

        <!-- The note highway's switch, sized to sit with the Image | Video switch, and its options. -->
        <Style Selector="ToggleSplitButton.highway">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleSplitButton.highway PathIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>
        <!-- Wider than Fluent lets a flyout be, so a row's difficulty, offset and waveform fit on one line. -->
        <Style Selector="FlyoutPresenter.highwayFlyout">
            <Setter Property="MaxWidth" Value="720" />
        </Style>
        <!-- The background's offset button, sized to sit with the Image | Video switch beside it. -->
        <Style Selector="Button.offset">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.offset PathIcon, StackPanel.timing PathIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>
        <Style Selector="TextBlock.highwayHeader">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="Button.nudge">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The instruments above the metadata: a round icon with the difficulty in a badge at its bottom right
             and the variant's tag at its top left, and the name and charted difficulties under it. -->
        <Style Selector="Button.instrument">
            <Setter Property="Width" Value="100" />
            <Setter Property="Padding" Value="2,4" />
            <Setter Property="Margin" Value="0,0,2,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.instrument:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
        </Style>
        <Style Selector="Button.instrument:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <!-- Read-only, the icons still read normally. -->
        <Style Selector="Button.instrument:disabled">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.instrument:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <!-- The chart has no notes for the part. -->
        <Style Selector="Button.instrument.absent StackPanel.instrumentFace">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Border.instrumentCircle">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Background" Value="{DynamicResource ToolbarGroupBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- A pending change rings the icon in the accent, as * marks an edited row. -->
        <Style Selector="Border.instrumentCircle.edited">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush">
                <SolidColorBrush Color="{DynamicResource SystemAccentColor}" />
            </Setter>
        </Style>
        <Style Selector="Border.instrumentCircle PathIcon">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
        </Style>
        <Style Selector="Button.instrument.absent Border.instrumentCircle PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
        </Style>
        <!-- Outlined in the panel's colour, so the badge and tag read as cut out of the circle. -->
        <Style Selector="Border.instrumentBadge">
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="Border.instrumentBadge TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource DifficultyBadgeTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.instrumentBadge.unset TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="Border.instrumentTag">
            <Setter Property="Height" Value="14" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{DynamicResource ToolbarGroupBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Border.instrumentTag TextBlock">
            <Setter Property="FontSize" Value="8" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.instrumentName">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.difficultyLetter">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <!-- The flyout's difficulties: a swatch of each tier's colour with its number, the current one outlined. -->
        <Style Selector="Button.preset">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="Border.presetFace">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.preset:pointerover Border.presetFace">
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="Button.preset.current Border.presetFace">
            <Setter Property="BorderBrush" Value="White" />
        </Style>
        <Style Selector="Border.presetFace TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource DifficultyBadgeTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.presetFace.unset TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>

        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Button.icon:pointerover, Button.icon:focus-visible">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- Playback: round transport buttons, and small M/S toggles that fill in with the accent when on. -->
        <Style Selector="Button.transport">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.transport PathIcon">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
        </Style>
        <!-- A track's waveform fades while the track isn't heard, as the mix's waveform leaves it out. -->
        <Style Selector="ctl|WaveformView.track">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ctl|WaveformView.track.unheard">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <!-- While the highway's options are open, its notes are drawn as outlines, so the waveform behind them shows
             and a note can be lined up with its sound as offsets are set. -->
        <Style Selector="ctl|NoteHighwayView.tuning">
            <Setter Property="AreNotesOutlined" Value="True" />
        </Style>
        <Style Selector="ToggleButton.trackSwitch">
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- Behind everything, along the bottom of the panel: what's heard as a spectrum, whichever song is
             playing, up to 128px tall. It stays put while the details scroll over it. Hidden, it stops drawing. -->
        <ctl:SpectrumView VerticalAlignment="Bottom"
                          MaxHeight="128"
                          IsVisible="{Binding Player.ShowSpectrum}"
                          IsActive="{Binding Player.IsPlaying}"
                          Source="{Binding Player}"
                          LowColor="{DynamicResource SpectrumLowColor}"
                          MiddleColor="{DynamicResource SpectrumMiddleColor}"
                          HighColor="{DynamicResource SpectrumHighColor}" />

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="24"
                    Spacing="6"
                    IsVisible="{Binding ShowPlaceholder}">
            <TextBlock Classes="centered"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Text="{x:Static res:Strings.DetailPlaceholderTitle}" />
            <TextBlock Classes="muted centered" Text="{x:Static res:Strings.DetailPlaceholderBody}" />
        </StackPanel>

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    IsVisible="{Binding IsLoading}">
            <Arc Classes="spinner"
                 Classes.active="{Binding IsLoading}"
                 Width="36" Height="36" StrokeThickness="3"
                 HorizontalAlignment="Center" />
            <TextBlock Classes="muted centered" Text="{x:Static res:Strings.Loading}" />
        </StackPanel>

        <TextBlock Classes="centered"
                   VerticalAlignment="Center"
                   Margin="24"
                   Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                   Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}" />

        <DockPanel IsVisible="{Binding ShowDetails}">
            <!-- Save and Discard are on the toolbar; a failed save is reported here, above the rows it concerns. -->
            <Border DockPanel.Dock="Top"
                    Classes="banner error"
                    Margin="20,12,20,0"
                    IsVisible="{Binding HasSaveError}">
                <SelectableTextBlock TextWrapping="Wrap" Text="{Binding SaveError}" />
            </Border>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,16">
                    <!-- "Name - Artist", with the charter at the right; the path below, with the song's size at the right.
                         Right-clicking either line shows the songs in the file manager. -->
                    <StackPanel Background="Transparent">
                        <StackPanel.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{x:Static vm:SongDetailViewModel.RevealLabel}" Command="{Binding RevealCommand}" />
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <SelectableTextBlock Grid.Column="0"
                                                 FontSize="18"
                                                 FontWeight="SemiBold"
                                                 VerticalAlignment="Center"
                                                 TextWrapping="Wrap"
                                                 Text="{Binding Title}" />
                            <!-- The charter can carry rich-text tags (colours, bold…), which are drawn rather than shown. -->
                            <Border Grid.Column="1"
                                    Classes="chip large"
                                    MaxWidth="240"
                                    IsVisible="{Binding HasCharter}"
                                    ToolTip.Tip="{x:Static res:Strings.CharterToolTip}">
                                <TextBlock Opacity="1"
                                           TextTrimming="CharacterEllipsis"
                                           ctl:RichTextMarkup.Text="{Binding Charter}" />
                            </Border>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,2,0,0">
                            <SelectableTextBlock Grid.Column="0"
                                                 Opacity="0.7"
                                                 FontSize="12"
                                                 VerticalAlignment="Center"
                                                 TextWrapping="Wrap"
                                                 Text="{Binding Subtitle}" />
                            <Border Grid.Column="1" Classes="chip large" IsVisible="{Binding HasSizeText}">
                                <TextBlock Text="{Binding SizeText}" />
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Album art on the left and the background beside it, each in its own shape, as tall as
                         lets both fit the panel's width, with a caption below each. The row, captions included,
                         is at most 512px or 40% of the window's height, whichever is smaller. -->
                    <ctl:MediaRow Margin="0,16,0,0" MaxRowHeight="512" MaxViewportFraction="0.4" FooterHeight="32" ClipToBounds="True">
                        <!-- The file's name, with its actions beside it, and its size in a chip, under the tile; a - for
                             each when there's none. -->
                        <DockPanel ctl:MediaRow.AspectRatio="{Binding ArtAspect}">
                            <Border DockPanel.Dock="Bottom"
                                    Classes="mediaCaption"
                                    Height="{Binding $parent[ctl:MediaRow].FooterHeight}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                    <!-- Shown while the art has a staged change, like an edited row's marker. -->
                                    <TextBlock Grid.Column="0"
                                               Classes="marker"
                                               Text="{Binding ArtMarker}"
                                               IsVisible="{Binding IsArtChanged}" />
                                    <!-- Left-aligned, the name's column is only as wide as the name, so the actions sit just
                                         after it; short of room, the name gives way rather than the actions. -->
                                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="4" HorizontalAlignment="Left">
                                        <TextBlock Classes="artName"
                                                   Text="{Binding ArtFileName, TargetNullValue='-'}"
                                                   ToolTip.Tip="{Binding ArtFileName}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" IsVisible="{Binding CanEdit}">
                                            <Button Classes="captionAction"
                                                    Command="{Binding ReplaceArtCommand}"
                                                    ToolTip.Tip="{x:Static res:Strings.ReplaceArtToolTip}"
                                                    AutomationProperties.Name="{x:Static res:Strings.ReplaceArtToolTip}">
                                                <PathIcon Data="{StaticResource ReplaceIconGeometry}" />
                                            </Button>
                                            <Button Classes="captionAction"
                                                    Command="{Binding RemoveArtCommand}"
                                                    ToolTip.Tip="{x:Static res:Strings.RemoveArtToolTip}"
                                                    AutomationProperties.Name="{x:Static res:Strings.RemoveArtToolTip}">
                                                <PathIcon Data="{StaticResource TrashIconGeometry}" />
                                            </Button>
                                            <!-- Hidden by Button.captionAction.revert:disabled unless there's a change to undo. -->
                                            <Button Classes="captionAction revert"
                                                    Command="{Binding RevertArtCommand}"
                                                    ToolTip.Tip="{x:Static res:Strings.RevertArtToolTip}"
                                                    AutomationProperties.Name="{x:Static res:Strings.RevertArtToolTip}">
                                                <PathIcon Data="{StaticResource RevertIconGeometry}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Column="2" Classes="chip large">
                                        <TextBlock Text="{Binding ArtFileSize, TargetNullValue='-'}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Classes="artTile" AutomationProperties.Name="{x:Static res:Strings.AlbumArtName}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding ArtDownloadHeader}" Command="{Binding DownloadArtCommand}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Panel>
                                    <Image Source="{Binding ArtImage}"
                                           Stretch="Uniform"
                                           IsVisible="{Binding HasArtImage}" />
                                    <StackPanel VerticalAlignment="Center"
                                                Margin="12"
                                                Spacing="6"
                                                IsVisible="{Binding !HasArtImage}">
                                        <PathIcon Width="28" Height="28"
                                                  Opacity="0.4"
                                                  HorizontalAlignment="Center"
                                                  Data="{StaticResource AlbumArtIconGeometry}" />
                                        <TextBlock Classes="muted centered"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding ArtNote}" />
                                    </StackPanel>
                                </Panel>
                            </Border>
                        </DockPanel>

                        <!-- The background video or image, or why there's none to show, captioned like the art, with its
                             actions beside its name and the Image | Video switch at the right. Remove removes the kind shown. -->
                        <DockPanel ctl:MediaRow.AspectRatio="{Binding Background.AspectRatio}">
                            <Border DockPanel.Dock="Bottom"
                                    Classes="mediaCaption"
                                    Height="{Binding $parent[ctl:MediaRow].FooterHeight}">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0"
                                               Classes="marker"
                                               Text="{Binding Background.Marker}"
                                               IsVisible="{Binding Background.IsChanged}" />
                                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="4" HorizontalAlignment="Left">
                                        <TextBlock Classes="artName"
                                                   Text="{Binding Background.ShownFileName, TargetNullValue='-'}"
                                                   ToolTip.Tip="{Binding Background.ShownFileName}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" IsVisible="{Binding CanEdit}">
                                            <Button Classes="captionAction"
                                                    Command="{Binding ReplaceBackgroundCommand}"
                                                    ToolTip.Tip="{x:Static res:Strings.ReplaceBackgroundToolTip}"
                                                    AutomationProperties.Name="{x:Static res:Strings.ReplaceBackgroundToolTip}">
                                                <PathIcon Data="{StaticResource ReplaceIconGeometry}" />
                                            </Button>
                                            <Button Classes="captionAction"
                                                    Command="{Binding RemoveBackgroundCommand}"
                                                    ToolTip.Tip="{Binding Background.RemoveToolTip}"
                                                    AutomationProperties.Name="{Binding Background.RemoveToolTip}">
                                                <PathIcon Data="{StaticResource TrashIconGeometry}" />
                                            </Button>
                                            <Button Classes="captionAction revert"
                                                    Command="{Binding RevertBackgroundCommand}"
                                                    ToolTip.Tip="{x:Static res:Strings.RevertBackgroundToolTip}"
                                                    AutomationProperties.Name="{x:Static res:Strings.RevertBackgroundToolTip}">
                                                <PathIcon Data="{StaticResource RevertIconGeometry}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Column="2" Classes="chip large">
                                        <TextBlock Text="{Binding Background.ShownFileSize, TargetNullValue='-'}" />
                                    </Border>
                                    <!-- The note highway's button, while the highway is drawn over the background; only one song's chart can
                                         play along, so it's hidden for several. -->
                                    <Panel Grid.Column="3" IsVisible="{Binding ShowSongFiles}">
                                        <ToggleSplitButton Classes="highway"
                                                           IsChecked="{Binding Highway.IsEnabled}"
                                                           IsEnabled="{Binding Highway.HasChart}"
                                                           IsVisible="{Binding Highway.IsOverBackground}"
                                                           ToolTip.Tip="{Binding Highway.ToggleToolTip}"
                                                           Flyout="{StaticResource HighwayOptionsFlyout}"
                                                           AutomationProperties.Name="{x:Static res:Strings.HighwayToggleToolTip}">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <PathIcon Data="{StaticResource HighwayIconGeometry}" />
                                                <TextBlock Classes="marker" Text="{Binding Highway.Marker}" IsVisible="{Binding Highway.IsChanged}" />
                                            </StackPanel>
                                        </ToggleSplitButton>
                                    </Panel>
                                    <!-- The video's offset, in a flyout of its own so the caption stays short; only while one song
                                         is selected and it has a video, whether or not the video is what's shown. Focusable, so a click on its empty space or a label (or Enter
                                         in the box) can take focus from the box without closing the flyout. -->
                                    <Button Grid.Column="4"
                                            Classes="offset"
                                            IsVisible="{Binding ShowVideoOffset}"
                                            ToolTip.Tip="{x:Static res:Strings.VideoOffsetButtonToolTip}"
                                            AutomationProperties.Name="{x:Static res:Strings.VideoOffsetName}">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <PathIcon Data="{StaticResource OffsetIconGeometry}" />
                                            <TextBlock Classes="marker" Text="{Binding VideoOffset.Marker}" IsVisible="{Binding VideoOffset.HasOffset}" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedRight">
                                                <StackPanel Spacing="6"
                                                            Background="Transparent"
                                                            Focusable="True"
                                                            PointerPressed="OnOffsetFlyoutPressed"
                                                            AutomationProperties.Name="{x:Static res:Strings.VideoOffsetName}">
                                                    <TextBlock Classes="highwayHeader" Text="{x:Static res:Strings.VideoOffsetName}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <NumericUpDown ctl:DragScrub.IsEnabled="True"
                                                                       Width="72"
                                                                       ShowButtonSpinner="False"
                                                                       VerticalAlignment="Center"
                                                                       Value="{Binding VideoOffset.Offset}"
                                                                       IsEnabled="{Binding VideoOffset.CanEdit}"
                                                                       Increment="1"
                                                                       Minimum="{Binding VideoOffset.MinOffset}"
                                                                       Maximum="{Binding VideoOffset.MaxOffset}"
                                                                       FormatString="+0;-0;0"
                                                                       AutomationProperties.Name="{x:Static res:Strings.VideoOffsetName}">
                                                            <ToolTip.Tip>
                                                                <StackPanel MaxWidth="320" Spacing="6">
                                                                    <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.VideoOffsetToolTip}" />
                                                                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static res:Strings.OffsetControlsHelp}" />
                                                                </StackPanel>
                                                            </ToolTip.Tip>
                                                        </NumericUpDown>
                                                        <TextBlock Classes="muted" VerticalAlignment="Center" Text="{x:Static res:Strings.HighwayOffsetUnit}" />
                                                        <Button Classes="nudge"
                                                                Command="{Binding VideoOffset.RevertOffsetCommand}"
                                                                ToolTip.Tip="{x:Static res:Strings.VideoRevertOffsetToolTip}"
                                                                AutomationProperties.Name="{x:Static res:Strings.VideoRevertOffsetToolTip}">
                                                            <PathIcon Width="12" Height="12" Data="{StaticResource RevertIconGeometry}" />
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <!-- Always shown; a kind the selection doesn't have can't be picked. -->
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2">
                                        <RadioButton Classes="backgroundKind"
                                                     IsChecked="{Binding Background.IsImageSelected}"
                                                     IsEnabled="{Binding Background.HasImageKind}"
                                                     ToolTip.Tip="{x:Static res:Strings.ShowBackgroundImageToolTip}"
                                                     AutomationProperties.Name="{x:Static res:Strings.ShowBackgroundImageToolTip}">
                                            <PathIcon Data="{StaticResource ImageIconGeometry}" />
                                        </RadioButton>
                                        <RadioButton Classes="backgroundKind"
                                                     IsChecked="{Binding Background.IsVideoSelected}"
                                                     IsEnabled="{Binding Background.HasVideoKind}"
                                                     ToolTip.Tip="{x:Static res:Strings.ShowBackgroundVideoToolTip}"
                                                     AutomationProperties.Name="{x:Static res:Strings.ShowBackgroundVideoToolTip}">
                                            <PathIcon Data="{StaticResource VideoIconGeometry}" />
                                        </RadioButton>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Classes="artTile" AutomationProperties.Name="{x:Static res:Strings.BackgroundName}">
                                <!-- Saves the kind shown, image or video, as the toggle above picks it. -->
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding Background.DownloadHeader}" Command="{Binding DownloadBackgroundCommand}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Panel>
                                    <Image Source="{Binding Background.Image}"
                                           Stretch="Uniform"
                                           IsVisible="{Binding Background.HasImage}" />
                                    <ctl:VideoFrameView Playback="{Binding Background.Video}"
                                                        Timeline="{Binding Background.Timeline}"
                                                        Clock="{Binding Background.Clock}"
                                                        IsVisible="{Binding Background.HasVideo}" />
                                    <!-- Why there's no background, behind the highway as the background would be. -->
                                    <StackPanel VerticalAlignment="Center"
                                                Margin="12"
                                                Spacing="6"
                                                IsVisible="{Binding Background.HasNote}">
                                        <PathIcon Width="28" Height="28"
                                                  Opacity="0.4"
                                                  HorizontalAlignment="Center"
                                                  Data="{StaticResource BackgroundIconGeometry}" />
                                        <TextBlock Classes="muted centered"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Background.Note}" />
                                    </StackPanel>
                                    <!-- The chart's notes over whatever the background is, as a game draws them, unless the
                                         settings put them in their own row below the lyrics. A highway under the pointer shows
                                         its whole chart while Shift is held, to scrub through. -->
                                    <ctl:NoteHighwayView x:Name="HighwayOverlayView"
                                                         Scene="{Binding Highway.Scene}"
                                                         Clock="{Binding Highway.Clock}"
                                                         LookAhead="{Binding Highway.LookAhead}"
                                                         Waveforms="{Binding Highway.LaneWaveforms}"
                                                         LengthSeconds="{Binding Player.TimelineSeconds}"
                                                         FineScrubFactor="{Binding Player.LaneFineScrubFactor}"
                                                         ToolTip.Tip="{Binding Player.HighwayScrubToolTip}"
                                                         IsVisible="{Binding Highway.IsShownOverBackground}" />
                                </Panel>
                            </Border>
                        </DockPanel>
                    </ctl:MediaRow>
                    <TextBlock Classes="error" Text="{Binding ArtError}" IsVisible="{Binding HasArtError}" />
                    <TextBlock Classes="error" Text="{Binding BackgroundError}" IsVisible="{Binding HasBackgroundError}" />

                    <!-- The one selected song's vocals as a karaoke lane, in step with the audio, shown while it has
                         a vocals track or vocals in its chart. Captioned and edited like the art. While Shift is held
                         over the lane it shows the whole part, to scrub through. -->
                    <DockPanel Margin="0,16,0,0" IsVisible="{Binding Lyrics.IsVisible}">
                        <!-- The name, which gives way on a narrow panel, with its actions beside it, then the offset at the
                             right, as the highway's instruments have in their flyout. -->
                        <Border DockPanel.Dock="Bottom" Classes="mediaCaption" MinHeight="32">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
                                <TextBlock Grid.Column="0"
                                           Classes="marker"
                                           Text="{Binding Lyrics.Marker}"
                                           IsVisible="{Binding Lyrics.IsChanged}" />
                                <TextBlock Grid.Column="1" Classes="artName" Text="{x:Static res:Strings.LyricsHeader}" />
                                <Grid Grid.Column="2" ColumnDefinitions="*,Auto" ColumnSpacing="4" HorizontalAlignment="Left">
                                    <TextBlock Classes="artName muted"
                                               Text="{Binding Lyrics.SourceName, TargetNullValue='-'}"
                                               ToolTip.Tip="{Binding Lyrics.SourceName}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" IsVisible="{Binding CanEdit}">
                                        <Button Classes="captionAction"
                                                Command="{Binding ReplaceLyricsCommand}"
                                                ToolTip.Tip="{Binding Lyrics.ReplaceToolTip}"
                                                AutomationProperties.Name="{Binding Lyrics.ReplaceToolTip}">
                                            <PathIcon Data="{StaticResource ReplaceIconGeometry}" />
                                        </Button>
                                        <Button Classes="captionAction"
                                                Command="{Binding RemoveLyricsCommand}"
                                                ToolTip.Tip="{x:Static res:Strings.LyricsRemoveToolTip}"
                                                AutomationProperties.Name="{x:Static res:Strings.LyricsRemoveToolTip}">
                                            <PathIcon Data="{StaticResource TrashIconGeometry}" />
                                        </Button>
                                        <Button Classes="captionAction revert"
                                                Command="{Binding RevertLyricsCommand}"
                                                ToolTip.Tip="{x:Static res:Strings.LyricsRevertToolTip}"
                                                AutomationProperties.Name="{x:Static res:Strings.LyricsRevertToolTip}">
                                            <PathIcon Data="{StaticResource RevertIconGeometry}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Column="3"
                                           Classes="finding"
                                           MaxWidth="260"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding Lyrics.Warning}"
                                           ToolTip.Tip="{Binding Lyrics.Warning}"
                                           IsVisible="{Binding Lyrics.HasWarning}" />
                                <!-- The audio behind the lane: the button shows or hides it, as the highway flyout's check box does,
                                     and the arrow picks the track. -->
                                <ToggleSplitButton Grid.Column="4"
                                                   Classes="highway"
                                                   IsChecked="{Binding Player.ShowLaneWaveforms}"
                                                   IsEnabled="{Binding Player.ShowWaveforms}"
                                                   IsVisible="{Binding Lyrics.HasLyrics}"
                                                   ToolTip.Tip="{Binding Player.LaneWaveformsToolTip}"
                                                   ToolTip.ShowOnDisabled="True"
                                                   AutomationProperties.Name="{x:Static res:Strings.ShowLaneWaveformsLabel}">
                                    <PathIcon Data="{StaticResource WaveformIconGeometry}" />
                                    <ToggleSplitButton.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedRight">
                                            <StackPanel Spacing="6" AutomationProperties.Name="{x:Static res:Strings.LaneWaveformOptionsName}">
                                                <TextBlock Classes="highwayHeader" Text="{x:Static res:Strings.LaneWaveformName}" />
                                                <ComboBox MinWidth="180"
                                                          ItemsSource="{Binding Lyrics.WaveformPicker.Options}"
                                                          SelectedIndex="{Binding Lyrics.WaveformPicker.Index}"
                                                          IsEnabled="{Binding Player.AreLaneWaveformsShown}"
                                                          ToolTip.Tip="{x:Static res:Strings.LaneWaveformPickerToolTip}"
                                                          AutomationProperties.Name="{x:Static res:Strings.LaneWaveformName}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:WaveformOption">
                                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                        </Flyout>
                                    </ToggleSplitButton.Flyout>
                                </ToggleSplitButton>
                                <StackPanel Grid.Column="5"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            IsVisible="{Binding Lyrics.HasLyrics}">
                                    <NumericUpDown ctl:DragScrub.IsEnabled="True"
                                                   Width="72"
                                                   ShowButtonSpinner="False"
                                                   VerticalAlignment="Center"
                                                   Value="{Binding Lyrics.Offset}"
                                                   IsEnabled="{Binding Lyrics.CanSetOffset}"
                                                   Increment="1"
                                                   Minimum="-2147483648"
                                                   Maximum="2147483647"
                                                   FormatString="+0;-0;0"
                                                   AutomationProperties.Name="{x:Static res:Strings.LyricsOffsetName}">
                                        <ToolTip.Tip>
                                            <StackPanel Spacing="6">
                                                <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.LyricsOffsetToolTip}" />
                                                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static res:Strings.OffsetControlsHelp}" />
                                            </StackPanel>
                                        </ToolTip.Tip>
                                    </NumericUpDown>
                                    <TextBlock Classes="muted" VerticalAlignment="Center" Text="{x:Static res:Strings.HighwayOffsetUnit}" />
                                    <Button Classes="nudge"
                                            Command="{Binding Lyrics.RevertOffsetCommand}"
                                            ToolTip.Tip="{x:Static res:Strings.LyricsRevertOffsetToolTip}"
                                            AutomationProperties.Name="{x:Static res:Strings.LyricsRevertOffsetToolTip}">
                                        <PathIcon Width="12" Height="12" Data="{StaticResource RevertIconGeometry}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Classes="artTile" Height="120" AutomationProperties.Name="{x:Static res:Strings.LyricsHeader}">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{x:Static res:Strings.MenuExportLyrics}" Command="{Binding ExportLyricsCommand}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Panel>
                                <ctl:LyricLaneView x:Name="LyricLane"
                                                   Scene="{Binding Lyrics.Scene}"
                                                   TimeShift="{Binding Lyrics.TimeShift}"
                                                   Waveform="{Binding Lyrics.Waveform}"
                                                   Clock="{Binding Lyrics.Clock}"
                                                   LengthSeconds="{Binding Player.TimelineSeconds}"
                                                   FineScrubFactor="{Binding Player.LaneFineScrubFactor}"
                                                   ToolTip.Tip="{Binding Player.LyricsScrubToolTip}"
                                                   IsVisible="{Binding Lyrics.HasLyrics}" />
                                <TextBlock Classes="muted centered"
                                           VerticalAlignment="Center"
                                           Margin="12"
                                           TextWrapping="Wrap"
                                           Text="{Binding Lyrics.Note}"
                                           IsVisible="{Binding Lyrics.HasNote}" />
                            </Panel>
                        </Border>
                    </DockPanel>
                    <TextBlock Classes="error" Text="{Binding LyricsError}" IsVisible="{Binding HasLyricsError}" />
                    <TextBlock Classes="error" Text="{Binding Lyrics.Problem}" IsVisible="{Binding Lyrics.HasProblem}" />

                    <!-- The one selected song's chart as note highways, one per instrument, in step with the audio, while the
                         settings put them here rather than over the background. Captioned like the lyrics: the button at the
                         right shows or hides the highways, and its arrow opens their options. -->
                    <Panel IsVisible="{Binding ShowSongFiles}">
                        <DockPanel Margin="0,16,0,0" IsVisible="{Binding Highway.IsInRow}">
                            <Border DockPanel.Dock="Bottom" Classes="mediaCaption" MinHeight="32">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0"
                                               Classes="marker"
                                               Text="{Binding Highway.Marker}"
                                               IsVisible="{Binding Highway.IsChanged}" />
                                    <TextBlock Grid.Column="1" Classes="artName" Text="{x:Static res:Strings.HighwayInstrumentsHeader}" />
                                    <TextBlock Grid.Column="2"
                                               Classes="artName muted"
                                               Text="{Binding Highway.Note}"
                                               ToolTip.Tip="{Binding Highway.Note}"
                                               IsVisible="{Binding Highway.HasNote}" />
                                    <ToggleSplitButton Grid.Column="3"
                                                       Classes="highway"
                                                       IsChecked="{Binding Highway.IsEnabled}"
                                                       IsEnabled="{Binding Highway.HasChart}"
                                                       ToolTip.Tip="{Binding Highway.ToggleToolTip}"
                                                       Flyout="{StaticResource HighwayOptionsFlyout}"
                                                       AutomationProperties.Name="{x:Static res:Strings.HighwayToggleToolTip}">
                                        <PathIcon Data="{StaticResource HighwayIconGeometry}" />
                                    </ToggleSplitButton>
                                </Grid>
                            </Border>

                            <!-- Only while there's a chart and the highways are switched on, leaving the caption, with why there's
                                 no chart, to switch them back on. Highways are as wide as the height allows, centred. -->
                            <Border Classes="artTile"
                                    Height="240"
                                    IsVisible="{Binding Highway.IsTileShown}"
                                    AutomationProperties.Name="{x:Static res:Strings.HighwayInstrumentsHeader}">
                                <ctl:NoteHighwayView x:Name="HighwayRowView"
                                                     Scene="{Binding Highway.Scene}"
                                                     Clock="{Binding Highway.Clock}"
                                                     LookAhead="{Binding Highway.LookAhead}"
                                                     Waveforms="{Binding Highway.LaneWaveforms}"
                                                     LengthSeconds="{Binding Player.TimelineSeconds}"
                                                     FineScrubFactor="{Binding Player.LaneFineScrubFactor}"
                                                     ToolTip.Tip="{Binding Player.HighwayScrubToolTip}"
                                                     IsVisible="{Binding Highway.IsShown}" />
                            </Border>
                        </DockPanel>
                    </Panel>

                    <!-- The one selected song's audio tracks, played together and in step. A track
                         can be muted, or soloed to hear it alone; added and removed tracks play as
                         they will be once saved. A removed track stays listed, struck through, until
                         it's kept after all or something replaces it. -->
                    <StackPanel IsVisible="{Binding ShowSongFiles}" Grid.IsSharedSizeScope="True">
                        <!-- Fluent gives a slider a tall row of its own; the volume sliders fit the compact track rows instead. -->
                        <StackPanel.Resources>
                            <x:Double x:Key="SliderHorizontalHeight">20</x:Double>
                        </StackPanel.Resources>
                        <!-- The audio offset, the master volume, the playback speed and pitch correction sit at the right of the
                             header; each track has its own level in the mix below. The offset moves every track alike, as
                             song.ini's delay does. -->
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" Classes="section" Text="{Binding Player.TracksHeader}" />
                            <StackPanel Grid.Column="1"
                                        Classes="timing"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding Player.HasTracks}">
                                <TextBlock Classes="marker" VerticalAlignment="Center" Text="{Binding AudioOffset.Marker}" IsVisible="{Binding AudioOffset.HasOffset}" />
                                <PathIcon Opacity="0.7" VerticalAlignment="Center" Data="{StaticResource OffsetIconGeometry}" />
                                <NumericUpDown ctl:DragScrub.IsEnabled="True"
                                               Width="72"
                                               ShowButtonSpinner="False"
                                               VerticalAlignment="Center"
                                               Value="{Binding AudioOffset.Offset}"
                                               IsEnabled="{Binding AudioOffset.CanEdit}"
                                               Increment="1"
                                               Minimum="{Binding AudioOffset.MinOffset}"
                                               Maximum="{Binding AudioOffset.MaxOffset}"
                                               FormatString="+0;-0;0"
                                               ToolTip.ShowOnDisabled="True"
                                               AutomationProperties.Name="{x:Static res:Strings.AudioOffsetName}">
                                    <ToolTip.Tip>
                                        <StackPanel Spacing="6">
                                            <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.AudioOffsetToolTip}" />
                                            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static res:Strings.OffsetControlsHelp}" />
                                        </StackPanel>
                                    </ToolTip.Tip>
                                </NumericUpDown>
                                <TextBlock Classes="muted" VerticalAlignment="Center" Text="{x:Static res:Strings.HighwayOffsetUnit}" />
                                <Button Classes="nudge"
                                        Command="{Binding AudioOffset.RevertOffsetCommand}"
                                        ToolTip.Tip="{x:Static res:Strings.AudioRevertOffsetToolTip}"
                                        AutomationProperties.Name="{x:Static res:Strings.AudioRevertOffsetToolTip}">
                                    <PathIcon Width="12" Height="12" Data="{StaticResource RevertIconGeometry}" />
                                </Button>
                            </StackPanel>
                            <PathIcon Grid.Column="2"
                                      Width="14" Height="14"
                                      Opacity="0.7"
                                      VerticalAlignment="Center"
                                      IsVisible="{Binding Player.HasTracks}"
                                      Data="{StaticResource VolumeIconGeometry}" />
                            <Slider Grid.Column="3"
                                    Width="90"
                                    Minimum="0"
                                    Maximum="1"
                                    Value="{Binding Player.Volume}"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding Player.HasTracks}"
                                    ToolTip.Tip="{x:Static res:Strings.VolumeName}"
                                    AutomationProperties.Name="{x:Static res:Strings.VolumeName}" />
                            <!-- Presets, or any whole percent typed in; what's typed takes effect on Enter or leaving the box, so
                                 typing 150 doesn't play at 1% and 15% on the way. See SongDetailView.CommitPlaybackSpeed. -->
                            <TextBlock Grid.Column="4"
                                       Classes="muted"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding Player.HasTracks}"
                                       Text="{x:Static res:Strings.PlaybackSpeedLabel}" />
                            <ComboBox Grid.Column="5"
                                      x:Name="PlaybackSpeedBox"
                                      IsEditable="True"
                                      Width="90"
                                      Padding="8,0,0,0"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      ItemsSource="{x:Static vm:PlayerViewModel.PlaybackSpeedPresets}"
                                      Text="{Binding Player.PlaybackSpeedText, Mode=OneWay}"
                                      IsVisible="{Binding Player.HasTracks}"
                                      ToolTip.Tip="{x:Static res:Strings.PlaybackSpeedToolTip}"
                                      AutomationProperties.Name="{x:Static res:Strings.PlaybackSpeedName}">
                                <!-- Fluent pads a ComboBox unevenly for its selection text and gives a text box a minimum height of
                                     its own, which together leave the typed text off centre; the box's text is centred instead. -->
                                <ComboBox.Styles>
                                    <Style Selector="ComboBox /template/ TextBox#PART_EditableTextBox">
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="VerticalAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </ComboBox.Styles>
                            </ComboBox>
                            <ToggleButton Grid.Column="6"
                                          Classes="tool"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding Player.PitchCorrection}"
                                          IsVisible="{Binding Player.HasTracks}"
                                          ToolTip.Tip="{x:Static res:Strings.PitchCorrectionToolTip}"
                                          AutomationProperties.Name="{x:Static res:Strings.PitchCorrectionLabel}">
                                <PathIcon Width="14" Height="14" Data="{StaticResource PitchCorrectionIconGeometry}" />
                            </ToggleButton>
                        </Grid>
                        <TextBlock Classes="muted" Text="{x:Static res:Strings.NoTracks}" IsVisible="{Binding !Player.HasTracks}" />

                        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto"
                              ColumnSpacing="8"
                              Margin="0,0,0,6"
                              IsVisible="{Binding Player.HasTracks}">
                            <Button Grid.Column="0"
                                    Classes="transport accent"
                                    Command="{Binding Player.PlayPauseCommand}"
                                    ToolTip.Tip="{Binding Player.PlayPauseToolTip}"
                                    AutomationProperties.Name="{Binding Player.PlayPauseToolTip}">
                                <Panel>
                                    <PathIcon Data="{StaticResource PlayIconGeometry}" IsVisible="{Binding !Player.IsPlaying}" />
                                    <PathIcon Data="{StaticResource PauseIconGeometry}" IsVisible="{Binding Player.IsPlaying}" />
                                </Panel>
                            </Button>
                            <Button Grid.Column="1"
                                    Classes="transport"
                                    Command="{Binding Player.StopCommand}"
                                    ToolTip.Tip="{x:Static res:Strings.StopToolTip}"
                                    AutomationProperties.Name="{x:Static res:Strings.StopToolTip}">
                                <PathIcon Data="{StaticResource StopIconGeometry}" />
                            </Button>
                            <!-- A hidden copy of the length holds the column at its widest, so the waveform
                                 doesn't shift as the position gains a digit (9:59 to 10:00). -->
                            <Panel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Classes="muted"
                                           FontFeatures="tnum"
                                           Opacity="0"
                                           IsHitTestVisible="False"
                                           AutomationProperties.AccessibilityView="Raw"
                                           Text="{Binding Player.LengthText}" />
                                <TextBlock Classes="muted"
                                           HorizontalAlignment="Right"
                                           FontFeatures="tnum"
                                           Text="{Binding Player.PositionText}" />
                            </Panel>
                            <!-- What is heard, as a waveform that changes with the mute and solo switches. Dragging seeks
                                 when it's let go; a click seeks at once. It spans the song as a game plays it, which can
                                 run on past the audio, so the waveform can stop short of the end. -->
                            <ctl:WaveformView x:Name="SeekBar"
                                              Grid.Column="3"
                                              Height="40"
                                              Waveform="{Binding Player.Waveform}"
                                              PositionSeconds="{Binding Player.PositionSeconds}"
                                              LengthSeconds="{Binding Player.TimelineSeconds}"
                                              FineSecondsPerPixel="{Binding Player.FineScrubSecondsPerPixel}"
                                              ToolTip.Tip="{Binding Player.SeekBarToolTip}"
                                              PlayedBrush="{DynamicResource AccentTextBrush}"
                                              UnplayedBrush="{DynamicResource WaveformBrush}"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="{x:Static res:Strings.SeekName}" />
                            <TextBlock Grid.Column="4"
                                       Classes="muted"
                                       VerticalAlignment="Center"
                                       FontFeatures="tnum"
                                       Text="{Binding Player.LengthText}"
                                       ToolTip.Tip="{Binding Player.LengthToolTip}" />
                            <Button Grid.Column="5"
                                    Classes="transport"
                                    Command="{Binding Player.JumpToPreviewCommand}"
                                    IsVisible="{Binding Player.HasPreviewStart}"
                                    ToolTip.Tip="{x:Static res:Strings.JumpToPreviewToolTip}"
                                    AutomationProperties.Name="{x:Static res:Strings.JumpToPreviewToolTip}">
                                <PathIcon Data="{StaticResource PreviewIconGeometry}" />
                            </Button>
                        </Grid>
                        <TextBlock Classes="muted" Text="{x:Static res:Strings.OpeningAudio}" IsVisible="{Binding Player.IsOpening}" />
                        <TextBlock Classes="error" Text="{Binding Player.Error}" IsVisible="{Binding Player.HasError}" />

                        <!-- The track rows and the removed-track rows share their column widths, so the sizes, names,
                             waveforms and buttons line up: every column but the waveform's is shared, so each track's
                             waveform starts and ends at the same place, on the one time axis of the song's length. -->
                        <ItemsControl ItemsSource="{Binding Player.Tracks}"
                                      AutomationProperties.Name="{x:Static res:Strings.TracksListName}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TrackRowViewModel">
                                    <!-- Transparent so the whole row, gaps and waveform included, takes a right-click. -->
                                    <Grid ColumnSpacing="6" RowDefinitions="Auto,Auto" Background="Transparent">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{Binding DownloadHeader}"
                                                          Command="{Binding DownloadCommand}"
                                                          IsEnabled="{Binding CanDownload}" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="TrackSwitches" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="TrackSize" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="TrackName" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="TrackVolume" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="TrackActions" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Classes="marker"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Marker}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <ToggleButton Classes="trackSwitch"
                                                          Content="{x:Static res:Strings.MuteButton}"
                                                          IsChecked="{Binding IsMuted}"
                                                          ToolTip.Tip="{x:Static res:Strings.MuteToolTip}"
                                                          AutomationProperties.Name="{x:Static res:Strings.MuteToolTip}" />
                                            <ToggleButton Classes="trackSwitch"
                                                          Content="{x:Static res:Strings.SoloButton}"
                                                          IsChecked="{Binding IsSolo}"
                                                          ToolTip.Tip="{x:Static res:Strings.SoloToolTip}"
                                                          AutomationProperties.Name="{x:Static res:Strings.SoloToolTip}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Classes="chip" HorizontalAlignment="Left" IsVisible="{Binding HasSize}">
                                            <TextBlock Text="{Binding Size}" />
                                        </Border>
                                        <!-- Capped, so one long name doesn't squeeze every track's waveform. -->
                                        <TextBlock Grid.Column="3"
                                                   MaxWidth="160"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Name}"
                                                   Text="{Binding Name}" />
                                        <!-- The track's own waveform, faded while it isn't heard. It only shows; the seek bar above seeks.
                                             Hidden while waveforms are off, leaving its column so the rows still line up. -->
                                        <ctl:WaveformView Grid.Column="4"
                                                          Classes="track"
                                                          Classes.unheard="{Binding !IsHeard}"
                                                          IsVisible="{Binding $parent[ItemsControl].((vm:SongDetailViewModel)DataContext).Player.ShowWaveforms, FallbackValue=True}"
                                                          Height="20"
                                                          VerticalAlignment="Center"
                                                          IsHitTestVisible="False"
                                                          Waveform="{Binding Waveform}"
                                                          PositionSeconds="{Binding $parent[ItemsControl].((vm:SongDetailViewModel)DataContext).Player.PositionSeconds, Mode=OneWay, FallbackValue=0}"
                                                          LengthSeconds="{Binding $parent[ItemsControl].((vm:SongDetailViewModel)DataContext).Player.TimelineSeconds, FallbackValue=0}"
                                                          PlayedBrush="{DynamicResource AccentTextBrush}"
                                                          UnplayedBrush="{DynamicResource WaveformBrush}" />
                                        <!-- How loud the track is in the mix; the master volume is in the header above. -->
                                        <Slider Grid.Column="5"
                                                Width="90"
                                                Minimum="0"
                                                Maximum="1"
                                                Value="{Binding Volume}"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="{x:Static res:Strings.TrackVolumeName}"
                                                AutomationProperties.Name="{x:Static res:Strings.TrackVolumeName}" />
                                        <StackPanel Grid.Column="6"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding $parent[ItemsControl].((vm:SongDetailViewModel)DataContext).CanEdit, FallbackValue=False}">
                                            <!-- Replaces the stem's track, in whatever format it was, as Add track does. -->
                                            <Button Classes="icon"
                                                    Padding="4"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding $parent[ItemsControl].((vm:SongDetailViewModel)DataContext).ReplaceTrackCommand, FallbackValue={x:Null}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{x:Static res:Strings.ReplaceTrackToolTip}"
                                                    AutomationProperties.Name="{x:Static res:Strings.ReplaceTrackToolTip}">
                                                <PathIcon Width="12" Height="12" Data="{StaticResource ReplaceIconGeometry}" />
                                            </Button>
                                            <Button Classes="icon"
                                                    Padding="4"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding $parent[ItemsControl].((vm:SongDetailViewModel)DataContext).RemoveTrackCommand, FallbackValue={x:Null}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{x:Static res:Strings.RemoveTrackToolTip}"
                                                    AutomationProperties.Name="{x:Static res:Strings.RemoveTrackToolTip}">
                                                <PathIcon Width="12" Height="12" Data="{StaticResource RemoveIconGeometry}" />
                                            </Button>
                                        </StackPanel>
                                        <!-- Below the row, so a long reason doesn't make the waveform taller. -->
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="2"
                                                   Grid.ColumnSpan="5"
                                                   Classes="error"
                                                   Margin="0,0,0,2"
                                                   Text="{Binding Error}"
                                                   IsVisible="{Binding HasError}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding RemovedTracks}"
                                      IsVisible="{Binding HasRemovedTracks}"
                                      AutomationProperties.Name="{x:Static res:Strings.RemovedTracksListName}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RemovedTrackRow">
                                    <!-- As tall as a track row, which its switches and slider set, so the list keeps its rhythm. -->
                                    <Grid ColumnSpacing="6" MinHeight="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="TrackSwitches" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="TrackSize" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="TrackName" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="TrackVolume" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="TrackActions" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="2" Classes="chip" HorizontalAlignment="Left">
                                            <TextBlock Classes="removed" Text="{Binding Size}" />
                                        </Border>
                                        <TextBlock Grid.Column="3"
                                                   Classes="removed"
                                                   MaxWidth="160"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Name}"
                                                   Text="{Binding Name}" />
                                        <Button Grid.Column="6"
                                                Classes="icon"
                                                Padding="4"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                Command="{Binding $parent[ItemsControl].((vm:SongDetailViewModel)DataContext).UndoRemoveTrackCommand, FallbackValue={x:Null}}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding $parent[ItemsControl].((vm:SongDetailViewModel)DataContext).CanEdit, FallbackValue=False}"
                                                ToolTip.Tip="{x:Static res:Strings.UndoRemoveTrackToolTip}"
                                                AutomationProperties.Name="{x:Static res:Strings.UndoRemoveTrackToolTip}">
                                            <PathIcon Width="12" Height="12" Data="{StaticResource RevertIconGeometry}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="error" Text="{Binding TracksError}" IsVisible="{Binding HasTracksError}" />

                        <!-- One entry per stem; a stem the song has already is replaced, in whatever format it was. -->
                        <Button Classes="icon"
                                Margin="10,4,0,0"
                                IsVisible="{Binding CanEdit}"
                                AutomationProperties.Name="{x:Static res:Strings.AddTrackButton}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Width="12" Height="12" Data="{StaticResource AddIconGeometry}" />
                                <TextBlock Text="{x:Static res:Strings.AddTrackButton}" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft" ItemsSource="{Binding AddTrackOptions}">
                                    <MenuFlyout.ItemContainerTheme>
                                        <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:StemOption">
                                            <Setter Property="Header" Value="{Binding Label}" />
                                            <Setter Property="Command" Value="{Binding Command}" />
                                        </ControlTheme>
                                    </MenuFlyout.ItemContainerTheme>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <!-- The chart: notes.chart or notes.mid, replaced by choosing either kind. Without one the song can't be played. -->
                    <StackPanel IsVisible="{Binding ShowSongFiles}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="section" Text="{x:Static res:Strings.ChartHeader}" />
                            <Panel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,4" IsVisible="{Binding CanEdit}">
                                <Button Classes="icon"
                                        Padding="4"
                                        Command="{Binding RevertChartCommand}"
                                        IsVisible="{Binding IsChartChanged}"
                                        ToolTip.Tip="{x:Static res:Strings.RevertChartToolTip}"
                                        AutomationProperties.Name="{x:Static res:Strings.RevertChartToolTip}">
                                    <PathIcon Width="12" Height="12" Data="{StaticResource RevertIconGeometry}" />
                                </Button>
                            </Panel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Charts}"
                                      AutomationProperties.Name="{x:Static res:Strings.ChartsListName}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChartRow">
                                    <Grid ColumnDefinitions="14,*,Auto,Auto" ColumnSpacing="4" Margin="0,1" Background="Transparent">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{Binding DownloadHeader}"
                                                          Command="{Binding DownloadCommand}"
                                                          IsEnabled="{Binding DownloadCommand, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <TextBlock Grid.Column="0"
                                                   Classes="marker"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Marker}" />
                                        <TextBlock Grid.Column="1"
                                                   Classes.removed="{Binding IsRemoved}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Name}" />
                                        <Border Grid.Column="2" Classes="chip" Margin="4,0">
                                            <TextBlock Classes.removed="{Binding IsRemoved}" Text="{Binding Size}" />
                                        </Border>
                                        <!-- Sized for the buttons, so the sizes line up on a removed row, which has none. -->
                                        <StackPanel Grid.Column="3"
                                                    Orientation="Horizontal"
                                                    MinWidth="44"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding $parent[ItemsControl].((vm:SongDetailViewModel)DataContext).CanEdit, FallbackValue=False}">
                                            <Button Classes="icon"
                                                    Padding="4"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding $parent[ItemsControl].((vm:SongDetailViewModel)DataContext).ChooseChartCommand, FallbackValue={x:Null}}"
                                                    IsVisible="{Binding IsKept}"
                                                    ToolTip.Tip="{x:Static res:Strings.ReplaceChartToolTip}"
                                                    AutomationProperties.Name="{x:Static res:Strings.ReplaceChartToolTip}">
                                                <PathIcon Width="12" Height="12" Data="{StaticResource ReplaceIconGeometry}" />
                                            </Button>
                                            <Button Classes="icon"
                                                    Padding="4"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding $parent[ItemsControl].((vm:SongDetailViewModel)DataContext).RemoveChartCommand, FallbackValue={x:Null}}"
                                                    IsVisible="{Binding IsKept}"
                                                    ToolTip.Tip="{x:Static res:Strings.RemoveChartToolTip}"
                                                    AutomationProperties.Name="{x:Static res:Strings.RemoveChartToolTip}">
                                                <PathIcon Width="12" Height="12" Data="{StaticResource RemoveIconGeometry}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel IsVisible="{Binding ShowChartMissing}">
                            <TextBlock Classes="finding" TextWrapping="Wrap" Text="{Binding ChartMissingNote}" />
                            <Button Classes="icon"
                                    Margin="10,4,0,0"
                                    Command="{Binding ChooseChartCommand}"
                                    IsVisible="{Binding CanEdit}"
                                    AutomationProperties.Name="{x:Static res:Strings.AddChartButton}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Width="12" Height="12" Data="{StaticResource AddIconGeometry}" />
                                    <TextBlock Text="{x:Static res:Strings.AddChartButton}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Classes="error" Text="{Binding ChartError}" IsVisible="{Binding HasChartError}" />
                    </StackPanel>

                    <!-- Everything else in the song: files the other sections don't show, such as a highway image,
                         a readme, or a second album.jpg beside the album.png that's used. -->
                    <StackPanel IsVisible="{Binding ShowSongFiles}">
                        <TextBlock Classes="section" Text="{Binding OtherFilesHeader}" />
                        <TextBlock Classes="muted" Text="{x:Static res:Strings.NoOtherFiles}" IsVisible="{Binding ShowNoOtherFiles}" />
                        <ItemsControl ItemsSource="{Binding Files}"
                                      AutomationProperties.Name="{x:Static res:Strings.OtherFilesListName}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FileRow">
                                    <Grid ColumnDefinitions="14,*,Auto,Auto" ColumnSpacing="4" Margin="0,1" Background="Transparent">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{Binding DownloadHeader}"
                                                          Command="{Binding DownloadCommand}"
                                                          IsEnabled="{Binding DownloadCommand, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <TextBlock Grid.Column="0"
                                                   Classes="marker"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Marker}" />
                                        <TextBlock Grid.Column="1"
                                                   Classes.removed="{Binding IsRemoved}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="PathSegmentEllipsis"
                                                   ToolTip.Tip="{Binding Path}"
                                                   Text="{Binding Path}" />
                                        <Border Grid.Column="2" Classes="chip" Margin="4,0">
                                            <TextBlock Classes.removed="{Binding IsRemoved}" Text="{Binding Size}" />
                                        </Border>

                                        <!-- One action per row: remove a file (or drop an added one), or undo its removal. -->
                                        <Panel Grid.Column="3"
                                               MinWidth="20"
                                               IsVisible="{Binding $parent[ItemsControl].((vm:SongDetailViewModel)DataContext).CanEdit, FallbackValue=False}">
                                            <Button Classes="icon"
                                                    Padding="4"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding $parent[ItemsControl].((vm:SongDetailViewModel)DataContext).RevertFileCommand, FallbackValue={x:Null}}"
                                                    CommandParameter="{Binding}"
                                                    IsVisible="{Binding CanRevert}"
                                                    ToolTip.Tip="{x:Static res:Strings.RevertFileToolTip}"
                                                    AutomationProperties.Name="{x:Static res:Strings.RevertFileToolTip}">
                                                <PathIcon Width="12" Height="12" Data="{StaticResource RevertIconGeometry}" />
                                            </Button>
                                            <Button Classes="icon"
                                                    Padding="4"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding $parent[ItemsControl].((vm:SongDetailViewModel)DataContext).RemoveFileCommand, FallbackValue={x:Null}}"
                                                    CommandParameter="{Binding}"
                                                    IsVisible="{Binding CanRemove}"
                                                    ToolTip.Tip="{x:Static res:Strings.RemoveFileToolTip}"
                                                    AutomationProperties.Name="{x:Static res:Strings.RemoveFileToolTip}">
                                                <PathIcon Width="12" Height="12" Data="{StaticResource RemoveIconGeometry}" />
                                            </Button>
                                        </Panel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="error" Text="{Binding FilesError}" IsVisible="{Binding HasFilesError}" />
                        <Button Classes="icon"
                                Margin="10,4,0,0"
                                Command="{Binding AddFilesCommand}"
                                IsVisible="{Binding CanEdit}"
                                AutomationProperties.Name="{x:Static res:Strings.AddFilesButton}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Width="12" Height="12" Data="{StaticResource AddIconGeometry}" />
                                <TextBlock Text="{x:Static res:Strings.AddFilesButton}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Findings}"
                                  IsVisible="{Binding HasFindings}"
                                  Margin="0,12,0,0"
                                  AutomationProperties.Name="{x:Static res:Strings.FindingsListName}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FindingRow">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2">
                                    <TextBlock Grid.Column="0"
                                               Classes="finding"
                                               Classes.error="{Binding IsError}"
                                               FontWeight="SemiBold"
                                               Text="{Binding RuleId}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="finding"
                                               Classes.error="{Binding IsError}"
                                               TextWrapping="Wrap"
                                               Text="{Binding Message}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Classes="section" Text="{Binding MetadataHeader}" />
                    <TextBlock Classes="finding" TextWrapping="Wrap" Margin="0,0,0,6" Text="{Binding ReadOnlyNote}" IsVisible="{Binding HasReadOnlyNote}" />
                    <!-- An icon per song.ini difficulty, which the rows below leave out. Clicking one sets it. -->
                    <StackPanel Spacing="2" Margin="0,0,0,10" IsVisible="{Binding ShowInstruments}">
                        <ItemsControl ItemsSource="{Binding Instruments}"
                                      AutomationProperties.Name="{x:Static res:Strings.InstrumentsListName}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:InstrumentDifficultyViewModel">
                                    <Button Classes="instrument"
                                            Classes.absent="{Binding !IsCharted}"
                                            IsVisible="{Binding IsShown}"
                                            IsEnabled="{Binding CanEdit}"
                                            ToolTip.ShowOnDisabled="True"
                                            AutomationProperties.Name="{Binding AccessibleName}">
                                        <ToolTip.Tip>
                                            <StackPanel Spacing="2">
                                                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Name}" />
                                                <TextBlock Classes="muted" Text="{Binding Key}" />
                                                <TextBlock TextWrapping="Wrap"
                                                           Text="{Binding KeyDescription}"
                                                           IsVisible="{Binding KeyDescription, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                <TextBlock TextWrapping="Wrap" Text="{Binding ValueNote}" IsVisible="{Binding HasValueNote}" />
                                                <ItemsControl Margin="0,4,0,0"
                                                              Grid.IsSharedSizeScope="True"
                                                              ItemsSource="{Binding NoteCounts}"
                                                              ItemTemplate="{StaticResource NoteCountRowTemplate}"
                                                              IsVisible="{Binding HasNoteCounts}" />
                                                <TextBlock TextWrapping="Wrap" Classes="muted" Text="{x:Static res:Strings.InstrumentNotCharted}" IsVisible="{Binding !IsCharted}" />
                                            </StackPanel>
                                        </ToolTip.Tip>
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <StackPanel Spacing="8">
                                                    <StackPanel>
                                                        <TextBlock Classes="highwayHeader" Text="{Binding Name}" />
                                                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Key}" />
                                                    </StackPanel>
                                                    <ItemsControl Grid.IsSharedSizeScope="True"
                                                                  ItemsSource="{Binding NoteCounts}"
                                                                  ItemTemplate="{StaticResource NoteCountRowTemplate}"
                                                                  IsVisible="{Binding HasNoteCounts}" />
                                                    <!-- ? unsets it; 0 to 6 set it, closing the flyout. -->
                                                    <ItemsControl ItemsSource="{Binding Presets}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="4" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:DifficultyPresetViewModel">
                                                                <Button Classes="preset"
                                                                        Classes.current="{Binding IsCurrent}"
                                                                        Command="{Binding Command}"
                                                                        CommandParameter="{Binding Tier}"
                                                                        Click="OnDifficultyChosen"
                                                                        AutomationProperties.Name="{Binding Text}">
                                                                    <Border Classes="presetFace"
                                                                            Classes.unset="{Binding Tier, Converter={x:Static ObjectConverters.IsNull}}"
                                                                            Background="{Binding Tier, Converter={StaticResource DifficultyTierBrush}}">
                                                                        <TextBlock Text="{Binding Text}" />
                                                                    </Border>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <!-- A tier past the buttons. Enter sets it and leaves the flyout open. -->
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.DifficultyOtherLabel}" />
                                                        <NumericUpDown Width="110"
                                                                       VerticalAlignment="Center"
                                                                       Value="{Binding OtherValue}"
                                                                       Increment="1"
                                                                       Minimum="0"
                                                                       Maximum="2147483647"
                                                                       FormatString="0"
                                                                       AutomationProperties.Name="{x:Static res:Strings.DifficultyOtherLabel}">
                                                            <NumericUpDown.KeyBindings>
                                                                <KeyBinding Gesture="Enter" Command="{Binding ApplyOtherCommand}" />
                                                            </NumericUpDown.KeyBindings>
                                                        </NumericUpDown>
                                                        <Button Classes="nudge"
                                                                Content="{x:Static res:Strings.DifficultySetButton}"
                                                                Command="{Binding ApplyOtherCommand}"
                                                                Click="OnDifficultyChosen" />
                                                        <Button Classes="nudge"
                                                                Command="{Binding RevertCommand}"
                                                                IsVisible="{Binding IsEdited}"
                                                                Click="OnDifficultyChosen"
                                                                ToolTip.Tip="{x:Static res:Strings.DifficultyRevertButton}"
                                                                AutomationProperties.Name="{x:Static res:Strings.DifficultyRevertButton}">
                                                            <PathIcon Width="12" Height="12" Data="{StaticResource RevertIconGeometry}" />
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                        <StackPanel Classes="instrumentFace" Spacing="4">
                                            <Panel Width="50" Height="44" HorizontalAlignment="Center">
                                                <Border Classes="instrumentCircle" Classes.edited="{Binding IsEdited}">
                                                    <PathIcon Data="{Binding Glyph, Converter={StaticResource DifficultyGlyph}}" />
                                                </Border>
                                                <Border Classes="instrumentTag" IsVisible="{Binding HasTag}">
                                                    <TextBlock Text="{Binding Tag}" />
                                                </Border>
                                                <Border Classes="instrumentBadge"
                                                        Classes.unset="{Binding Tier, Converter={x:Static ObjectConverters.IsNull}}"
                                                        Background="{Binding Tier, Converter={StaticResource DifficultyTierBrush}}">
                                                    <TextBlock Text="{Binding BadgeText}" />
                                                </Border>
                                            </Panel>
                                            <!-- "Guitar - EMHX": the letters are always shown whole; a long name gives way to them. -->
                                            <DockPanel HorizontalAlignment="Center">
                                                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Letters}" IsVisible="{Binding HasLetters}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:DifficultyLetter">
                                                            <TextBlock Classes="difficultyLetter"
                                                                       Text="{Binding Text}"
                                                                       Foreground="{Binding Difficulty, Converter={StaticResource DifficultyLetterBrush}}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Classes="instrumentName"
                                                           Text="{x:Static res:Strings.InstrumentCaptionSeparator}"
                                                           IsVisible="{Binding HasLetters}" />
                                                <TextBlock Classes="instrumentName" Text="{Binding Name}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="nudge"
                                HorizontalAlignment="Left"
                                Content="{Binding InstrumentsToggleText}"
                                Command="{Binding ToggleShowAllInstrumentsCommand}"
                                IsVisible="{Binding HasHiddenInstruments}" />
                        <!-- The difficulties have icons rather than rows, so their validation failures are listed here. -->
                        <ItemsControl ItemsSource="{Binding HiddenIssues}"
                                      IsVisible="{Binding HasHiddenIssues}"
                                      Margin="0,4,0,0"
                                      AutomationProperties.Name="{x:Static res:Strings.HiddenIssuesListName}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MetadataIssueRow">
                                    <Border Classes="metadataRow invalid" Margin="0,1">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{Binding QuickFixHeader}" Command="{Binding QuickFixCommand}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Classes="issue" FontWeight="SemiBold" Text="{Binding Key}" />
                                            <TextBlock Grid.Column="1" Classes="issue" Text="{Binding Message}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>


                    <TextBlock Classes="muted" Text="{Binding MetadataNote}" IsVisible="{Binding HasMetadataNote}" />
                    <ItemsControl ItemsSource="{Binding Metadata}"
                                  Grid.IsSharedSizeScope="True"
                                  AutomationProperties.Name="{x:Static res:Strings.MetadataListName}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MetadataRowViewModel">
                                <!-- A value that fails validation is marked orange, with why under it. -->
                                <Border Classes="metadataRow" Classes.invalid="{Binding HasIssue}" Margin="0,1">
                                    <!-- Quick Fix puts the key's fix in the drafts; it's there on every row, disabled where there's none. -->
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{Binding QuickFixHeader}" Command="{Binding QuickFixCommand}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid RowDefinitions="Auto,Auto">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="MetadataKey" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="MetadataActions" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Classes="marker"
                                                   Margin="0,2,0,0"
                                                   Text="{Binding Marker}" />
                                        <TextBlock Grid.Column="1"
                                                   Classes="muted"
                                                   Classes.removed="{Binding IsRemoved}"
                                                   MaxWidth="220"
                                                   Margin="0,2,16,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Key}">
                                            <!-- The key in full (it may be trimmed), and what it does when it's a known key. -->
                                            <ToolTip.Tip>
                                                <StackPanel Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Key}" />
                                                    <TextBlock TextWrapping="Wrap" Text="{Binding KeyDescription}" IsVisible="{Binding HasKeyDescription}" />
                                                </StackPanel>
                                            </ToolTip.Tip>
                                        </TextBlock>

                                        <!-- Tags like <color=#FDFD96FF> are rendered and times are formatted; the tooltip shows the value as stored. -->
                                        <Button Grid.Column="2"
                                                Classes="value"
                                                Command="{Binding BeginEditCommand}"
                                                IsVisible="{Binding !IsEditing}"
                                                ToolTip.Tip="{Binding ToolTip}"
                                                AutomationProperties.Name="{Binding Key}">
                                            <Panel>
                                                <TextBlock TextWrapping="Wrap"
                                                           Classes.removed="{Binding IsRemoved}"
                                                           ctl:RichTextMarkup.Text="{Binding DisplayValue}"
                                                           IsVisible="{Binding ShowRichValue}" />
                                                <TextBlock TextWrapping="Wrap"
                                                           Classes="distinct"
                                                           Classes.removed="{Binding IsRemoved}"
                                                           Text="{Binding DisplayValue}"
                                                           IsVisible="{Binding ShowDistinct}" />
                                            </Panel>
                                        </Button>
                                        <StackPanel Grid.Column="2" IsVisible="{Binding IsEditing}">
                                            <!-- Enter or leaving the box keeps the text; Escape drops it. -->
                                            <TextBox Classes="inline"
                                                     Text="{Binding EditText}"
                                                     PlaceholderText="{Binding EditPlaceholder}"
                                                     IsVisible="{Binding IsEditing}"
                                                     ctl:FocusWhenShown.IsEnabled="True"
                                                     LostFocus="OnEditLostFocus"
                                                     AutomationProperties.Name="{Binding Key}">
                                                <TextBox.KeyBindings>
                                                    <KeyBinding Gesture="Enter" Command="{Binding CommitCommand}" />
                                                    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
                                                </TextBox.KeyBindings>
                                            </TextBox>
                                            <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3"
                                                    Orientation="Horizontal"
                                                    Margin="4,0,0,0"
                                                    IsVisible="{Binding $parent[ItemsControl].((vm:SongDetailViewModel)DataContext).CanEdit, FallbackValue=False}">
                                            <Button Classes="icon"
                                                    Command="{Binding $parent[ItemsControl].((vm:SongDetailViewModel)DataContext).AutoSetSongLengthCommand}"
                                                    IsVisible="{Binding IsSongLength}"
                                                    ToolTip.Tip="{x:Static res:Strings.AutoSetLengthToolTip}"
                                                    AutomationProperties.Name="{x:Static res:Strings.AutoSetLengthButton}">
                                                <PathIcon Width="12" Height="12" Data="{StaticResource AutoLengthIconGeometry}" />
                                            </Button>
                                            <Button Classes="icon"
                                                    Command="{Binding RevertCommand}"
                                                    IsVisible="{Binding IsChanged}"
                                                    ToolTip.Tip="{x:Static res:Strings.RevertRowToolTip}"
                                                    AutomationProperties.Name="{x:Static res:Strings.RevertRowToolTip}">
                                                <PathIcon Width="12" Height="12" Data="{StaticResource RevertIconGeometry}" />
                                            </Button>
                                            <Button Classes="icon"
                                                    Command="{Binding RemoveCommand}"
                                                    IsVisible="{Binding CanRemove}"
                                                    ToolTip.Tip="{x:Static res:Strings.RemoveRowToolTip}"
                                                    AutomationProperties.Name="{x:Static res:Strings.RemoveRowToolTip}">
                                                <PathIcon Width="12" Height="12" Data="{StaticResource RemoveIconGeometry}" />
                                            </Button>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" IsVisible="{Binding !IsEditing}">
                                            <TextBlock Classes="issue" Text="{Binding Issue}" IsVisible="{Binding HasIssue}" />
                                            <TextBlock Classes="hint" Text="{Binding Hint}" IsVisible="{Binding HasHint}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- New row: key and value, both checked before anything goes into the drafts.
                         The key box suggests the known keys not already in use, and takes any other key typed. -->
                    <StackPanel Margin="14,6,0,0" Spacing="4" IsVisible="{Binding IsAdding}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                            <AutoCompleteBox x:Name="NewKeyBox"
                                             Grid.Column="0"
                                             Width="220"
                                             Text="{Binding NewKey}"
                                             ItemsSource="{Binding AvailableKeys}"
                                             ValueMemberBinding="{Binding Key, DataType=meta:KnownKey}"
                                             FilterMode="Contains"
                                             MinimumPrefixLength="0"
                                             MaxDropDownHeight="320"
                                             PlaceholderText="{x:Static res:Strings.NewKeyWatermark}"
                                             IsVisible="{Binding IsAdding}"
                                             ctl:FocusWhenShown.IsEnabled="True"
                                             ToolTip.Tip="{x:Static res:Strings.NewKeyToolTip}"
                                             AutomationProperties.Name="{x:Static res:Strings.NewKeyWatermark}">
                                <AutoCompleteBox.ItemTemplate>
                                    <!-- A fixed width: the list is virtualised, so sizing to content would
                                         resize the dropdown to the widest visible item as it scrolls. -->
                                    <DataTemplate x:DataType="meta:KnownKey">
                                        <StackPanel Width="300" Margin="0,2" Spacing="1">
                                            <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Key}" />
                                            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding Description}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </AutoCompleteBox.ItemTemplate>
                            </AutoCompleteBox>
                            <TextBox x:Name="NewValueBox"
                                     Grid.Column="1"
                                     Text="{Binding NewValue}"
                                     PlaceholderText="{x:Static res:Strings.NewValueWatermark}"
                                     AutomationProperties.Name="{x:Static res:Strings.NewValueWatermark}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding CommitAddCommand}" />
                                    <KeyBinding Gesture="Escape" Command="{Binding CancelAddCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Button Grid.Column="2"
                                    Content="{x:Static res:Strings.AddButton}"
                                    Command="{Binding CommitAddCommand}"
                                    AutomationProperties.Name="{x:Static res:Strings.AddButton}" />
                            <Button Grid.Column="3"
                                    Content="{x:Static res:Strings.CancelButton}"
                                    Command="{Binding CancelAddCommand}"
                                    AutomationProperties.Name="{x:Static res:Strings.CancelButton}" />
                        </Grid>
                        <TextBlock Classes="error" Text="{Binding NewRowError}" IsVisible="{Binding HasNewRowError}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,4,0,0" Spacing="8">
                        <Button Classes="icon"
                                Command="{Binding BeginAddCommand}"
                                IsVisible="{Binding ShowAddRow}"
                                AutomationProperties.Name="{x:Static res:Strings.AddRowButton}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Width="12" Height="12" Data="{StaticResource AddIconGeometry}" />
                                <TextBlock Text="{x:Static res:Strings.AddRowButton}" />
                            </StackPanel>
                        </Button>
                        <!-- With no song_length row there's no row button, so Auto Set is offered here; it adds the row. -->
                        <Button Classes="icon"
                                Command="{Binding AutoSetSongLengthCommand}"
                                IsVisible="{Binding ShowAutoSetLengthFallback}"
                                ToolTip.Tip="{x:Static res:Strings.AutoSetLengthToolTip}"
                                AutomationProperties.Name="{x:Static res:Strings.AutoSetLengthButton}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Width="12" Height="12" Data="{StaticResource AutoLengthIconGeometry}" />
                                <TextBlock Text="{x:Static res:Strings.AutoSetLengthButton}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Classes="muted"
                               Margin="14,4,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding AutoLengthNote}"
                               IsVisible="{Binding HasAutoLengthNote}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- In front of everything, along the bottom: the tip of whatever's under the pointer, as tall as it needs. -->
        <ctl:ToolTipStrip x:Name="TipStrip" VerticalAlignment="Bottom" />
    </Panel>
</UserControl>
