<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ChartPacker.ViewModels"
             xmlns:res="using:ChartPacker.Resources"
             xmlns:ctl="using:ChartPacker.Controls"
             xmlns:meta="using:ChartPacker.Core.Metadata"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="600"
             x:Class="ChartPacker.Views.SongDetailView"
             x:DataType="vm:SongDetailViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Margin" Value="0,22,0,8" />
        </Style>
        <Style Selector="TextBlock.finding">
            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
        </Style>
        <Style Selector="TextBlock.finding.error">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- Row markers: * edited, + added; removed rows are struck through. -->
        <Style Selector="TextBlock.marker">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground">
                <SolidColorBrush Color="{DynamicResource SystemAccentColor}" />
            </Setter>
        </Style>
        <Style Selector="TextBlock.removed">
            <Setter Property="TextDecorations" Value="Strikethrough" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="TextBlock.distinct">
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>

        <!-- A metadata value: reads as plain text, and is a button so it can be clicked or tabbed to for editing. -->
        <Style Selector="Button.value">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Margin" Value="-4,0,0,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Ibeam" />
        </Style>
        <Style Selector="Button.value:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="Button.value:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListMediumBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <!-- Read-only (e.g. while saving, or a removed row) should still read normally. -->
        <Style Selector="Button.value:disabled">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.value:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>

        <!-- A value's edit box, sized so its text lands exactly where Button.value's did: border 1 +
             padding 3,1 matches that padding of 4,2, and there's no minimum size, so the row doesn't
             move when editing starts. The focus border is drawn behind the text, so it doesn't shift either. -->
        <Style Selector="TextBox.inline">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="3,1" />
            <Setter Property="Margin" Value="-4,0,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Button.icon:pointerover, Button.icon:focus-visible">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="24"
                    Spacing="6"
                    IsVisible="{Binding ShowPlaceholder}">
            <TextBlock Classes="centered"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Text="{x:Static res:Strings.DetailPlaceholderTitle}" />
            <TextBlock Classes="muted centered" Text="{x:Static res:Strings.DetailPlaceholderBody}" />
        </StackPanel>

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    IsVisible="{Binding IsLoading}">
            <Arc Classes="spinner"
                 Classes.active="{Binding IsLoading}"
                 Width="36" Height="36" StrokeThickness="3"
                 HorizontalAlignment="Center" />
            <TextBlock Classes="muted centered" Text="{x:Static res:Strings.Loading}" />
        </StackPanel>

        <TextBlock Classes="centered"
                   VerticalAlignment="Center"
                   Margin="24"
                   Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                   Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}" />

        <DockPanel IsVisible="{Binding ShowDetails}">
            <!-- Save and Discard are on the toolbar; a failed save is reported here, above the rows it concerns. -->
            <Border DockPanel.Dock="Top"
                    Classes="banner error"
                    Margin="20,12,20,0"
                    IsVisible="{Binding HasSaveError}">
                <SelectableTextBlock TextWrapping="Wrap" Text="{Binding SaveError}" />
            </Border>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,16">
                    <SelectableTextBlock FontSize="18"
                                         FontWeight="SemiBold"
                                         TextWrapping="Wrap"
                                         Text="{Binding Title}" />
                    <SelectableTextBlock Opacity="0.7"
                                         FontSize="12"
                                         Margin="0,2,0,0"
                                         TextWrapping="Wrap"
                                         Text="{Binding Subtitle}" />

                    <ItemsControl ItemsSource="{Binding Findings}"
                                  IsVisible="{Binding HasFindings}"
                                  Margin="0,12,0,0"
                                  AutomationProperties.Name="{x:Static res:Strings.FindingsListName}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FindingRow">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2">
                                    <TextBlock Grid.Column="0"
                                               Classes="finding"
                                               Classes.error="{Binding IsError}"
                                               FontWeight="SemiBold"
                                               Text="{Binding RuleId}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="finding"
                                               Classes.error="{Binding IsError}"
                                               TextWrapping="Wrap"
                                               Text="{Binding Message}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Classes="section" Text="{Binding MetadataHeader}" />
                    <TextBlock Classes="finding" TextWrapping="Wrap" Margin="0,0,0,6" Text="{Binding ReadOnlyNote}" IsVisible="{Binding HasReadOnlyNote}" />
                    <TextBlock Classes="muted" Text="{Binding MetadataNote}" IsVisible="{Binding HasMetadataNote}" />
                    <ItemsControl ItemsSource="{Binding Metadata}"
                                  Grid.IsSharedSizeScope="True"
                                  AutomationProperties.Name="{x:Static res:Strings.MetadataListName}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MetadataRowViewModel">
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="MetadataKey" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="MetadataActions" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Classes="marker"
                                               Margin="0,2,0,0"
                                               Text="{Binding Marker}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="muted"
                                               Classes.removed="{Binding IsRemoved}"
                                               MaxWidth="220"
                                               Margin="0,2,16,0"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Key}">
                                        <!-- The key in full (it may be trimmed), and what it does when it's a known key. -->
                                        <ToolTip.Tip>
                                            <StackPanel MaxWidth="320" Spacing="2">
                                                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Key}" />
                                                <TextBlock TextWrapping="Wrap" Text="{Binding KeyDescription}" IsVisible="{Binding HasKeyDescription}" />
                                            </StackPanel>
                                        </ToolTip.Tip>
                                    </TextBlock>

                                    <!-- Tags like <color=#FDFD96FF> are rendered and times are formatted; the tooltip shows the value as stored. -->
                                    <Button Grid.Column="2"
                                            Classes="value"
                                            Command="{Binding BeginEditCommand}"
                                            IsVisible="{Binding !IsEditing}"
                                            ToolTip.Tip="{Binding ToolTip}"
                                            AutomationProperties.Name="{Binding Key}">
                                        <Panel>
                                            <TextBlock TextWrapping="Wrap"
                                                       Classes.removed="{Binding IsRemoved}"
                                                       ctl:RichTextMarkup.Text="{Binding DisplayValue}"
                                                       IsVisible="{Binding ShowRichValue}" />
                                            <TextBlock TextWrapping="Wrap"
                                                       Classes="distinct"
                                                       Classes.removed="{Binding IsRemoved}"
                                                       Text="{Binding DisplayValue}"
                                                       IsVisible="{Binding ShowDistinct}" />
                                        </Panel>
                                    </Button>
                                    <StackPanel Grid.Column="2" IsVisible="{Binding IsEditing}">
                                        <!-- Enter or leaving the box keeps the text; Escape drops it. -->
                                        <TextBox Classes="inline"
                                                 Text="{Binding EditText}"
                                                 PlaceholderText="{Binding EditPlaceholder}"
                                                 IsVisible="{Binding IsEditing}"
                                                 ctl:FocusWhenShown.IsEnabled="True"
                                                 LostFocus="OnEditLostFocus"
                                                 AutomationProperties.Name="{Binding Key}">
                                            <TextBox.KeyBindings>
                                                <KeyBinding Gesture="Enter" Command="{Binding CommitCommand}" />
                                                <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
                                            </TextBox.KeyBindings>
                                        </TextBox>
                                        <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3"
                                                Orientation="Horizontal"
                                                Margin="4,0,0,0"
                                                IsVisible="{Binding $parent[ItemsControl].((vm:SongDetailViewModel)DataContext).CanEdit, FallbackValue=False}">
                                        <Button Classes="icon"
                                                Command="{Binding RevertCommand}"
                                                IsVisible="{Binding IsChanged}"
                                                ToolTip.Tip="{x:Static res:Strings.RevertRowToolTip}"
                                                AutomationProperties.Name="{x:Static res:Strings.RevertRowToolTip}">
                                            <PathIcon Width="12" Height="12" Data="{StaticResource RevertIconGeometry}" />
                                        </Button>
                                        <Button Classes="icon"
                                                Command="{Binding RemoveCommand}"
                                                IsVisible="{Binding CanRemove}"
                                                ToolTip.Tip="{x:Static res:Strings.RemoveRowToolTip}"
                                                AutomationProperties.Name="{x:Static res:Strings.RemoveRowToolTip}">
                                            <PathIcon Width="12" Height="12" Data="{StaticResource RemoveIconGeometry}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- New row: key and value, both checked before anything goes into the drafts.
                         The key box suggests the known keys not already in use, and takes any other key typed. -->
                    <StackPanel Margin="14,6,0,0" Spacing="4" IsVisible="{Binding IsAdding}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                            <AutoCompleteBox x:Name="NewKeyBox"
                                             Grid.Column="0"
                                             Width="220"
                                             Text="{Binding NewKey}"
                                             ItemsSource="{Binding AvailableKeys}"
                                             ValueMemberBinding="{Binding Key, DataType=meta:KnownKey}"
                                             FilterMode="Contains"
                                             MinimumPrefixLength="0"
                                             MaxDropDownHeight="320"
                                             PlaceholderText="{x:Static res:Strings.NewKeyWatermark}"
                                             IsVisible="{Binding IsAdding}"
                                             ctl:FocusWhenShown.IsEnabled="True"
                                             ToolTip.Tip="{x:Static res:Strings.NewKeyToolTip}"
                                             AutomationProperties.Name="{x:Static res:Strings.NewKeyWatermark}">
                                <AutoCompleteBox.ItemTemplate>
                                    <!-- A fixed width: the list is virtualised, so sizing to content would
                                         resize the dropdown to the widest visible item as it scrolls. -->
                                    <DataTemplate x:DataType="meta:KnownKey">
                                        <StackPanel Width="300" Margin="0,2" Spacing="1">
                                            <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Key}" />
                                            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding Description}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </AutoCompleteBox.ItemTemplate>
                            </AutoCompleteBox>
                            <TextBox x:Name="NewValueBox"
                                     Grid.Column="1"
                                     Text="{Binding NewValue}"
                                     PlaceholderText="{x:Static res:Strings.NewValueWatermark}"
                                     AutomationProperties.Name="{x:Static res:Strings.NewValueWatermark}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding CommitAddCommand}" />
                                    <KeyBinding Gesture="Escape" Command="{Binding CancelAddCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Button Grid.Column="2"
                                    Content="{x:Static res:Strings.AddButton}"
                                    Command="{Binding CommitAddCommand}"
                                    AutomationProperties.Name="{x:Static res:Strings.AddButton}" />
                            <Button Grid.Column="3"
                                    Content="{x:Static res:Strings.CancelButton}"
                                    Command="{Binding CancelAddCommand}"
                                    AutomationProperties.Name="{x:Static res:Strings.CancelButton}" />
                        </Grid>
                        <TextBlock Classes="error" Text="{Binding NewRowError}" IsVisible="{Binding HasNewRowError}" />
                    </StackPanel>
                    <Button Classes="icon"
                            Margin="10,4,0,0"
                            Command="{Binding BeginAddCommand}"
                            IsVisible="{Binding ShowAddRow}"
                            AutomationProperties.Name="{x:Static res:Strings.AddRowButton}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Width="12" Height="12" Data="{StaticResource AddIconGeometry}" />
                            <TextBlock Text="{x:Static res:Strings.AddRowButton}" />
                        </StackPanel>
                    </Button>

                    <StackPanel IsVisible="{Binding ShowFiles}">
                        <TextBlock Classes="section" Text="{Binding FilesHeader}" />
                        <TextBlock Classes="muted" Text="{x:Static res:Strings.NoFiles}" IsVisible="{Binding ShowNoFiles}" />
                        <ItemsControl ItemsSource="{Binding Files}"
                                      AutomationProperties.Name="{x:Static res:Strings.FilesListName}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FileRow">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,2">
                                        <TextBlock Grid.Column="0"
                                                   TextTrimming="PathSegmentEllipsis"
                                                   ToolTip.Tip="{Binding Path}"
                                                   Text="{Binding Path}" />
                                        <TextBlock Grid.Column="1"
                                                   Classes="muted"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding Size}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Panel>
</UserControl>
