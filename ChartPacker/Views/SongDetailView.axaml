<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ChartPacker.ViewModels"
             xmlns:res="using:ChartPacker.Resources"
             xmlns:ctl="using:ChartPacker.Controls"
             xmlns:hw="using:ChartPacker.UI.Controls.Highway"
             xmlns:ui="using:ChartPacker.UI.Controls"
             xmlns:uiviews="using:ChartPacker.UI.Views"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="600"
             x:Class="ChartPacker.Views.SongDetailView"
             x:DataType="vm:SongDetailViewModel"
             Focusable="True"
             FocusAdorner="{x:Null}"
             ui:CommitOnClickAway.IsEnabled="True"
             ToolTip.ServiceEnabled="False">
    <!-- Focusable so a click on empty space can take focus from an edit box, which commits it. Tooltips don't pop up
         over the panel: TipStrip shows them along its bottom instead. -->

    <UserControl.Resources>
        <!-- The note highway's options, shared by its button in the background's caption and in its own row's. Always
             below the button, never flipped over the highway, so the lanes stay in sight while the offsets are set;
             short of room it shrinks and scrolls instead. -->
        <Flyout x:Key="HighwayOptionsFlyout"
                x:DataType="vm:SongDetailViewModel"
                Placement="BottomEdgeAlignedRight"
                PlacementConstraintAdjustment="SlideX, FlipX, ResizeY"
                FlyoutPresenterClasses="highwayFlyout"
                Opened="OnHighwayOptionsOpened"
                Closed="OnHighwayOptionsClosed">
            <!-- Focusable, so a click on its empty space or a label (or Enter in an offset box) can take
                 focus from the offset box without closing the flyout. -->
            <StackPanel Classes="highwayOptions"
                        Spacing="8"
                        Background="Transparent"
                        Focusable="True"
                        PointerPressed="OnOffsetFlyoutPressed"
                        AutomationProperties.Name="{x:Static res:Strings.HighwayOptionsName}">
                <TextBlock Classes="highwayHeader" Text="{x:Static res:Strings.HighwayInstrumentsHeader}" />
                <ItemsControl ItemsSource="{Binding Highway.Rows}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HighwayRowViewModel">
                            <Grid ColumnDefinitions="110,140,Auto,Auto,Auto,130" ColumnSpacing="6">
                                <CheckBox Grid.Column="0"
                                          Content="{Binding Name}"
                                          IsChecked="{Binding IsChecked}" />
                                <ComboBox Grid.Column="1"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding Difficulties}"
                                          SelectedIndex="{Binding DifficultyIndex}"
                                          AutomationProperties.Name="{Binding Name}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DifficultyOption">
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <NumericUpDown Grid.Column="2"
                                               ui:DragScrub.IsEnabled="True"
                                               Width="72"
                                               ShowButtonSpinner="False"
                                               VerticalAlignment="Center"
                                               Value="{Binding Offset}"
                                               IsEnabled="{Binding CanEdit}"
                                               Increment="1"
                                               Minimum="-2147483648"
                                               Maximum="2147483647"
                                               FormatString="+0;-0;0"
                                               AutomationProperties.Name="{x:Static res:Strings.HighwayOffsetName}">
                                    <!-- What it moves, then, muted, the ways to change it, which every offset box shares. -->
                                    <ToolTip.Tip>
                                        <StackPanel MaxWidth="320" Spacing="6">
                                            <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.HighwayOffsetToolTip}" />
                                            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static res:SharedStrings.OffsetControlsHelp}" />
                                        </StackPanel>
                                    </ToolTip.Tip>
                                </NumericUpDown>
                                <TextBlock Grid.Column="3" Classes="muted" VerticalAlignment="Center" Text="{x:Static res:Strings.HighwayOffsetUnit}" />
                                <Button Grid.Column="4"
                                        Classes="nudge"
                                        Command="{Binding RevertOffsetCommand}"
                                        ToolTip.Tip="{x:Static res:Strings.HighwayRevertOffsetToolTip}"
                                        AutomationProperties.Name="{x:Static res:Strings.HighwayRevertOffsetToolTip}">
                                    <PathIcon Width="12" Height="12" Data="{StaticResource RevertIconGeometry}" />
                                </Button>
                                <!-- The track drawn behind the instrument's notes: its own, or one picked for this song. -->
                                <ComboBox Grid.Column="5"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding WaveformPicker.Options}"
                                          SelectedIndex="{Binding WaveformPicker.Index}"
                                          IsEnabled="{Binding $parent[ItemsControl].((vm:SongDetailViewModel)DataContext).Player.AreLaneWaveformsShown, FallbackValue=False}"
                                          ToolTip.Tip="{x:Static res:Strings.LaneWaveformPickerToolTip}"
                                          AutomationProperties.Name="{x:Static res:Strings.LaneWaveformName}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WaveformOption">
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="finding" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Text="{Binding Highway.Problem}" IsVisible="{Binding Highway.HasProblem}" />
                <TextBlock Classes="muted" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Text="{Binding Highway.Note}" IsVisible="{Binding Highway.HasNote}" />
                <!-- Shared with the lyrics lane's waveform button, and a setting; only while track waveforms are read. -->
                <CheckBox Content="{x:Static res:Strings.ShowLaneWaveformsLabel}"
                          IsChecked="{Binding Player.ShowLaneWaveforms}"
                          IsEnabled="{Binding Player.ShowWaveforms}"
                          ToolTip.Tip="{Binding Player.LaneWaveformsToolTip}"
                          ToolTip.ShowOnDisabled="True" />
                <Grid ColumnDefinitions="110,*" ColumnSpacing="6">
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{x:Static res:Strings.HighwayNoteSpeedLabel}" />
                    <Slider Grid.Column="1"
                            Minimum="0.5"
                            Maximum="3"
                            SmallChange="0.1"
                            LargeChange="0.5"
                            Value="{Binding Highway.NoteSpeed}"
                            AutomationProperties.Name="{x:Static res:Strings.HighwayNoteSpeedLabel}" />
                </Grid>
                <TextBlock Classes="muted" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" FontSize="12" Text="{x:Static res:Strings.HighwayFootnote}" />
            </StackPanel>
        </Flyout>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://ChartPacker.UI/Styles/Inspector.axaml" />
        <!-- A flyout floats over the panel, and can cover the tip strip, so its tips pop up as usual. -->
        <Style Selector="FlyoutPresenter">
            <Setter Property="ToolTip.ServiceEnabled" Value="True" />
        </Style>
        <!-- The tip of what's under the pointer, over the bottom of the panel: its background is see-through, so the
             rows under it still show, its words aren't. -->
        <Style Selector="ctl|ToolTipStrip">
            <Setter Property="Background" Value="{DynamicResource ToolTipStripBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="TextElement.FontSize" Value="12" />
        </Style>
        <!-- While the save bar shows, over the bottom of the panel, the tip strip sits on it, and the details end above
             it, so the last of them can still be scrolled into view. The bar is 45 high. -->
        <Style Selector="ctl|ToolTipStrip.save-bar">
            <Setter Property="Margin" Value="0,0,0,45" />
        </Style>
        <Style Selector="StackPanel.details">
            <Setter Property="Margin" Value="20,16" />
        </Style>
        <Style Selector="StackPanel.details.save-bar">
            <Setter Property="Margin" Value="20,16,20,61" />
        </Style>

        <!-- The background's Image | Video switch: radio buttons, so one is always picked, drawn as
             compact icon toggles with the one shown in the accent. -->
        <Style Selector="RadioButton.backgroundKind">
            <Setter Property="Theme" Value="{StaticResource {x:Type ToggleButton}}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="RadioButton.backgroundKind PathIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>

        <!-- The note highway's switch, sized to sit with the Image | Video switch, and its options. -->
        <Style Selector="ToggleSplitButton.highway">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleSplitButton.highway PathIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>
        <!-- Wider than Fluent lets a flyout be, so a row's difficulty, offset and waveform fit on one line. -->
        <Style Selector="FlyoutPresenter.highwayFlyout">
            <Setter Property="MaxWidth" Value="720" />
        </Style>
        <!-- The background's offset button, sized to sit with the Image | Video switch beside it. -->
        <Style Selector="Button.offset">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.offset PathIcon, StackPanel.timing PathIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>

        <!-- Playback: round transport buttons. The tracks' M/S toggles are TrackListView's. -->
        <Style Selector="Button.transport">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.transport PathIcon">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
        </Style>
        <!-- While the highway's options are open, its notes are drawn as outlines, so the waveform behind them shows
             and a note can be lined up with its sound as offsets are set. -->
        <Style Selector="hw|NoteHighwayView.tuning">
            <Setter Property="AreNotesOutlined" Value="True" />
        </Style>
    </UserControl.Styles>

    <!-- Everything is layered, as in a Panel; the save bar last, over the bottom of the rest, so showing it moves
         nothing. -->
    <Grid>
        <!-- Behind everything, along the bottom of the panel: what's heard as a spectrum, whichever song is
             playing, up to 128px tall. It stays put while the details scroll over it. Hidden, it stops drawing. -->
        <ctl:SpectrumView VerticalAlignment="Bottom"
                          MaxHeight="128"
                          IsVisible="{Binding Player.ShowSpectrum}"
                          IsActive="{Binding Player.IsPlaying}"
                          Source="{Binding Player}"
                          LowColor="{DynamicResource SpectrumLowColor}"
                          MiddleColor="{DynamicResource SpectrumMiddleColor}"
                          HighColor="{DynamicResource SpectrumHighColor}">
            <!-- The album art's colours change the shades at once; these fade them, with the rest of the panel. -->
            <ctl:SpectrumView.Transitions>
                <Transitions>
                    <ColorTransition Property="LowColor" Duration="0:0:0.4" Easing="CubicEaseInOut" />
                    <ColorTransition Property="MiddleColor" Duration="0:0:0.4" Easing="CubicEaseInOut" />
                    <ColorTransition Property="HighColor" Duration="0:0:0.4" Easing="CubicEaseInOut" />
                </Transitions>
            </ctl:SpectrumView.Transitions>
        </ctl:SpectrumView>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="24"
                    Spacing="6"
                    IsVisible="{Binding ShowPlaceholder}">
            <TextBlock Classes="centered"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Text="{x:Static res:Strings.DetailPlaceholderTitle}" />
            <TextBlock Classes="muted centered" Text="{x:Static res:Strings.DetailPlaceholderBody}" />
        </StackPanel>

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    IsVisible="{Binding IsLoading}">
            <Arc Classes="spinner"
                 Classes.active="{Binding IsLoading}"
                 Width="36" Height="36" StrokeThickness="3"
                 HorizontalAlignment="Center" />
            <TextBlock Classes="muted centered" Text="{x:Static res:Strings.Loading}" />
        </StackPanel>

        <TextBlock Classes="centered"
                   VerticalAlignment="Center"
                   Margin="24"
                   Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                   Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}" />

        <DockPanel IsVisible="{Binding ShowDetails}">
            <!-- Save and Discard are in the save bar along the bottom; a failed save is reported here, above the rows it
                 concerns. -->
            <Border DockPanel.Dock="Top"
                    Classes="banner error"
                    Margin="20,12,20,0"
                    IsVisible="{Binding HasSaveError}">
                <SelectableTextBlock TextWrapping="Wrap" Text="{Binding SaveError}" />
            </Border>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Classes="details" Classes.save-bar="{Binding ShowSaveBar}">
                    <!-- "Name - Artist", with the charter at the right; the path below, with the song's size at the right.
                         Right-clicking either line shows the songs in the file manager. -->
                    <StackPanel Background="Transparent">
                        <StackPanel.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{x:Static vm:SongDetailViewModel.RevealLabel}" Command="{Binding RevealCommand}" />
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <SelectableTextBlock Grid.Column="0"
                                                 FontSize="18"
                                                 FontWeight="SemiBold"
                                                 VerticalAlignment="Center"
                                                 TextWrapping="Wrap"
                                                 Text="{Binding Title}" />
                            <!-- The charter can carry rich-text tags (colours, bold…), which are drawn rather than shown. -->
                            <Border Grid.Column="1"
                                    Classes="chip large"
                                    MaxWidth="240"
                                    IsVisible="{Binding HasCharter}"
                                    ToolTip.Tip="{x:Static res:Strings.CharterToolTip}">
                                <TextBlock Opacity="1"
                                           TextTrimming="CharacterEllipsis"
                                           ui:RichTextMarkup.Text="{Binding Charter}" />
                            </Border>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,2,0,0">
                            <SelectableTextBlock Grid.Column="0"
                                                 Opacity="0.7"
                                                 FontSize="12"
                                                 VerticalAlignment="Center"
                                                 TextWrapping="Wrap"
                                                 Text="{Binding Subtitle}" />
                            <Border Grid.Column="1" Classes="chip large" IsVisible="{Binding HasSizeText}">
                                <TextBlock Text="{Binding SizeText}" />
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Album art on the left and the background beside it, each in its own shape, as tall as
                         lets both fit the panel's width, with a caption below each. The row, captions included,
                         is at most 512px or 40% of the window's height, whichever is smaller. -->
                    <ctl:MediaRow Margin="0,16,0,0" MaxRowHeight="512" MaxViewportFraction="0.4" FooterHeight="32" ClipToBounds="True">
                        <!-- The file's name, with its actions beside it, and its size in a chip, under the tile; a - for
                             each when there's none. -->
                        <DockPanel ctl:MediaRow.AspectRatio="{Binding ArtAspect}">
                            <Border DockPanel.Dock="Bottom"
                                    Classes="mediaCaption"
                                    Height="{Binding $parent[ctl:MediaRow].FooterHeight}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                    <!-- Shown while the art has a staged change, like an edited row's marker. -->
                                    <TextBlock Grid.Column="0"
                                               Classes="marker"
                                               Text="{Binding ArtMarker}"
                                               IsVisible="{Binding IsArtChanged}" />
                                    <!-- Left-aligned, the name's column is only as wide as the name, so the actions sit just
                                         after it; short of room, the name gives way rather than the actions. -->
                                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="4" HorizontalAlignment="Left">
                                        <TextBlock Classes="artName"
                                                   Text="{Binding ArtFileName, TargetNullValue='-'}"
                                                   ToolTip.Tip="{Binding ArtFileName}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" IsVisible="{Binding CanEdit}">
                                            <Button Classes="captionAction"
                                                    Command="{Binding ReplaceArtCommand}"
                                                    ToolTip.Tip="{x:Static res:Strings.ReplaceArtToolTip}"
                                                    AutomationProperties.Name="{x:Static res:Strings.ReplaceArtToolTip}">
                                                <PathIcon Data="{StaticResource ReplaceIconGeometry}" />
                                            </Button>
                                            <Button Classes="captionAction"
                                                    Command="{Binding RemoveArtCommand}"
                                                    ToolTip.Tip="{x:Static res:Strings.RemoveArtToolTip}"
                                                    AutomationProperties.Name="{x:Static res:Strings.RemoveArtToolTip}">
                                                <PathIcon Data="{StaticResource TrashIconGeometry}" />
                                            </Button>
                                            <!-- Hidden by Button.captionAction.revert:disabled unless there's a change to undo. -->
                                            <Button Classes="captionAction revert"
                                                    Command="{Binding RevertArtCommand}"
                                                    ToolTip.Tip="{x:Static res:Strings.RevertArtToolTip}"
                                                    AutomationProperties.Name="{x:Static res:Strings.RevertArtToolTip}">
                                                <PathIcon Data="{StaticResource RevertIconGeometry}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Column="2" Classes="chip large">
                                        <TextBlock Text="{Binding ArtFileSize, TargetNullValue='-'}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Classes="artTile" AutomationProperties.Name="{x:Static res:Strings.AlbumArtName}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding ArtDownloadHeader}" Command="{Binding DownloadArtCommand}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Panel>
                                    <Image Source="{Binding ArtImage}"
                                           Stretch="Uniform"
                                           IsVisible="{Binding HasArtImage}" />
                                    <StackPanel VerticalAlignment="Center"
                                                Margin="12"
                                                Spacing="6"
                                                IsVisible="{Binding !HasArtImage}">
                                        <PathIcon Width="28" Height="28"
                                                  Opacity="0.4"
                                                  HorizontalAlignment="Center"
                                                  Data="{StaticResource AlbumArtIconGeometry}" />
                                        <TextBlock Classes="muted centered"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding ArtNote}" />
                                    </StackPanel>
                                </Panel>
                            </Border>
                        </DockPanel>

                        <!-- The background video or image, or why there's none to show, captioned like the art, with its
                             actions beside its name and the Image | Video switch at the right. Remove removes the kind shown. -->
                        <DockPanel ctl:MediaRow.AspectRatio="{Binding Background.AspectRatio}">
                            <Border DockPanel.Dock="Bottom"
                                    Classes="mediaCaption"
                                    Height="{Binding $parent[ctl:MediaRow].FooterHeight}">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0"
                                               Classes="marker"
                                               Text="{Binding Background.Marker}"
                                               IsVisible="{Binding Background.IsChanged}" />
                                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="4" HorizontalAlignment="Left">
                                        <TextBlock Classes="artName"
                                                   Text="{Binding Background.ShownFileName, TargetNullValue='-'}"
                                                   ToolTip.Tip="{Binding Background.ShownFileName}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" IsVisible="{Binding CanEdit}">
                                            <Button Classes="captionAction"
                                                    Command="{Binding ReplaceBackgroundCommand}"
                                                    ToolTip.Tip="{x:Static res:Strings.ReplaceBackgroundToolTip}"
                                                    AutomationProperties.Name="{x:Static res:Strings.ReplaceBackgroundToolTip}">
                                                <PathIcon Data="{StaticResource ReplaceIconGeometry}" />
                                            </Button>
                                            <Button Classes="captionAction"
                                                    Command="{Binding RemoveBackgroundCommand}"
                                                    ToolTip.Tip="{Binding Background.RemoveToolTip}"
                                                    AutomationProperties.Name="{Binding Background.RemoveToolTip}">
                                                <PathIcon Data="{StaticResource TrashIconGeometry}" />
                                            </Button>
                                            <Button Classes="captionAction revert"
                                                    Command="{Binding RevertBackgroundCommand}"
                                                    ToolTip.Tip="{x:Static res:Strings.RevertBackgroundToolTip}"
                                                    AutomationProperties.Name="{x:Static res:Strings.RevertBackgroundToolTip}">
                                                <PathIcon Data="{StaticResource RevertIconGeometry}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Column="2" Classes="chip large">
                                        <TextBlock Text="{Binding Background.ShownFileSize, TargetNullValue='-'}" />
                                    </Border>
                                    <!-- The note highway's button, while the highway is drawn over the background; only one song's chart can
                                         play along, so it's hidden for several. -->
                                    <Panel Grid.Column="3" IsVisible="{Binding ShowSongFiles}">
                                        <ToggleSplitButton Classes="highway"
                                                           IsChecked="{Binding Highway.IsEnabled}"
                                                           IsEnabled="{Binding Highway.HasChart}"
                                                           IsVisible="{Binding Highway.IsOverBackground}"
                                                           ToolTip.Tip="{Binding Highway.ToggleToolTip}"
                                                           Flyout="{StaticResource HighwayOptionsFlyout}"
                                                           AutomationProperties.Name="{x:Static res:Strings.HighwayToggleToolTip}">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <PathIcon Data="{StaticResource HighwayIconGeometry}" />
                                                <TextBlock Classes="marker" Text="{Binding Highway.Marker}" IsVisible="{Binding Highway.IsChanged}" />
                                            </StackPanel>
                                        </ToggleSplitButton>
                                    </Panel>
                                    <!-- The video's offset, in a flyout of its own so the caption stays short; only while one song
                                         is selected and it has a video, whether or not the video is what's shown. Focusable, so a click on its empty space or a label (or Enter
                                         in the box) can take focus from the box without closing the flyout. -->
                                    <Button Grid.Column="4"
                                            Classes="offset"
                                            IsVisible="{Binding ShowVideoOffset}"
                                            ToolTip.Tip="{x:Static res:Strings.VideoOffsetButtonToolTip}"
                                            AutomationProperties.Name="{x:Static res:Strings.VideoOffsetName}">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <PathIcon Data="{StaticResource OffsetIconGeometry}" />
                                            <TextBlock Classes="marker" Text="{Binding VideoOffset.Marker}" IsVisible="{Binding VideoOffset.HasOffset}" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedRight">
                                                <StackPanel Spacing="6"
                                                            Background="Transparent"
                                                            Focusable="True"
                                                            PointerPressed="OnOffsetFlyoutPressed"
                                                            AutomationProperties.Name="{x:Static res:Strings.VideoOffsetName}">
                                                    <TextBlock Classes="highwayHeader" Text="{x:Static res:Strings.VideoOffsetName}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <NumericUpDown ui:DragScrub.IsEnabled="True"
                                                                       Width="72"
                                                                       ShowButtonSpinner="False"
                                                                       VerticalAlignment="Center"
                                                                       Value="{Binding VideoOffset.Offset}"
                                                                       IsEnabled="{Binding VideoOffset.CanEdit}"
                                                                       Increment="1"
                                                                       Minimum="{Binding VideoOffset.MinOffset}"
                                                                       Maximum="{Binding VideoOffset.MaxOffset}"
                                                                       FormatString="+0;-0;0"
                                                                       AutomationProperties.Name="{x:Static res:Strings.VideoOffsetName}">
                                                            <ToolTip.Tip>
                                                                <StackPanel MaxWidth="320" Spacing="6">
                                                                    <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.VideoOffsetToolTip}" />
                                                                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static res:SharedStrings.OffsetControlsHelp}" />
                                                                </StackPanel>
                                                            </ToolTip.Tip>
                                                        </NumericUpDown>
                                                        <TextBlock Classes="muted" VerticalAlignment="Center" Text="{x:Static res:Strings.HighwayOffsetUnit}" />
                                                        <Button Classes="nudge"
                                                                Command="{Binding VideoOffset.RevertOffsetCommand}"
                                                                ToolTip.Tip="{x:Static res:Strings.VideoRevertOffsetToolTip}"
                                                                AutomationProperties.Name="{x:Static res:Strings.VideoRevertOffsetToolTip}">
                                                            <PathIcon Width="12" Height="12" Data="{StaticResource RevertIconGeometry}" />
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <!-- Always shown; a kind the selection doesn't have can't be picked. -->
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2">
                                        <RadioButton Classes="backgroundKind"
                                                     IsChecked="{Binding Background.IsImageSelected}"
                                                     IsEnabled="{Binding Background.HasImageKind}"
                                                     ToolTip.Tip="{x:Static res:Strings.ShowBackgroundImageToolTip}"
                                                     AutomationProperties.Name="{x:Static res:Strings.ShowBackgroundImageToolTip}">
                                            <PathIcon Data="{StaticResource ImageIconGeometry}" />
                                        </RadioButton>
                                        <RadioButton Classes="backgroundKind"
                                                     IsChecked="{Binding Background.IsVideoSelected}"
                                                     IsEnabled="{Binding Background.HasVideoKind}"
                                                     ToolTip.Tip="{x:Static res:Strings.ShowBackgroundVideoToolTip}"
                                                     AutomationProperties.Name="{x:Static res:Strings.ShowBackgroundVideoToolTip}">
                                            <PathIcon Data="{StaticResource VideoIconGeometry}" />
                                        </RadioButton>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Classes="artTile" AutomationProperties.Name="{x:Static res:Strings.BackgroundName}">
                                <!-- Saves the kind shown, image or video, as the toggle above picks it. -->
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding Background.DownloadHeader}" Command="{Binding DownloadBackgroundCommand}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Panel>
                                    <Image Source="{Binding Background.Image}"
                                           Stretch="Uniform"
                                           IsVisible="{Binding Background.HasImage}" />
                                    <ui:VideoFrameView Playback="{Binding Background.Video}"
                                                        Timeline="{Binding Background.Timeline}"
                                                        Clock="{Binding Background.Clock}"
                                                        IsVisible="{Binding Background.HasVideo}" />
                                    <!-- Why there's no background, behind the highway as the background would be. -->
                                    <StackPanel VerticalAlignment="Center"
                                                Margin="12"
                                                Spacing="6"
                                                IsVisible="{Binding Background.HasNote}">
                                        <PathIcon Width="28" Height="28"
                                                  Opacity="0.4"
                                                  HorizontalAlignment="Center"
                                                  Data="{StaticResource BackgroundIconGeometry}" />
                                        <TextBlock Classes="muted centered"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Background.Note}" />
                                    </StackPanel>
                                    <!-- The chart's notes over whatever the background is, as a game draws them, unless the
                                         settings put them in their own row below the lyrics. A highway under the pointer shows
                                         its whole chart while Shift is held, to scrub through. -->
                                    <hw:NoteHighwayView x:Name="HighwayOverlayView"
                                                         Scene="{Binding Highway.Scene}"
                                                         Clock="{Binding Highway.Clock}"
                                                         LookAhead="{Binding Highway.LookAhead}"
                                                         Waveforms="{Binding Highway.LaneWaveforms}"
                                                         LengthSeconds="{Binding Player.TimelineSeconds}"
                                                         FineScrubFactor="{Binding Player.LaneFineScrubFactor}"
                                                         ToolTip.Tip="{Binding Player.HighwayScrubToolTip}"
                                                         IsVisible="{Binding Highway.IsShownOverBackground}" />
                                </Panel>
                            </Border>
                        </DockPanel>
                    </ctl:MediaRow>
                    <TextBlock Classes="error" Text="{Binding ArtError}" IsVisible="{Binding HasArtError}" />
                    <TextBlock Classes="error" Text="{Binding BackgroundError}" IsVisible="{Binding HasBackgroundError}" />

                    <!-- The one selected song's vocals as a karaoke lane, in step with the audio, shown while it has
                         a vocals track or vocals in its chart. Captioned and edited like the art. While Shift is held
                         over the lane it shows the whole part, to scrub through. -->
                    <DockPanel Margin="0,16,0,0" IsVisible="{Binding Lyrics.IsVisible}">
                        <!-- The name, which gives way on a narrow panel, with its actions beside it, then the offset at the
                             right, as the highway's instruments have in their flyout. -->
                        <Border DockPanel.Dock="Bottom" Classes="mediaCaption" MinHeight="32">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
                                <TextBlock Grid.Column="0"
                                           Classes="marker"
                                           Text="{Binding Lyrics.Marker}"
                                           IsVisible="{Binding Lyrics.IsChanged}" />
                                <TextBlock Grid.Column="1" Classes="artName" Text="{x:Static res:Strings.LyricsHeader}" />
                                <Grid Grid.Column="2" ColumnDefinitions="*,Auto" ColumnSpacing="4" HorizontalAlignment="Left">
                                    <TextBlock Classes="artName muted"
                                               Text="{Binding Lyrics.SourceName, TargetNullValue='-'}"
                                               ToolTip.Tip="{Binding Lyrics.SourceName}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" IsVisible="{Binding CanEdit}">
                                        <Button Classes="captionAction"
                                                Command="{Binding ReplaceLyricsCommand}"
                                                ToolTip.Tip="{Binding Lyrics.ReplaceToolTip}"
                                                AutomationProperties.Name="{Binding Lyrics.ReplaceToolTip}">
                                            <PathIcon Data="{StaticResource ReplaceIconGeometry}" />
                                        </Button>
                                        <Button Classes="captionAction"
                                                Command="{Binding RemoveLyricsCommand}"
                                                ToolTip.Tip="{x:Static res:Strings.LyricsRemoveToolTip}"
                                                AutomationProperties.Name="{x:Static res:Strings.LyricsRemoveToolTip}">
                                            <PathIcon Data="{StaticResource TrashIconGeometry}" />
                                        </Button>
                                        <Button Classes="captionAction revert"
                                                Command="{Binding RevertLyricsCommand}"
                                                ToolTip.Tip="{x:Static res:Strings.LyricsRevertToolTip}"
                                                AutomationProperties.Name="{x:Static res:Strings.LyricsRevertToolTip}">
                                            <PathIcon Data="{StaticResource RevertIconGeometry}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Column="3"
                                           Classes="finding"
                                           MaxWidth="260"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding Lyrics.Warning}"
                                           ToolTip.Tip="{Binding Lyrics.Warning}"
                                           IsVisible="{Binding Lyrics.HasWarning}" />
                                <!-- The audio behind the lane: the button shows or hides it, as the highway flyout's check box does,
                                     and the arrow picks the track. -->
                                <ToggleSplitButton Grid.Column="4"
                                                   Classes="highway"
                                                   IsChecked="{Binding Player.ShowLaneWaveforms}"
                                                   IsEnabled="{Binding Player.ShowWaveforms}"
                                                   IsVisible="{Binding Lyrics.HasLyrics}"
                                                   ToolTip.Tip="{Binding Player.LaneWaveformsToolTip}"
                                                   ToolTip.ShowOnDisabled="True"
                                                   AutomationProperties.Name="{x:Static res:Strings.ShowLaneWaveformsLabel}">
                                    <PathIcon Data="{StaticResource WaveformIconGeometry}" />
                                    <ToggleSplitButton.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedRight">
                                            <StackPanel Spacing="6" AutomationProperties.Name="{x:Static res:Strings.LaneWaveformOptionsName}">
                                                <TextBlock Classes="highwayHeader" Text="{x:Static res:Strings.LaneWaveformName}" />
                                                <ComboBox MinWidth="180"
                                                          ItemsSource="{Binding Lyrics.WaveformPicker.Options}"
                                                          SelectedIndex="{Binding Lyrics.WaveformPicker.Index}"
                                                          IsEnabled="{Binding Player.AreLaneWaveformsShown}"
                                                          ToolTip.Tip="{x:Static res:Strings.LaneWaveformPickerToolTip}"
                                                          AutomationProperties.Name="{x:Static res:Strings.LaneWaveformName}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:WaveformOption">
                                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                        </Flyout>
                                    </ToggleSplitButton.Flyout>
                                </ToggleSplitButton>
                                <StackPanel Grid.Column="5"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            IsVisible="{Binding Lyrics.HasLyrics}">
                                    <NumericUpDown ui:DragScrub.IsEnabled="True"
                                                   Width="72"
                                                   ShowButtonSpinner="False"
                                                   VerticalAlignment="Center"
                                                   Value="{Binding Lyrics.Offset}"
                                                   IsEnabled="{Binding Lyrics.CanSetOffset}"
                                                   Increment="1"
                                                   Minimum="-2147483648"
                                                   Maximum="2147483647"
                                                   FormatString="+0;-0;0"
                                                   AutomationProperties.Name="{x:Static res:Strings.LyricsOffsetName}">
                                        <ToolTip.Tip>
                                            <StackPanel Spacing="6">
                                                <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.LyricsOffsetToolTip}" />
                                                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static res:SharedStrings.OffsetControlsHelp}" />
                                            </StackPanel>
                                        </ToolTip.Tip>
                                    </NumericUpDown>
                                    <TextBlock Classes="muted" VerticalAlignment="Center" Text="{x:Static res:Strings.HighwayOffsetUnit}" />
                                    <Button Classes="nudge"
                                            Command="{Binding Lyrics.RevertOffsetCommand}"
                                            ToolTip.Tip="{x:Static res:Strings.LyricsRevertOffsetToolTip}"
                                            AutomationProperties.Name="{x:Static res:Strings.LyricsRevertOffsetToolTip}">
                                        <PathIcon Width="12" Height="12" Data="{StaticResource RevertIconGeometry}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Classes="artTile" Height="120" AutomationProperties.Name="{x:Static res:Strings.LyricsHeader}">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{x:Static res:Strings.MenuExportLyrics}" Command="{Binding ExportLyricsCommand}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Panel>
                                <ctl:LyricLaneView x:Name="LyricLane"
                                                   Scene="{Binding Lyrics.Scene}"
                                                   TimeShift="{Binding Lyrics.TimeShift}"
                                                   Waveform="{Binding Lyrics.Waveform}"
                                                   Clock="{Binding Lyrics.Clock}"
                                                   LengthSeconds="{Binding Player.TimelineSeconds}"
                                                   FineScrubFactor="{Binding Player.LaneFineScrubFactor}"
                                                   NoteBrush="{DynamicResource AccentMarkBrush}"
                                                   SingingBrush="{DynamicResource AccentHighlightBrush}"
                                                   SungBrush="{DynamicResource AccentTextBrush}"
                                                   ToolTip.Tip="{Binding Player.LyricsScrubToolTip}"
                                                   IsVisible="{Binding Lyrics.HasLyrics}" />
                                <TextBlock Classes="muted centered"
                                           VerticalAlignment="Center"
                                           Margin="12"
                                           TextWrapping="Wrap"
                                           Text="{Binding Lyrics.Note}"
                                           IsVisible="{Binding Lyrics.HasNote}" />
                            </Panel>
                        </Border>
                    </DockPanel>
                    <TextBlock Classes="error" Text="{Binding LyricsError}" IsVisible="{Binding HasLyricsError}" />
                    <TextBlock Classes="error" Text="{Binding Lyrics.Problem}" IsVisible="{Binding Lyrics.HasProblem}" />

                    <!-- The one selected song's chart as note highways, one per instrument, in step with the audio, while the
                         settings put them here rather than over the background. Captioned like the lyrics: the button at the
                         right shows or hides the highways, and its arrow opens their options. -->
                    <Panel IsVisible="{Binding ShowSongFiles}">
                        <DockPanel Margin="0,16,0,0" IsVisible="{Binding Highway.IsInRow}">
                            <Border DockPanel.Dock="Bottom" Classes="mediaCaption" MinHeight="32">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0"
                                               Classes="marker"
                                               Text="{Binding Highway.Marker}"
                                               IsVisible="{Binding Highway.IsChanged}" />
                                    <TextBlock Grid.Column="1" Classes="artName" Text="{x:Static res:Strings.HighwayInstrumentsHeader}" />
                                    <TextBlock Grid.Column="2"
                                               Classes="artName muted"
                                               Text="{Binding Highway.Note}"
                                               ToolTip.Tip="{Binding Highway.Note}"
                                               IsVisible="{Binding Highway.HasNote}" />
                                    <ToggleSplitButton Grid.Column="3"
                                                       Classes="highway"
                                                       IsChecked="{Binding Highway.IsEnabled}"
                                                       IsEnabled="{Binding Highway.HasChart}"
                                                       ToolTip.Tip="{Binding Highway.ToggleToolTip}"
                                                       Flyout="{StaticResource HighwayOptionsFlyout}"
                                                       AutomationProperties.Name="{x:Static res:Strings.HighwayToggleToolTip}">
                                        <PathIcon Data="{StaticResource HighwayIconGeometry}" />
                                    </ToggleSplitButton>
                                </Grid>
                            </Border>

                            <!-- Only while there's a chart and the highways are switched on, leaving the caption, with why there's
                                 no chart, to switch them back on. Highways are as wide as the height allows, centred. -->
                            <Border Classes="artTile"
                                    Height="240"
                                    IsVisible="{Binding Highway.IsTileShown}"
                                    AutomationProperties.Name="{x:Static res:Strings.HighwayInstrumentsHeader}">
                                <hw:NoteHighwayView x:Name="HighwayRowView"
                                                     Scene="{Binding Highway.Scene}"
                                                     Clock="{Binding Highway.Clock}"
                                                     LookAhead="{Binding Highway.LookAhead}"
                                                     Waveforms="{Binding Highway.LaneWaveforms}"
                                                     LengthSeconds="{Binding Player.TimelineSeconds}"
                                                     FineScrubFactor="{Binding Player.LaneFineScrubFactor}"
                                                     ToolTip.Tip="{Binding Player.HighwayScrubToolTip}"
                                                     IsVisible="{Binding Highway.IsShown}" />
                            </Border>
                        </DockPanel>
                    </Panel>

                    <!-- The one selected song's audio tracks, played together and in step. A track
                         can be muted, or soloed to hear it alone; added and removed tracks play as
                         they will be once saved. A removed track stays listed, struck through, until
                         it's kept after all or something replaces it. -->
                    <StackPanel IsVisible="{Binding ShowSongFiles}" Grid.IsSharedSizeScope="True">
                        <!-- Fluent gives a slider a tall row of its own; the volume sliders fit the compact track rows instead. -->
                        <StackPanel.Resources>
                            <x:Double x:Key="SliderHorizontalHeight">20</x:Double>
                        </StackPanel.Resources>
                        <!-- The audio offset, the master volume, the playback speed and pitch correction sit at the right of the
                             header; each track has its own level in the mix below. The offset moves every track alike, as
                             song.ini's delay does. -->
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" Classes="section" Text="{Binding Player.TracksHeader}" />
                            <StackPanel Grid.Column="1"
                                        Classes="timing"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding Player.HasTracks}">
                                <TextBlock Classes="marker" VerticalAlignment="Center" Text="{Binding AudioOffset.Marker}" IsVisible="{Binding AudioOffset.HasOffset}" />
                                <PathIcon Opacity="0.7" VerticalAlignment="Center" Data="{StaticResource OffsetIconGeometry}" />
                                <NumericUpDown ui:DragScrub.IsEnabled="True"
                                               Width="72"
                                               ShowButtonSpinner="False"
                                               VerticalAlignment="Center"
                                               Value="{Binding AudioOffset.Offset}"
                                               IsEnabled="{Binding AudioOffset.CanEdit}"
                                               Increment="1"
                                               Minimum="{Binding AudioOffset.MinOffset}"
                                               Maximum="{Binding AudioOffset.MaxOffset}"
                                               FormatString="+0;-0;0"
                                               ToolTip.ShowOnDisabled="True"
                                               AutomationProperties.Name="{x:Static res:Strings.AudioOffsetName}">
                                    <ToolTip.Tip>
                                        <StackPanel Spacing="6">
                                            <TextBlock TextWrapping="Wrap" Text="{x:Static res:Strings.AudioOffsetToolTip}" />
                                            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static res:SharedStrings.OffsetControlsHelp}" />
                                        </StackPanel>
                                    </ToolTip.Tip>
                                </NumericUpDown>
                                <TextBlock Classes="muted" VerticalAlignment="Center" Text="{x:Static res:Strings.HighwayOffsetUnit}" />
                                <Button Classes="nudge"
                                        Command="{Binding AudioOffset.RevertOffsetCommand}"
                                        ToolTip.Tip="{x:Static res:Strings.AudioRevertOffsetToolTip}"
                                        AutomationProperties.Name="{x:Static res:Strings.AudioRevertOffsetToolTip}">
                                    <PathIcon Width="12" Height="12" Data="{StaticResource RevertIconGeometry}" />
                                </Button>
                            </StackPanel>
                            <PathIcon Grid.Column="2"
                                      Width="14" Height="14"
                                      Opacity="0.7"
                                      VerticalAlignment="Center"
                                      IsVisible="{Binding Player.HasTracks}"
                                      Data="{StaticResource VolumeIconGeometry}" />
                            <Slider Grid.Column="3"
                                    Width="90"
                                    Minimum="0"
                                    Maximum="1"
                                    Value="{Binding Player.Volume}"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding Player.HasTracks}"
                                    ToolTip.Tip="{x:Static res:Strings.VolumeName}"
                                    AutomationProperties.Name="{x:Static res:Strings.VolumeName}" />
                            <!-- Presets, or any whole percent typed in; what's typed takes effect on Enter or leaving the box, so
                                 typing 150 doesn't play at 1% and 15% on the way. See SongDetailView.CommitPlaybackSpeed. -->
                            <TextBlock Grid.Column="4"
                                       Classes="muted"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding Player.HasTracks}"
                                       Text="{x:Static res:Strings.PlaybackSpeedLabel}" />
                            <ComboBox Grid.Column="5"
                                      x:Name="PlaybackSpeedBox"
                                      IsEditable="True"
                                      Width="90"
                                      Padding="8,0,0,0"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      ItemsSource="{x:Static vm:PlayerViewModel.PlaybackSpeedPresets}"
                                      Text="{Binding Player.PlaybackSpeedText, Mode=OneWay}"
                                      IsVisible="{Binding Player.HasTracks}"
                                      ToolTip.Tip="{x:Static res:Strings.PlaybackSpeedToolTip}"
                                      AutomationProperties.Name="{x:Static res:Strings.PlaybackSpeedName}">
                                <!-- Fluent pads a ComboBox unevenly for its selection text and gives a text box a minimum height of
                                     its own, which together leave the typed text off centre; the box's text is centred instead. -->
                                <ComboBox.Styles>
                                    <Style Selector="ComboBox /template/ TextBox#PART_EditableTextBox">
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="VerticalAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </ComboBox.Styles>
                            </ComboBox>
                            <ToggleButton Grid.Column="6"
                                          Classes="tool"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding Player.PitchCorrection}"
                                          IsVisible="{Binding Player.HasTracks}"
                                          ToolTip.Tip="{x:Static res:Strings.PitchCorrectionToolTip}"
                                          AutomationProperties.Name="{x:Static res:Strings.PitchCorrectionLabel}">
                                <PathIcon Width="14" Height="14" Data="{StaticResource PitchCorrectionIconGeometry}" />
                            </ToggleButton>
                        </Grid>
                        <TextBlock Classes="muted" Text="{x:Static res:Strings.NoTracks}" IsVisible="{Binding !Player.HasTracks}" />

                        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto"
                              ColumnSpacing="8"
                              Margin="0,0,0,6"
                              IsVisible="{Binding Player.HasTracks}">
                            <Button Grid.Column="0"
                                    Classes="transport accent"
                                    Command="{Binding Player.PlayPauseCommand}"
                                    ToolTip.Tip="{Binding Player.PlayPauseToolTip}"
                                    AutomationProperties.Name="{Binding Player.PlayPauseToolTip}">
                                <Panel>
                                    <PathIcon Data="{StaticResource PlayIconGeometry}" IsVisible="{Binding !Player.IsPlaying}" />
                                    <PathIcon Data="{StaticResource PauseIconGeometry}" IsVisible="{Binding Player.IsPlaying}" />
                                </Panel>
                            </Button>
                            <Button Grid.Column="1"
                                    Classes="transport"
                                    Command="{Binding Player.StopCommand}"
                                    ToolTip.Tip="{x:Static res:Strings.StopToolTip}"
                                    AutomationProperties.Name="{x:Static res:Strings.StopToolTip}">
                                <PathIcon Data="{StaticResource StopIconGeometry}" />
                            </Button>
                            <!-- A hidden copy of the length holds the column at its widest, so the waveform
                                 doesn't shift as the position gains a digit (9:59 to 10:00). -->
                            <Panel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Classes="muted"
                                           FontFeatures="tnum"
                                           Opacity="0"
                                           IsHitTestVisible="False"
                                           AutomationProperties.AccessibilityView="Raw"
                                           Text="{Binding Player.LengthText}" />
                                <TextBlock Classes="muted"
                                           HorizontalAlignment="Right"
                                           FontFeatures="tnum"
                                           Text="{Binding Player.PositionText}" />
                            </Panel>
                            <!-- What is heard, as a waveform that changes with the mute and solo switches. Dragging seeks
                                 when it's let go; a click seeks at once. It spans the song as a game plays it, which can
                                 run on past the audio, so the waveform can stop short of the end. -->
                            <ui:WaveformView x:Name="SeekBar"
                                              Grid.Column="3"
                                              Height="40"
                                              Waveform="{Binding Player.Waveform}"
                                              PositionSeconds="{Binding Player.PositionSeconds}"
                                              LengthSeconds="{Binding Player.TimelineSeconds}"
                                              FineSecondsPerPixel="{Binding Player.FineScrubSecondsPerPixel}"
                                              ToolTip.Tip="{Binding Player.SeekBarToolTip}"
                                              PlayedBrush="{DynamicResource AccentTextBrush}"
                                              UnplayedBrush="{DynamicResource WaveformBrush}"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="{x:Static res:Strings.SeekName}" />
                            <TextBlock Grid.Column="4"
                                       Classes="muted"
                                       VerticalAlignment="Center"
                                       FontFeatures="tnum"
                                       Text="{Binding Player.LengthText}"
                                       ToolTip.Tip="{Binding Player.LengthToolTip}" />
                            <Button Grid.Column="5"
                                    Classes="transport"
                                    Command="{Binding Player.JumpToPreviewCommand}"
                                    IsVisible="{Binding Player.HasPreviewStart}"
                                    ToolTip.Tip="{x:Static res:Strings.JumpToPreviewToolTip}"
                                    AutomationProperties.Name="{x:Static res:Strings.JumpToPreviewToolTip}">
                                <PathIcon Data="{StaticResource PreviewIconGeometry}" />
                            </Button>
                        </Grid>
                        <TextBlock Classes="muted" Text="{x:Static res:Strings.OpeningAudio}" IsVisible="{Binding Player.IsOpening}" />
                        <TextBlock Classes="error" Text="{Binding Player.Error}" IsVisible="{Binding Player.HasError}" />

                        <!-- The tracks, those a staged change removes, and Add track, as Chart Builder's Chart settings shows them too. -->
                        <uiviews:TrackListView Tracks="{Binding Player.Tracks}"
                                               RemovedTracks="{Binding RemovedTracks}"
                                               AddTrackOptions="{Binding AddTrackOptions}"
                                               CanEdit="{Binding CanEdit}"
                                               ShowWaveforms="{Binding Player.ShowWaveforms}"
                                               PositionSeconds="{Binding Player.PositionSeconds}"
                                               LengthSeconds="{Binding Player.TimelineSeconds}"
                                               ReplaceTrackCommand="{Binding ReplaceTrackCommand}"
                                               RemoveTrackCommand="{Binding RemoveTrackCommand}"
                                               RestoreTrackCommand="{Binding UndoRemoveTrackCommand}" />

                        <TextBlock Classes="error" Text="{Binding TracksError}" IsVisible="{Binding HasTracksError}" />
                    </StackPanel>

                    <!-- The chart: notes.chart or notes.mid, replaced by choosing either kind. Without one the song can't be played. -->
                    <StackPanel IsVisible="{Binding ShowSongFiles}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="section" Text="{x:Static res:Strings.ChartHeader}" />
                            <Panel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,4" IsVisible="{Binding CanEdit}">
                                <Button Classes="icon"
                                        Padding="4"
                                        Command="{Binding RevertChartCommand}"
                                        IsVisible="{Binding IsChartChanged}"
                                        ToolTip.Tip="{x:Static res:Strings.RevertChartToolTip}"
                                        AutomationProperties.Name="{x:Static res:Strings.RevertChartToolTip}">
                                    <PathIcon Width="12" Height="12" Data="{StaticResource RevertIconGeometry}" />
                                </Button>
                            </Panel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Charts}"
                                      AutomationProperties.Name="{x:Static res:Strings.ChartsListName}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChartRow">
                                    <Grid ColumnDefinitions="14,*,Auto,Auto" ColumnSpacing="4" Margin="0,1" Background="Transparent">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{Binding DownloadHeader}"
                                                          Command="{Binding DownloadCommand}"
                                                          IsEnabled="{Binding DownloadCommand, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <TextBlock Grid.Column="0"
                                                   Classes="marker"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Marker}" />
                                        <TextBlock Grid.Column="1"
                                                   Classes.removed="{Binding IsRemoved}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Name}" />
                                        <Border Grid.Column="2" Classes="chip" Margin="4,0">
                                            <TextBlock Classes.removed="{Binding IsRemoved}" Text="{Binding Size}" />
                                        </Border>
                                        <!-- Sized for the buttons, so the sizes line up on a removed row, which has none. -->
                                        <StackPanel Grid.Column="3"
                                                    Orientation="Horizontal"
                                                    MinWidth="44"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding $parent[ItemsControl].((vm:SongDetailViewModel)DataContext).CanEdit, FallbackValue=False}">
                                            <Button Classes="icon"
                                                    Padding="4"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding $parent[ItemsControl].((vm:SongDetailViewModel)DataContext).ChooseChartCommand, FallbackValue={x:Null}}"
                                                    IsVisible="{Binding IsKept}"
                                                    ToolTip.Tip="{x:Static res:Strings.ReplaceChartToolTip}"
                                                    AutomationProperties.Name="{x:Static res:Strings.ReplaceChartToolTip}">
                                                <PathIcon Width="12" Height="12" Data="{StaticResource ReplaceIconGeometry}" />
                                            </Button>
                                            <Button Classes="icon"
                                                    Padding="4"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding $parent[ItemsControl].((vm:SongDetailViewModel)DataContext).RemoveChartCommand, FallbackValue={x:Null}}"
                                                    IsVisible="{Binding IsKept}"
                                                    ToolTip.Tip="{x:Static res:Strings.RemoveChartToolTip}"
                                                    AutomationProperties.Name="{x:Static res:Strings.RemoveChartToolTip}">
                                                <PathIcon Width="12" Height="12" Data="{StaticResource RemoveIconGeometry}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel IsVisible="{Binding ShowChartMissing}">
                            <TextBlock Classes="finding" TextWrapping="Wrap" Text="{Binding ChartMissingNote}" />
                            <Button Classes="icon"
                                    Margin="10,4,0,0"
                                    Command="{Binding ChooseChartCommand}"
                                    IsVisible="{Binding CanEdit}"
                                    AutomationProperties.Name="{x:Static res:Strings.AddChartButton}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Width="12" Height="12" Data="{StaticResource AddIconGeometry}" />
                                    <TextBlock Text="{x:Static res:Strings.AddChartButton}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Classes="error" Text="{Binding ChartError}" IsVisible="{Binding HasChartError}" />
                    </StackPanel>

                    <!-- Everything else in the song: files the other sections don't show, such as a highway image,
                         a readme, or a second album.jpg beside the album.png that's used. -->
                    <StackPanel IsVisible="{Binding ShowSongFiles}">
                        <TextBlock Classes="section" Text="{Binding OtherFilesHeader}" />
                        <TextBlock Classes="muted" Text="{x:Static res:Strings.NoOtherFiles}" IsVisible="{Binding ShowNoOtherFiles}" />
                        <ItemsControl ItemsSource="{Binding Files}"
                                      AutomationProperties.Name="{x:Static res:Strings.OtherFilesListName}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FileRow">
                                    <Grid ColumnDefinitions="14,*,Auto,Auto" ColumnSpacing="4" Margin="0,1" Background="Transparent">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{Binding DownloadHeader}"
                                                          Command="{Binding DownloadCommand}"
                                                          IsEnabled="{Binding DownloadCommand, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <TextBlock Grid.Column="0"
                                                   Classes="marker"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Marker}" />
                                        <TextBlock Grid.Column="1"
                                                   Classes.removed="{Binding IsRemoved}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="PathSegmentEllipsis"
                                                   ToolTip.Tip="{Binding Path}"
                                                   Text="{Binding Path}" />
                                        <Border Grid.Column="2" Classes="chip" Margin="4,0">
                                            <TextBlock Classes.removed="{Binding IsRemoved}" Text="{Binding Size}" />
                                        </Border>

                                        <!-- One action per row: remove a file (or drop an added one), or undo its removal. -->
                                        <Panel Grid.Column="3"
                                               MinWidth="20"
                                               IsVisible="{Binding $parent[ItemsControl].((vm:SongDetailViewModel)DataContext).CanEdit, FallbackValue=False}">
                                            <Button Classes="icon"
                                                    Padding="4"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding $parent[ItemsControl].((vm:SongDetailViewModel)DataContext).RevertFileCommand, FallbackValue={x:Null}}"
                                                    CommandParameter="{Binding}"
                                                    IsVisible="{Binding CanRevert}"
                                                    ToolTip.Tip="{x:Static res:Strings.RevertFileToolTip}"
                                                    AutomationProperties.Name="{x:Static res:Strings.RevertFileToolTip}">
                                                <PathIcon Width="12" Height="12" Data="{StaticResource RevertIconGeometry}" />
                                            </Button>
                                            <Button Classes="icon"
                                                    Padding="4"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding $parent[ItemsControl].((vm:SongDetailViewModel)DataContext).RemoveFileCommand, FallbackValue={x:Null}}"
                                                    CommandParameter="{Binding}"
                                                    IsVisible="{Binding CanRemove}"
                                                    ToolTip.Tip="{x:Static res:Strings.RemoveFileToolTip}"
                                                    AutomationProperties.Name="{x:Static res:Strings.RemoveFileToolTip}">
                                                <PathIcon Width="12" Height="12" Data="{StaticResource RemoveIconGeometry}" />
                                            </Button>
                                        </Panel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="error" Text="{Binding FilesError}" IsVisible="{Binding HasFilesError}" />
                        <Button Classes="icon"
                                Margin="10,4,0,0"
                                Command="{Binding AddFilesCommand}"
                                IsVisible="{Binding CanEdit}"
                                AutomationProperties.Name="{x:Static res:Strings.AddFilesButton}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Width="12" Height="12" Data="{StaticResource AddIconGeometry}" />
                                <TextBlock Text="{x:Static res:Strings.AddFilesButton}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Findings}"
                                  IsVisible="{Binding HasFindings}"
                                  Margin="0,12,0,0"
                                  AutomationProperties.Name="{x:Static res:Strings.FindingsListName}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FindingRow">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2">
                                    <TextBlock Grid.Column="0"
                                               Classes="finding"
                                               Classes.error="{Binding IsError}"
                                               FontWeight="SemiBold"
                                               Text="{Binding RuleId}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="finding"
                                               Classes.error="{Binding IsError}"
                                               TextWrapping="Wrap"
                                               Text="{Binding Message}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- The chart's findings counted, not listed (GitHub issue #53): View issues lists them in a window of
                         their own, by part and difficulty. -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,12,0,0" IsVisible="{Binding HasChartIssues}">
                        <TextBlock Grid.Column="0"
                                   Classes="finding"
                                   Classes.error="{Binding ChartIssues.HasErrors}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="{Binding ChartIssues.Headline}" />
                        <Button Grid.Column="1"
                                Classes="labelled"
                                VerticalAlignment="Center"
                                Content="{x:Static res:SharedStrings.ChartIssuesViewButton}"
                                Command="{Binding ViewChartIssuesCommand}"
                                IsVisible="{Binding CanViewChartIssues}"
                                ToolTip.Tip="{x:Static res:SharedStrings.ChartIssuesViewToolTip}" />
                    </Grid>

                    <TextBlock Classes="section" Text="{Binding MetadataEditor.MetadataHeader}" />
                    <TextBlock Classes="finding" TextWrapping="Wrap" Margin="0,0,0,6" Text="{Binding ReadOnlyNote}" IsVisible="{Binding HasReadOnlyNote}" />
                    <uiviews:MetadataEditorView DataContext="{Binding MetadataEditor}" />
                    <TextBlock Classes="muted"
                               Margin="14,4,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding AutoLengthNote}"
                               IsVisible="{Binding HasAutoLengthNote}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- In front of everything, along the bottom: the tip of whatever's under the pointer, as tall as it needs. -->
        <ctl:ToolTipStrip x:Name="TipStrip" VerticalAlignment="Bottom" Classes.save-bar="{Binding ShowSaveBar}" />

        <!-- The save bar: over the bottom of everything, while the selection has unsaved changes and through their save.
             It covers the bottom of the spectrum; the details and the tip strip end above it (save-bar, above). Its
             buttons' tips show in the strip. 45 high, as those styles allow for. -->
        <Border VerticalAlignment="Bottom"
                Height="45"
                IsVisible="{Binding ShowSaveBar}"
                Background="{DynamicResource ToolbarBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,8">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0"
                           Classes="muted"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding SaveBarLabel}" />
                <Arc Grid.Column="1"
                     Classes="spinner"
                     Classes.active="{Binding IsSavingShown}"
                     IsVisible="{Binding IsSavingShown}"
                     Width="14" Height="14" StrokeThickness="2"
                     VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Classes="labelled"
                        Command="{Binding DiscardCommand}"
                        ToolTip.ShowOnDisabled="True"
                        AutomationProperties.Name="{x:Static res:Strings.DiscardButton}">
                    <ToolTip.Tip>
                        <ui:TitledToolTip Title="{x:Static res:Strings.DiscardButton}" Description="{x:Static res:Strings.DiscardToolTip}" />
                    </ToolTip.Tip>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ui:LineIcon Data="{StaticResource UndoStroke}" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.DiscardButton}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3"
                        Classes="labelled accent"
                        Command="{Binding SaveCommand}"
                        ToolTip.ShowOnDisabled="True"
                        AutomationProperties.Name="{x:Static res:Strings.SaveButton}">
                    <ToolTip.Tip>
                        <ui:TitledToolTip Title="{x:Static res:Strings.SaveButton}" Description="{x:Static res:Strings.SaveToolTip}" />
                    </ToolTip.Tip>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ui:LineIcon Data="{StaticResource SaveStroke}" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.SaveButton}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
