<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ChartPacker.ViewModels"
        xmlns:res="using:ChartPacker.Resources"
        xmlns:ctl="using:ChartPacker.Controls"
        xmlns:ui="using:ChartPacker.UI.Controls"
        xmlns:views="using:ChartPacker.Views"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="880"
        x:Class="ChartPacker.Views.ValidatorWindow"
        x:DataType="vm:ValidatorWindowViewModel"
        Title="{x:Static res:Strings.ValidatorWindowTitle}"
        Background="{DynamicResource AppBackgroundBrush}"
        Width="1400" Height="880"
        MinWidth="900" MinHeight="520"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- A filter chip: clicking it turns it on or off. -->
        <DataTemplate x:Key="ValidatorFilterChipTemplate" x:DataType="vm:ValidatorFilterChipViewModel">
            <ToggleButton Classes="filterChip"
                          IsChecked="{Binding IsOn}"
                          ToolTip.Tip="{Binding ToolTip}"
                          AutomationProperties.Name="{Binding Label}">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <ui:LineIcon Data="{StaticResource CheckStroke}" IsVisible="{Binding IsOn}" />
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>
        </DataTemplate>

        <!-- A metadata key's chip: as above, with the key in the monospace its chip in the issue list uses. -->
        <DataTemplate x:Key="ValidatorKeyChipTemplate" x:DataType="vm:ValidatorFilterChipViewModel">
            <ToggleButton Classes="filterChip"
                          IsChecked="{Binding IsOn}"
                          ToolTip.Tip="{Binding ToolTip}"
                          AutomationProperties.Name="{Binding Label}">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <ui:LineIcon Data="{StaticResource CheckStroke}" IsVisible="{Binding IsOn}" />
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontFamily="Consolas, Menlo, monospace" />
                </StackPanel>
            </ToggleButton>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <!-- Check boxes without a label: just the box, so they line up down the list. -->
        <Style Selector="CheckBox.bare">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Rows: hover and selection as in the library list (tint and a violet bar on the left). -->
        <Style Selector="ListBox.validator-songs ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.validator-songs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolHoverBrush}" />
        </Style>
        <Style Selector="ListBox.validator-songs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush">
                <SolidColorBrush Color="{DynamicResource SystemAccentColor}" />
            </Setter>
        </Style>
        <Style Selector="ListBox.validator-songs ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#558B5CF6" />
        </Style>

        <!-- A song fixed since it was listed stays, dimmed, so the list doesn't move under the pointer. -->
        <Style Selector="StackPanel.validator-song.fixed">
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <!-- The counts at the end of a song's lines: violet for quick fixes, orange for the rest, green once it passes.
             A zero is dimmed, not hidden, so the columns stay put. -->
        <Style Selector="Border.count">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
        </Style>
        <Style Selector="Border.count > TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.count.fixable">
            <Setter Property="Background" Value="#2E8B5CF6" />
            <Setter Property="BorderBrush" Value="#668B5CF6" />
        </Style>
        <Style Selector="Border.count.fixable > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style Selector="Border.count.manual">
            <Setter Property="Background" Value="#2EFB923C" />
            <Setter Property="BorderBrush" Value="#66FB923C" />
        </Style>
        <Style Selector="Border.count.manual > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InvalidBrush}" />
        </Style>
        <Style Selector="Border.count.passes">
            <Setter Property="Background" Value="#2E4ADE80" />
            <Setter Property="BorderBrush" Value="#664ADE80" />
        </Style>
        <Style Selector="Border.count.passes > TextBlock">
            <Setter Property="Foreground" Value="#4ADE80" />
        </Style>
        <Style Selector="Border.count.zero">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <!-- A song's list of issues, opened under it. -->
        <Style Selector="Border.issues">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="30,8,0,2" />
        </Style>
        <Style Selector="TextBlock.issue">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- A chart lint finding (charter-spec C16 item 5): coloured as the detail panel colours findings. -->
        <Style Selector="TextBlock.issue.chartWarning">
            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
        </Style>
        <Style Selector="TextBlock.issue.chartError">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
        </Style>
        <Style Selector="TextBlock.fix">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.key">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource ToolHoverBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Border.key > TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
            <Setter Property="Foreground" Value="{DynamicResource InvalidBrush}" />
        </Style>
    </Window.Styles>

    <!-- Columns (0) songs, (1) splitter, (2) inspector. ValidatorWindow.axaml.cs indexes these. -->
    <Grid x:Name="ValidatorRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="360" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="3*" MinWidth="420" />
        </Grid.ColumnDefinitions>

        <!-- The songs that fail, as they're found. -->
        <DockPanel Grid.Column="0">
            <!-- How far the check has got, or what it found, with the filter beside it, and a box over the songs' boxes
                 that ticks every quick fix shown. -->
            <Border DockPanel.Dock="Top" Classes="toolbar" Padding="13,10,12,8">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Arc Classes="spinner"
                                     Classes.active="{Binding IsChecking}"
                                     IsVisible="{Binding IsChecking}"
                                     Width="12" Height="12" StrokeThickness="2"
                                     VerticalAlignment="Center" />
                                <TextBlock VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Text="{Binding StatusText}" />
                            </StackPanel>
                            <TextBlock Classes="muted"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding HasActiveFilters}"
                                       Text="{Binding ShownSummaryText}" />
                        </StackPanel>

                        <!-- On/off chips: with none on in a group, it lets every issue through. -->
                        <Button Grid.Column="1"
                                Classes="tool"
                                Classes.active="{Binding HasActiveFilters}"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{x:Static res:Strings.ValidatorFilterToolTip}"
                                AutomationProperties.Name="{x:Static res:Strings.ValidatorFilterToolTip}">
                            <Panel Width="32" Height="32">
                                <ui:LineIcon Data="{StaticResource FilterStroke}" HorizontalAlignment="Center" />
                                <Border Classes="badge" IsVisible="{Binding HasActiveFilters}">
                                    <TextBlock Text="{Binding ActiveFilterCount}" />
                                </Border>
                            </Panel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Width="340" Spacing="14" Margin="2">
                                            <StackPanel Classes="filter-section">
                                                <TextBlock Classes="caption" Text="{x:Static res:Strings.ValidatorFilterFixLabel}" />
                                                <ItemsControl ItemsSource="{Binding FixChips}" ItemTemplate="{StaticResource ValidatorFilterChipTemplate}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- Only the types the listed songs have. -->
                                            <StackPanel Classes="filter-section">
                                                <TextBlock Classes="caption" Text="{x:Static res:Strings.ValidatorFilterTypeLabel}" />
                                                <ItemsControl ItemsSource="{Binding TypeChips}"
                                                              ItemTemplate="{StaticResource ValidatorFilterChipTemplate}"
                                                              IsVisible="{Binding HasTypeChips}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                                <TextBlock Classes="muted"
                                                           FontSize="12"
                                                           IsVisible="{Binding !HasTypeChips}"
                                                           Text="{x:Static res:Strings.ValidatorFilterNoTypes}" />
                                            </StackPanel>

                                            <!-- Only the metadata keys that fail in the listed songs, not every key. -->
                                            <StackPanel Classes="filter-section">
                                                <TextBlock Classes="caption" Text="{x:Static res:Strings.ValidatorFilterKeyLabel}" />
                                                <ItemsControl ItemsSource="{Binding KeyChips}"
                                                              ItemTemplate="{StaticResource ValidatorKeyChipTemplate}"
                                                              IsVisible="{Binding HasKeyChips}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                                <TextBlock Classes="muted"
                                                           FontSize="12"
                                                           IsVisible="{Binding !HasKeyChips}"
                                                           Text="{x:Static res:Strings.ValidatorFilterNoTypes}" />
                                            </StackPanel>

                                            <Button HorizontalAlignment="Right"
                                                    Content="{x:Static res:Strings.ResetFilters}"
                                                    Command="{Binding ClearFiltersCommand}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <ProgressBar IsVisible="{Binding IsChecking}"
                                 Minimum="0"
                                 Maximum="{Binding Total}"
                                 Value="{Binding Checked}"
                                 MinWidth="0"
                                 MinHeight="3"
                                 Height="3"
                                 AutomationProperties.Name="{Binding StatusText}" />
                    <CheckBox VerticalAlignment="Center"
                              IsThreeState="False"
                              IsEnabled="{Binding HasFixes}"
                              IsChecked="{Binding AllFixesSelected}"
                              Content="{x:Static res:Strings.ValidatorSelectAllFixes}" />
                </StackPanel>
            </Border>

            <!-- Quick fixes go into the drafts; Save all changes writes every listed song's. -->
            <Border DockPanel.Dock="Bottom" Classes="toolbar" BorderThickness="0,1,0,0" Padding="12,8">
                <StackPanel Spacing="8">
                    <Border Classes="banner error" IsVisible="{Binding HasSaveError}">
                        <SelectableTextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding SaveError}" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Panel Width="14" VerticalAlignment="Center">
                            <Arc Classes="spinner"
                                 Classes.active="{Binding IsSaving}"
                                 IsVisible="{Binding IsSaving}"
                                 Width="14" Height="14" StrokeThickness="2" />
                        </Panel>
                        <Button Classes="labelled"
                                Command="{Binding FixSelectedCommand}"
                                ToolTip.Tip="{x:Static res:Strings.ValidatorFixSelectedToolTip}">
                            <TextBlock VerticalAlignment="Center" Text="{Binding FixSelectedText}" />
                        </Button>
                        <Button Classes="labelled accent"
                                Command="{Binding SaveAllCommand}"
                                ToolTip.Tip="{x:Static res:Strings.ValidatorSaveAllToolTip}"
                                AutomationProperties.Name="{x:Static res:Strings.ValidatorSaveAll}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:LineIcon Data="{StaticResource SaveStroke}" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.ValidatorSaveAll}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Panel>
                <ListBox x:Name="SongList"
                         Classes="validator-songs"
                         ItemsSource="{Binding ShownSongs}"
                         SelectedItem="{Binding SelectedSong}"
                         SelectionMode="Single"
                         Background="Transparent"
                         AutomationProperties.Name="{x:Static res:Strings.ValidatorSongsListName}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ValidatorSongViewModel">
                            <StackPanel Classes="validator-song" Classes.fixed="{Binding IsFixed}">
                                <!-- The box ticks every quick fix of the song. Clicking anywhere else on these lines picks
                                     the song, or opens and closes its issues once it's picked (ValidatorWindow.axaml.cs). -->
                                <Grid Classes="song-header"
                                      Background="Transparent"
                                      ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto"
                                      ColumnSpacing="10" RowSpacing="3"
                                      ToolTip.Tip="{Binding Path}">
                                    <CheckBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                              Classes="bare"
                                              VerticalAlignment="Center"
                                              IsThreeState="False"
                                              IsEnabled="{Binding HasShownFixes}"
                                              IsChecked="{Binding AllSelected}"
                                              AutomationProperties.Name="{Binding SelectFixesName}" />

                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Title}" />
                                    <!-- Artist · charter, or where the song is when it has neither. The charter can carry
                                         rich-text tags (colours, bold…), which are drawn rather than shown. -->
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Classes="muted"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Details}"
                                               IsVisible="{Binding ShowDetails}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Classes="muted"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ui:RichTextMarkup.Prefix="{Binding BylinePrefix}"
                                               ui:RichTextMarkup.Text="{Binding Charter}"
                                               IsVisible="{Binding ShowByline}" />

                                    <Border Grid.Row="0" Grid.Column="2"
                                            Classes="count fixable"
                                            Classes.zero="{Binding !HasFixes}"
                                            IsVisible="{Binding !IsFixed}"
                                            ToolTip.Tip="{x:Static res:Strings.ValidatorFixableCountToolTip}">
                                        <TextBlock Text="{Binding FixableCountText}" />
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="2"
                                            Classes="count manual"
                                            Classes.zero="{Binding !HasManual}"
                                            IsVisible="{Binding !IsFixed}"
                                            ToolTip.Tip="{x:Static res:Strings.ValidatorManualCountToolTip}">
                                        <TextBlock Text="{Binding ManualCountText}" />
                                    </Border>
                                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                                            Classes="count passes"
                                            IsVisible="{Binding IsFixed}">
                                        <TextBlock Text="{x:Static res:Strings.ValidatorFixed}" />
                                    </Border>
                                </Grid>

                                <!-- Each failing key the filter shows, with why; one with a quick fix can be ticked, with what
                                     the fix does under it. -->
                                <Border Classes="issues" IsVisible="{Binding ShowIssues}">
                                    <ItemsControl ItemsSource="{Binding ShownIssues}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ValidatorIssueViewModel">
                                                <Grid ColumnDefinitions="28,*">
                                                    <CheckBox Grid.Column="0"
                                                              Classes="bare"
                                                              VerticalAlignment="Top"
                                                              IsVisible="{Binding IsFixable}"
                                                              IsChecked="{Binding IsSelected}"
                                                              AutomationProperties.Name="{Binding Text}" />
                                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                            <Border Grid.Column="0" Classes="key" IsVisible="{Binding HasKey}">
                                                                <TextBlock Text="{Binding Key}" />
                                                            </Border>
                                                            <TextBlock Grid.Column="1"
                                                                       Classes="issue"
                                                                       Classes.chartWarning="{Binding IsChartWarning}"
                                                                       Classes.chartError="{Binding IsChartError}"
                                                                       Text="{Binding Message}" />
                                                        </Grid>
                                                        <TextBlock Classes="fix" IsVisible="{Binding IsFixable}" Text="{Binding FixText}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="16"
                            Spacing="10"
                            IsVisible="{Binding ShowNoMatches}">
                    <TextBlock Classes="muted centered" Text="{x:Static res:Strings.ValidatorNoMatches}" TextWrapping="Wrap" />
                    <Button HorizontalAlignment="Center"
                            Content="{x:Static res:Strings.ClearFilters}"
                            Command="{Binding ClearFiltersCommand}" />
                </StackPanel>
            </Panel>
        </DockPanel>

        <GridSplitter Grid.Column="1"
                      Width="4"
                      ResizeDirection="Columns"
                      Background="{DynamicResource SubtleBorderBrush}" />

        <!-- The picked song in the full inspector, with its own Save and Discard, as the main toolbar has. -->
        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Classes="toolbar" BorderThickness="0,0,0,1" IsVisible="{Binding ShowInspector}" IsEnabled="{Binding !IsSaving}">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Panel Width="14" VerticalAlignment="Center">
                            <Arc Classes="spinner"
                                 Classes.active="{Binding Inspector.IsSaving}"
                                 IsVisible="{Binding Inspector.IsSaving}"
                                 Width="14" Height="14" StrokeThickness="2" />
                        </Panel>
                        <Border Classes="toolbar-group">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Classes="tool"
                                        Command="{Binding Inspector.DiscardCommand}"
                                        ToolTip.Tip="{x:Static res:Strings.DiscardToolTip}"
                                        AutomationProperties.Name="{x:Static res:Strings.DiscardButton}">
                                    <ui:LineIcon Data="{StaticResource UndoStroke}" />
                                </Button>
                                <Button Classes="labelled accent"
                                        Command="{Binding Inspector.SaveCommand}"
                                        ToolTip.Tip="{x:Static res:Strings.SaveToolTip}"
                                        AutomationProperties.Name="{x:Static res:Strings.SaveButton}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ui:LineIcon Data="{StaticResource SaveStroke}" />
                                        <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.SaveButton}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Panel>
                    <!-- Nothing is edited while Save all changes writes the drafts. -->
                    <Panel IsVisible="{Binding ShowInspector}" IsEnabled="{Binding !IsSaving}">
                        <views:SongDetailView DataContext="{Binding Inspector}" />
                    </Panel>
                    <TextBlock Classes="muted centered"
                               Margin="24"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ShowPickPrompt}"
                               Text="{x:Static res:Strings.ValidatorPickSong}" />
                </Panel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
