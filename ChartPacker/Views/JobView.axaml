<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ChartPacker.ViewModels"
             xmlns:res="using:ChartPacker.Resources"
             xmlns:sres="using:ChartShared.UI.Resources"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="40"
             x:Class="ChartPacker.Views.JobView"
             x:DataType="vm:JobViewModel">

    <UserControl.Styles>
        <!-- The summary line: flat, and clickable anywhere to open the progress window. The padding is
             cancelled by the margin, so the text sits where it would without the hover area. -->
        <Style Selector="Button.header">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="-6,-4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.header:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolHoverBrush}" />
        </Style>
        <Style Selector="Button.header:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolPressedBrush}" />
        </Style>
    </UserControl.Styles>

    <Border BorderThickness="0,1,0,0"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource SubtleBorderBrush}"
            Padding="12,6">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <!-- Not a tab stop: the Details button is the keyboard route to the same thing. -->
            <Button Grid.Column="0"
                    Classes="header"
                    IsTabStop="False"
                    Command="{Binding ShowDetailsCommand}"
                    ToolTip.Tip="{x:Static res:Strings.JobDetailsToolTip}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Arc Grid.Column="0"
                         Classes="spinner"
                         Classes.active="{Binding IsRunning}"
                         IsVisible="{Binding IsRunning}"
                         Width="14" Height="14" StrokeThickness="2"
                         VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SummaryText}"
                                   FontWeight="SemiBold"
                                   Classes.muted="{Binding IsWaiting}"
                                   TextTrimming="CharacterEllipsis" />
                        <ProgressBar Value="{Binding Progress}"
                                     Minimum="0" Maximum="100"
                                     IsVisible="{Binding IsRunning}" />
                    </StackPanel>
                </Grid>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="{x:Static sres:SharedStrings.CancelButton}"
                        Command="{Binding CancelCommand}"
                        IsVisible="{Binding IsRunning}"
                        AutomationProperties.Name="{x:Static sres:SharedStrings.CancelButton}" />
                <Button MinWidth="84"
                        HorizontalContentAlignment="Center"
                        Content="{x:Static res:Strings.JobDetailsButton}"
                        Command="{Binding ShowDetailsCommand}"
                        ToolTip.Tip="{x:Static res:Strings.JobDetailsToolTip}"
                        AutomationProperties.Name="{x:Static res:Strings.JobDetailsToolTip}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
