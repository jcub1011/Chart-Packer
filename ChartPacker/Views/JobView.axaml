<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ChartPacker.ViewModels"
             xmlns:res="using:ChartPacker.Resources"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="240"
             x:Class="ChartPacker.Views.JobView"
             x:DataType="vm:JobViewModel">

    <UserControl.Resources>
        <!-- Fluent has an error brush but no warning one; these are the Windows caution colours. -->
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WarningTextBrush" Color="#9D5D00" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WarningTextBrush" Color="#FCE100" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.status.attention">
            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
        </Style>
        <Style Selector="TextBlock.status.failed">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
        </Style>
        <Style Selector="TextBlock.message">
            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
        </Style>
        <Style Selector="TextBlock.message.error">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
        </Style>
    </UserControl.Styles>

    <Border BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            Padding="12,8">
        <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Arc Grid.Column="0"
                     Classes="spinner"
                     Classes.active="{Binding IsRunning}"
                     IsVisible="{Binding IsRunning}"
                     Width="14" Height="14" StrokeThickness="2"
                     VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SummaryText}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar Value="{Binding Progress}"
                                 Minimum="0" Maximum="100"
                                 IsVisible="{Binding IsRunning}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <ToggleButton IsChecked="{Binding IsExpanded}"
                                  Content="{x:Static res:Strings.JobDetailsButton}"
                                  AutomationProperties.Name="{x:Static res:Strings.JobDetailsButton}" />
                    <Button Content="{x:Static res:Strings.CancelButton}"
                            Command="{Binding CancelCommand}"
                            IsVisible="{Binding IsRunning}"
                            AutomationProperties.Name="{x:Static res:Strings.CancelButton}" />
                    <Button Content="{x:Static res:Strings.DismissButton}"
                            Command="{Binding DismissCommand}"
                            IsVisible="{Binding !IsRunning}"
                            AutomationProperties.Name="{x:Static res:Strings.DismissButton}" />
                </StackPanel>
            </Grid>

            <ScrollViewer MaxHeight="220"
                          Margin="0,8,0,0"
                          HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding IsExpanded}">
                <ItemsControl ItemsSource="{Binding Items}"
                              AutomationProperties.Name="{x:Static res:Strings.JobResultsListName}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:JobItemRow">
                            <Grid ColumnDefinitions="20,Auto,*" ColumnSpacing="8" Margin="0,3">
                                <TextBlock Grid.Column="0"
                                           Classes="status"
                                           Classes.attention="{Binding IsAttention}"
                                           Classes.failed="{Binding IsFailed}"
                                           FontWeight="Bold"
                                           Text="{Binding Glyph}" />
                                <TextBlock Grid.Column="1"
                                           FontWeight="SemiBold"
                                           MaxWidth="280"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Name}"
                                           Text="{Binding Name}" />
                                <StackPanel Grid.Column="2">
                                    <SelectableTextBlock Opacity="0.8" TextWrapping="Wrap" Text="{Binding Detail}" />
                                    <ItemsControl ItemsSource="{Binding Messages}" IsVisible="{Binding HasMessages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:JobMessageRow">
                                                <TextBlock Classes="message"
                                                           Classes.error="{Binding IsError}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding Text}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
