<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ChartPacker.ViewModels"
        xmlns:svm="using:ChartShared.UI.ViewModels"
        xmlns:sv="using:ChartShared.UI.Views"
        xmlns:res="using:ChartPacker.Resources"
        xmlns:sres="using:ChartShared.UI.Resources"
        xmlns:ui="using:ChartShared.UI.Controls"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="760"
        x:Class="ChartPacker.Views.GenerateDifficultiesWindow"
        x:DataType="vm:GenerateDifficultiesViewModel"
        Title="{x:Static res:Strings.GenerateDifficultiesTitle}"
        Background="{DynamicResource AppBackgroundBrush}"
        Width="1280" Height="760"
        MinWidth="720" MinHeight="480"
        ShowInTaskbar="False"
        CanMinimize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        WindowDecorationsTheme="{StaticResource TitleBarDecorations}"
        WindowStartupLocation="CenterOwner">

    <!-- Generate missing difficulties (charter-spec C16 item 5), opened by the Validator's Fix selected. On the left, the
         rules, as Chart Builder's Reduce shows them; in the middle, the songs, and the one picked as it'd be generated: each
         part's difficulties on the estimator's ladder, the new ones marked; on the right, the part picked in the preview, as
         Reduce's: its drafts against what they're made from, as highways played with the song. It can't be minimized: a
         modal window with no taskbar entry would have nothing to restore it from. -->
    <Window.Styles>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- The title bar, as the main window's is: the icon (the owner's, set in code) and the title. -->
        <ui:TitleBar x:Name="WindowTitleBar"
                     Grid.Row="0"
                     Height="31"
                     BorderThickness="0,0,0,1"
                     BorderBrush="{DynamicResource SubtleBorderBrush}"
                     AppName="{x:Static res:Strings.AppName}">
            <TextBlock Margin="8,0,12,0"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Text="{x:Static res:Strings.GenerateDifficultiesTitle}" />
        </ui:TitleBar>

        <!-- The rules, the songs and their difficulties, and, when it's shown, a splitter and the preview; the code-behind
             sizes the last three as the preview is shown or hidden. -->
        <Grid x:Name="Body" Grid.Row="1" ColumnDefinitions="320,360,Auto,*">
            <!-- The rules, for the family and target picked. -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,14,16,16" Spacing="12">
                        <TextBlock Classes="note" Text="{x:Static res:Strings.GenerateDifficultiesIntro}" />

                        <TextBlock Classes="heading" Margin="0,6,0,0" Text="{x:Static sres:SharedStrings.ReductionRulesHeading}" />
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="caption" VerticalAlignment="Center"
                                       Text="{x:Static sres:SharedStrings.ReductionFamilyLabel}" />
                            <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding FamilyChoices}"
                                      SelectedItem="{Binding SelectedFamily}"
                                      DisplayMemberBinding="{Binding Label, x:DataType=svm:FamilyChoice}"
                                      AutomationProperties.Name="{x:Static sres:SharedStrings.ReductionFamilyLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="caption" VerticalAlignment="Center"
                                       Text="{x:Static sres:SharedStrings.ReductionRulesForLabel}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding TargetChoices}"
                                      SelectedItem="{Binding SelectedTarget}"
                                      DisplayMemberBinding="{Binding Label, x:DataType=svm:DifficultyChoice}"
                                      AutomationProperties.Name="{x:Static sres:SharedStrings.ReductionRulesForLabel}" />
                        </Grid>

                        <sv:ReductionRulesView DataContext="{Binding Rules}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- The songs, then the one picked as it'd be generated: a part picked shows in the preview. -->
            <Grid x:Name="SongsPane" Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*" Margin="20,14,20,0">
                <TextBlock Grid.Row="0" Classes="heading" Text="{x:Static res:Strings.GenerateDifficultiesSongsHeading}" />
                <ListBox Grid.Row="1"
                         Margin="0,8,0,0"
                         MaxHeight="168"
                         ItemsSource="{Binding Songs}"
                         SelectedItem="{Binding SelectedSong}"
                         SelectionMode="Single"
                         AutomationProperties.Name="{x:Static res:Strings.GenerateDifficultiesSongsHeading}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:GenerateDifficultiesSongRow">
                            <StackPanel Spacing="1">
                                <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                <TextBlock Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding Missing}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2" Classes="heading" Margin="0,16,0,0" Text="{x:Static sres:SharedStrings.DifficultyLadderHeading}" />
                <Panel Grid.Row="3" Margin="0,8,0,12">
                    <TextBlock Classes="note" Text="{Binding LaddersStatus}" IsVisible="{Binding HasLaddersStatus}" />
                    <!-- Each part: Expert down to Easy, the new difficulties marked, each a little easier than the one above
                         it, if all's well; then how many findings the new ones have. -->
                    <ListBox ItemsSource="{Binding Ladders}"
                             SelectedItem="{Binding SelectedPart}"
                             SelectionMode="Single"
                             IsVisible="{Binding HasLadders}"
                             ToolTip.Tip="{x:Static res:Strings.GenerateDifficultiesPreviewPartLabel}"
                             AutomationProperties.Name="{x:Static res:Strings.GenerateDifficultiesPreviewPartLabel}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GenerateDifficultiesPartPreview">
                                <StackPanel Spacing="6" Margin="0,4">
                                    <TextBlock Classes="caption" Text="{Binding Name}" />
                                    <sv:DifficultyLadderView DataContext="{Binding Ladder}" />
                                    <TextBlock Classes="note" Text="{Binding Findings}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Panel>
            </Grid>

            <GridSplitter x:Name="PreviewSplitter"
                          Grid.Column="2"
                          Width="4"
                          ResizeDirection="Columns"
                          Background="{DynamicResource SubtleBorderBrush}" />

            <!-- The picked part's drafts against what they're made from, played with the song, as Reduce shows them. -->
            <sv:ReductionPreviewView x:Name="PreviewPane"
                                     Grid.Column="3"
                                     MinWidth="360"
                                     DataContext="{Binding Preview}" />
        </Grid>

        <!-- Reset, Save as defaults and the preview at the left; Cancel and Generate at the right, as the other dialogs have them. -->
        <Border Grid.Row="2" Classes="toolbar" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button MinWidth="80"
                            HorizontalContentAlignment="Center"
                            Content="{x:Static sres:SharedStrings.ReductionResetButton}"
                            Command="{Binding ResetCommand}"
                            ToolTip.Tip="{x:Static sres:SharedStrings.ReductionResetToolTip}"
                            AutomationProperties.Name="{x:Static sres:SharedStrings.ReductionResetButton}" />
                    <Button Content="{x:Static res:Strings.GenerateDifficultiesSaveDefaultsButton}"
                            Command="{Binding SaveDefaultsCommand}"
                            ToolTip.Tip="{x:Static res:Strings.GenerateDifficultiesSaveDefaultsToolTip}"
                            AutomationProperties.Name="{x:Static res:Strings.GenerateDifficultiesSaveDefaultsButton}" />
                    <ToggleButton IsChecked="{Binding Preview.IsExpanded}"
                                  ToolTip.Tip="{x:Static sres:SharedStrings.ReductionPreviewToolTip}"
                                  AutomationProperties.Name="{x:Static sres:SharedStrings.ReductionPreviewButton}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Width="14" Height="14" Data="{StaticResource HighwayIconGeometry}" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Static sres:SharedStrings.ReductionPreviewButton}" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Classes="muted"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding SaveStatus}"
                           IsVisible="{Binding HasSaveStatus}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button MinWidth="80"
                            HorizontalContentAlignment="Center"
                            Content="{x:Static sres:SharedStrings.CancelButton}"
                            Command="{Binding CancelCommand}"
                            IsCancel="True"
                            AutomationProperties.Name="{x:Static sres:SharedStrings.CancelButton}" />
                    <Button MinWidth="80"
                            HorizontalContentAlignment="Center"
                            Classes="accent"
                            Content="{x:Static res:Strings.GenerateDifficultiesGenerateButton}"
                            Command="{Binding GenerateCommand}"
                            IsDefault="True"
                            AutomationProperties.Name="{x:Static res:Strings.GenerateDifficultiesGenerateButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
