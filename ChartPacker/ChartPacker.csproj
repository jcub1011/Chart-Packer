<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The version is set in Directory.Build.props, shared with Chart Builder. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ChartPacker.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PublishAot>True</PublishAot>
    <PublishTrimmed>True</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Serilog" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChartShared.Audio\ChartShared.Audio.csproj" />
    <ProjectReference Include="..\ChartShared.Core\ChartShared.Core.csproj" />
    <ProjectReference Include="..\ChartShared.UI\ChartShared.UI.csproj" />
    <ProjectReference Include="..\ChartShared.Video\ChartShared.Video.csproj" />
  </ItemGroup>

  <!-- In Debug, building Chart Packer builds Chart Builder too, and Chart Packer is told where it is, so Edit
       chart can start it from its own output folder (ChartBuilderLauncher). Installed or published, the two
       share a folder instead. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <ProjectReference Include="..\ChartBuilder\ChartBuilder.csproj" ReferenceOutputAssembly="false" Private="false" />
    <AssemblyMetadata Include="ChartBuilderDebugFolder"
                      Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\ChartBuilder\bin\$(Configuration)\$(TargetFramework)'))" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>ChartPacker.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The language server's design-time build doesn't run CoreResGen, which is what adds the
       generated Strings class to the compile; hand it the last build's copy. -->
  <ItemGroup Condition="'$(DesignTimeBuild)' == 'true'">
    <Compile Include="$(IntermediateOutputPath)Strings.Designer.cs"
             Condition="Exists('$(IntermediateOutputPath)Strings.Designer.cs')" />
  </ItemGroup>
</Project>
