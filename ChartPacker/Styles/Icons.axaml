    <StreamGeometry x:Key="SortDescendingStroke">M4.5,2.5 V13.5 M1.5,10.5 L4.5,13.5 L7.5,10.5 M9.5,4.5 H14.5 M9.5,8 H13 M9.5,11.5 H11.5</StreamGeometry>
