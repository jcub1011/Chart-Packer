    <StreamGeometry x:Key="OutputFolderStroke">M1.5,4 A1,1 0 0 1 2.5,3 H6 L7.5,4.5 H13.5 A1,1 0 0 1 14.5,5.5 V12.5 A1,1 0 0 1 13.5,13.5 H2.5 A1,1 0 0 1 1.5,12.5 Z M5.5,9 H10.5 M8.5,7 L10.5,9 L8.5,11</StreamGeometry>
