    <!-- Line icons on a 16×16 grid, for LineIcon (stroked, not filled). -->
    <StreamGeometry x:Key="InputFolderStroke">M1.5,12.5 V3.5 A1,1 0 0 1 2.5,2.5 H6 L7.5,4 H12 A1,1 0 0 1 13,5 V6.5 M1.5,12.5 L3.4,7.2 A1,1 0 0 1 4.3,6.5 H14 A0.75,0.75 0 0 1 14.7,7.5 L12.9,12 A1,1 0 0 1 12,12.5 Z</StreamGeometry>
