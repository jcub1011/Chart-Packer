<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Filled icons on a 24×24 grid, for PathIcon. -->
    <StreamGeometry x:Key="SngIconGeometry">M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 Z M12,9.5 A2.5,2.5 0 1 1 12,14.5 A2.5,2.5 0 1 1 12,9.5 Z</StreamGeometry>
    <StreamGeometry x:Key="InfoIconGeometry">M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 Z M11,10 L13,10 L13,17 L11,17 Z M12,6 A1.25,1.25 0 1 1 12,8.5 A1.25,1.25 0 1 1 12,6 Z</StreamGeometry>
    <StreamGeometry x:Key="FolderIconGeometry">M2,6 A2,2 0 0 1 4,4 L9.2,4 L11.2,6 L20,6 A2,2 0 0 1 22,8 L22,18 A2,2 0 0 1 20,20 L4,20 A2,2 0 0 1 2,18 Z</StreamGeometry>
    <StreamGeometry x:Key="RevertIconGeometry">M4,9 L9,4 L9,7.5 L13,7.5 A6.5,6.5 0 0 1 13,20.5 L8,20.5 L8,18.5 L13,18.5 A4.5,4.5 0 0 0 13,9.5 L9,9.5 L9,14 Z</StreamGeometry>
    <StreamGeometry x:Key="RemoveIconGeometry">M5.3,4 L12,10.7 L18.7,4 L20,5.3 L13.3,12 L20,18.7 L18.7,20 L12,13.3 L5.3,20 L4,18.7 L10.7,12 L4,5.3 Z</StreamGeometry>
    <!-- A lid with a handle, and a can with two slots cut out. -->
    <StreamGeometry x:Key="TrashIconGeometry">M9,3 L15,3 L15,5 L20,5 L20,7 L4,7 L4,5 L9,5 Z M5.5,8 L18.5,8 L17.4,21 L6.6,21 Z M9,10.5 L10.5,10.5 L10.5,18.5 L9,18.5 Z M13.5,10.5 L15,10.5 L15,18.5 L13.5,18.5 Z</StreamGeometry>
    <!-- A picture frame with a sun and hills: an image. -->
    <StreamGeometry x:Key="ImageIconGeometry">M3,4 L21,4 L21,20 L3,20 Z M5,6 L5,18 L19,18 L19,6 Z M6,17 L10,11.5 L13,15.5 L15,13 L18,17 Z M15.5,7.5 A1.5,1.5 0 1 0 15.5,10.5 A1.5,1.5 0 1 0 15.5,7.5 Z</StreamGeometry>
    <!-- A camera body with its lens hood to the right: a video. -->
    <StreamGeometry x:Key="VideoIconGeometry">M2,6 L16,6 L16,18 L2,18 Z M17,10.5 L22,7 L22,17 L17,13.5 Z</StreamGeometry>
    <!-- Two rails with notes falling between them onto a strike line: the note highway. -->
    <StreamGeometry x:Key="HighwayIconGeometry">M3,2 L5,2 L5,22 L3,22 Z M19,2 L21,2 L21,22 L19,22 Z M7,4 L11,4 L11,7 L7,7 Z M13,9 L17,9 L17,12 L13,12 Z M7,13 L11,13 L11,16 L7,16 Z M5,18.5 L19,18.5 L19,20 L5,20 Z</StreamGeometry>
    <!-- A wide frame with a sun and hills: a background. -->
    <StreamGeometry x:Key="BackgroundIconGeometry">M1,5 L23,5 L23,19 L1,19 Z M3,7 L3,17 L21,17 L21,7 Z M4,16 L9,10 L12.5,14 L15,11.5 L20,16 Z M16.5,8 A1.5,1.5 0 1 0 16.5,11 A1.5,1.5 0 1 0 16.5,8 Z</StreamGeometry>
    <!-- A square frame with a music note inside: album art. -->
    <StreamGeometry x:Key="AlbumArtIconGeometry">M3,3 L21,3 L21,21 L3,21 Z M5,5 L5,19 L19,19 L19,5 Z M11.5,7 L13,7 L16.5,8.5 L16.5,10.5 L13,9 L13,15.5 A2.5,2.5 0 1 1 11.5,13.21 Z</StreamGeometry>
    <!-- Two arrows passing each other, right along the top and left along the bottom: swap one file for another. -->
    <StreamGeometry x:Key="ReplaceIconGeometry">M3,6 L15,6 L15,3 L21,7.25 L15,11.5 L15,8.5 L3,8.5 Z M21,15.5 L9,15.5 L9,12.5 L3,16.75 L9,21 L9,18 L21,18 Z</StreamGeometry>
    <!-- A stopwatch: a ring with a crown on top and one hand. Work out a length. -->
    <StreamGeometry x:Key="AutoLengthIconGeometry">M12,5 A8,8 0 1 0 12,21 A8,8 0 1 0 12,5 Z M12,7 A6,6 0 1 1 12,19 A6,6 0 1 1 12,7 Z M10,1.5 L14,1.5 L14,4 L10,4 Z M11,9 L13,9 L13,13.5 L11,13.5 Z</StreamGeometry>
    <StreamGeometry x:Key="AddIconGeometry">M11,4 L13,4 L13,11 L20,11 L20,13 L13,13 L13,20 L11,20 L11,13 L4,13 L4,11 L11,11 Z</StreamGeometry>
    <StreamGeometry x:Key="PlayIconGeometry">M7,4 L20,12 L7,20 Z</StreamGeometry>
    <StreamGeometry x:Key="PauseIconGeometry">M6,4 L10,4 L10,20 L6,20 Z M14,4 L18,4 L18,20 L14,20 Z</StreamGeometry>
    <StreamGeometry x:Key="StopIconGeometry">M6,6 L18,6 L18,18 L6,18 Z</StreamGeometry>
    <!-- A play triangle after a marker line: play from the preview start. -->
    <StreamGeometry x:Key="PreviewIconGeometry">M5,4 L7.5,4 L7.5,20 L5,20 Z M10,4 L21,12 L10,20 Z</StreamGeometry>
    <!-- A speaker cone and one sound wave. -->
    <StreamGeometry x:Key="VolumeIconGeometry">M3,9 L7,9 L12,5 L12,19 L7,15 L3,15 Z M16,8 A5,5 0 0 1 16,16 L15,14 A3,3 0 0 0 15,10 Z</StreamGeometry>

    <!-- Line icons on a 16×16 grid, for LineIcon (stroked, not filled). -->
    <StreamGeometry x:Key="InputFolderStroke">M1.5,12.5 V3.5 A1,1 0 0 1 2.5,2.5 H6 L7.5,4 H12 A1,1 0 0 1 13,5 V6.5 M1.5,12.5 L3.4,7.2 A1,1 0 0 1 4.3,6.5 H14 A0.75,0.75 0 0 1 14.7,7.5 L12.9,12 A1,1 0 0 1 12,12.5 Z</StreamGeometry>
    <StreamGeometry x:Key="ScanStroke">M13.5,8 A5.5,5.5 0 1 1 11.9,4.1 M11.9,1.1 V4.1 H8.9</StreamGeometry>
    <StreamGeometry x:Key="DepthStroke">M8,1.5 L14.5,5 L8,8.5 L1.5,5 Z M1.5,8 L8,11.5 L14.5,8 M1.5,11 L8,14.5 L14.5,11</StreamGeometry>
    <StreamGeometry x:Key="OutputFolderStroke">M1.5,4 A1,1 0 0 1 2.5,3 H6 L7.5,4.5 H13.5 A1,1 0 0 1 14.5,5.5 V12.5 A1,1 0 0 1 13.5,13.5 H2.5 A1,1 0 0 1 1.5,12.5 Z M5.5,9 H10.5 M8.5,7 L10.5,9 L8.5,11</StreamGeometry>
    <StreamGeometry x:Key="ClearStroke">M4.5,4.5 L11.5,11.5 M11.5,4.5 L4.5,11.5</StreamGeometry>
    <StreamGeometry x:Key="PackStroke">M1.5,9.5 V13.5 H14.5 V9.5 M8,1.5 V9 M5,6 L8,9 L11,6</StreamGeometry>
    <StreamGeometry x:Key="UnpackStroke">M1.5,9.5 V13.5 H14.5 V9.5 M8,9.5 V2 M5,5 L8,2 L11,5</StreamGeometry>
    <StreamGeometry x:Key="FlatStroke">M8,1.5 V5.5 M5.5,3 L8,5.5 L10.5,3 M1.5,8 H14.5 M8,14.5 V10.5 M5.5,13 L8,10.5 L10.5,13</StreamGeometry>
    <StreamGeometry x:Key="UndoStroke">M3,6.5 H10 A3.5,3.5 0 0 1 10,13.5 H6 M6,3.5 L3,6.5 L6,9.5</StreamGeometry>
    <!-- A cog: eight teeth around a hub. -->
    <StreamGeometry x:Key="SettingsStroke">M6.9,1 H9.1 L9.5,2.8 L10.7,3.3 L12.2,2.3 L13.7,3.8 L12.7,5.3 L13.2,6.5 L15,6.9 V9.1 L13.2,9.5 L12.7,10.7 L13.7,12.2 L12.2,13.7 L10.7,12.7 L9.5,13.2 L9.1,15 H6.9 L6.5,13.2 L5.3,12.7 L3.8,13.7 L2.3,12.2 L3.3,10.7 L2.8,9.5 L1,9.1 V6.9 L2.8,6.5 L3.3,5.3 L2.3,3.8 L3.8,2.3 L5.3,3.3 L6.5,2.8 Z M10.25,8 A2.25,2.25 0 1 1 5.75,8 A2.25,2.25 0 1 1 10.25,8 Z</StreamGeometry>
    <!-- A magnifying glass. -->
    <StreamGeometry x:Key="SearchStroke">M11,6.5 A4.5,4.5 0 1 1 2,6.5 A4.5,4.5 0 1 1 11,6.5 Z M9.8,9.8 L14,14</StreamGeometry>
    <StreamGeometry x:Key="FilterStroke">M1.5,2.5 H14.5 L9.5,8.5 V13.5 L6.5,12 V8.5 Z</StreamGeometry>
    <!-- An arrow beside bars; up for first to last, down for last to first. -->
