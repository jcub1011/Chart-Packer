<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ChartPacker.App"
             xmlns:local="using:ChartPacker"
             RequestedThemeVariant="Dark">
             <!-- Dark only, to match the rhythm games the app packs for. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme DensityStyle="Compact">
            <FluentTheme.Palettes>
                <!-- Near-black blue-grey surfaces with an electric-violet accent. -->
                <ColorPaletteResources x:Key="Dark"
                                       Accent="#8B5CF6"
                                       RegionColor="#0E0F14"
                                       ErrorText="#F87171"
                                       AltHigh="#0E0F14"
                                       AltLow="#330E0F14"
                                       AltMedium="#990E0F14"
                                       AltMediumHigh="#CC0E0F14"
                                       AltMediumLow="#660E0F14"
                                       BaseHigh="#ECEBF3"
                                       BaseLow="#2E3040"
                                       BaseMedium="#9A9BB0"
                                       BaseMediumHigh="#B9BACB"
                                       BaseMediumLow="#6A6C82"
                                       ChromeAltLow="#B9BACB"
                                       ChromeBlackHigh="#000000"
                                       ChromeBlackLow="#B9BACB"
                                       ChromeBlackMedium="#000000"
                                       ChromeBlackMediumLow="#000000"
                                       ChromeDisabledHigh="#2E3040"
                                       ChromeDisabledLow="#7C7D92"
                                       ChromeGray="#6E7085"
                                       ChromeHigh="#6E7085"
                                       ChromeLow="#14151C"
                                       ChromeMedium="#1B1C26"
                                       ChromeMediumLow="#232431"
                                       ChromeWhite="#FFFFFF"
                                       ListLow="#1C1D28"
                                       ListMedium="#2A2B3A" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="/Styles/Theme.axaml" />

        <!-- Fluent has no progress ring, so the spinner is a rotating arc. It only animates while
             the "active" class is set, so it doesn't tick while hidden. -->
        <Style Selector="Arc.spinner">
            <Setter Property="StartAngle" Value="0" />
            <Setter Property="SweepAngle" Value="270" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="Stroke">
                <SolidColorBrush Color="{DynamicResource SystemAccentColor}" />
            </Setter>
        </Style>
        <Style Selector="Arc.spinner.active">
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="TextBlock.centered">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Application.Styles>
</Application>
