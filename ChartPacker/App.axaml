<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ChartPacker.App"
             xmlns:local="using:ChartPacker"
             RequestedThemeVariant="Dark">
             <!-- Dark only, to match the rhythm games the app packs for. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ChartPacker.UI/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <!-- The palette, colours and common styles are shared with Chart Builder. -->
    <Application.Styles>
        <StyleInclude Source="avares://ChartPacker.UI/Styles/AppTheme.axaml" />
    </Application.Styles>
</Application>
