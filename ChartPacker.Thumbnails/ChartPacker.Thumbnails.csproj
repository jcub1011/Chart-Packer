<Project Sdk="Microsoft.NET.Sdk">
  <!-- Explorer's thumbnail handler for .sng files: shows a song's album art as its thumbnail. Published
       (build/publish.ps1) as a native DLL, ChartPacker.Thumbnails.dll, which the installer registers as an
       in-process COM server. Windows only. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The COM objects are built by hand from function pointers, as WindowsAudioEndpoint calls them. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChartShared.Core\ChartShared.Core.csproj" />
  </ItemGroup>
</Project>
