<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The SDL3 bindings take pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="NLayer" Version="3.0.0" />
    <PackageReference Include="NVorbis" Version="1.0.0-rc.2" />
    <PackageReference Include="ppy.SDL3-CS" Version="2026.1002.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The decoder tests simulate FFmpeg lacking a decoder, through an internal overload. -->
    <InternalsVisibleTo Include="ChartPacker.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChartPacker.Core\ChartPacker.Core.csproj" />
    <!-- FFmpeg's audio decoders, used when its libraries are present. -->
    <ProjectReference Include="..\ChartPacker.Ffmpeg\ChartPacker.Ffmpeg.csproj" />
  </ItemGroup>
</Project>
