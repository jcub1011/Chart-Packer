<?xml version="1.0" encoding="utf-8"?>
<!-- One package source for this repo. With central package management NuGet warns (NU1507) when more than
     one source is in effect, and every package in Directory.Packages.props comes from nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
